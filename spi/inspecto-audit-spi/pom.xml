<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- LA separation D-1 step 2 (docs/archived-documents/plans-archive/la-separation-d1-design.md): the audit SPI — Event,
         EventLog, EventType and the transitive closure they need (AuditAttrs, AuditChain, EventLevel,
         EventQuery, EventStore, InMemoryEventStore, SecretScrubber, plus metrics.MetricRegistry, which
         EventLog calls and which calls EventLog back). A pure move out of inspecto-event: packages
         com.gamma.event / com.gamma.metrics are unchanged (a split package with inspecto-event,
         Decision 2). Depends on inspecto-util only — NO inspecto-etl. ParquetEventStore (-> etl
         PartitionWriter), DbEventStore, EventStoreAppender and the saved views stay in inspecto-event,
         which depends on this module, so every existing consumer still resolves through it. -->
    <artifactId>inspecto-audit-spi</artifactId>
    <name>Inspecto audit SPI (Event, EventLog, EventType)</name>

    <dependencies>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-util</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- A real SLF4J binding so MDC works in tests (MetricRegistryTest, EventLog space MDC);
             the runtime binding is supplied by inspecto-event (compile). -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- LA separation D-1 (Decision 5): this module may reach ONLY the inspecto-* modules below, directly or
                 transitively, at compile/provided/runtime scope. tools/check-module-deps.mjs derives the same answer from the
                 poms and fails if this list drifts from its ALLOWED table. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>platform-layer-deps</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.gamma.inspector:*:*:*:compile</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:provided</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:runtime</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.gamma.inspector:inspecto-api</include>
                                        <include>com.gamma.inspector:inspecto-util</include>
                                    </includes>
                                    <message>inspecto-audit-spi may depend only on the inspecto-* modules listed in tools/check-module-deps.mjs (LA separation, D-1). A host module here silently undoes the extraction.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
