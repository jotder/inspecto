<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- LA separation D-1 step 3 (docs/archived-documents/plans-archive/la-separation-d1-design.md): the LOWER half of the control contract —
         RequestAttrs, WriteRootProvider, ApiException, ErrorCodes, SpiSlot, WriteGates, Subject, Roles, ComponentAccess, RowScope,
         AccessDecider(s), AccessPolicies, AuditTrail, AccessGrants, Authenticator(s), CapabilityManifest, GeoCountryResolver(s),
         and com.gamma.spi.OptionalSpi (the fail-soft ServiceLoader seam SpiSlot uses; a split package with inspecto-processor).
         A pure move out of inspecto-processor: package com.gamma.control is unchanged (a split package, Decision 2). It references
         NO ApiContext and no host class — inspecto-http-spi depends on THIS module, never the reverse. -->
    <artifactId>inspecto-auth-spi</artifactId>
    <name>Inspecto auth SPI (Subject, Roles, ComponentAccess, request attributes, errors)</name>

    <dependencies>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-util</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-audit-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- LA separation D-1 (Decision 5): this module may reach ONLY the inspecto-* modules below, directly or
                 transitively, at compile/provided/runtime scope. tools/check-module-deps.mjs derives the same answer from the
                 poms and fails if this list drifts from its ALLOWED table. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>platform-layer-deps</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.gamma.inspector:*:*:*:compile</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:provided</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:runtime</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.gamma.inspector:inspecto-api</include>
                                        <include>com.gamma.inspector:inspecto-audit-spi</include>
                                        <include>com.gamma.inspector:inspecto-config</include>
                                        <include>com.gamma.inspector:inspecto-util</include>
                                    </includes>
                                    <message>inspecto-auth-spi may depend only on the inspecto-* modules listed in tools/check-module-deps.mjs (LA separation, D-1). A host module here silently undoes the extraction.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
                    <!-- MODULE-REORG-1 P5b: the Authenticator/TokenRelay TCK(s) ship as this module's test-jar (abstract contract classes + their *TckSelfTest
                 stay here); an implementer's module extends them from its own test tree. Consumers declare it type test-jar, scope test. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
