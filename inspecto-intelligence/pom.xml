<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>inspecto-intelligence</artifactId>
    <packaging>jar</packaging>

    <name>Inspecto — Embedded Intelligence (optional)</name>
    <description>
        Optional embedded-intelligence agent (AGT-5, P0 — docs/superpower/embedded-intelligence-plan.md).
        Implements the IntelligenceAgent SPI from the core module and is loaded in-process by
        SourceService when present on the classpath. The deliberative, multi-turn successor track
        to inspecto-agent's reflex skills: assembles an eoiagent ApplicationPack (InspectoPack) and
        exposes it as chat sessions over /agent/sessions.

        ALL agent-platform deps (eoiagent-*, LangChain4j, the Ollama client) live ONLY in this
        module, so the core fat-JAR stays lean — same air-gap discipline as inspecto-agent.
    </description>

    <!-- langchain4j.version + eoiagent.version are managed by the parent (M1), one line for both
         optional agent modules — they were previously kept in lockstep by hand. -->

    <dependencies>
        <!-- test-jar carries the EventLogLeakDetector (auto-registered JUnit extension). -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-etl</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-processor</artifactId>
            <version>${project.version}</version>
            <!-- `provided` (ASSURE-INTELLIGENCE-BUNDLE-1), as inspecto-agent scopes it: the core is always
                 on a bundle's classpath as inspecto.jar, so shading it into the sidecar would ship a second
                 copy of the product. Still on the compile and test classpath. -->
            <scope>provided</scope>
        </dependency>
        <!-- S9: no longer depends on inspecto-agent. The pack's ModelProfile + LlmGateway are built
             from the core-owned read-side model settings (com.gamma.model.ModelSettings/ModelSettingsStore),
             which read the same assist-settings.properties the agent module's settings screen writes — so
             operators still configure one model provider, without a sibling-internal compile edge. -->

        <!-- eoiagent: ApplicationPack SPI (app-api), PlatformBuilder/AgentPlatform (platform),
             core types (core), and the OpenAI-compatible/Ollama LlmGateway transports (model).
             langchain4j-open-ai excluded so the air-gapped guarantee stays a packaging fact
             (EgressGuardTest) — a hosted module would ship it deliberately. -->
        <dependency>
            <groupId>com.eoiagent</groupId>
            <artifactId>eoiagent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eoiagent</groupId>
            <artifactId>eoiagent-app-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eoiagent</groupId>
            <artifactId>eoiagent-platform</artifactId>
            <!-- ASSURE-INTELLIGENCE-BUNDLE-1: eoiagent-knowledge's pgvector store (and the postgresql
                 driver copy it drags in) is unused here; the bundle has its own postgresql.jar. The ONNX
                 embedding stack is NOT excludable - OnnxEmbeddingAdapter loads all-MiniLM on the session
                 path (proven 2026-09-29: 23 of 214 tests die with NoClassDefFoundError without it). -->
            <exclusions>
                <exclusion>
                    <groupId>dev.langchain4j</groupId>
                    <artifactId>langchain4j-pgvector</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.eoiagent</groupId>
            <artifactId>eoiagent-model</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>dev.langchain4j</groupId>
                    <artifactId>langchain4j-open-ai</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <!-- ASSURE-INTELLIGENCE-BUNDLE-1 (D-P2): Enterprise stages this SHADED `sidecar` artifact as
                     inspecto-intelligence.jar. A thin jar would be present but unable to link (eoiagent,
                     LangChain4j, onnxruntime missing) - the same trap PKG-5 closed for inspecto-agent. -->
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>sidecar</shadedClassifierName>
                            <transformers>
                                <!-- MERGE the ServiceLoader registrations, or the IntelligenceAgent entry is lost. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Same excludes as the inspecto-agent sidecar - see its pom. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>logback.xml</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/services/org.slf4j.spi.SLF4JServiceProvider</exclude>
                                        <exclude>org/slf4j/impl/**</exclude>
                                        <exclude>ch/qos/logback/**</exclude>
                                        <exclude>META-INF/services/java.sql.Driver</exclude>
                                        <exclude>META-INF/services/jakarta.servlet.ServletContainerInitializer</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <!-- onnxruntime 1.20.0 ships DEBUG SYMBOLS beside its native libraries: a
                                         305 MB win-x64 onnxruntime.pdb plus macOS .dSYM bundles. The runtime
                                         never loads them; the libraries themselves stay. -->
                                    <artifact>com.microsoft.onnxruntime:onnxruntime</artifact>
                                    <excludes>
                                        <exclude>**/*.pdb</exclude>
                                        <exclude>**/*.dSYM/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Compiler + surefire native-access flag are inherited from the parent POM's <pluginManagement>. -->
</project>
