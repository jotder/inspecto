partitionKey: MOVED_AT
raw:
  name: receipt
  format: CSV
  fields[7]{name,selector,type,description}:
    MOVEMENT_ID,"@id",VARCHAR,"Goods receipt identifier (the record element's id attribute)"
    MOVED_AT,"at",TIMESTAMP,"When the movement was booked (warehouse-local wall clock, no offset)"
    SKU,"item.@sku",VARCHAR,"Stock-keeping unit"
    QTY,"item.qty.#text",INTEGER,"Quantity moved: the qty element's text, which also carries a uom attribute"
    UOM,"item.qty.@uom",VARCHAR,"Unit of measure"
    SUPPLIER,"supplier",VARCHAR,"Supplier code"
    LOCATION,"location",VARCHAR,"Bin location put away to"
mapping:
  canonicalName: stock_receipts
  rawName: receipt
  fields[8]:
    - name: MOVEMENT_ID
      from: MOVEMENT_ID
      fn: keep
    - name: MOVED_AT
      from: MOVED_AT
      fn: keep
    - name: MOVEMENT_DATE
      from: ""
      fn: custom
      args:
        expression: "CAST(MOVED_AT AS DATE)"
    - name: SKU
      from: SKU
      fn: keep
    - name: QTY
      from: QTY
      fn: keep
    - name: UOM
      from: UOM
      fn: keep
    - name: SUPPLIER
      from: SUPPLIER
      fn: keep
    - name: LOCATION
      from: LOCATION
      fn: keep
