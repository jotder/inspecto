name: stock_movements_routed
active: true
description: "Test fixture: a copy of the demo stock_movements Pipeline (plugin XmlRecordIngester, segments receipt / dispatch / transfer) with ONE shared route: block whose predicate reads QTY, a column every segment maps. @DIR@ is replaced by the test's temp dir."

dirs:
  poll:       "@DIR@/inbox"
  database:   "@DIR@/database"
  backup:     "@DIR@/backup"
  temp:       "@DIR@/temp"
  errors:     "@DIR@/errors"
  quarantine: "@DIR@/quarantine"
  markers:    "@DIR@/markers"
  status_dir: "@DIR@/status"
  log_dir:    "@DIR@/logs"

output:
  format: PARQUET
  compression: snappy

sinks[2]{database,format}:
  "@DIR@/db_bulk",PARQUET
  "@DIR@/db_normal",PARQUET

route:
  mode: case
  default: normal
  branches[2]{key,where,database}:
    bulk,"QTY >= 40","@DIR@/db_bulk"
    normal,"true","@DIR@/db_normal"

processing:
  threads: 1
  file_pattern: "glob:**/*.xml"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  csv_settings:
    timestamp_formats[1]: "%Y-%m-%dT%H:%M:%S"

parsing:
  frontend: plugin
  plugin:
    ingester: com.gamma.ingester.XmlRecordIngester
    segments:
      receipt:  stock_receipt_schema.toon
      dispatch: stock_dispatch_schema.toon
      transfer: stock_transfer_schema.toon
    ingester_config:
      record_element: ""
      namespace_aware: false

collector:
  discovery: poll
  connector: local
