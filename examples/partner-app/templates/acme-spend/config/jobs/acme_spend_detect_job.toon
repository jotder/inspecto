job:
  name: acme_spend_detect
  type: sql.template
  description: "Acme Spend Watch: each account whose amounts in the window exceed the threshold"
  sql: "SELECT account_id, CAST($window_start AS DATE) AS window_date, count(*) AS events, sum(amount) AS total FROM acme_spend_events WHERE event_ts >= CAST($window_start AS TIMESTAMP) AND event_ts < CAST($window_end AS TIMESTAMP) GROUP BY account_id HAVING sum(amount) > CAST($threshold AS DOUBLE)"
  sources: acme_spend_events
  sink_dataset: acme_spend_findings
  cron: "0 2 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  threshold: "1000"
  enabled: true
