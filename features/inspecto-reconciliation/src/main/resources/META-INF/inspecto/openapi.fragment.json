    "/recon/run" : {
      "post" : {
        "tags" : [ "recon" ],
        "summary" : "One day of the Board: a page of grain rows + the day's exact totals and Break summary",
        "operationId" : "postReconRun",
        "description" : "Stateless compute over a saved reconciliation (`id`) or an inline draft (`config`), scoped to ONE day (RECON-PERF-1, operator 2026-10-09). The day's comparison is computed once (one grain join; totals, pair summaries and the group count from one aggregate over it) and cached in memory per (spec, day, sample, input-file stamps), so a further page or filter of the same day is a cache read (`statistics.cached`). `totals` and `summary` cover the whole day whatever the page or filter.",
        "requestBody" : {
          "required" : true,
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "id" : {
                    "type" : "string",
                    "description" : "A saved reconciliation component."
                  },
                  "config" : {
                    "type" : "object",
                    "description" : "An inline reconciliation config."
                  },
                  "day" : {
                    "type" : "string",
                    "format" : "date",
                    "description" : "The ONE day to compare (yyyy-mm-dd) of each Dataset's temporal column (columns[].role temporal, else dateField); absent = the latest day present on any side. A Dataset with no temporal column is a 422 (RECON-PERF-1, operator 2026-10-09)."
                  },
                  "limit" : {
                    "type" : "integer",
                    "minimum" : 1,
                    "maximum" : 200,
                    "default" : 50,
                    "description" : "Page size."
                  },
                  "offset" : {
                    "type" : "integer",
                    "minimum" : 0,
                    "default" : 0
                  },
                  "filter" : {
                    "type" : "string",
                    "enum" : [ "all", "breaks", "missing_a", "missing_b", "missing_c", "value_break" ],
                    "default" : "all",
                    "description" : "Which grain rows the page lists; missing_c only on a 3-way reconciliation."
                  },
                  "sample" : {
                    "type" : "integer",
                    "minimum" : 1,
                    "maximum" : 100000,
                    "description" : "Compare at most this many keys, chosen deterministically (hash of the key); reported in `sample`."
                  }
                }
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "The page and the day.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Envelope"
                  }, {
                    "properties" : {
                      "data" : {
                        "type" : "object",
                        "properties" : {
                          "keyColumns" : {
                            "type" : "array",
                            "items" : {
                              "type" : "string"
                            }
                          },
                          "measures" : {
                            "type" : "array",
                            "items" : {
                              "type" : "string"
                            }
                          },
                          "day" : {
                            "type" : [ "string", "null" ],
                            "format" : "date"
                          },
                          "availableDays" : {
                            "type" : "array",
                            "items" : {
                              "type" : "string",
                              "format" : "date"
                            },
                            "description" : "Days present across the sides, newest first, at most 366."
                          },
                          "filter" : {
                            "type" : "string"
                          },
                          "sample" : {
                            "type" : [ "object", "null" ],
                            "properties" : {
                              "sampled" : {
                                "type" : "boolean"
                              },
                              "size" : {
                                "type" : "integer"
                              },
                              "keys" : {
                                "type" : "integer"
                              },
                              "totalKeys" : {
                                "type" : "integer"
                              }
                            }
                          },
                          "rows" : {
                            "type" : "array",
                            "items" : {
                              "type" : "object"
                            }
                          },
                          "page" : {
                            "type" : "object",
                            "properties" : {
                              "offset" : {
                                "type" : "integer"
                              },
                              "limit" : {
                                "type" : "integer"
                              },
                              "total" : {
                                "type" : "integer"
                              }
                            }
                          },
                          "totals" : {
                            "type" : "object"
                          },
                          "summary" : {
                            "type" : "object"
                          },
                          "statistics" : {
                            "type" : "object",
                            "properties" : {
                              "rowCount" : {
                                "type" : "integer"
                              },
                              "elapsedMs" : {
                                "type" : "integer"
                              },
                              "truncated" : {
                                "type" : "boolean"
                              },
                              "cached" : {
                                "type" : "boolean"
                              }
                            }
                          },
                          "dayScoped" : {
                            "type" : "boolean",
                            "description" : "False when NO reconciled Dataset declares a day column: the whole relations were compared and `day` is null. A mix of dated and undated sides is a 422."
                          }
                        }
                      }
                    }
                  } ]
                }
              }
            }
          },
          "404" : {
            "$ref" : "#/components/responses/NotFound"
          },
          "422" : {
            "$ref" : "#/components/responses/ValidationFailed"
          }
        }
      }
