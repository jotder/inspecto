    "/recon/breaks" : {
      "post" : {
        "tags" : [ "recon" ],
        "summary" : "The paged Break sets of one anchor-relative pair",
        "operationId" : "postReconBreaks",
        "description" : "Stateless compute over a saved reconciliation (`id`) or an inline draft (`config`). Rows always carry the anchor as role `a` and the compared side (`side`: b|c) as role `b`. When the config declares `impact.column` naming a column that is NOT compared, each Break row also carries that column's per-side value as `impact` — summed per key, never compared, so it cannot create or suppress a Break (operator decision 2026-09-25).",
        "requestBody" : {
          "required" : true,
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "id" : {
                    "type" : "string",
                    "description" : "A saved reconciliation component."
                  },
                  "config" : {
                    "type" : "object",
                    "description" : "An inline reconciliation config (datasets, keyColumns, compareColumns, impact:{column, currency}, ...)."
                  },
                  "side" : {
                    "type" : "string",
                    "enum" : [ "b", "c" ],
                    "default" : "b"
                  },
                  "path" : {
                    "type" : "object",
                    "additionalProperties" : {
                      "type" : "string"
                    },
                    "description" : "Board dimension path: key column -> value."
                  },
                  "type" : {
                    "type" : "string",
                    "enum" : [ "missing_left", "missing_right", "value_break", "cardinality_break" ]
                  },
                  "limit" : {
                    "type" : "integer"
                  },
                  "offset" : {
                    "type" : "integer"
                  },
                  "day" : {
                    "type" : "string",
                    "format" : "date",
                    "description" : "The ONE day to compare (yyyy-mm-dd) of each Dataset's temporal column (columns[].role temporal, else dateField); absent = the latest day present on any side. A Dataset with no temporal column is a 422 (RECON-PERF-1, operator 2026-10-09)."
                  }
                }
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "One ReconBreakSet per Break type (all of them unless `type` narrows it).",
            "content" : {
              "application/json" : {
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Envelope"
                  }, {
                    "properties" : {
                      "data" : {
                        "type" : "object",
                        "properties" : {
                          "missing_right" : {
                            "$ref" : "#/components/schemas/ReconBreakSet"
                          },
                          "missing_left" : {
                            "$ref" : "#/components/schemas/ReconBreakSet"
                          },
                          "value_break" : {
                            "$ref" : "#/components/schemas/ReconBreakSet"
                          },
                          "cardinality_break" : {
                            "$ref" : "#/components/schemas/ReconBreakSet"
                          }
                        }
                      }
                    }
                  } ]
                }
              }
            }
          },
          "404" : {
            "$ref" : "#/components/responses/NotFound"
          },
          "422" : {
            "$ref" : "#/components/responses/ValidationFailed"
          }
        }
      }
    },
