id: scoring
title: Scoring
buildRole: implementation
offeringRole: optional
bindingTime: boot
absentMessage: "Risk Scores are not installed in this bundle - they are provided by the optional inspecto-scoring module (Professional edition and above)."
provides:
  features[1]: scoring
  contracts[2]: JobTypeProvider,ComponentKindValidator
  routes[2]: "GET /risk-scores/([^/]+)/([^/]+)","POST /risk-scores/preview"
requires:
  modules[1]: entity-list
