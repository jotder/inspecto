id: scoring
title: Scoring
buildRole: implementation
offeringRole: optional
bindingTime: boot
absentMessage: "Risk Scores are not installed in this bundle - they are provided by the optional inspecto-scoring module (Standard edition and above)."
provides:
  features[1]: scoring
  configKinds[1]: risk-score
  contracts[2]: JobTypeProvider,ComponentKindValidator
  jobTypes[1]: risk.score
  routes[3]: "GET /risk-scores/([^/]+)/([^/]+)","GET /risk-score-lists/([^/]+)","POST /risk-scores/preview"
requires:
  modules[1]: entity-list
