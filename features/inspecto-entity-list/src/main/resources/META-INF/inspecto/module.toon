---
id: entity-list
title: Entity lists
buildRole: implementation
offeringRole: optional
bindingTime: boot
absentMessage: "Entity Lists are not installed in this bundle - they are provided by the optional inspecto-entity-list module (Professional edition and above)."
provides:
  features[1]: entityList
  contracts[2]: GovernableKindProvider,WatchListFeed
  routes[7]: "GET /entity-lists","GET /entity-lists/([^/]+)","POST /entity-lists","POST /entity-lists/([^/]+)/members","POST /entity-lists/([^/]+)/retire","POST /entity-lists/([^/]+)/match","POST /entity-lists/([^/]+)/register-dataset"
requires:
  modules[1]: entity-store
