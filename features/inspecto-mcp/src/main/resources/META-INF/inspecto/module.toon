id: mcp
title: MCP endpoint
buildRole: implementation
offeringRole: optional
bindingTime: boot
absentMessage: "The MCP endpoint is not installed in this bundle - AI agents reach Inspecto through the optional inspecto-mcp module (Standard edition and above; Basic has no sign-in)."
provides:
  features[1]: mcp
  routes[2]: "POST /mcp","GET /.well-known/oauth-protected-resource"
