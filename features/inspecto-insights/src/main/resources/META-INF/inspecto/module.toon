id: insights
title: Business Insights
buildRole: implementation
offeringRole: optional
bindingTime: boot
absentMessage: "Business Insights is not installed in this bundle - it is provided by the optional inspecto-insights module (every edition)."
provides:
  features[1]: insights
  configKinds[1]: insight-profile
  contracts[2]: JobTypeProvider,ComponentKindValidator
  jobTypes[1]: insight.scan
  routes[5]: "POST /insights/explain","GET /insights","GET /insights/brief","POST /insights/preview","POST /insights/([^/]+)/([^/]+)/feedback"
