<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>inspecto-security</artifactId>
    <packaging>jar</packaging>

    <name>Inspecto — security module (Standard edition, optional)</name>
    <description>
        OPTIONAL Standard-edition Authenticator (W6, docs/EDITIONS.md "Security direction"): an OIDC
        resource server that validates IAM-issued (Keycloak/WSO2/Okta/Entra) JWTs via Nimbus JOSE+JWT
        + JWKS and resolves claims -> Roles -> Capabilities (docs/superpower/rbac-groundwork.md).
        Discovered by the core's ServiceLoader seam (com.gamma.control.Authenticator) -- dropping THIS
        jar on the classpath (+ -Dauth.oidc.issuer / -Dauth.oidc.jwksUri) is what turns authentication
        on. The Personal edition never bundles it and stays auth-free -- exactly how inspecto-connectors
        and inspecto-agent-hosted isolate their own optional dependencies from the lean core. Only built
        as part of the reactor under the "edition-standard" profile (see the parent pom's profile-scoped
        &lt;modules&gt;), so a routine "mvn -o clean test" (Personal) never touches this module at all.
    </description>

    <properties>
        <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
    </properties>

    <dependencies>
        <!-- The core: the Authenticator SPI + Subject. PROVIDED (SEC-SIDECAR-BOOT-1, 2026-09-07): this jar
             is dropped onto a running engine's classpath, where inspecto.jar already supplies all of it.
             Compile scope would drag the whole core into the shaded sidecar below. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-processor</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JOSE/JWT signature verification + JWKS (Apache 2.0). Confined to this module. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>

        <!-- slf4j-api facade — this module's only logging need is the boot-time posture warning when
             `auth.oidc.audience` is unset (JAVA-2); version is managed by the parent. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- SEC-SIDECAR-BOOT-1 (2026-09-07). This module shipped as a 16 KB THIN jar with zero
                 com/nimbusds classes, while OidcAuthenticator has nine direct Nimbus imports and
                 ControlApi resolves the Authenticator SPI DURING STARTUP through an unguarded
                 ServiceLoader (SpiSlot). Every Standard and Enterprise bundle therefore failed to boot.
                 Nothing went red: the module's own tests have Nimbus on the compile classpath, and the
                 core-side auth tests inject a lambda via Authenticators.forTest - both halves green, the
                 join untested. Same shape as CONNECTORS-BUNDLE-1, same fix.
                 See okf/backend/build-run/guard-coverage.md. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>sidecar</shadedClassifierName>
                            <transformers>
                                <!-- Load-bearing: the Authenticator / Subject / TokenRelay / SecretsProvider
                                     registrations are how the edition is switched on. Lose them and the
                                     bundle silently reverts to auth-free. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>logback.xml</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
