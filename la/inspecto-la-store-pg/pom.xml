<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>inspecto-la-store-pg</artifactId>
    <packaging>jar</packaging>

    <name>Inspecto — Link Analysis Postgres InvestigationStore (optional)</name>
    <description>
        OPTIONAL (LA-INVESTIGATION-STORE-DESIGN-1, slice S2, decision D-IS7): the PostgreSQL implementation of
        inspecto-la-core's InvestigationStore port, so two pods can serve one Space. Plain JDBC (java.sql) - the driver is the
        host's, exactly as for the other Postgres-backed stores - and NOT wired anywhere: the filesystem store stays the default
        for every edition until slice S6 adds the investigations.backend selection. Built only under the enterprise and preview
        edition profiles. Its tests run the SAME InvestigationStoreContract the filesystem store runs (la-core's test-jar) against
        a real server: set INSPECTO_TEST_PG_URL, otherwise every case SKIPS (and says so).
    </description>

    <dependencies>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-la-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-la-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- test scope is NOT transitive: the module that owns the test must declare the driver (a skipping test cannot report a missing one). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- LA separation D-1 (Decision 5): this module may reach ONLY the inspecto-* modules below, directly or
                 transitively, at compile/provided/runtime scope. tools/check-module-deps.mjs derives the same answer from the
                 poms and fails if this list drifts from its ALLOWED table. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>platform-layer-deps</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.gamma.inspector:*:*:*:compile</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:provided</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:runtime</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.gamma.inspector:inspecto-api</include>
                                        <include>com.gamma.inspector:inspecto-audit-spi</include>
                                        <include>com.gamma.inspector:inspecto-auth-spi</include>
                                        <include>com.gamma.inspector:inspecto-config</include>
                                        <include>com.gamma.inspector:inspecto-entity-store</include>
                                        <include>com.gamma.inspector:inspecto-http-spi</include>
                                        <include>com.gamma.inspector:inspecto-la-core</include>
                                        <include>com.gamma.inspector:inspecto-la-graph</include>
                                        <include>com.gamma.inspector:inspecto-sql</include>
                                        <include>com.gamma.inspector:inspecto-util</include>
                                    </includes>
                                    <message>inspecto-la-store-pg may depend only on the inspecto-* modules listed in tools/check-module-deps.mjs (LA separation, D-1). A host module here silently undoes the extraction.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
