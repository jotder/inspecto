<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>inspecto-la-api</artifactId>
    <packaging>jar</packaging>

    <name>Inspecto — Link Analysis routes (written against the ports) (optional)</name>
    <description>
        OPTIONAL Link Analysis module (LA separation D-1 step 5b/6, 2026-10-01): the Link Analysis control-plane routes
        (package com.gamma.la.api) — the geo and entity projections, traversal and branching patterns, Investigations and
        their Dossier / Working Set / coverage / templates / Case link, Value Measures, entity identities and snapshots —
        written against inspecto-http-spi and the two ports of inspecto-la-core (DatasetProvider, CasePort). It names no
        engine, ETL, acquisition or control-plane class. Contributed through the public com.gamma.control.RouteModule
        ServiceLoader seam. The routes and URLs are exactly those inspecto-geo-link used to register.

        Without a Dataset provider (the bridge, inspecto-geo-link) a route that needs a Dataset answers a clean 503; without
        a Case port a Case link is stored but grants nothing (the existing "ops not installed" behaviour).

        Dependency rule (Decision 5): this module may reach ONLY the inspecto-* modules listed in
        tools/check-module-deps.mjs (the maven-enforcer rule below and the Node guard both derive from that table).
        Bundled in exactly the editions that ship inspecto-geo-link; staged as an optional jar, not part of the fat jar.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-la-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- D-3 step 4: the index build service and the manifest (la-core must NEVER depend on la-storage; only this module does). -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-la-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-entity-store</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-http-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-auth-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-access</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-audit-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-sql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-util</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MODULE-REORG-1 P5a: platform test kit (FakeApiContext + RouteModuleContract TCK) -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-http-spi</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- LA separation D-1 (Decision 5): this module may reach ONLY the inspecto-* modules below, directly or
                 transitively, at compile/provided/runtime scope. tools/check-module-deps.mjs derives the same answer from the
                 poms and fails if this list drifts from its ALLOWED table. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>platform-layer-deps</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.gamma.inspector:*:*:*:compile</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:provided</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:runtime</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.gamma.inspector:inspecto-access</include>
                                        <include>com.gamma.inspector:inspecto-api</include>
                                        <include>com.gamma.inspector:inspecto-audit-spi</include>
                                        <include>com.gamma.inspector:inspecto-auth-spi</include>
                                        <include>com.gamma.inspector:inspecto-config</include>
                                        <include>com.gamma.inspector:inspecto-entity-store</include>
                                        <include>com.gamma.inspector:inspecto-http-spi</include>
                                        <include>com.gamma.inspector:inspecto-la-graph</include>
                                        <include>com.gamma.inspector:inspecto-la-core</include>
                                        <include>com.gamma.inspector:inspecto-la-storage</include>
                                        <include>com.gamma.inspector:inspecto-sql</include>
                                        <include>com.gamma.inspector:inspecto-util</include>
                                    </includes>
                                    <message>inspecto-la-api may depend only on the inspecto-* modules listed in tools/check-module-deps.mjs (LA separation, D-1). A host module here silently undoes the extraction.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
