<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>inspecto-geo-link</artifactId>
    <packaging>jar</packaging>

    <name>Inspecto — geo map + link analysis routes (Professional edition, optional)</name>
    <description>
        OPTIONAL Professional-edition control-plane route groups (EDITIONS.md CP-09, "Geo map + link analysis"):
        GeoRoutes (/geo/projection, /geo/routes) and InvRoutes (/inv/projection, /inv/projection/neighbors,
        /inv/schema/relationships), contributed through the core's public com.gamma.control.RouteModule
        ServiceLoader seam (EDG-01 cell 3a) and registered AFTER the core's built-in route list.

        WHY THIS MODULE EXISTS (EDG-01 cell 3b, 2026-09-07). CP-09 was decided "not for Personal" on
        2026-09-02 and both route groups nonetheless shipped in every bundle because they sat in the core.
        Dropping THIS jar on the classpath is what makes the five paths exist; without it the core answers
        them with 503 "not installed" (AbsentGeoLinkRoutes) and /bootstrap reports features.geoLink=false,
        on which the SPA hides the two nav entries and the two widget offers.

        THIN, like inspecto-policy: nothing beyond what the core already supplies (the query engine, the
        component/view stores, Jackson), so there is no shade and no sidecar classifier.

        Built only under the "edition-professional"/"edition-enterprise" profiles (see the parent pom's
        profile-scoped &lt;modules&gt;), so a routine "mvn -o clean test" (= Personal, the DEFAULT build --
        there is no -Pedition-personal) never compiles or tests it.
    </description>

    <dependencies>
        <!-- The core: RouteModule/ApiContext/ApiException/WriteGates (public since cell 3a), the query
             engine and the component/view stores. Compile scope, as inspecto-policy does — a thin jar
             dropped beside inspecto.jar resolves all of it from there at run time. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-processor</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- LA separation D-1 step 5b/6: Link Analysis itself. inspecto-la-api holds the routes (written against the ports),
             inspecto-la-core the host-free model + the two ports (DatasetProvider, CasePort). THIS module is the BRIDGE: it
             implements the ports from the engine and the host and holds the host-bound routes (Alert Rules). -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-la-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-la-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SEP-08: the Entity List routes (POST /entity-lists ...) are driven by the real-HTTP tests that moved with the
             stack; Link Analysis itself reads the fact log through inspecto-entity-store, never through this module. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-entity-list</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-entity-store</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- fp-etl test-jar: the shared fixtures com.gamma.etl.TestConfigs / PipelineConfigBatchTest boot a
             real CollectorService + ControlApi in the two HTTP tests that moved here with the routes (same
             pattern as inspecto-policy; test scope is not transitive, so declared explicitly). -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-etl</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <!-- LA-COVERAGE-FLOOR-HOME-1: the Link Analysis routes are tested HERE (real-HTTP ControlApi tests need geo-link's
         fixtures), but jacoco credits a class only to the module that owns it, so la/inspecto-la-api/-core/-graph/-storage
         read near zero. This writes target/site/jacoco-aggregate/jacoco.csv covering those modules' classes with this
         module's execution data; tools/check-coverage.mjs keeps the better row per class, so nothing double counts. -->
    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>report-aggregate</id>
                                <phase>test</phase>
                                <goals><goal>report-aggregate</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
