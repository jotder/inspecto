---
id: geo-link
title: Geo and link adapters over platform data
buildRole: implementation
offeringRole: optional
bindingTime: boot
absentMessage: "Geo map and link analysis are not installed in this bundle - they are provided by the optional inspecto-geo-link module (every edition, Basic included)."
provides:
  features[2]: geoLink,investigations
  contracts[6]: CasePort,CollectorCoveragePort,DatasetProvider,LinkIndexBuilder,InvestigationMeasureProbe,OutboundPort
  routes[7]: "GET /inv/investigations/([^/]+)/measures","GET /inv/investigations/([^/]+)/data-changes","GET /inv/investigations/([^/]+)/alert-rules","POST /inv/investigations/([^/]+)/alert-rules","POST /inv/investigations/([^/]+)/standing-detection","DELETE /inv/investigations/([^/]+)/standing-detection/([^/]+)","PUT /inv/investigations/([^/]+)/alert-rules/([^/]+)"
requires:
  modules[2]: la-api,la-core
