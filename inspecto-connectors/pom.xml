<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>inspecto-connectors</artifactId>
    <packaging>jar</packaging>

    <name>Inspecto — remote source connectors (optional)</name>
    <description>
        OPTIONAL remote SourceConnector implementations (Data Acquisition roadmap Phase E):
        SFTP (over sshj) and FTP/FTPS (over Apache commons-net), discovered via the core's
        SourceConnectorFactory ServiceLoader seam.

        This module exists so the lean core (inspecto) stays dep-free: the network client
        libraries (sshj + its BouncyCastle transitive deps, commons-net) live HERE only. The
        default deployment ships the core fat-JAR with the built-in local connector; dropping THIS
        jar on the classpath is what lights up the sftp:/ftp: source schemes. No core code changes
        either way — exactly how inspecto-agent-hosted isolates the hosted-model SDKs.
    </description>

    <properties>
        <sshj.version>0.39.0</sshj.version>
        <commons-net.version>3.6</commons-net.version>
        <!-- postgresql.version managed by the parent (M1) — shared with the core test-scope pin. -->
        <kafka.version>3.9.2</kafka.version>
        <!-- test-only embedded servers -->
        <sshd.version>2.12.1</sshd.version>
        <ftpserver.version>1.2.0</ftpserver.version>
    </properties>

    <dependencies>
        <!-- The core: the SourceConnector SPI, ConnectionProfile, SecretResolver, RetrievalPlan.
             PROVIDED on purpose (CONNECTORS-BUNDLE-1, 2026-09-07): this jar is dropped onto a running
             engine's classpath, where `inspecto.jar` already supplies all of it. Compile scope would drag
             the whole ~97 MB core and its deps into the shaded sidecar below. Same idiom as
             `tools/templates/processor/pom.xml`, the scaffold for third-party plugin modules. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-processor</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- slf4j facade. Seven classes here call LoggerFactory directly, and it used to arrive as a
             transitive of the core — which `provided` above no longer propagates, so the module has to
             declare it (the same "declare it directly" rule the parent pom records for inspecto-util).
             PROVIDED, not compile: the running engine already supplies slf4j-api + its logback binding, so
             shading a second copy of the logging facade into the sidecar would be asking for trouble. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- SFTP client (Apache 2.0). Pulls BouncyCastle transitively — confined to this module. -->
        <dependency>
            <groupId>com.hierynomus</groupId>
            <artifactId>sshj</artifactId>
            <version>${sshj.version}</version>
        </dependency>

        <!-- FTP/FTPS client (Apache 2.0), already in the local .m2 cache. -->
        <dependency>
            <groupId>commons-net</groupId>
            <artifactId>commons-net</artifactId>
            <version>${commons-net.version}</version>
        </dependency>

        <!-- PostgreSQL JDBC driver (BSD-2) for the DB-export source. The connector itself is JDBC-generic
             (any driver on the classpath auto-registers); this is the default target. Confined to this module. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- Kafka consumer client (Apache 2.0) for the streaming source (ACQ-5). 3.9.x = the last line
             compatible with brokers back to 2.1 (4.x drops them). MockConsumer ships in this jar, so the
             tests need no broker. Confined to this module. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>

        <!-- JSON parsing (Apache 2.0) for the native GCS JSON API + OAuth2 token responses (GcsConnector).
             Version is parent-managed (M1); already on the classpath transitively via the core, declared
             directly here for compile honesty. No new jar reaches the fat JAR. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- ── test: embedded servers so the real clients are exercised end-to-end ── -->
        <!-- In-process SFTP server (Apache MINA SSHD) — the server side; the client under test is sshj. -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
            <version>${sshd.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-sftp</artifactId>
            <version>${sshd.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- In-process FTP server (Apache FtpServer) — the server side; the client under test is commons-net. -->
        <dependency>
            <groupId>org.apache.ftpserver</groupId>
            <artifactId>ftpserver-core</artifactId>
            <version>${ftpserver.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- CONNECTORS-BUNDLE-1 (2026-09-07): the DELIVERY half this module's description promised in
                 its founding commit and nobody ever built. A thin jar is useless as a drop-in — sshj,
                 commons-net and kafka-clients would be missing. So the sidecar is SHADED. ⚠ The
                 javax.mail half of that argument moved out with `SmtpEmailChannel` on 2026-09-07 (EDG-01
                 cell 1) — see `inspecto-notify-channels`, which now carries the identical reasoning for
                 its own shade. Removing the dependency also drops a CDDL/GPLv2+CE artifact from the
                 sidecar Personal ships.
                 The core is `provided` above, so it and its deps are excluded by construction; what lands
                 here is exactly the network-client set this module exists to confine. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <!-- Pinned: the offline reactor resolves no plugin version from a repository, and this is
                     the version the core fat jar already uses. -->
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- `sidecar` so the reactor's own thin artifact stays the installed one and
                                 only the bundle carries the fat copy. -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>sidecar</shadedClassifierName>
                            <transformers>
                                <!-- The whole point: MERGE the ServiceLoader registrations, or the eight
                                     CollectorConnectorFactory entries and the two DeliveryStatusAdapter
                                     entries are lost. ⚠ SmtpEmailChannel used to be in this list; it moved
                                     to inspecto-notify-channels on 2026-09-07 (EDG-01 cell 1) because this
                                     sidecar is bundled in EVERY edition and CP-15 is not for Personal. The
                                     inbound DeliveryStatusAdapters stay: they are inert without a
                                     configured signing key and DeliveryStatusRoutes 404s an unconfigured
                                     adapter. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signed jars (BouncyCastle is one): a retained signature throws
                                             SecurityException at run time. Same filter as the core fat jar. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Never ship a second logging config; the core owns it. -->
                                        <exclude>logback.xml</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
