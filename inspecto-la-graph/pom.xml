<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>inspecto-la-graph</artifactId>
    <packaging>jar</packaging>

    <name>Inspecto — Link Analysis graph algorithms (la-graph, optional)</name>
    <description>
        The server-side port of the SPA's graph algorithms (shortest path, centrality, PageRank, Louvain,
        suspicion score, ...), carved out of inspecto-geo-link as D-1 step 1 of the Link Analysis separation
        (docs/superpower/la-separation-d1-design.md). Plain JDK: NO dependency on any platform module, by
        design — that is what lets it be extracted before any SPI exists. Since D-4 step 4 inspecto-la-core's
        InMemoryGraphEngine calls it, so it is staged in the bundles beside inspecto-la-core.jar.

        Built only under the edition profiles (see the parent pom's profile-scoped modules), alongside
        inspecto-geo-link. The parity tests read their fixtures from ../inspecto-ui/projects/link-analysis/src/graph,
        where the TypeScript specs read them too (D-5 step 3 moved them with the library).
    </description>

    <dependencies>
        <!-- Tests only: the parity tests parse the shared JSON fixtures. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- LA separation D-1 (Decision 5): this module may reach ONLY the inspecto-* modules below, directly or
                 transitively, at compile/provided/runtime scope. tools/check-module-deps.mjs derives the same answer from the
                 poms and fails if this list drifts from its ALLOWED table. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>platform-layer-deps</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.gamma.inspector:*:*:*:compile</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:provided</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:runtime</exclude>
                                    </excludes>
                                    <includes>

                                    </includes>
                                    <message>inspecto-la-graph may depend only on the inspecto-* modules listed in tools/check-module-deps.mjs (LA separation, D-1). A host module here silently undoes the extraction.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
