# ngx-toastr's peer range lags Angular by a major: 20.0.5 is the LATEST published version and still
# declares `@angular/common: ^21.0.0` while this project is on 22.1.1. There is no version to upgrade
# to, and the library itself works on 22 (the full suite and `npm run build` are green on it), so the
# conflict is a metadata lag, not an incompatibility.
#
# Pinned here rather than left to whoever runs the install: without it `npm install --legacy-peer-deps`
# succeeds by hand while `npm ci` — which inspecto/package.ps1 step 1b runs — fails ERESOLVE, so a tree
# that builds and tests locally could not be packaged. Revisit (and delete this file) once ngx-toastr
# publishes an Angular 22 peer range.
legacy-peer-deps=true
