/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "compileOnSave": false,
    "compilerOptions": {
        // TypeScript 6 hard-errors on `baseUrl` (TS5101) and TS 7 removes it, so the three
        // src-local import roots are spelled explicitly instead. With no `baseUrl`, `paths`
        // resolve relative to THIS file's directory. Everything else imported bare is a real
        // package in node_modules and needs no mapping.
        "paths": {
            "app/*": ["./src/app/*"],
            "environments/*": ["./src/environments/*"],
            "@gamma": ["./src/@gamma"],
            "@gamma/*": ["./src/@gamma/*"]
        },
        "outDir": "./dist/out-tsc",
        "esModuleInterop": true,
        "sourceMap": true,
        "declaration": false,
        "experimentalDecorators": true,
        "moduleResolution": "bundler",
        // §3.1 imports the committed node-attributes contract JSON directly (mock handler + drift spec).
        // The bundler resolves it either way; this makes the dependency explicit so a plain `tsc`
        // type-check does not fail on an import the build accepts.
        "resolveJsonModule": true,
        "importHelpers": true,
        "target": "ES2022",
        "module": "ES2022",
        "useDefineForClassFields": false,
        "lib": ["ES2022", "dom"],
        // @antv/g6's transitive types reference WebXR/Pixi DOM globals our lib set lacks
        "skipLibCheck": true,
        "strict": false
    },
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictTemplates": true
    }
}
