{
  "description": "REPORT-CHART-MARKERS-1: the same stored Chart Markers and overlays resolve to the same lines, bands and words on screen (chart-markers.ts, chart-overlays.ts) and in the report PDF (com.gamma.job.ChartMarkers). Numbers are worded with no configured format. A null cell is an absent value.",
  "markers": [
    {
      "name": "lines over the drawn values, the Widget's own target",
      "markers": [{"kind": "constant", "value": 50, "label": "Cap"}, {"kind": "average"}, {"kind": "percentile", "p": 90},
                  {"kind": "percentile", "p": 50.5}, {"kind": "target"}],
      "values": [10, 20, 30, 40], "target": 45, "kpi": null,
      "expected": [
        {"type": "line", "value": 50, "text": "Cap 50", "dashed": true},
        {"type": "line", "value": 25, "text": "Average 25", "dashed": true},
        {"type": "line", "value": 37, "text": "90th percentile 37", "dashed": true},
        {"type": "line", "value": 45, "text": "Target 45", "dashed": false, "tone": "info"}
      ]
    },
    {
      "name": "the bound KPI's target wins over the Widget's, RAG up with a label",
      "markers": [{"kind": "target"}, {"kind": "rag", "label": "Status"}],
      "values": [], "target": 45,
      "kpi": {"direction": "up", "target": 60, "bands": {"green": 50, "amber": 30}},
      "expected": [
        {"type": "line", "value": 60, "text": "Target 60", "dashed": false, "tone": "info"},
        {"type": "band", "from": null, "to": 30, "tone": "error", "text": "Status: Red below 30"},
        {"type": "band", "from": 30, "to": 50, "tone": "warning", "text": "Status: Amber 30–50"},
        {"type": "band", "from": 50, "to": null, "tone": "success", "text": "Status: Green at or above 50"}
      ]
    },
    {
      "name": "RAG down",
      "markers": [{"kind": "rag"}], "values": [1], "kpi": {"direction": "down", "bands": {"green": 10, "amber": 20}},
      "expected": [
        {"type": "band", "from": null, "to": 10, "tone": "success", "text": "Green at or below 10"},
        {"type": "band", "from": 10, "to": 20, "tone": "warning", "text": "Amber 10–20"},
        {"type": "band", "from": 20, "to": null, "tone": "error", "text": "Red above 20"}
      ]
    },
    {
      "name": "RAG band",
      "markers": [{"kind": "rag"}], "values": [], "kpi": {"direction": "band", "bands": {"green": [40, 60], "amber": [20, 80]}},
      "expected": [
        {"type": "band", "from": null, "to": 20, "tone": "error", "text": "Red below 20"},
        {"type": "band", "from": 20, "to": 40, "tone": "warning", "text": "Amber 20–40"},
        {"type": "band", "from": 40, "to": 60, "tone": "success", "text": "Green 40–60"},
        {"type": "band", "from": 60, "to": 80, "tone": "warning", "text": "Amber 60–80"},
        {"type": "band", "from": 80, "to": null, "tone": "error", "text": "Red above 80"}
      ]
    },
    {
      "name": "green equal to amber leaves no amber zone",
      "markers": [{"kind": "rag"}], "values": [], "kpi": {"direction": "up", "bands": {"green": 50, "amber": 50}},
      "expected": [
        {"type": "band", "from": null, "to": 50, "tone": "error", "text": "Red below 50"},
        {"type": "band", "from": 50, "to": null, "tone": "success", "text": "Green at or above 50"}
      ]
    },
    {
      "name": "a marker that cannot be placed is dropped; bands are put in order",
      "markers": [{"kind": "average"}, {"kind": "percentile", "p": 13}, {"kind": "percentile", "p": 0}, {"kind": "target"},
                  {"kind": "rag"}, {"kind": "band", "tone": "info"}, {"kind": "band", "from": 5, "to": 5, "tone": "info"},
                  {"kind": "band", "from": 100, "to": 1, "tone": "warning"},
                  {"kind": "band", "to": 1234.567, "tone": "info", "label": "Low"},
                  {"kind": "constant", "value": "7"}],
      "values": [], "kpi": null,
      "expected": [
        {"type": "band", "from": 1, "to": 100, "tone": "warning", "text": "Band 1–100"},
        {"type": "band", "from": null, "to": 1234.567, "tone": "info", "text": "Low below 1,234.57"}
      ]
    }
  ],
  "overlays": [
    {
      "name": "one series: forecast band at 90 %, a flagged point at sensitivity 5",
      "labels": ["2026-01", "2026-02", "2026-03"],
      "overlay": {"forecast": {"level": 0.9}, "anomaly": {"sensitivity": 5}},
      "series": [{"label": "EU", "data": [10, 12, null], "overlay": [
        {"fc": null, "lo": null, "hi": null, "expected": 7, "z": 3},
        {"fc": null, "lo": null, "hi": null, "expected": 12, "z": 1},
        {"fc": 14, "lo": 11, "hi": 17.5, "expected": null, "z": null}]}],
      "expected": [
        {"type": "interval", "points": [{"index": 2, "value": 14, "lower": 11, "upper": 17.5}],
         "text": "Forecast 2026-03 to 2026-03, 90 % band 11–17.5"},
        {"type": "points", "tone": "error", "points": [{"index": 0, "value": 10}],
         "text": "Unusual value at 2026-01 (10, expected 7)"}
      ]
    },
    {
      "name": "two series are named; default sensitivity 3 flags |z| = 3.5 (3.4 is not); a series without cells draws nothing",
      "labels": ["a", "b"],
      "overlay": {"anomaly": {}},
      "series": [
        {"label": "EU", "data": [5, 9], "overlay": [{"fc": null, "lo": null, "hi": null, "expected": 8, "z": -3.5},
                                                     {"fc": null, "lo": null, "hi": null, "expected": 8, "z": 3.4}]},
        {"label": "US", "data": [1, 2], "overlay": [{"fc": null, "lo": null, "hi": null, "expected": 1, "z": 0},
                                                     {"fc": null, "lo": null, "hi": null, "expected": 1, "z": 4}]},
        {"label": "APAC", "data": [3, 3]}],
      "expected": [
        {"type": "points", "tone": "error", "points": [{"index": 0, "value": 5}], "text": "EU: Unusual value at a (5, expected 8)"},
        {"type": "points", "tone": "error", "points": [{"index": 1, "value": 2}], "text": "US: Unusual value at b (2, expected 1)"}
      ]
    }
  ],
  "notes": [
    {
      "name": "fewer than two seasons: the reason, no band",
      "summary": [{"overlay": "forecast", "of": "sum_amount", "series": {}, "reason": "fewer than two seasons (14 days)"}],
      "flagged": 0, "sensitivity": null, "unit": "day",
      "expected": ["No forecast: fewer than two seasons (14 days)."]
    },
    {
      "name": "a tested forecast and the flagged count",
      "summary": [
        {"overlay": "forecast", "of": "sum_amount", "series": {}, "method": "holt-winters", "period": 12, "periodSource": "calendar",
         "level": 0.8, "horizon": 6, "backtest": {"origins": 4, "mape": 12.34, "coverage": 0.75}},
        {"overlay": "anomaly", "of": "sum_amount", "series": {}, "scored": 20, "seasonality": "weekday"}],
      "flagged": 2, "sensitivity": null, "unit": "month",
      "expected": [
        "Forecast of the next 6 months, 80 % band (Holt-Winters, a 12-month calendar season). Tested on this history from 4 starting points: average error 12.3 %, 75.0 % of actual values inside the band.",
        "2 unusual values at sensitivity 3 of 5 (at least 3.5 robust deviations from the same weekday)."
      ]
    },
    {
      "name": "nothing scored: the reason",
      "summary": [{"overlay": "anomaly", "of": "sum_amount", "series": {}, "reason": "fewer than 7 points"}],
      "flagged": 0, "sensitivity": 1, "unit": "day",
      "expected": ["No anomaly markers: fewer than 7 points."]
    }
  ]
}
