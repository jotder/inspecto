# Project exclude paths
# .claude/ IS tracked (shared team Claude Code setup: skills, agents, hooks, settings, maps) —
# only session-local and machine-local state stays ignored:
/.claude/settings.local.json
/.claude/sessions/
/.claude/worktrees/
/.claude/completions/
/.claude/templates/
/.idea/
/backup/
/database/
/errors/
/target/
/inspecto/target/
/inspecto-api/target/
/inspecto-util/target/
/inspecto-config/target/
/inspecto-sql/target/
/inspecto-etl/target/
/inspecto-event/target/
/inspecto-acquire/target/
/inspecto-engine/target/
/inspecto-agent/target/
/inbox/
/markers/

# Build / run artifacts that must never be committed
*.class
*.log
*.dryrun
# Committed example sample data can legitimately be *.log (e.g. text_regex-frontend) — un-ignore it.
!/inspecto/examples/**/samples/**

# IDE files (IntelliJ)
*.iml
/inspecto/.idea/

# Scaffolded pack projects (tools/scaffold.mjs) — a pack is developed and versioned in its own
# repo, never inside the engine's. The templates it is generated from ARE tracked, under tools/.
/packs-dev/

# Local build / deploy artifacts and ad-hoc run output
/inspecto-deploy.zip
/inspecto-deploy-linux.zip
# Since 2026-09-17 package.ps1 names the zip after the EMBEDDED runtime's platform (RELEASE-BUNDLE-PLATFORM-MISMATCH-1)
/inspecto-deploy-*.zip
# Release-integrity sidecars package.ps1 always emits beside each artifact (SOC 2 CC8-04)
/inspecto-deploy*.zip.sha256
/inspecto-deploy*.zip.asc
/inspecto-deploy/
/inspecto-deploy-old/
# The jlink runtime package.ps1 stages for the LINUX bundle (OPS-07, 2026-09-14). 73 MB of binaries,
# left in the working tree by any packaging run and NOT covered by the patterns above — one `git add -A`
# from being committed. Found 2026-09-14 when a package run left it untracked.
/inspecto-deploy-linux-runtime/
# The DuckDB extension cache tools/fetch-duckdb-extensions.mjs writes by default (~160 MB, six binaries).
/.duckdb-extension-cache/
/.graalvm-cache/
# Angular CLI's build cache — regenerated on every `ng build`/`ng serve`.
/.angular/
/file-processor-4.0/
/data/

# Scratch flow config + ad-hoc test-connection artifact
/inspecto/config/
/spaces/default/config/test_connection.toon

# Multi-space runtime output — keep spaces/<id>/config/ + space.toon tracked; ignore generated state.
# (data/samples/ is the one committed exception: pristine sample inputs + seed scripts.)
/spaces/*/data/**
!/spaces/*/data/samples/
!/spaces/*/data/samples/**
/spaces/*/audit/
/spaces/*/duckdb/
/spaces/*/flows/
# The UAT space is fully GENERATED (config cloned from spaces/demo by tools/seed-uat.ps1) — never commit it.
/spaces/uat/

# Stray root-level DuckDB files written by ad-hoc local backend runs (jobs_report, provenance, …)
/inspecto/*.duckdb
/inspecto/*.duckdb.wal
/inspecto/*.db
/inspecto/*.db.wal

# The consignment-outputs registry became default-on (addressing D1), so under the legacy flat layout it
# lands in the working directory — which for a test run is whichever module is building. Matched by bare
# name, at any depth: a build in ANY module now produces it without anyone asking. Real per-space copies
# live under spaces/*/duckdb/, already ignored above.
inspecto-consignment-outputs.db
inspecto-consignment-outputs.db.wal

# Dry-run and audit outputs produced by ad-hoc local runs in the module root
/inspecto/available_files.csv*
/inspecto/missing_files.csv*
/inspecto/error_log.csv*
/inspecto/status_unknown.csv*
/inspecto-agent-hosted/target/
/inspecto-connectors/target/
/inspecto-notify-channels/target/
/inspecto-backup/target/
/inspecto-geo-link/target/
/inspecto-exchange/target/
/inspecto-metrics/target/
/inspecto-events/target/
/inspecto-ops/target/
/inspecto-security/target/
/inspecto-policy/target/
/inspecto-intelligence/target/

# Editor-local config (VS Code)
/.vscode/
**/.history/

# Eclipse writes its build output to bin/, which mirrors .project/.settings/pom.xml and a
# target/ into itself. Derived from `legacy-code/pom.xml` (the only tracked file there), so
# it is regenerated by opening that module — never committed. The per-module /target/ rules
# above do not reach a nested one.
/asn-parser/asn-decoders/legacy-code/bin/

# CodeGraph index (generated, machine-local; rebuild with `codegraph init`)
/.codegraph/

# Session-local working notes (*.local.* files are intentionally never committed)
*.local.md

# Stray npm lockfile at the repo root (no root package.json; the UI's lockfile
# lives in inspecto-ui/ and IS tracked)
/package-lock.json
/inspecto-issues/
/spaces/_shared/

# `mvn dependency:build-classpath` writes cp.txt into every module dir it touches
cp.txt
inspecto-dedup-ledger.db*

# Office lock files (a sheet open in Excel while a shift commits)
~$*

# Generated deliverables: regenerate with scripts/generate_whitepaper_docx.py, never commit the binary
docs/stakeholders/*.docx
