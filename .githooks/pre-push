#!/bin/sh
# .githooks/pre-push — git-native enforcement of the branch/release policy (docs/BRANCHING.md).
# Portable POSIX sh (no python/bash deps) so every teammate + agent gets it.
#
# Enforces:
#   - HARD-BLOCK a push carrying a probable committed secret (SEC-INCIDENT-1).
#   - HARD-BLOCK any push whose target ref is a RETIRED/EOL line (1.x, 2.x, 3.x).
#   - HARD-BLOCK a push that would turn CI red on the canonical-vocabulary guard.
#   - Prints the merge-forward reminder for supported pushes.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Override (humans only):    UCC_RELEASE_GUARD_DISABLE=1 git push ...   (document the exception)

# ── helper: run one pure-Node repo guard ────────────────────────────────────────
# Returns 0 when the guard is clean OR cannot run; 1 when it found violations.
#
# A missing `node` WARNS rather than blocks. Node is not a hard dependency of a backend-only shift,
# and a hook that fails every push on some machines gets `core.hooksPath` unset entirely — after
# which NO layer runs locally, which is strictly worse than skipping one guard. CI is the
# un-bypassable backstop for both guards.
#
# ⚠ stdin is redirected from /dev/null: git feeds this hook the ref list on stdin, and a guard that
# read it would silently eat the lines the loops below depend on. The ref list is captured once, to
# $REFS, and every consumer reads THAT.
#
# Any argument after the third is passed through to the script (used for --range).
run_guard() {
  script=$1; label=$2; skip_note=$3
  shift 3
  [ -f "$script" ] || return 0
  if ! command -v node >/dev/null 2>&1; then
    echo "pre-push: WARNING — node not found, $label SKIPPED." >&2
    echo "          $skip_note" >&2
    return 0
  fi
  node "$script" "$@" </dev/null || return 1
  return 0
}

# ── capture the ref list ONCE ───────────────────────────────────────────────────
# stdin can be read exactly once, and two things now need it: the push-range secret scan and the
# retired-branch loop. Saving it up front is what lets the secrets guard see the range at all —
# previously it ran before anything had read stdin, so it had no way to know what was being pushed.
REFS=$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/pre-push-refs.$$")
cat > "$REFS"
trap 'rm -f "$REFS"' EXIT INT TERM

# ── committed-secret guard (SEC-INCIDENT-1) ─────────────────────────────────────
# Deliberately ABOVE the release-guard override: UCC_RELEASE_GUARD_DISABLE exists so a human can
# push a security backport to an EOL line. It must not also switch off the secrets check — that is
# a different subject, and the moment you most want this guard is a hurried security push.
#
# WHY HERE AND NOT ONLY IN CI: tools/check-secrets.mjs has run in ci.yml since the incident, but CI
# fires AFTER the push. Against a PUBLIC remote the disclosure is already complete by the time the
# build turns red — which is precisely how SEC-INCIDENT-1 happened (pushed 2026-06-12, spotted six
# weeks later). A pre-push block is the only layer that can prevent rather than report.
#
# SCOPE: two passes, because the first one alone hands out a FALSE GREEN. The tree scan sees a
# secret only if it SURVIVES to HEAD; a credential committed and then moved to an env var one commit
# later is invisible to it, while the objects carrying the value still travel in the push. The range
# scan below closes that. CI cannot substitute for it — CI only ever sees HEAD.
#
if ! run_guard tools/check-secrets.mjs "committed-secret guard" \
     "CI still runs it, but only after this push is already public."; then
  echo "pre-push: refusing to push — the committed-secret guard failed (above)." >&2
  echo "          A pushed secret cannot be un-pushed: fix it HERE, before it leaves." >&2
  echo "          If it is genuinely not a secret, append 'secret-allow' on the line." >&2
  exit 1
fi

# ── committed-secret guard, PUSH RANGE ──────────────────────────────────────────
# Also above the override: same subject as the tree scan, same irreversibility.
range_status=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "$local_oid" ] && continue
  # An all-zero LOCAL oid is a branch deletion — it publishes no objects, so there is nothing to scan.
  case "$local_oid" in *[!0]*) : ;; *) continue ;; esac
  # An all-zero REMOTE oid is a NEW branch: there is no `remote..local` range, and scanning the whole
  # of history instead would be both slow and wrong. Bound it by everything the remote already has.
  case "$remote_oid" in
    *[!0]*) range_spec="$remote_oid..$local_oid" ;;
    *)      range_spec="$local_oid --not --remotes" ;;
  esac
  # Unquoted on purpose: $range_spec must word-split into separate git arguments. It only ever holds
  # object ids and flags, never a path.
  if ! run_guard tools/check-secrets.mjs "committed-secret guard (push range)" \
       "This class is invisible to CI, which only ever scans HEAD." \
       --range $range_spec; then
    range_status=1
  fi
done < "$REFS"

if [ "$range_status" -ne 0 ]; then
  echo "pre-push: refusing to push — a secret is present INSIDE the push range (above)." >&2
  echo "          Your working tree is clean, which is exactly why this is easy to miss." >&2
  echo "          Rewrite the range (git rebase -i / filter-repo), then push again." >&2
  exit 1
fi

[ "${UCC_RELEASE_GUARD_DISABLE:-0}" = "1" ] && exit 0

RETIRED="${UCC_RETIRED_BRANCHES:-1.x 2.x 3.x}"
status=0

# pre-push feeds: <local_ref> <local_oid> <remote_ref> <remote_oid>
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/*) target=${remote_ref#refs/heads/} ;;
    *)            target=$remote_ref ;;
  esac
  for r in $RETIRED; do
    if [ "$target" = "$r" ]; then
      echo "pre-push: refusing to push to RETIRED/EOL branch '$r' (docs/BRANCHING.md)." >&2
      echo "          Supported lines: the current N.x maintenance branch + master." >&2
      echo "          A security backport to an EOL line needs a human to set" >&2
      echo "          UCC_RELEASE_GUARD_DISABLE=1 and document the exception." >&2
      status=1
    fi
  done
done < "$REFS"

[ "$status" -ne 0 ] && exit 1

# ── canonical-vocabulary guard (docs/GLOSSARY.md is binding) ────────────────────
# Deliberately BELOW the UCC_RELEASE_GUARD_DISABLE override, unlike the secrets guard above. That
# override exists so a human can push an emergency security backport to an EOL line; a vocabulary
# nit must not stand in the way of that. The secrets check outranks the override because a leaked
# credential is irreversible — a banned synonym is not.
#
# It blocks rather than warns because the only thing a violation buys you is a red CI: the same
# script runs in ci.yml and would reject the push's build anyway. Failing here costs one amended
# commit; failing there costs a broken master everyone else pulls.
#
# ⚠ This is not hypothetical. On 2026-08-26 master was found RED on this guard — two allowlist
# entries whose debt had been paid, plus two real senses — and it had gone unnoticed because
# nothing in the local loop runs it (the Maven reactor and `ng test` do not).
if ! run_guard tools/check-vocabulary.mjs "vocabulary guard" \
     "CI still runs it — an unnoticed violation there is a red master."; then
  echo "pre-push: refusing to push — the canonical-vocabulary guard failed (above)." >&2
  echo "          docs/GLOSSARY.md is binding; the guard names the canonical term for each hit." >&2
  echo "          A genuinely different sense goes in DOC_ALLOW/CONFIG_ALLOW/SOURCE_ALLOW WITH a" >&2
  echo "          reason, or 'vocab-allow' on the line — never an unexplained exemption." >&2
  exit 1
fi

echo "pre-push: nothing is in production after 3.x — master is the only line worked on, so the" >&2
echo "          merge-forward set is EMPTY (BRANCHING.md §0-A; 4.x was deleted 2026-08-17)." >&2
echo "          When the next major is cut and has users, MERGE-FORWARD (oldest supported -> master) applies again." >&2
echo "          Editions are build flavors, not branches." >&2
exit 0
