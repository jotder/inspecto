#!/bin/sh
# .githooks/pre-push — git-native enforcement of the branch/release policy (docs/BRANCHING.md).
# Portable POSIX sh (no python/bash deps) so every teammate + agent gets it.
#
# Enforces:
#   - HARD-BLOCK a push carrying a probable committed secret (SEC-INCIDENT-1).
#   - HARD-BLOCK any push whose target ref is a RETIRED/EOL line (1.x, 2.x, 3.x).
#   - Prints the merge-forward reminder for supported pushes.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Override (humans only):    UCC_RELEASE_GUARD_DISABLE=1 git push ...   (document the exception)

# ── committed-secret guard (SEC-INCIDENT-1) ─────────────────────────────────────
# Deliberately ABOVE the release-guard override: UCC_RELEASE_GUARD_DISABLE exists so a human can
# push a security backport to an EOL line. It must not also switch off the secrets check — that is
# a different subject, and the moment you most want this guard is a hurried security push.
#
# WHY HERE AND NOT ONLY IN CI: tools/check-secrets.mjs has run in ci.yml since the incident, but CI
# fires AFTER the push. Against a PUBLIC remote the disclosure is already complete by the time the
# build turns red — which is precisely how SEC-INCIDENT-1 happened (pushed 2026-06-12, spotted six
# weeks later). A pre-push block is the only layer that can prevent rather than report.
#
# SCOPE: the guard scans TRACKED FILES AS THEY STAND, not every commit in the push range. That
# matches the incident's shape (a secret living in HEAD) but does NOT catch a secret introduced and
# then removed within the pushed range — those values are still in the objects you are about to
# publish. Rewrite such history before pushing; this hook will not see it.
#
# Node is not a hard dependency of a backend-only shift, so a missing node WARNS rather than blocks:
# a hook that fails every push on some machines gets core.hooksPath unset entirely, and then no
# guard runs at all. CI stays the un-bypassable backstop.
if [ -f "tools/check-secrets.mjs" ]; then
  if command -v node >/dev/null 2>&1; then
    if ! node tools/check-secrets.mjs; then
      echo "pre-push: refusing to push — the committed-secret guard failed (above)." >&2
      echo "          A pushed secret cannot be un-pushed: fix it HERE, before it leaves." >&2
      echo "          If it is genuinely not a secret, append 'secret-allow' on the line." >&2
      exit 1
    fi
  else
    echo "pre-push: WARNING — node not found, committed-secret guard SKIPPED." >&2
    echo "          CI still runs it, but only after this push is already public." >&2
  fi
fi

[ "${UCC_RELEASE_GUARD_DISABLE:-0}" = "1" ] && exit 0

RETIRED="${UCC_RETIRED_BRANCHES:-1.x 2.x 3.x}"
status=0

# pre-push feeds: <local_ref> <local_oid> <remote_ref> <remote_oid>
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/*) target=${remote_ref#refs/heads/} ;;
    *)            target=$remote_ref ;;
  esac
  for r in $RETIRED; do
    if [ "$target" = "$r" ]; then
      echo "pre-push: refusing to push to RETIRED/EOL branch '$r' (docs/BRANCHING.md)." >&2
      echo "          Supported lines: the current N.x maintenance branch + master." >&2
      echo "          A security backport to an EOL line needs a human to set" >&2
      echo "          UCC_RELEASE_GUARD_DISABLE=1 and document the exception." >&2
      status=1
    fi
  done
done

[ "$status" -ne 0 ] && exit 1

echo "pre-push: nothing is in production after 3.x — master is the only line worked on, so the" >&2
echo "          merge-forward set is EMPTY (BRANCHING.md §0-A; 4.x was deleted 2026-08-17)." >&2
echo "          When the next major is cut and has users, MERGE-FORWARD (oldest supported -> master) applies again." >&2
echo "          Editions are build flavors, not branches." >&2
exit 0
