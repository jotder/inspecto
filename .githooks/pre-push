#!/bin/sh
# .githooks/pre-push — git-native enforcement of the branch/release policy (docs/BRANCHING.md).
# Portable POSIX sh (no python/bash deps) so every teammate + agent gets it.
#
# Enforces:
#   - HARD-BLOCK a push carrying a probable committed secret (SEC-INCIDENT-1).
#   - HARD-BLOCK any push whose target ref is a RETIRED/EOL line (1.x, 2.x, 3.x).
#   - HARD-BLOCK a push that would turn CI red on the canonical-vocabulary guard.
#   - Prints the merge-forward reminder for supported pushes.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Override (humans only):    UCC_RELEASE_GUARD_DISABLE=1 git push ...   (document the exception)

# ── helper: run one pure-Node repo guard ────────────────────────────────────────
# Returns 0 when the guard is clean OR cannot run; 1 when it found violations.
#
# A missing `node` WARNS rather than blocks. Node is not a hard dependency of a backend-only shift,
# and a hook that fails every push on some machines gets `core.hooksPath` unset entirely — after
# which NO layer runs locally, which is strictly worse than skipping one guard. CI is the
# un-bypassable backstop for both guards.
#
# ⚠ stdin is redirected from /dev/null: git feeds this hook the ref list on stdin, and a guard that
# read it would silently eat the lines the loops below depend on. The ref list is captured once, to
# $REFS, and every consumer reads THAT.
#
# Any argument after the third is passed through to the script (used for --range).
run_guard() {
  script=$1; label=$2; skip_note=$3
  shift 3
  [ -f "$script" ] || return 0
  if ! command -v node >/dev/null 2>&1; then
    echo "pre-push: WARNING — node not found, $label SKIPPED." >&2
    echo "          $skip_note" >&2
    return 0
  fi
  node "$script" "$@" </dev/null || return 1
  return 0
}

# ── capture the ref list ONCE ───────────────────────────────────────────────────
# stdin can be read exactly once, and two things now need it: the push-range secret scan and the
# retired-branch loop. Saving it up front is what lets the secrets guard see the range at all —
# previously it ran before anything had read stdin, so it had no way to know what was being pushed.
REFS=$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/pre-push-refs.$$")
cat > "$REFS"
trap 'rm -f "$REFS"' EXIT INT TERM

# ── committed-secret guard (SEC-INCIDENT-1) ─────────────────────────────────────
# Deliberately ABOVE the release-guard override: UCC_RELEASE_GUARD_DISABLE exists so a human can
# push a security backport to an EOL line. It must not also switch off the secrets check — that is
# a different subject, and the moment you most want this guard is a hurried security push.
#
# WHY HERE AND NOT ONLY IN CI: tools/check-secrets.mjs has run in ci.yml since the incident, but CI
# fires AFTER the push. Against a PUBLIC remote the disclosure is already complete by the time the
# build turns red — which is precisely how SEC-INCIDENT-1 happened (pushed 2026-06-12, spotted six
# weeks later). A pre-push block is the only layer that can prevent rather than report.
#
# SCOPE: two passes, because the first one alone hands out a FALSE GREEN. The tree scan sees a
# secret only if it SURVIVES to HEAD; a credential committed and then moved to an env var one commit
# later is invisible to it, while the objects carrying the value still travel in the push. The range
# scan below closes that. CI cannot substitute for it — CI only ever sees HEAD.
#
if ! run_guard tools/check-secrets.mjs "committed-secret guard" \
     "CI still runs it, but only after this push is already public."; then
  echo "pre-push: refusing to push — the committed-secret guard failed (above)." >&2
  echo "          A pushed secret cannot be un-pushed: fix it HERE, before it leaves." >&2
  echo "          If it is genuinely not a secret, append 'secret-allow' on the line." >&2
  exit 1
fi

# ── committed-secret guard, PUSH RANGE ──────────────────────────────────────────
# Also above the override: same subject as the tree scan, same irreversibility.
range_status=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "$local_oid" ] && continue
  # An all-zero LOCAL oid is a branch deletion — it publishes no objects, so there is nothing to scan.
  case "$local_oid" in *[!0]*) : ;; *) continue ;; esac
  # An all-zero REMOTE oid is a NEW branch: there is no `remote..local` range, and scanning the whole
  # of history instead would be both slow and wrong. Bound it by everything the remote already has.
  case "$remote_oid" in
    *[!0]*) range_spec="$remote_oid..$local_oid" ;;
    *)      range_spec="$local_oid --not --remotes" ;;
  esac
  # Unquoted on purpose: $range_spec must word-split into separate git arguments. It only ever holds
  # object ids and flags, never a path.
  if ! run_guard tools/check-secrets.mjs "committed-secret guard (push range)" \
       "This class is invisible to CI, which only ever scans HEAD." \
       --range $range_spec; then
    range_status=1
  fi
done < "$REFS"

if [ "$range_status" -ne 0 ]; then
  echo "pre-push: refusing to push — a secret is present INSIDE the push range (above)." >&2
  echo "          Your working tree is clean, which is exactly why this is easy to miss." >&2
  echo "          Rewrite the range (git rebase -i / filter-repo), then push again." >&2
  exit 1
fi

[ "${UCC_RELEASE_GUARD_DISABLE:-0}" = "1" ] && exit 0

RETIRED="${UCC_RETIRED_BRANCHES:-1.x 2.x 3.x}"
status=0

# pre-push feeds: <local_ref> <local_oid> <remote_ref> <remote_oid>
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/*) target=${remote_ref#refs/heads/} ;;
    *)            target=$remote_ref ;;
  esac
  for r in $RETIRED; do
    if [ "$target" = "$r" ]; then
      echo "pre-push: refusing to push to RETIRED/EOL branch '$r' (docs/BRANCHING.md)." >&2
      echo "          Supported lines: the current N.x maintenance branch + master." >&2
      echo "          A security backport to an EOL line needs a human to set" >&2
      echo "          UCC_RELEASE_GUARD_DISABLE=1 and document the exception." >&2
      status=1
    fi
  done
done < "$REFS"

[ "$status" -ne 0 ] && exit 1

# ── canonical-vocabulary guard (docs/GLOSSARY.md is binding) ────────────────────
# Deliberately BELOW the UCC_RELEASE_GUARD_DISABLE override, unlike the secrets guard above. That
# override exists so a human can push an emergency security backport to an EOL line; a vocabulary
# nit must not stand in the way of that. The secrets check outranks the override because a leaked
# credential is irreversible — a banned synonym is not.
#
# It blocks rather than warns because the only thing a violation buys you is a red CI: the same
# script runs in ci.yml and would reject the push's build anyway. Failing here costs one amended
# commit; failing there costs a broken master everyone else pulls.
#
# ⚠ This is not hypothetical. On 2026-08-26 master was found RED on this guard — two allowlist
# entries whose debt had been paid, plus two real senses — and it had gone unnoticed because
# nothing in the local loop runs it (the Maven reactor and `ng test` do not).
if ! run_guard tools/check-vocabulary.mjs "vocabulary guard" \
     "CI still runs it — an unnoticed violation there is a red master."; then
  echo "pre-push: refusing to push — the canonical-vocabulary guard failed (above)." >&2
  echo "          docs/GLOSSARY.md is binding; the guard names the canonical term for each hit." >&2
  echo "          A genuinely different sense goes in DOC_ALLOW/CONFIG_ALLOW/SOURCE_ALLOW WITH a" >&2
  echo "          reason, or 'vocab-allow' on the line — never an unexplained exemption." >&2
  exit 1
fi

# Gate-tally guard. BACKLOG §2's summary must match its own table. Local as well as CI because the
# section is edited by hand, in prose, and the failure it catches is a NUMBER that looks like evidence
# and is not — "13 of 15 still gated" was written on 2026-09-07 about a 16-row table with 4 rows nobody
# had checked. Nothing about that is visible to a reader, or to any other guard.
if ! run_guard tools/check-gate-tally.mjs "gate-tally guard"      "CI runs it too — a stale tally there is a red master."; then
  echo "pre-push: refusing to push — BACKLOG §2's stated arithmetic contradicts its table (above)." >&2
  echo "          Fix the SENTENCE to match the rows, never the rows to match the sentence." >&2
  echo "          A gate you cannot run is not a gate that holds: mark it NOT RUN and count it there." >&2
  exit 1
fi

# Family-count guard (2026-09-12). Adding an OperationalDb.Family entry means updating NINE statements
# outside the enum; it was missed by hand twice in two shifts, each time surfacing only after a full
# reactor run. This turns a 14-minute discovery into an instant one.
if ! run_guard tools/check-family-count.mjs "family-count guard"   "CI runs it too — a drifted count there is a red master."; then
  echo "pre-push: refusing to push — a stated OperationalDb.Family count disagrees with the enum (above)." >&2
  echo "          The ENUM is the source of truth; update the statements to match it, never the reverse." >&2
  exit 1
fi

# Doc-link guard. Every relative markdown link in a current doc must resolve. Local as well as CI
# because the thing it catches is created by ordinary, correct work: a class moves module, a plan gets
# archived, a skill is copied to a new folder one level deeper — and the link that pointed at it is now
# a 404 nobody sees. Its first run found 14, including SEVEN in `.claude/skills/*/SKILL.md` pointing at
# `../../docs/…` (i.e. `.claude/docs/`, which does not exist) — skills telling an agent to read
# PROJECT_NOTES / EDITIONS / BRANCHING, resolving to nothing at all.
#
# ⚠ It ignores broken links INSIDE docs/archived-documents/** (never-maintained tier, by policy) but not
# links pointing INTO it, and it prints that exemption on every run — an unstated scope is an unaudited one.
if ! run_guard tools/check-doc-links.mjs "doc-link guard" \
     "CI runs it too — a broken doc link there is a red master."; then
  echo "pre-push: refusing to push — a current doc links to something that does not exist (above)." >&2
  echo "          Fix the LINK, not the guard: a moved target needs its new path, an archived one needs" >&2
  echo "          the docs/archived-documents/… path, and a deleted one needs the link removed." >&2
  exit 1
fi

# Citation guard (2026-09-09, SPEC-STALEREF-1). The link guard above sees markdown `[text](target)` links.
# It cannot see the commoner way a doc points at the tree: a backticked path or class name in PROSE. That
# was unchecked and had rotted — the 17-spec consolidation measured 23 stale citations and this guard,
# once run, found 152: 39 dead paths and 113 citations of Java types the 2026-08-31 Consignment rename
# retired. One of them was a release gate resting on `BatchGraphRunner`, a class that does not exist,
# while `ConsignmentGraphRunner` has two production callers.
#
# ⚠ Two deliberate ALLOW rules, both printed on every run with their counts: a dead path is fine on a line
# that states the absence, and an old type name is fine on a line that also names its replacement — that
# is what RECORDING a rename or a deletion looks like, and it is why this guard needs no waiver list.
# Its old-name set is PARSED from tools/rename-batch-to-consignment.mjs, never mirrored: a hand-mirrored
# map drifts, and that is one of the very failure classes this guard exists to close.
if ! run_guard tools/check-doc-citations.mjs "citation guard" \
     "CI runs it too — a stale citation there is a red master."; then
  echo "pre-push: refusing to push — a current doc cites something that is not there (above)." >&2
  echo "          Fix the CITATION, not the guard. A renamed type needs its current name; a moved path" >&2
  echo "          needs its new one. If the line is deliberately recording history, say so ON the line:" >&2
  echo "          name the replacement, or state that the path no longer exists." >&2
  exit 1
fi

# Doc-count guard (SPEC-COUNTS-1). Every marked count statement must equal what its owning contract
# derives. Cheap (no build, pure file reads) and it catches the commonest doc drift there is: a
# number that was right when it was typed. ⚠ Adding a processor or a node type changes SIX doc
# statements at once, which is the point — the guard names every one of them.
if ! run_guard tools/check-doc-counts.mjs "doc-count guard" \
     "CI runs it too — a drifted count there is a red master."; then
  echo "pre-push: refusing to push — a stated count no longer matches its contract (above)." >&2
  echo "          Fix the DOC, or the contract. A marked number asserts the CURRENT value; if a" >&2
  echo "          line is deliberately recording an old figure, remove the marker rather than" >&2
  echo "          changing the guard. Removing a marker needs its floor lowered in the manifest," >&2
  echo "          on purpose — slack in a floor is where a marker disappears unnoticed." >&2
  exit 1
fi

# NUL-byte guard (2026-09-10, found by scale-out spike S4). One NUL byte makes a whole tracked text
# file INVISIBLE to every recursive ripgrep, so it silently drops out of every sweep and census while
# still matching when its path is named explicitly — which is precisely what hides the hole. Five
# source files were affected, six occurrences, each a separator in a composite map key written as a
# raw 0x00 instead of the escape. This repository reviews itself with grep, so a silent false negative
# in grep is worse than a wrong answer. Falsified four ways before wiring: a NUL put back into a
# tracked .java failed WITH its file and line; a NUL in an UNTRACKED file passed (the scope claim);
# a NUL appended to a tracked .png passed (the extension exemption); and the clean tree passed.
if ! run_guard tools/check-nul-bytes.mjs "NUL-byte guard" \
     "CI runs it too — a NUL byte there makes a file unsearchable for everyone."; then
  echo "pre-push: refusing to push — a tracked text file contains a NUL byte (above)." >&2
  echo "          Fix the FILE. If the byte is a separator in a composite key, write the two-character" >&2
  echo "          escape instead: it compiles to the same character in Java, TypeScript and JavaScript," >&2
  echo "          and it leaves the file searchable." >&2
  exit 1
fi

echo "pre-push: nothing is in production after 3.x — master is the only line worked on, so the" >&2
echo "          merge-forward set is EMPTY (BRANCHING.md §0-A; 4.x was deleted 2026-08-17)." >&2
echo "          When the next major is cut and has users, MERGE-FORWARD (oldest supported -> master) applies again." >&2
echo "          Editions are build flavors, not branches." >&2
exit 0
