<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>inspecto-la-storage</artifactId>
    <packaging>jar</packaging>

    <name>Inspecto — Link Analysis index store (versioned on-disk graph index) (optional)</name>
    <description>
        OPTIONAL Link Analysis module (LA separation D-3 step 2, 2026-10-02): the on-disk graph index store - the
        IndexManifest, IndexMapping and the versioned, atomically published IndexStore (package com.gamma.la.storage).
        Skeleton only: later D-3 steps add the builder, the SqlGraphEngine and the routing engine. Plain java.nio and
        Jackson; no DuckDB yet.

        Dependency rule (D-3 Decision 7): depends on inspecto-la-core; inspecto-la-core must NEVER depend on it
        (inspecto-la-api will). The maven-enforcer rule below and tools/check-module-deps.mjs both derive from the
        ALLOWED table. Staged as an optional jar beside inspecto-la-core.
    </description>

    <dependencies>
        <!-- The host-free LA model; la-storage builds on it (la-core never reaches back). -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-la-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- LA separation D-1 (Decision 5): this module may reach ONLY the inspecto-* modules below, directly or
                 transitively, at compile/provided/runtime scope. tools/check-module-deps.mjs derives the same answer from the
                 poms and fails if this list drifts from its ALLOWED table. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>platform-layer-deps</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.gamma.inspector:*:*:*:compile</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:provided</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:runtime</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.gamma.inspector:inspecto-api</include>
                                        <include>com.gamma.inspector:inspecto-audit-spi</include>
                                        <include>com.gamma.inspector:inspecto-auth-spi</include>
                                        <include>com.gamma.inspector:inspecto-config</include>
                                        <include>com.gamma.inspector:inspecto-entity-store</include>
                                        <include>com.gamma.inspector:inspecto-http-spi</include>
                                        <include>com.gamma.inspector:inspecto-la-graph</include>
                                        <include>com.gamma.inspector:inspecto-la-core</include>
                                        <include>com.gamma.inspector:inspecto-sql</include>
                                        <include>com.gamma.inspector:inspecto-util</include>
                                    </includes>
                                    <message>inspecto-la-storage may depend only on the inspecto-* modules listed in tools/check-module-deps.mjs (LA separation, D-3). A host module here silently undoes the extraction.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
