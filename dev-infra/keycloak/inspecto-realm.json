{
  "realm": "inspecto",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "business",
        "description": "Roles.SEED business: triage requirements."
      },
      {
        "name": "pipeline-developer",
        "description": "Roles.SEED builder: author the workbench and alert rules."
      },
      {
        "name": "operations",
        "description": "Roles.SEED operations: operate runs, work Incidents."
      },
      {
        "name": "power",
        "description": "Roles.SEED power."
      },
      {
        "name": "admin",
        "description": "Roles.SEED admin."
      },
      {
        "name": "super",
        "description": "Roles.SEED super: every capability."
      }
    ],
    "client": {
      "inspecto_spa": [
        {
          "name": "operations",
          "description": "Client role: proves the realm-role + client-role union (auth.oidc.provider=keycloak)."
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "inspecto_spa",
      "name": "Inspecto SPA (dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4204/*",
        "http://localhost:8080/*",
        "http://localhost:8090/*",
        "http://localhost:8095/*",
        "http://localhost:8096/*",
        "http://localhost:8097/*",
        "http://localhost:8098/*",
        "http://localhost:18080/*",
        "http://localhost:18090/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:4204",
        "http://localhost:8080",
        "http://localhost:8090",
        "http://localhost:8095",
        "http://localhost:8096",
        "http://localhost:8097",
        "http://localhost:8098",
        "http://localhost:18080",
        "http://localhost:18090"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:8080/*##http://localhost:8090/*##http://localhost:18080/*##http://localhost:18090/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "inspecto-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "inspecto_spa",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "claude-code",
      "name": "AI agent client (Agent Kit, dev)",
      "description": "DEV FIXTURE. The Agent Kit's agent client: list it in -Dauth.oidc.agentClients. Public, PKCE; redirects of the generated Claude Code, Gemini CLI and OpenCode packages (Codex prints its own).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8765/callback",
        "http://localhost:8765/oauth/callback",
        "http://127.0.0.1:8765/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "inspecto-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "inspecto_spa",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ops-bot",
      "name": "Machine agent client (Agent Kit golden tasks, dev)",
      "description": "DEV FIXTURE. Machine agent for the golden suites: list it in -Dauth.oidc.clients and -Dauth.oidc.agentMachineClients. Service account holds realm role operations. Secret written here on purpose.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-ops-bot",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "inspecto-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "inspecto_spa",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
