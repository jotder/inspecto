<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- com.gamma.acquire (WS-D increment 4): file/remote acquisition — connectors, connection
         profiles/registry/workbench, the fingerprint ledger (metadata/checksum dedup), stability
         gate, gap detection, retry/circuit-breaker/rate-limit policies. No longer SCC-trapped once
         etl became a foundation leaf (increment 1): acquire imports only api/config/etl/event/util,
         and nothing in the remaining engine cluster imports back into it, so it sits below fp-event
         as a clean one-way leaf. -->
    <artifactId>inspecto-acquire</artifactId>
    <name>Inspecto acquire (file/remote acquisition)</name>

    <dependencies>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-util</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-etl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-event</artifactId>
        </dependency>
        <!-- SecretResolver / SecretsProvider live in the auth SPI since D-1 step 4 (the security module needs them without the core). -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-auth-spi</artifactId>
        </dependency>

        <!-- Logging — slf4j-api facade (parent-managed). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- JUnit 5 — unit tests (parent-managed, M1). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- MODULE-REORG-1 P5b: the CollectorConnectorFactory/ExportConnectorFactory TCK(s) ship as this module's test-jar (abstract contract classes + their *TckSelfTest
                 stay here); an implementer's module extends them from its own test tree. Consumers declare it type test-jar, scope test. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
