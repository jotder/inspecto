terms[20]{key,label,abbreviation,definition}:
  concept.node,Subscribers,"","The lines and identities on the canvas."
  concept.link,Calls,"","Calls, messages and other contacts between two lines, folded into one link per pair and kind."
  concept.row,Call detail records,CDR / XDR,"The usage records behind the links: a CDR for voice and SMS, an XDR for data and signalling events."
  concept.link_from,A-party,"","The calling or sending line of a call detail record."
  concept.link_to,B-party,"","The called or receiving line of a call detail record."
  entity_type.msisdn,MSISDN,"","Mobile Station International Subscriber Directory Number: the phone number of a line, keyed in E.164 form."
  entity_type.imsi,IMSI,"","International Mobile Subscriber Identity: the identity stored on the SIM card."
  entity_type.imei,IMEI,"","International Mobile Equipment Identity: the serial number of a handset."
  entity_type.handset,Handset,"","The phone a SIM card is used in, identified by its IMEI."
  entity_type.cell,Cell ID,"","The radio cell that served an event; a proxy for where the line was."
  link_kind.voice,Voice call,"","A voice call between two lines."
  link_kind.sms,SMS,"","A text message between two lines."
  link_kind.forwarding,Call forwarding,"","One line forwards its calls to another."
  link_kind.shared_device,Shared handset,"","Two lines were used in the same handset."
  link_kind.shared_identity,Shared identity,"","Two lines were registered with the same identity document."
  link_kind.shared_payment,Shared payment,"","Two lines were topped up or billed with the same payment instrument."
  pattern.forwarding-relay,Call-forwarding relay,"","A line forwards to a second line, which forwards on to a third, hiding where the calls end."
  term.simbox,SIM box,"","A gateway holding many SIM cards that turns international calls into local ones to bypass interconnect charges."
  term.irsf,IRSF,"","International Revenue Share Fraud: traffic pumped to high-cost international numbers whose operator shares the revenue."
  term.wangiri,Wangiri,"","One-ring fraud: a short missed call from a premium-rate number that tempts the victim to call back."
