terms[26]{key,label,abbreviation,definition}:
  concept.node,Wallets,"","The wallets, agents and merchants on the canvas."
  concept.link,Transfers,"","Movements of value between two parties, folded into one link per pair and kind."
  concept.row,Wallet transactions,"","The ledger entries behind the links."
  concept.link_from,Sending wallet,"","The wallet or agent the value leaves."
  concept.link_to,Receiving wallet,"","The wallet, agent or merchant the value reaches."
  entity_type.wallet,Wallet,"","A mobile money account held on a phone number."
  entity_type.agent,Agent,"","A registered shop or person who exchanges cash for wallet value on behalf of the provider."
  link_kind.p2p,P2P transfer,P2P,"A person-to-person transfer between two wallets."
  link_kind.cash_in,Cash-in,"","A customer hands cash to an agent, who credits the customer's wallet."
  link_kind.cash_out,Cash-out,"","An agent pays out cash and debits the customer's wallet."
  link_kind.merchant_pay,Merchant payment,"","A wallet pays a registered merchant."
  link_kind.shared_device,Shared device,"","Two wallets were used from the same phone."
  link_kind.shared_id,Shared identity,"","Two wallets were registered with the same identity document."
  measure.timeToCashOut,Time to cash-out,"","How quickly value received by a wallet leaves it again as cash through an agent."
  measure.cashOutConcentration,Cash-out concentration,"","The share of an agent's cash-out paid to a few wallets fed by many payers."
  term.float,Float,"","The electronic value and cash an agent holds to serve cash-in and cash-out."
  record_type.transfer,Wallet transfer,"","One movement of value from one wallet to another."
  record_type.cash_out,Cash-out,"","An agent pays a customer cash and debits the customer's wallet."
  entity_type.merchant,Merchant,"","A business that wallets pay for goods and services, named by its merchant code."
  entity_type.biller,Biller,"","A company whose bills wallets pay: a utility, a school, an insurer."
  record_type.cash_in,Cash-in,"","An agent takes a customer's cash and credits the customer's wallet."
  record_type.merchant_payment,Merchant payment,"","A wallet pays a merchant."
  record_type.bill_payment,Bill payment,"","A wallet pays a biller for an account the biller keeps."
  record_type.bank_transfer,Bank transfer,"","Value moved between a wallet and a bank account or a payment card."
  record_type.kyc_registration,KYC registration,"","A customer's wallet opened against an identity document (know your customer)."
  record_type.login_event,App sign-in,"","A wallet holder signing in to the provider's app, from a handset and a network address."
