<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- LA separation D-1 step 3: the UPPER half of the control contract — ApiContext (routing, request/response helpers,
         capability gates), RouteModule, Handler, Envelope, Idempotency. Depends on inspecto-auth-spi. It names no host class
         once ApiContext.service()/spaces()/sseStreams() move to HostContext (step 3c). -->
    <artifactId>inspecto-http-spi</artifactId>
    <name>Inspecto HTTP SPI (ApiContext, RouteModule, Handler, Envelope)</name>

    <dependencies>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-auth-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-util</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- LA separation D-1 (Decision 5): this module may reach ONLY the inspecto-* modules below, directly or
                 transitively, at compile/provided/runtime scope. tools/check-module-deps.mjs derives the same answer from the
                 poms and fails if this list drifts from its ALLOWED table. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>platform-layer-deps</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.gamma.inspector:*:*:*:compile</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:provided</exclude>
                                        <exclude>com.gamma.inspector:*:*:*:runtime</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.gamma.inspector:inspecto-api</include>
                                        <include>com.gamma.inspector:inspecto-audit-spi</include>
                                        <include>com.gamma.inspector:inspecto-auth-spi</include>
                                        <include>com.gamma.inspector:inspecto-config</include>
                                        <include>com.gamma.inspector:inspecto-util</include>
                                    </includes>
                                    <message>inspecto-http-spi may depend only on the inspecto-* modules listed in tools/check-module-deps.mjs (LA separation, D-1). A host module here silently undoes the extraction.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
