{
  "realm": "inspecto",
  "enabled": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "business",
        "description": "Read-only + Requirements/Reconciliation authoring."
      },
      {
        "name": "pipeline-developer",
        "description": "canAuthorWorkbench: Connections/Pipelines/Jobs create-edit-delete, pipeline canvas."
      },
      {
        "name": "operations",
        "description": "canOperateRuns: Runs trigger/pause/resume/reprocess."
      },
      {
        "name": "power",
        "description": "Union of canAuthorWorkbench + canOperateRuns."
      },
      {
        "name": "admin",
        "description": "User admin, external-system onboarding (grants beyond the current 3 named capabilities — rbac-groundwork.md §4 open Q1, not yet enforced server-side)."
      },
      {
        "name": "super",
        "description": "All grants — canAuthorWorkbench + canOperateRuns + canTriageRequirements."
      }
    ]
  },
  "clients": [
    {
      "clientId": "inspecto-spa",
      "name": "Inspecto SPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://inspecto.internal/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "https://inspecto.internal",
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://inspecto.internal/*"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "inspecto-api",
      "name": "Inspecto Control Plane (resource server audience)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ]
}
