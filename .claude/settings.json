{
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelLimits": {
    "stealth/ox-alpha": {
      "contextWindow": 1000000,
      "maxOutputTokens": 128000
    }
  },
  "enabledPlugins": {
    "apollo@inline": false,
    "brand-voice@inline": false,
    "common-room@inline": false,
    "human-resources@inline": false,
    "operations@inline": false
  },
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(/c/maven/apache-maven-3.9.16/bin/mvn:*)",
      "Bash(java:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx vitest:*)",
      "Bash(npx ng:*)",
      "Bash(pnpm:*)",
      "Bash(pwsh:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(xargs:*)",
      "Bash(mkdir:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git check-ignore:*)",
      "Bash(git config:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(mvn:*)",
      "PowerShell(npm:*)",
      "PowerShell(node:*)",
      "WebSearch",
      "mcp__Claude_Preview__preview_start"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-git-release-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-tool-db-layer-doc.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-context.sh",
            "statusMessage": "Loading repo-first protocol + shift snapshot"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-session-snapshot.sh",
            "statusMessage": "Writing session snapshot for shift handover"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact-persist.sh",
            "statusMessage": "Reminding to persist knowledge before compaction"
          }
        ]
      }
    ]
  }
}
