{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "inspecto-ui",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd inspecto-ui && npx ng serve --port %PORT%"
      ],
      "autoPort": true,
      "port": 4204
    },
    {
      "name": "inspecto-bundle",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd inspecto-deploy && set PORT=%PORT% && set CONTROL_TOKEN=devtoken && call .\\serve.bat"
      ],
      "autoPort": true,
      "port": 8090
    },
    {
      "name": "inspecto-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "pwsh -NoProfile -File tools\\run-backend.ps1 -Port %PORT%"
      ],
      "autoPort": true,
      "port": 8080
    },
    {
      "name": "inspecto-geolink",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd inspecto-deploy && runtime\\bin\\java.exe --enable-native-access=ALL-UNNAMED -Dcontrol.port=%PORT% -Dspaces.root=..\\spaces -Dui.dir=./ui -Dduckdb.extension.dir=duckdb-extensions\\windows_amd64 -cp inspecto.jar;inspecto-connectors.jar;inspecto-notify-channels.jar;inspecto-backup.jar;inspecto-geo-link.jar;inspecto-exchange.jar;inspecto-metrics.jar;inspecto-events.jar;inspecto-ops.jar;inspecto-agent.jar com.gamma.control.ControlApi"
      ],
      "autoPort": true,
      "port": 8090
    },
    {
      "name": "inspecto-geolink-8080",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd inspecto-deploy && runtime\\bin\\java.exe --enable-native-access=ALL-UNNAMED -Dcontrol.port=8080 -Dspaces.root=..\\spaces -Dui.dir=./ui -Dduckdb.extension.dir=duckdb-extensions\\windows_amd64 -cp inspecto.jar;inspecto-connectors.jar;inspecto-notify-channels.jar;inspecto-backup.jar;inspecto-geo-link.jar;inspecto-exchange.jar;inspecto-metrics.jar;inspecto-events.jar;inspecto-ops.jar;inspecto-agent.jar com.gamma.control.ControlApi"
      ],
      "port": 8080
    }
  ]
}
