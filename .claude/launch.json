{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "inspecto-ui",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd inspecto-ui && npx ng serve --port %PORT%"
      ],
      "autoPort": true,
      "port": 4204
    },
    {
      "name": "inspecto-bundle",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd inspecto-deploy && set PORT=%PORT% && set CONTROL_TOKEN=devtoken && call .\\serve.bat"
      ],
      "autoPort": true,
      "port": 8090
    },
    {
      "name": "inspecto-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "pwsh -NoProfile -File tools\\run-backend.ps1 -Port %PORT%"
      ],
      "autoPort": true,
      "port": 8080
    }
  ]
}
