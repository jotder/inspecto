<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gamma.asn</groupId>
    <artifactId>asn-decoders</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>ASN.1 decoder rewrite (docs/REDESIGN.md). JDK-only at runtime; test scope may use JUnit.</description>

    <modules>
        <module>asn-core</module>
        <module>asn-schema</module>
        <module>asn-plugin-api</module>
        <module>asn-transform</module>
        <module>asn-plugin-vendors</module>
        <module>asn-facade</module>
        <module>legacy-code</module>
        <module>asn-golden</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.12.2</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- Coverage reporting, mirroring the inspecto root POM's `coverage` profile (GUARD-SWEEP-1g,
         2026-09-08).

         🔴 It has to be DUPLICATED here, not inherited. This POM is a separate root
         (com.gamma.asn:asn-decoders) that the inspecto reactor merely AGGREGATES as a module — and a
         Maven profile is inherited through <parent>, never through aggregation. So the root's profile
         could not reach these nine modules, and `mvn -Pcoverage` produced reports for 21 modules while
         silently measuring nothing here: ~13 300 lines across 91 files, about a tenth of the codebase,
         absent from a number presented as repo-wide. That is exactly the "scope exemptions are silent by
         default" failure guard-coverage.md documents.

         ⚠ REPORTING only — prepare-agent + report, no `check` goal and no threshold, so it cannot fail a
         build. Keep it in step with the root profile if that one changes. -->
    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.13</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals><goal>prepare-agent</goal></goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals><goal>report</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
