target/
.idea/
*.iml

# ─────────────────────────────────────────────────────────────────────────────
# OPERATOR DATA — NEVER COMMIT. See DATA-GOV-1 in docs/BACKLOG.md §5.
# These trees hold real carrier CDR captures and their DECODED output, which
# carry subscriber identifiers. A push is irreversible: history, forks and
# caches keep content that is later deleted (the SEC-INCIDENT-1 lesson).
# Keep them on disk for local parity runs; they must not enter git.
# ─────────────────────────────────────────────────────────────────────────────
config/
data/

# The corpus keeps only AGGREGATE evidence tracked — PARITY.md, README.md,
# SUMMARY.json and per-case report.json (counts, ratios, capture file names) —
# never the records themselves (~37 MB across 25 files).
corpus/**/*.jsonl

# ⚠ parity.json is NOT aggregate: every one carries a 25-entry `content.examples[]`
# of `{new, leaf, legacy}` — actual decoded FIELD VALUES, including 15-digit
# subscriber identifiers and raw legacy bytes. Verified 2026-07-30 across all 9.
corpus/**/parity.json

# Generated parity OUTPUT — regenerable by the documented commands in
# corpus/README.md, goes stale silently, and enumerates carrier capture
# filenames / network-element names. Only README.md (the hand-written corpus
# contract) is tracked.
corpus/PARITY.md
corpus/SUMMARY.json
corpus/**/report.json

# Archives of the above — a single `git add -A` would otherwise commit the whole
# corpus as one blob. This is how 132 MB nearly shipped on 2026-07-30.
*.7z
*.rar
*.zip
*.gz
*.tar
*.tgz

# Raw capture formats, wherever they land.
*.ber
*.dat
*.backup
