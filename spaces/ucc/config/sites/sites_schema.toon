raw:
  name: SITES
  format: CSV
  fields[6]{name,selector,type}:
    SITE_ID,"0",VARCHAR
    SITE_NAME,"1",VARCHAR
    SITE_LAT,"2",DOUBLE
    SITE_LON,"3",DOUBLE
    CAPACITY,"4",VARCHAR
    STATUS,"5",VARCHAR
mapping:
  canonicalName: sites
  rawName: SITES
  fields[6]:
    - name: SITE_ID
      from: SITE_ID
      fn: keep
    - name: SITE_NAME
      from: SITE_NAME
      fn: keep
    - name: SITE_LAT
      from: SITE_LAT
      fn: keep
    - name: SITE_LON
      from: SITE_LON
      fn: keep
    - name: CAPACITY
      from: ""
      fn: custom
      args:
        expression: "TRY_CAST(CAPACITY AS INTEGER)"
    - name: STATUS
      from: STATUS
      fn: keep
