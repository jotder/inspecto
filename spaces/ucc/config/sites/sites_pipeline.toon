name: sites
active: true

dirs:
  poll:       data/inbox/sites
  database:   data/sites/database
  backup:     data/sites/backup
  temp:       data/sites/temp
  errors:     data/sites/errors
  quarantine: data/sites/quarantine
  markers:    data/sites/markers
  status_dir: data/sites/status
  log_dir:    data/sites/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.dat"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 90
  grammar:     sites.grammar.toon
  schema_file: sites_schema.toon

collector:
  discovery: poll
  connector: local
