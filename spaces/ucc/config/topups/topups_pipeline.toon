name: topups
active: true

dirs:
  poll:       data/inbox/topups
  database:   data/topups/database
  backup:     data/topups/backup
  temp:       data/topups/temp
  errors:     data/topups/errors
  quarantine: data/topups/quarantine
  markers:    data/topups/markers
  status_dir: data/topups/status
  log_dir:    data/topups/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.json"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 90
  schema_file: topups_schema.toon
  csv_settings:
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

parsing:
  frontend: json
  json:
    format: newline

collector:
  discovery: poll
  connector: local
  gap_detection:
    enabled: true
    sequence: "TOPUPS_{yyyyMMdd}"
