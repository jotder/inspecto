name: VOUCHER_UNKNOWN_ETL
active: true

dirs:
  poll:       data/inbox/voucher/unknown
  database:   data/voucher/database
  backup:     data/voucher/backup
  temp:       data/voucher/temp
  errors:     data/voucher/errors
  quarantine: data/voucher/quarantine
  markers:    data/voucher/markers
  status_dir: data/voucher/status
  log_dir:    data/voucher/logs

output:
  format: CSV
  compression: snappy

processing:
  threads: 3
  duckdb_threads: 0
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 90
  schemas[3]{column_count,file_pattern,schema_file,table}:
    76,  "glob:**/*other*",    "voucher_76.toon",  voucher_other
    116, "glob:**/*main*",     "voucher_116.toon", voucher_main
    537, "",                   "voucher_537.toon", voucher
  duckdb:
    temp_directory: ""
    memory_limit: ""
    max_temp_directory_size: ""
  grammar: voucher.grammar.toon

collector:
  consignment:
    max_files: 500
    max_bytes: 268435456
  stability:
    window: 10s
    size_checks: 2
