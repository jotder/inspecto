partitionKey: PAID_DATE
raw:
  name: PAYMENTS
  format: CSV
  fields[10]{name,selector,type}:
    PAYMENT_ID,"0",VARCHAR
    PAYER_ACCOUNT,"1",VARCHAR
    PAYEE_ACCOUNT,"2",VARCHAR
    MERCHANT,"3",VARCHAR
    AMOUNT,"4",DOUBLE
    CURRENCY,"5",VARCHAR
    MERCHANT_LAT,"6",DOUBLE
    MERCHANT_LON,"7",DOUBLE
    PAID_DATE,"8",DATE
    PAID_AT,"9",TIMESTAMP
mapping:
  canonicalName: payments
  rawName: PAYMENTS
  rules[10]{targetColumn,sourceExpression,transformType}:
    PAYMENT_ID,PAYMENT_ID,DIRECT
    PAYER_ACCOUNT,PAYER_ACCOUNT,DIRECT
    PAYEE_ACCOUNT,PAYEE_ACCOUNT,DIRECT
    MERCHANT,"UPPER(TRIM(MERCHANT))",EXPR
    AMOUNT,AMOUNT,DIRECT
    CURRENCY,CURRENCY,DIRECT
    MERCHANT_LAT,MERCHANT_LAT,DIRECT
    MERCHANT_LON,MERCHANT_LON,DIRECT
    PAID_DATE,PAID_DATE,DIRECT
    PAID_AT,PAID_AT,DIRECT
