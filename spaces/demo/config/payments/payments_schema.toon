partitionKey: PAID_DATE
raw:
  name: PAYMENTS
  format: CSV
  fields[10]{name,selector,type}:
    PAYMENT_ID,"0",VARCHAR
    PAYER_ACCOUNT,"1",VARCHAR
    PAYEE_ACCOUNT,"2",VARCHAR
    MERCHANT,"3",VARCHAR
    AMOUNT,"4",DOUBLE
    CURRENCY,"5",VARCHAR
    MERCHANT_LAT,"6",DOUBLE
    MERCHANT_LON,"7",DOUBLE
    PAID_DATE,"8",DATE
    PAID_AT,"9",TIMESTAMP
mapping:
  canonicalName: payments
  rawName: PAYMENTS
  fields[10]:
    - name: PAYMENT_ID
      from: PAYMENT_ID
      fn: keep
    - name: PAYER_ACCOUNT
      from: PAYER_ACCOUNT
      fn: keep
    - name: PAYEE_ACCOUNT
      from: PAYEE_ACCOUNT
      fn: keep
    - name: MERCHANT
      from: ""
      fn: custom
      args:
        expression: "UPPER(TRIM(MERCHANT))"
    - name: AMOUNT
      from: AMOUNT
      fn: keep
    - name: CURRENCY
      from: CURRENCY
      fn: keep
    - name: MERCHANT_LAT
      from: MERCHANT_LAT
      fn: keep
    - name: MERCHANT_LON
      from: MERCHANT_LON
      fn: keep
    - name: PAID_DATE
      from: PAID_DATE
      fn: keep
    - name: PAID_AT
      from: PAID_AT
      fn: keep
