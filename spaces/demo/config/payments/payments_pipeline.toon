name: payments
active: true
version: 1

dirs:
  poll:       spaces/demo/data/inbox/payments
  database:   spaces/demo/data/payments/database
  backup:     spaces/demo/data/payments/backup
  temp:       spaces/demo/data/payments/temp
  errors:     spaces/demo/data/payments/errors
  quarantine: spaces/demo/data/payments/quarantine
  markers:    spaces/demo/data/payments/markers
  status_dir: spaces/demo/data/payments/status
  log_dir:    spaces/demo/data/payments/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.psv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: spaces/demo/config/payments/payments_schema.toon
  csv_settings:
    delimiter: "|"
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
  gap_detection:
    enabled: true
    sequence: "PAYMENTS_{yyyyMMdd}"
