name: orders_by_region_feed
active: true

trigger:
  type: event
  on: dataset
  from: datasets/orders_by_region

collector:
  connector: dataset
  dataset: datasets/orders_by_region
  discovery: poll

dirs:
  poll:       data/inbox/orders_by_region_feed
  database:   data/orders_by_region_feed/database
  backup:     data/orders_by_region_feed/backup
  temp:       data/orders_by_region_feed/temp
  errors:     data/orders_by_region_feed/errors
  quarantine: data/orders_by_region_feed/quarantine
  status_dir: data/orders_by_region_feed/status
  log_dir:    data/orders_by_region_feed/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.parquet"
  schema_file: orders_by_region_feed_schema.toon

parsing:
  frontend: parquet
