name: orders_enriched_rollup
active: false

dirs:
  poll:       data/inbox/orders
  database:   data/orders/rollup_draft
  errors:     data/orders/errors
  quarantine: data/orders/quarantine

output:
  format: PARQUET

processing:
  file_pattern: "glob:**/*.csv"
  schema_file: orders_schema.toon
  dedup:
    keys[1]: ORDER_ID
    order_by: ORDER_DATE DESC
  join:
    reference: data/ref/region_dim.csv
    on[1]: REGION
  summarize:
    group_by[1]: REGION
    measures[2]: count, "sum(GROSS)"
