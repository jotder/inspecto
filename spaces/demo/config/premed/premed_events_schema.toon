partitionKey: EVENT_DATE
raw:
  name: EVENTS
  format: CSV
  fields[8]{name,selector,type}:
    EVENT_ID,"0",VARCHAR
    EVENT_DATE,"1",DATE
    EVENT_TS,"2",TIMESTAMP
    EVENT_TYPE,"3",VARCHAR
    IMSI,"4",VARCHAR
    MSISDN,"5",VARCHAR
    DURATION_SEC,"6",INTEGER
    BYTES,"7",BIGINT
mapping:
  canonicalName: premed_events
  rawName: EVENTS
  fields[9]:
    - name: EVENT_ID
      from: EVENT_ID
      fn: keep
    - name: EVENT_DATE
      from: EVENT_DATE
      fn: keep
    - name: EVENT_TS
      from: EVENT_TS
      fn: keep
    - name: EVENT_TYPE
      from: ""
      fn: custom
      args:
        expression: "UPPER(TRIM(EVENT_TYPE))"
    - name: IMSI
      from: IMSI
      fn: keep
    - name: MSISDN
      from: MSISDN
      fn: keep
    - name: DURATION_SEC
      from: DURATION_SEC
      fn: keep
    - name: BYTES
      from: BYTES
      fn: keep
    - name: BILLABLE_UNITS
      from: ""
      fn: custom
      args:
        expression: "CASE WHEN UPPER(TRIM(EVENT_TYPE)) = 'DATA' THEN CEIL(TRY_CAST(BYTES AS DOUBLE) / 1024.0) ELSE TRY_CAST(DURATION_SEC AS DOUBLE) END"
