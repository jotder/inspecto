name: account_links
active: true
description: "Link Analysis demo identity mapping — pairs of accounts one party holds, for identity import. Synthetic; regenerate with data/samples/gen-link-analysis-demos.py."

dirs:
  poll:       data/inbox/account_links
  database:   data/account_links/database
  backup:     data/account_links/backup
  temp:       data/account_links/temp
  errors:     data/account_links/errors
  quarantine: data/account_links/quarantine
  markers:    data/account_links/markers
  status_dir: data/account_links/status
  log_dir:    data/account_links/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: account_links_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
  gap_detection:
    enabled: true
    sequence: "ACCOUNT_LINKS_{yyyyMMdd}"
