# Multi-location ingest, the composition pattern (multiplicity plan Part B):
# N independent collector pipelines land one store each (here orders_east /
# orders_west); this flow job unions the stores. on_pipeline names every
# upstream and the all-gate fires one run only after ALL of them have
# committed since the last firing (default gate is any: each commit fires).
#
# Template: disabled because this demo space ships no east/west collector
# pipelines — point on_pipeline at your real upstreams and enable.
job:
  name: regional_orders_merge
  type: pipeline
  flow: regional_orders_merge_flow
  on_pipeline: orders_east_etl, orders_west_etl
  on_pipeline_gate: all
  enabled: false
