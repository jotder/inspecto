name: roaming_rejected_settlements
title: "Rejected roaming settlements"
description: "Revenue leakage: the same partner operators, showing only settlements that were rejected. Kestrel Telecom’s roaming files are rejected about 40% of the time. The filter is saved with the view: Apply locally costs nothing, and Push to server narrows the Dataset itself once the server accepts the filter. Then open Roaming subscriber footprint for a subscriber seen on four networks in three days."
sourceId: entity-projection
layout: force
profile: telecom
query:
  projection:
    datasetId: roaming_tap_dataset
    sourceCol: SENDER_NAME
    targetCol: RECIPIENT_NAME
    linkKindCol: EVENT_TYPE
    attrCols[1]: SETTLEMENT_STATUS
  filter:
    kind: group
    op: AND
    items[1]{kind,field,operator,value}:
      condition,SETTLEMENT_STATUS,"=",REJECTED
view:
  legend: true
  workingSet: true
  plugins:
    minimap: true
    hulls: true
    behaviors[1]: hover-activate
