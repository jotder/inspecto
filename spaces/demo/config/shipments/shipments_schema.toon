partitionKey: SHIPPED_DATE
raw:
  name: SHIPMENTS
  format: CSV
  fields[10]{name,selector,type}:
    SHIPMENT_ID,"shipment_id",VARCHAR
    ORDER_ID,"order_id",VARCHAR
    CARRIER,"carrier",VARCHAR
    STATUS,"status",VARCHAR
    HUB,"hub",VARCHAR
    HUB_LAT,"hub_lat",DOUBLE
    HUB_LON,"hub_lon",DOUBLE
    WEIGHT_KG,"weight_kg",DOUBLE
    SHIPPED_AT,"shipped_at",TIMESTAMP
    SHIPPED_DATE,"shipped_date",DATE
mapping:
  canonicalName: shipments
  rawName: SHIPMENTS
  fields[10]{name,from,fn}:
    SHIPMENT_ID,SHIPMENT_ID,keep
    ORDER_ID,ORDER_ID,keep
    CARRIER,CARRIER,keep
    STATUS,STATUS,keep
    HUB,HUB,keep
    HUB_LAT,HUB_LAT,keep
    HUB_LON,HUB_LON,keep
    WEIGHT_KG,WEIGHT_KG,keep
    SHIPPED_AT,SHIPPED_AT,keep
    SHIPPED_DATE,SHIPPED_DATE,keep
