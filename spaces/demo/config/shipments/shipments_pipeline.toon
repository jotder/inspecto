name: shipments
active: true

dirs:
  poll:       data/inbox/shipments
  database:   data/shipments/database
  backup:     data/shipments/backup
  temp:       data/shipments/temp
  errors:     data/shipments/errors
  quarantine: data/shipments/quarantine
  markers:    data/shipments/markers
  status_dir: data/shipments/status
  log_dir:    data/shipments/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.json"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: shipments_schema.toon
  csv_settings:
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

parsing:
  frontend: json
  json:
    format: newline

collector:
  discovery: poll
  connector: local
  gap_detection:
    enabled: true
    sequence: "SHIPMENTS_{yyyyMMdd}"
