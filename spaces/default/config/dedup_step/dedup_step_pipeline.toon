name: dedup_step
active: true
version: 1

dirs:
  poll:       spaces/default/data/inbox/dedup_step
  database:   spaces/default/data/dedup_step/database
  backup:     spaces/default/data/dedup_step/backup
  temp:       spaces/default/data/dedup_step/temp
  errors:     spaces/default/data/dedup_step/errors
  quarantine: spaces/default/data/dedup_step/quarantine
  markers:    spaces/default/data/dedup_step/markers
  status_dir: spaces/default/data/dedup_step/status
  log_dir:    spaces/default/data/dedup_step/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: spaces/default/config/dedup_step/dedup_step_schema.toon
  csv_settings:
    delimiter: ","
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

output_store: dedup_step_rollup

steps[1]:
  - dedup:
      keys[1]: ORDER_ID
      order_by: "ORDER_DATE DESC"

collector:
  discovery: poll
  connector: local
