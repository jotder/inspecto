name: dedup_step
active: true

dirs:
  poll:       data/inbox/dedup_step
  database:   data/dedup_step/database
  backup:     data/dedup_step/backup
  temp:       data/dedup_step/temp
  errors:     data/dedup_step/errors
  quarantine: data/dedup_step/quarantine
  markers:    data/dedup_step/markers
  status_dir: data/dedup_step/status
  log_dir:    data/dedup_step/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: dedup_step_schema.toon
  csv_settings:
    delimiter: ","
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

output_store: dedup_step_rollup

steps[1]:
  - dedup:
      keys[1]: ORDER_ID
      order_by: "ORDER_DATE DESC"

collector:
  discovery: poll
  connector: local
