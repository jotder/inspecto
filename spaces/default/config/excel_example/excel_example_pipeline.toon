name: excel_example
active: true

dirs:
  poll:       data/inbox/excel_example
  database:   data/excel_example/database
  backup:     data/excel_example/backup
  temp:       data/excel_example/temp
  errors:     data/excel_example/errors
  quarantine: data/excel_example/quarantine
  markers:    data/excel_example/markers
  status_dir: data/excel_example/status
  log_dir:    data/excel_example/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.xlsx"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 90
  schema_file: excel_example_schema.toon

parsing:
  frontend: xlsx
  xlsx:
    sheet: Inventory
    range: "A1:D6"
    header: true
    normalize_names: true
    ignore_errors: true
    stop_at_empty: false

collector:
  discovery: poll
  connector: local
