partitionKey: EVENT_DATE
raw:
  name: GWLOG
  format: CSV
  fields[9]{name,selector,type}:
    EVENT_DATE,"event_date",DATE
    EVENT_TIME,"event_time",VARCHAR
    LEVEL,"level",VARCHAR
    GATEWAY,"gateway",VARCHAR
    SESSION_ID,"session_id",VARCHAR
    MSISDN,"msisdn",VARCHAR
    ACTION,"action",VARCHAR
    RESULT,"result",VARCHAR
    LATENCY_MS,"latency_ms",VARCHAR
mapping:
  canonicalName: gwlog
  rawName: GWLOG
  rules[9]{targetColumn,sourceExpression,transformType}:
    EVENT_DATE,EVENT_DATE,DIRECT
    EVENT_TS,EVENT_DATE|EVENT_TIME,CONCAT_DT
    LEVEL,LEVEL,DIRECT
    GATEWAY,GATEWAY,DIRECT
    SESSION_ID,SESSION_ID,DIRECT
    MSISDN,MSISDN,DIRECT
    ACTION,ACTION,DIRECT
    RESULT,RESULT,DIRECT
    LATENCY_MS,"TRY_CAST(LATENCY_MS AS INTEGER)",EXPR
