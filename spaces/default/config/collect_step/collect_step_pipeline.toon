name: collect_step
active: true

dirs:
  poll:       data/inbox/collect_step
  database:   data/collect_step/database
  backup:     data/collect_step/backup
  temp:       data/collect_step/temp
  errors:     data/collect_step/errors
  quarantine: data/collect_step/quarantine
  markers:    data/collect_step/markers
  status_dir: data/collect_step/status
  log_dir:    data/collect_step/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: collect_step_schema.toon
  csv_settings:
    delimiter: ","
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  connector: local
  discovery: poll
  include[1]: "glob:**/ORDERS_*.csv"
  exclude[1]: "glob:**/*_draft.csv"
  recursive_depth: 2
  gap_detection:
    enabled: true
    sequence: "ORDERS_{yyyyMMdd}"
