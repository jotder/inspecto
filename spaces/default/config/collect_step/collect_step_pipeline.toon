name: collect_step
active: true
version: 1

dirs:
  poll:       spaces/default/data/inbox/collect_step
  database:   spaces/default/data/collect_step/database
  backup:     spaces/default/data/collect_step/backup
  temp:       spaces/default/data/collect_step/temp
  errors:     spaces/default/data/collect_step/errors
  quarantine: spaces/default/data/collect_step/quarantine
  markers:    spaces/default/data/collect_step/markers
  status_dir: spaces/default/data/collect_step/status
  log_dir:    spaces/default/data/collect_step/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: spaces/default/config/collect_step/collect_step_schema.toon
  csv_settings:
    delimiter: ","
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  connector: local
  discovery: poll
  include[1]: "glob:**/ORDERS_*.csv"
  exclude[1]: "glob:**/*_draft.csv"
  recursive_depth: 2
  gap_detection:
    enabled: true
    sequence: "ORDERS_{yyyyMMdd}"
