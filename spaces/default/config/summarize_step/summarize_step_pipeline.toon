name: summarize_step
active: true

dirs:
  poll:       data/inbox/summarize_step
  database:   data/summarize_step/database
  backup:     data/summarize_step/backup
  temp:       data/summarize_step/temp
  errors:     data/summarize_step/errors
  quarantine: data/summarize_step/quarantine
  markers:    data/summarize_step/markers
  status_dir: data/summarize_step/status
  log_dir:    data/summarize_step/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: summarize_step_schema.toon
  csv_settings:
    delimiter: ","
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

output_store: summarize_step_rollup

steps[1]:
  - summarize:
      group_by[1]: REGION
      measures[3]: count, "sum(GROSS)", "max(UNIT_PRICE)"

collector:
  discovery: poll
  connector: local
