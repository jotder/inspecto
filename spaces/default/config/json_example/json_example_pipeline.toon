name: json_example
active: true

dirs:
  poll:       data/inbox/json_example
  database:   data/json_example/database
  backup:     data/json_example/backup
  temp:       data/json_example/temp
  errors:     data/json_example/errors
  quarantine: data/json_example/quarantine
  markers:    data/json_example/markers
  status_dir: data/json_example/status
  log_dir:    data/json_example/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.json"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 90
  schema_file: json_example_schema.toon
  csv_settings:
    timestamp_formats[1]: "%Y-%m-%dT%H:%M:%S"

parsing:
  frontend: json
  json:
    format: auto
    records_path: "payload.shipments"
    maximum_object_size: 4194304

collector:
  discovery: poll
  connector: local
