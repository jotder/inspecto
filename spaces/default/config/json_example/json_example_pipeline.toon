name: json_example
active: true
version: 1

dirs:
  poll:       spaces/default/data/inbox/json_example
  database:   spaces/default/data/json_example/database
  backup:     spaces/default/data/json_example/backup
  temp:       spaces/default/data/json_example/temp
  errors:     spaces/default/data/json_example/errors
  quarantine: spaces/default/data/json_example/quarantine
  markers:    spaces/default/data/json_example/markers
  status_dir: spaces/default/data/json_example/status
  log_dir:    spaces/default/data/json_example/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.json"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 90
  schema_file: spaces/default/config/json_example/json_example_schema.toon
  csv_settings:
    timestamp_formats[1]: "%Y-%m-%dT%H:%M:%S"

parsing:
  frontend: json
  json:
    format: auto
    records_path: "payload.shipments"
    maximum_object_size: 4194304

collector:
  discovery: poll
  connector: local
