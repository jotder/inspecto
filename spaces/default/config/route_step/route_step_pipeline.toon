name: route_step
active: true

dirs:
  poll:       data/inbox/route_step
  database:   data/route_step/domestic
  backup:     data/route_step/backup
  temp:       data/route_step/temp
  errors:     data/route_step/errors
  quarantine: data/route_step/quarantine
  markers:    data/route_step/markers
  status_dir: data/route_step/status
  log_dir:    data/route_step/logs

output:
  format: CSV

sinks[2]{database,format}:
  data/route_step/domestic,CSV
  data/route_step/other,CSV

route:
  mode: case
  default: other
  branches[2]{key,where,database}:
    domestic,"REGION IN ('NORTH', 'SOUTH')",data/route_step/domestic
    other,"REGION IN ('EAST', 'WEST')",data/route_step/other

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: route_step_schema.toon
  csv_settings:
    delimiter: ","
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
