partitionKey: ORDER_DATE
raw:
  name: ORDERS
  format: CSV
  fields[7]{name,selector,type}:
    ORDER_ID,"0",VARCHAR
    ORDER_DATE,"1",DATE
    REGION,"2",VARCHAR
    PRODUCT,"3",VARCHAR
    QUANTITY,"4",INTEGER
    UNIT_PRICE,"5",DOUBLE
    STATUS,"6",VARCHAR
mapping:
  canonicalName: sql_step
  rawName: ORDERS
  fields[8]:
    - name: ORDER_ID
      from: ORDER_ID
      fn: keep
    - name: ORDER_DATE
      from: ORDER_DATE
      fn: keep
    - name: REGION
      from: ""
      fn: custom
      args:
        expression: "UPPER(TRIM(REGION))"
    - name: PRODUCT
      from: PRODUCT
      fn: keep
    - name: QUANTITY
      from: QUANTITY
      fn: keep
    - name: UNIT_PRICE
      from: UNIT_PRICE
      fn: keep
    - name: STATUS
      from: STATUS
      fn: keep
    - name: GROSS
      from: ""
      fn: custom
      args:
        expression: "ROUND(TRY_CAST(QUANTITY AS DOUBLE) * TRY_CAST(UNIT_PRICE AS DOUBLE), 2)"
