name: xml_example
active: true

dirs:
  poll:       data/inbox/xml_example
  database:   data/xml_example/database
  backup:     data/xml_example/backup
  temp:       data/xml_example/temp
  errors:     data/xml_example/errors
  quarantine: data/xml_example/quarantine
  markers:    data/xml_example/markers
  status_dir: data/xml_example/status
  log_dir:    data/xml_example/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.xml"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  csv_settings:
    date_formats[1]: "%Y-%m-%d"

parsing:
  frontend: plugin
  plugin:
    ingester: com.gamma.ingester.XmlRecordIngester
    segments:
      order: xml_example_schema.toon
    ingester_config:
      record_element: order
      namespace_aware: false

collector:
  discovery: poll
  connector: local
