name: csv_example
active: true

dirs:
  poll:       data/inbox/csv_example
  database:   data/csv_example/database
  backup:     data/csv_example/backup
  temp:       data/csv_example/temp
  errors:     data/csv_example/errors
  quarantine: data/csv_example/quarantine
  markers:    data/csv_example/markers
  status_dir: data/csv_example/status
  log_dir:    data/csv_example/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 90
  schema_file: csv_example_schema.toon

parsing:
  frontend: delimited
  encoding: utf-8
  compression: none
  delimited:
    delimiter: "|"
    quote: "\""
    comment: "#"
    has_header: true
    skip_header_lines: 1
    null_strings[2]: "NULL", "N/A"
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"
    strict_mode: true

collector:
  discovery: poll
  connector: local
