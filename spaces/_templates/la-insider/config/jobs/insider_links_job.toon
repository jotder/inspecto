job:
  name: insider_links
  type: sql.template
  description: "Folds the HR, access, mail, expense and vendor feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via), one row per pair. reports_to: an employee to their manager (via = department, role, role_since and the manager's department and role). granted_by: an employee to the person who approved their access grants (amount = grants; via = the systems, grants with no ticket, finance grants (AP, PAYROLL, TREASURY), finance grants made more than 30 days after the hire date, finance grants with no ticket, the last finance grant and its ticket, the employee's role and role_since). accessed: an employee to a system they hold a grant on (SYS- and the system name; amount = records read in the period; via = read days, the daily median, the largest 21-day average of daily reads over windows of 5 read days or more and its ratio to the median, the window's last day, the last grant and its ticket, and the employee's notice and leaving dates). mailed_domain: an employee to an external mail domain (amount = attachment megabytes; via = domain type - personal for the webmail domains inboxly.example, mailnest.example and postmail.example, business otherwise - mail days, messages, attachment megabytes and those sent on or after the notice date). approved_for: an approver to the employee whose expenses they approved (amount = total; via = approvals, those from 450 up to the 500 single-approver limit, those over it, those submitted at a weekend, the largest, how many of the approver's own expenses the requester approved back, and both roles). changed_vendor: an employee to a vendor whose master record they changed (amount = changes; via = fields, bank-detail changes, the changer's department and role, and how many people changed that vendor). Ids say what an endpoint is: EMP- employee, SYS- system, VEN- vendor, a domain name for a mail domain. Runs after every Pipeline commit, and every 5 minutes as well: a commit that lands while a run is in flight is skipped, not queued (JOB-SIGNAL-OVERLAP-SKIP-1), so the cron catches up the last landing."
  sql: "WITH e AS (SELECT employee_id, dept, role, nullif(trim(manager_id), '') AS mgr, CAST(hired_at AS DATE) AS hired, CAST(role_since AS DATE) AS since, CAST(notice_given_at AS DATE) AS notice, CAST(left_at AS DATE) AS left_on FROM employee), g AS (SELECT employee_id, system, 'SYS-' || system AS sys, nullif(trim(granted_by), '') AS granter, CAST(granted_at AS TIMESTAMP) AS gat, nullif(trim(ticket_id), '') AS tk, system IN ('AP', 'PAYROLL', 'TREASURY') AS fin FROM access_grant), rt AS (SELECT e.employee_id AS src, e.mgr AS dst, 'reports_to' AS kind, CAST(e.hired AS TIMESTAMP) AS ts, 1.0 AS amount, 'dept:' || e.dept || '|role:' || e.role || '|role_since:' || coalesce(CAST(e.since AS VARCHAR), '') || '|manager_dept:' || m.dept || '|manager_role:' || m.role AS via FROM e JOIN e m ON m.employee_id = e.mgr), gb AS (SELECT g.employee_id AS src, g.granter AS dst, 'granted_by' AS kind, max(g.gat) AS ts, count(*) AS amount, 'dept:' || e.dept || '|role:' || e.role || '|role_since:' || coalesce(CAST(e.since AS VARCHAR), '') || '|systems:' || array_to_string(list_sort(list_distinct(list(g.system))), ';') || '|grants:' || count(*) || '|no_ticket:' || count(*) FILTER (WHERE g.tk IS NULL) || '|finance_grants:' || count(*) FILTER (WHERE g.fin) || '|finance_after_onboarding:' || count(*) FILTER (WHERE g.fin AND g.gat > e.hired + INTERVAL 30 DAY) || '|finance_no_ticket:' || count(*) FILTER (WHERE g.fin AND g.tk IS NULL) || '|last_finance_grant:' || coalesce(CAST(CAST(max(g.gat) FILTER (WHERE g.fin) AS DATE) AS VARCHAR), '') || '|last_finance_ticket:' || coalesce(arg_max(coalesce(g.tk, 'none'), g.gat) FILTER (WHERE g.fin), '') AS via FROM g JOIN e USING (employee_id) WHERE g.granter IS NOT NULL AND g.granter <> g.employee_id GROUP BY g.employee_id, g.granter, e.dept, e.role, e.since), ad AS (SELECT employee_id, 'SYS-' || system AS sys, CAST(read_date AS DATE) AS rd, CAST(records_read AS DOUBLE) AS n FROM access_daily), aw AS (SELECT *, avg(n) OVER w AS wavg, count(*) OVER w AS wn FROM ad WINDOW w AS (PARTITION BY employee_id, sys ORDER BY rd RANGE BETWEEN INTERVAL 20 DAYS PRECEDING AND CURRENT ROW)), pk AS (SELECT employee_id, sys, sum(n) AS total, count(*) AS read_days, median(n) AS med, max(wavg) FILTER (WHERE wn >= 5) AS peak, arg_max(rd, wavg) FILTER (WHERE wn >= 5) AS peak_end, max(rd) AS last_read FROM aw GROUP BY employee_id, sys), ga AS (SELECT employee_id, sys, count(*) AS grants, max(gat) AS last_grant, arg_max(coalesce(tk, 'none'), gat) AS last_ticket FROM g GROUP BY employee_id, sys), ac AS (SELECT ga.employee_id AS src, ga.sys AS dst, 'accessed' AS kind, coalesce(CAST(pk.last_read AS TIMESTAMP), ga.last_grant) AS ts, coalesce(pk.total, 0) AS amount, 'dept:' || e.dept || '|role:' || e.role || '|records:' || CAST(coalesce(pk.total, 0) AS BIGINT) || '|read_days:' || coalesce(pk.read_days, 0) || '|daily_median:' || coalesce(CAST(pk.med AS VARCHAR), '') || '|peak_21d_avg:' || coalesce(CAST(round(pk.peak, 1) AS VARCHAR), '') || '|peak_ratio:' || coalesce(CAST(round(pk.peak / pk.med, 1) AS VARCHAR), '') || '|peak_window_end:' || coalesce(CAST(pk.peak_end AS VARCHAR), '') || '|grants:' || ga.grants || '|last_grant:' || CAST(CAST(ga.last_grant AS DATE) AS VARCHAR) || '|last_ticket:' || ga.last_ticket || '|notice_given:' || coalesce(CAST(e.notice AS VARCHAR), '') || '|left:' || coalesce(CAST(e.left_on AS VARCHAR), '') AS via FROM ga JOIN e USING (employee_id) LEFT JOIN pk USING (employee_id, sys)), m AS (SELECT employee_id, domain, CAST(sent_date AS DATE) AS sd, CAST(messages AS DOUBLE) AS msgs, CAST(attachment_mb AS DOUBLE) AS mb FROM email_external), md AS (SELECT m.employee_id AS src, m.domain AS dst, 'mailed_domain' AS kind, CAST(max(m.sd) AS TIMESTAMP) AS ts, sum(m.mb) AS amount, 'domain_type:' || CASE WHEN m.domain IN ('inboxly.example', 'mailnest.example', 'postmail.example') THEN 'personal' ELSE 'business' END || '|mail_days:' || count(*) || '|messages:' || CAST(sum(m.msgs) AS BIGINT) || '|attachment_mb:' || CAST(round(sum(m.mb), 1) AS VARCHAR) || '|after_notice_mb:' || CAST(round(coalesce(sum(m.mb) FILTER (WHERE m.sd >= e.notice), 0), 1) AS VARCHAR) || '|notice_given:' || coalesce(CAST(e.notice AS VARCHAR), '') || '|dept:' || e.dept || '|role:' || e.role AS via FROM m JOIN e USING (employee_id) GROUP BY m.employee_id, m.domain, e.notice, e.dept, e.role), x AS (SELECT requester_id AS req, approver_id AS appr, CAST(amount AS DOUBLE) AS amt, CAST(submitted_at AS TIMESTAMP) AS sat FROM expense), xp AS (SELECT appr, req, count(*) AS n, sum(amt) AS total, count(*) FILTER (WHERE amt >= 450 AND amt < 500) AS near, count(*) FILTER (WHERE amt >= 500) AS over, count(*) FILTER (WHERE dayofweek(sat) IN (0, 6)) AS wknd, max(amt) AS top, max(sat) AS last FROM x GROUP BY appr, req), af AS (SELECT xp.appr AS src, xp.req AS dst, 'approved_for' AS kind, xp.last AS ts, xp.total AS amount, 'approvals:' || xp.n || '|near_limit:' || xp.near || '|over_limit:' || xp.over || '|weekend:' || xp.wknd || '|largest:' || CAST(round(xp.top, 2) AS VARCHAR) || '|approved_back:' || coalesce(b.n, 0) || '|approver_role:' || coalesce(ea.role, '') || '|requester_role:' || coalesce(er.role, '') || '|requester_manager:' || coalesce(er.mgr, '') AS via FROM xp LEFT JOIN xp b ON b.appr = xp.req AND b.req = xp.appr LEFT JOIN e ea ON ea.employee_id = xp.appr LEFT JOIN e er ON er.employee_id = xp.req), vc AS (SELECT vendor_id, field_name, changed_by, CAST(changed_at AS TIMESTAMP) AS cat FROM vendor_change), ve AS (SELECT vendor_id, count(DISTINCT changed_by) AS editors FROM vc GROUP BY vendor_id), cv AS (SELECT vc.changed_by AS src, vc.vendor_id AS dst, 'changed_vendor' AS kind, max(vc.cat) AS ts, count(*) AS amount, 'fields:' || array_to_string(list_sort(list_distinct(list(vc.field_name))), ';') || '|changes:' || count(*) || '|bank_changes:' || count(*) FILTER (WHERE vc.field_name = 'bank_account') || '|changer_dept:' || coalesce(e.dept, '') || '|changer_role:' || coalesce(e.role, '') || '|vendor_editors:' || ve.editors AS via FROM vc JOIN ve USING (vendor_id) LEFT JOIN e ON e.employee_id = vc.changed_by GROUP BY vc.changed_by, vc.vendor_id, e.dept, e.role, ve.editors), links AS (SELECT * FROM rt UNION ALL SELECT * FROM gb UNION ALL SELECT * FROM ac UNION ALL SELECT * FROM md UNION ALL SELECT * FROM af UNION ALL SELECT * FROM cv) SELECT src, dst, kind, ts, round(amount, 2) AS amount, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: employee,access_grant,access_daily,email_external,expense,vendor_change
  sink_dataset: insider_links
  on_signal: pipeline.commit
  cron: "*/5 * * * *"
  enabled: true
