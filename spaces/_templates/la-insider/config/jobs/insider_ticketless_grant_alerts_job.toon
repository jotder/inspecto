job:
  name: insider_ticketless_grant_alerts
  type: alert.evaluate
  description: "Evaluates the Alert Rules each time the insider_ticketless_grant_counts Job produces its Dataset, so insider_finance_grant_without_ticket sees the new counts without anyone pressing Evaluate. On a build without Alert Rules (Basic) the rule is not armed and this Job finds nothing to evaluate."
  on_signal: job.dataset.produced
  when: "$signal.dataset == insider_ticketless_grant_counts"
  enabled: true
