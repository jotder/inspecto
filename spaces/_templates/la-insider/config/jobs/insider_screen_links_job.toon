job:
  name: insider_screen_links
  type: sql.template
  description: "Derived from insider_links each time it is produced: the three screens an insider-risk team runs, each a small slice of the link Dataset, tagged in the column screen so a saved view reads one screen and stays under the canvas's 1 000 nodes. leaver_exfiltration: every accessed link whose largest 21-day average of daily reads is 10 or more times the person's daily median, with that person's mailed_domain links of 100 MB of attachments or more. access_creep: every granted_by link that carries a grant to a finance system (AP, PAYROLL, TREASURY) made more than 30 days after the hire date, with the bank-detail vendor changes (changed_vendor with bank_changes over 0) of those employees. mutual_approvals: every approved_for link where the requester also approved the approver's own expenses, or with 20 approvals or more."
  sql: "WITH l AS (SELECT * FROM insider_links), sp AS (SELECT * FROM l WHERE kind = 'accessed' AND TRY_CAST(regexp_extract(via, 'peak_ratio:([0-9.]+)', 1) AS DOUBLE) >= 10), spm AS (SELECT * FROM l WHERE kind = 'mailed_domain' AND src IN (SELECT src FROM sp) AND amount >= 100), leaver AS (SELECT *, 'leaver_exfiltration' AS screen FROM (SELECT * FROM sp UNION ALL SELECT * FROM spm)), fg AS (SELECT * FROM l WHERE kind = 'granted_by' AND TRY_CAST(regexp_extract(via, 'finance_after_onboarding:([0-9]+)', 1) AS INTEGER) > 0), fv AS (SELECT * FROM l WHERE kind = 'changed_vendor' AND src IN (SELECT src FROM fg) AND TRY_CAST(regexp_extract(via, 'bank_changes:([0-9]+)', 1) AS INTEGER) > 0), creep AS (SELECT *, 'access_creep' AS screen FROM (SELECT * FROM fg UNION ALL SELECT * FROM fv)), mutual AS (SELECT *, 'mutual_approvals' AS screen FROM l WHERE kind = 'approved_for' AND (TRY_CAST(regexp_extract(via, 'approved_back:([0-9]+)', 1) AS INTEGER) > 0 OR TRY_CAST(regexp_extract(via, 'approvals:([0-9]+)', 1) AS INTEGER) >= 20)), links AS (SELECT * FROM leaver UNION ALL SELECT * FROM creep UNION ALL SELECT * FROM mutual) SELECT src, dst, kind, ts, amount, event_date, via, screen FROM links ORDER BY screen, kind, src, dst"
  sources: insider_links
  sink_dataset: insider_screen_links
  on_signal: job.dataset.produced
  when: "$signal.dataset == insider_links"
  enabled: true
