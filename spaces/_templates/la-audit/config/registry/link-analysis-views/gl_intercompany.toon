name: gl_intercompany
description: "AUDIT 3 - Intercompany journal flows between legal entities. Find cycles shows the four-entity round trip LE-05 to LE-06 to LE-07 to LE-08 and back at three quarter ends; Maximum flow from LE-05 to LE-07 quantifies it (7 200 000)."
sourceId: entity-projection
layout: dagre
profile: finance
query:
  projection:
    datasetId: gl_links_dataset
    sourceCol: src
    targetCol: dst
    linkKindCol: kind
    attrCols[3]: ts,amount,via
view:
  legend: true
  workingSet: true
  plugins:
    minimap: true
    behaviors[1]: hover-activate
