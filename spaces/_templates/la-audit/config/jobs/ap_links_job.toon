job:
  name: ap_links
  type: sql.template
  description: "Folds the procure-to-pay feeds into ONE link Dataset for Link Analysis: approved (approver to vendor, one per invoice), paid_to (vendor to the bank account paid), reports_to (manager to report, parent to child so Is forest reads the org chart), and shares_account / shares_address (a vendor or employee pair holding the same bank account or address key, once per unordered pair, the shared value in via; the master-data links carry the as-of day 2026-09-30 so the data-trust strip is not stretched back to a 2012 hire date). A placeholder account (PENDING) or a blank value makes no link, and a key held by more than max_key_holders parties is common, not evidence. Snapshot rebuild; docs/okf/product/solution-pack/la-audit/admin-guide-showcase-runbook.md."
  sql: "WITH approved AS (SELECT a.approver_id AS src, i.vendor_id AS dst, 'approved' AS kind, a.approved_at AS ts, CAST(i.amount AS DOUBLE) AS amount, a.approved_date AS event_date, a.invoice_id AS via FROM ap_approval a JOIN ap_invoice i ON i.invoice_id = a.invoice_id), paid AS (SELECT vendor_id, payment_account, 'paid_to', CAST(payment_date AS TIMESTAMP), CAST(amount AS DOUBLE), payment_date, invoice_id FROM ap_invoice WHERE coalesce(payment_account, '') NOT IN ('', 'PENDING')), org AS (SELECT manager_id, employee_id, 'reports_to', TIMESTAMP '2026-09-30 00:00:00', CAST(0 AS DOUBLE), DATE '2026-09-30', 'org' FROM employee_master WHERE coalesce(manager_id, '') <> ''), holders AS (SELECT 'shares_account' AS kind, bank_account AS k, vendor_id AS m, onboarded_date AS d FROM vendor_master WHERE coalesce(bank_account, '') NOT IN ('', 'PENDING') UNION ALL SELECT 'shares_account', bank_account, employee_id, hire_date FROM employee_master WHERE coalesce(bank_account, '') NOT IN ('', 'PENDING') UNION ALL SELECT 'shares_address', address_key, vendor_id, onboarded_date FROM vendor_master WHERE coalesce(address_key, '') <> '' UNION ALL SELECT 'shares_address', address_key, employee_id, hire_date FROM employee_master WHERE coalesce(address_key, '') <> ''), usable AS (SELECT kind, k FROM holders GROUP BY kind, k HAVING count(DISTINCT m) BETWEEN 2 AND CAST($max_key_holders AS INTEGER)), shared AS (SELECT x.m, y.m, x.kind, TIMESTAMP '2026-09-30 00:00:00', CAST(0 AS DOUBLE), DATE '2026-09-30', x.k FROM holders x JOIN usable u ON u.kind = x.kind AND u.k = x.k JOIN holders y ON y.kind = x.kind AND y.k = x.k AND x.m < y.m), links AS (SELECT * FROM approved UNION ALL SELECT * FROM paid UNION ALL SELECT * FROM org UNION ALL SELECT * FROM shared) SELECT * FROM links ORDER BY 3, 1, 2, 7"
  sources: ap_invoice,ap_approval,vendor_master,employee_master
  sink_dataset: ap_links
  cron: "*/10 * * * *"
  max_key_holders: "10"
  enabled: true
