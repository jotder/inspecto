job:
  name: ap_org_links
  type: sql.template
  description: "Runs each time the ap_links Job produces its Dataset (never on a timer, so it never reads an older snapshot): the rows of ap_links that make up the org chart (manager to report), a tree."
  sql: "SELECT * FROM ap_links WHERE kind = 'reports_to' ORDER BY kind, src, dst, via"
  sources: ap_links
  sink_dataset: ap_org_links
  on_signal: job.dataset.produced
  when: "$signal.dataset == ap_links"
  enabled: true
