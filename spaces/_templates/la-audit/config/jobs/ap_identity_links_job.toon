job:
  name: ap_identity_links
  type: sql.template
  description: "Runs each time the ap_links Job produces its Dataset (never on a timer, so it never reads an older snapshot): the rows of ap_links that make up the vendor identity graph (paid_to, shares_account, shares_address)."
  sql: "SELECT * FROM ap_links WHERE kind IN ('paid_to', 'shares_account', 'shares_address') ORDER BY kind, src, dst, via"
  sources: ap_links
  sink_dataset: ap_identity_links
  on_signal: job.dataset.produced
  when: "$signal.dataset == ap_links"
  enabled: true
