job:
  name: utility_links
  type: sql.template
  description: "Folds the revenue-protection feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, kwh, event_date, via), one row per pair. supplied_by: premise to its transformer (kwh = the meter reads summed); account_at: account to its premise (amount = arrears, via = holder and dates); paid_from: account to the bank account it pays from (amount = payments summed); visited_by: premise to a field-visit contractor; order_closed_by: premise to the contractor who closed its service orders (via = order type and id); vended_by: prepaid premise to its token vending point (amount = money, kwh = credited, via = kWh per unit of money and night-time sales). A blank or placeholder bank account (UNKNOWN, a number of one repeated digit) is no evidence and makes no link. Runs after every Pipeline commit."
  sql: "WITH mr AS (SELECT premise_id, min(read_date) AS d0, sum(kwh) AS kwh FROM meter_read GROUP BY premise_id), sb AS (SELECT p.premise_id AS src, p.transformer_id AS dst, 'supplied_by' AS kind, CAST(coalesce(m.d0, DATE '2025-10-01') AS TIMESTAMP) AS ts, 0.0 AS amount, round(coalesce(m.kwh, 0), 1) AS kwh, 'transformer:' || p.transformer_id AS via FROM premise p LEFT JOIN mr m ON m.premise_id = p.premise_id WHERE p.transformer_id IS NOT NULL AND p.transformer_id <> ''), aa AS (SELECT account_id AS src, premise_id AS dst, 'account_at' AS kind, CAST(opened_at AS TIMESTAMP) AS ts, coalesce(arrears, 0.0) AS amount, CAST(NULL AS DOUBLE) AS kwh, 'holder:' || coalesce(holder_name, '') || '|opened:' || CAST(opened_at AS VARCHAR) || coalesce('|closed:' || CAST(closed_at AS VARCHAR), '') AS via FROM customer_account WHERE premise_id IS NOT NULL AND premise_id <> ''), banks AS (SELECT DISTINCT account_id, trim(bank_account) AS bank FROM customer_account UNION SELECT DISTINCT account_id, trim(bank_account) FROM payment), pf AS (SELECT b.account_id AS src, b.bank AS dst, 'paid_from' AS kind, coalesce(min(p.paid_at), CAST(min(a.opened_at) AS TIMESTAMP)) AS ts, coalesce(sum(p.amount), 0.0) AS amount, CAST(NULL AS DOUBLE) AS kwh, 'payments:' || count(p.payment_id) AS via FROM banks b LEFT JOIN payment p ON p.account_id = b.account_id AND trim(p.bank_account) = b.bank LEFT JOIN customer_account a ON a.account_id = b.account_id WHERE length(regexp_replace(coalesce(bank, ''), '[^0-9]', '', 'g')) >= 6 AND replace(regexp_replace(bank, '[^0-9]', '', 'g'), substr(regexp_replace(bank, '[^0-9]', '', 'g'), 1, 1), '') <> '' AND upper(trim(bank)) NOT IN ('UNKNOWN', 'N/A', 'NA', 'NONE', 'TBC') GROUP BY b.account_id, b.bank), vb AS (SELECT premise_id AS src, contractor_id AS dst, 'visited_by' AS kind, min(visit_at) AS ts, 0.0 AS amount, CAST(NULL AS DOUBLE) AS kwh, string_agg(DISTINCT 'visit:' || visit_id || ':' || coalesce(visit_type, ''), '|' ORDER BY 'visit:' || visit_id || ':' || coalesce(visit_type, '')) AS via FROM field_visit WHERE contractor_id IS NOT NULL AND contractor_id <> '' GROUP BY premise_id, contractor_id), oc AS (SELECT premise_id AS src, closed_by AS dst, 'order_closed_by' AS kind, min(closed_at) AS ts, 0.0 AS amount, CAST(NULL AS DOUBLE) AS kwh, string_agg(DISTINCT order_type || ':' || order_id, '|' ORDER BY order_type || ':' || order_id) AS via FROM service_order WHERE closed_by IS NOT NULL AND closed_by <> '' GROUP BY premise_id, closed_by), vd AS (SELECT premise_id AS src, vendor_id AS dst, 'vended_by' AS kind, min(vend_at) AS ts, sum(amount) AS amount, round(sum(kwh), 1) AS kwh, 'vends:' || count(*) || '|kwh_per_money:' || CAST(round(sum(kwh) / nullif(sum(amount), 0), 2) AS VARCHAR) || '|night:' || count(*) FILTER (WHERE hour(vend_at) >= 22 OR hour(vend_at) < 5) AS via FROM prepaid_vend WHERE vendor_id IS NOT NULL AND vendor_id <> '' GROUP BY premise_id, vendor_id), links AS (SELECT * FROM sb UNION ALL SELECT * FROM aa UNION ALL SELECT * FROM pf UNION ALL SELECT * FROM vb UNION ALL SELECT * FROM oc UNION ALL SELECT * FROM vd) SELECT src, dst, kind, ts, round(amount, 2) AS amount, kwh, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: premise,customer_account,meter_read,payment,field_visit,service_order,prepaid_vend
  sink_dataset: utility_links
  on_signal: pipeline.commit
  enabled: true
