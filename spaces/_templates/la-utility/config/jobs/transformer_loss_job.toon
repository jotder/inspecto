job:
  name: transformer_loss
  type: sql.template
  description: "Energy balance per metered transformer per month: kWh supplied (transformer_read) against kWh registered by the meters of the premises it supplies (meter_read), loss_pct = the share not registered, and loss_band (over loss_alarm_pct, over loss_watch_pct, or normal). Technical loss is 4-7 %; a rising loss on a transformer points at meters registering less than is used. The location is the mean of its premises. Runs after every Pipeline commit."
  sql: "WITH sup AS (SELECT transformer_id, date_trunc('month', read_date) AS m, sum(kwh_supplied) AS s FROM transformer_read GROUP BY transformer_id, date_trunc('month', read_date)), met AS (SELECT p.transformer_id, date_trunc('month', r.read_date) AS m, sum(r.kwh) AS k FROM meter_read r JOIN premise p ON p.premise_id = r.premise_id GROUP BY p.transformer_id, date_trunc('month', r.read_date)), loc AS (SELECT transformer_id, avg(lat) AS lat, avg(lon) AS lon, min(city) AS city, count(*) AS premises FROM premise GROUP BY transformer_id), x AS (SELECT s.transformer_id, CAST(s.m AS DATE) AS month, l.city, round(l.lat, 5) AS lat, round(l.lon, 5) AS lon, l.premises, round(s.s, 1) AS kwh_supplied, round(coalesce(t.k, 0), 1) AS kwh_metered, round(100 * (s.s - coalesce(t.k, 0)) / nullif(s.s, 0), 1) AS loss_pct FROM sup s JOIN loc l ON l.transformer_id = s.transformer_id LEFT JOIN met t ON t.transformer_id = s.transformer_id AND t.m = s.m) SELECT *, CASE WHEN loss_pct >= CAST($loss_alarm_pct AS DOUBLE) THEN 'loss over threshold' WHEN loss_pct >= CAST($loss_watch_pct AS DOUBLE) THEN 'loss elevated' ELSE 'loss normal' END AS loss_band FROM x ORDER BY transformer_id, month"
  sources: transformer_read,meter_read,premise
  sink_dataset: transformer_loss
  on_signal: pipeline.commit
  loss_alarm_pct: "15"
  loss_watch_pct: "9"
  enabled: true
