name: payment
active: true
description: "Electricity revenue-protection Link Analysis showcase - One row per bill payment by a credit (smart-meter) account: the instant, the amount and the bank account it came from (blank for cash). One landed extract; the next month is in data/staged. Synthetic; regenerate with tools/gen-la-utility-data.py."

dirs:
  poll:       data/inbox/payment
  database:   data/payment/database
  backup:     data/payment/backup
  temp:       data/payment/temp
  errors:     data/payment/errors
  quarantine: data/payment/quarantine
  markers:    data/payment/markers
  status_dir: data/payment/status
  log_dir:    data/payment/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: payment_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
