job:
  name: fraud_identity
  type: sql.template
  description: "Subscription / identity - lines activated on one identity document (exempt_doc_prefixes are corporate accounts)"
  sql: "SELECT id_doc, CAST($window_start AS DATE) AS window_date, count(DISTINCT msisdn) AS lines_on_document FROM subscriber_events WHERE event_type = 'ACTIVATION' AND event_ts >= CAST($window_start AS TIMESTAMP) AND event_ts < CAST($window_end AS TIMESTAMP) AND NOT (len(list_filter(string_split($exempt_doc_prefixes, ','), lambda e: trim(e) <> '' AND starts_with(id_doc, trim(e)))) > 0) GROUP BY id_doc"
  sources: subscriber_events
  sink_dataset: fraud_identity
  cron: "0 2 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  day: "$yesterday"
  incremental:
    by: day
    column: window_date
    lookback: 1
    retain: 31
  exempt_doc_prefixes: "CORP-"
  enabled: true
