job:
  name: fraud_identity
  type: sql.template
  description: "Subscription / identity - lines activated on one identity document"
  sql: "SELECT id_doc, CAST($window_start AS DATE) AS window_date, count(DISTINCT msisdn) AS lines_on_document FROM subscriber_events WHERE event_type = 'ACTIVATION' AND event_ts >= CAST($window_start AS TIMESTAMP) AND event_ts < CAST($window_end AS TIMESTAMP) GROUP BY id_doc"
  sources: subscriber_events
  sink_dataset: fraud_identity
  window_start: "2026-07-01 00:00:00"
  window_end: "2026-07-02 00:00:00"
  enabled: true
