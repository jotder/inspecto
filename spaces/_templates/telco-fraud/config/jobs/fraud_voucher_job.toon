job:
  name: fraud_voucher
  type: sql.template
  description: "Voucher / EVD - redemptions per voucher serial (a serial redeems once)"
  sql: "SELECT voucher_serial, CAST($window_start AS DATE) AS window_date, count(*) AS redemptions, count(DISTINCT msisdn) AS redeemers FROM payments WHERE txn_type = 'VOUCHER' AND txn_ts >= CAST($window_start AS TIMESTAMP) AND txn_ts < CAST($window_end AS TIMESTAMP) GROUP BY voucher_serial"
  sources: payments
  sink_dataset: fraud_voucher
  cron: "0 2 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  day: "$yesterday"
  incremental:
    by: day
    column: window_date
    lookback: 1
    retain: 30
  enabled: true
