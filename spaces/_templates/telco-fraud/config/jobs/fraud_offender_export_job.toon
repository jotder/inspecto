job:
  name: fraud_offender_export
  type: report
  description: "Nightly CSV export of the IRSF offender Dataset, written after the 02:30 Alert Rule evaluation"
  scope: dataset
  dataset: fraud_irsf
  measures: "sum(irsf_seconds),sum(irsf_calls)"
  group_by: msisdn
  format: csv
  out_dir: exports/fraud_offender_export
  cron: "0 3 * * *"
  enabled: true
