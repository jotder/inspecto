job:
  name: fraud_premium_rate
  type: sql.template
  description: "Premium-rate - charge to premium-rate ranges, per caller"
  sql: "WITH cur AS (WITH n AS (SELECT a_number, charge, CASE WHEN b_number LIKE '+%' THEN substr(b_number, 2) WHEN b_number LIKE '00%' THEN substr(b_number, 3) WHEN b_number LIKE '0%' THEN $home_cc || substr(b_number, 2) ELSE b_number END AS nb FROM cdr WHERE direction = 'MO' AND start_ts >= CAST($window_start AS TIMESTAMP) AND start_ts < CAST($window_end AS TIMESTAMP)) SELECT a_number AS msisdn, CAST($window_start AS DATE) AS window_date, count(*) AS premium_calls, sum(charge) AS premium_charge FROM n WHERE coalesce(CASE WHEN len(list_filter(string_split($premium_prefixes, ','), e -> NOT regexp_full_match(trim(e), '[0-9]{1,15}'))) > 0 THEN error('premium_prefixes must be a comma-separated list of digit prefixes') END, 0) = 0 AND len(list_filter(string_split($premium_prefixes, ','), e -> starts_with(nb, trim(e)))) > 0 GROUP BY a_number) SELECT * FROM cur UNION ALL BY NAME SELECT * FROM fraud_premium_rate WHERE window_date <> CAST($window_start AS DATE) AND window_date >= CAST($window_start AS DATE) - to_days(CAST($retention_days AS INTEGER))"
  sources: cdr,fraud_premium_rate
  sink_dataset: fraud_premium_rate
  window_start: "2026-07-01 00:00:00"
  window_end: "2026-07-02 00:00:00"
  retention_days: "30"
  premium_prefixes: "999900,999909"
  home_cc: "999"
  enabled: true
