job:
  name: fraud_premium_rate
  type: sql.template
  description: "Premium-rate - charge to premium-rate ranges, per caller"
  sql: "SELECT a_number AS msisdn, CAST($window_start AS DATE) AS window_date, count(*) AS premium_calls, sum(charge) AS premium_charge FROM cdr WHERE direction = 'MO' AND start_ts >= CAST($window_start AS TIMESTAMP) AND start_ts < CAST($window_end AS TIMESTAMP) AND list_contains(string_split($premium_prefixes, ','), substr(b_number, 1, 3)) GROUP BY a_number"
  sources: cdr
  sink_dataset: fraud_premium_rate
  window_start: "2026-07-01 00:00:00"
  window_end: "2026-07-02 00:00:00"
  premium_prefixes: "900,909"
  enabled: true
