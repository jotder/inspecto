job:
  name: fraud_simbox
  type: sql.template
  description: "SIM-box - distinct voice targets of a line that never receives a call, never sends SMS and never moves"
  sql: "WITH cur AS (WITH w AS (SELECT * FROM cdr WHERE start_ts >= CAST($window_start AS TIMESTAMP) AND start_ts < CAST($window_end AS TIMESTAMP)), mo AS (SELECT a_number AS msisdn, count(DISTINCT b_number) FILTER (WHERE service = 'VOICE') AS voice_targets, count(*) FILTER (WHERE service = 'SMS') AS sms_sent, count(DISTINCT cell_id) AS cells FROM w WHERE direction = 'MO' GROUP BY a_number), mt AS (SELECT b_number AS msisdn, count(*) AS calls_received FROM w WHERE direction = 'MT' GROUP BY b_number) SELECT mo.msisdn, CAST($window_start AS DATE) AS window_date, voice_targets, sms_sent, cells, coalesce(mt.calls_received, 0) AS calls_received, CASE WHEN coalesce(mt.calls_received, 0) = 0 AND sms_sent = 0 AND cells <= CAST($max_cells AS INTEGER) AND NOT list_contains(string_split($exempt_msisdns, ','), mo.msisdn) THEN voice_targets ELSE 0 END AS simbox_targets FROM mo LEFT JOIN mt ON mt.msisdn = mo.msisdn WHERE voice_targets >= CAST($min_candidate_targets AS INTEGER)) SELECT * FROM cur UNION ALL BY NAME SELECT * FROM fraud_simbox WHERE window_date <> CAST($window_start AS DATE) AND window_date >= CAST($window_start AS DATE) - to_days(CAST($retention_days AS INTEGER))"
  sources: cdr,fraud_simbox
  sink_dataset: fraud_simbox
  cron: "0 2 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  retention_days: "30"
  max_cells: "1"
  min_candidate_targets: "10"
  exempt_msisdns: "99970001119"
  enabled: true
