job:
  name: fraud_dealer
  type: sql.template
  description: "Dealer activations - activations with no originated traffic up to traffic_grace_hours after the window, per dealer"
  sql: "SELECT e.dealer_id, CAST($window_start AS DATE) AS window_date, count(*) AS activations, count(*) FILTER (WHERE u.msisdn IS NULL) AS idle_activations FROM subscriber_events e LEFT JOIN (SELECT DISTINCT a_number AS msisdn FROM cdr WHERE direction = 'MO' AND start_ts >= CAST($window_start AS TIMESTAMP) AND start_ts < CAST($window_end AS TIMESTAMP) + to_hours(CAST($traffic_grace_hours AS INTEGER))) u ON u.msisdn = e.msisdn WHERE e.event_type = 'ACTIVATION' AND e.event_ts >= CAST($window_start AS TIMESTAMP) AND e.event_ts < CAST($window_end AS TIMESTAMP) GROUP BY e.dealer_id"
  sources: subscriber_events,cdr
  sink_dataset: fraud_dealer
  cron: "0 2 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  day: "$yesterday"
  incremental:
    by: day
    column: window_date
    lookback: 1
  traffic_grace_hours: "48"
  enabled: true
