job:
  name: fraud_dealer
  type: sql.template
  description: "Dealer activations - activations with no originated traffic in the window, per dealer"
  sql: "SELECT e.dealer_id, CAST($window_start AS DATE) AS window_date, count(*) AS activations, count(*) FILTER (WHERE u.msisdn IS NULL) AS idle_activations FROM subscriber_events e LEFT JOIN (SELECT DISTINCT a_number AS msisdn FROM cdr WHERE direction = 'MO' AND start_ts >= CAST($window_start AS TIMESTAMP) AND start_ts < CAST($window_end AS TIMESTAMP)) u ON u.msisdn = e.msisdn WHERE e.event_type = 'ACTIVATION' AND e.event_ts >= CAST($window_start AS TIMESTAMP) AND e.event_ts < CAST($window_end AS TIMESTAMP) GROUP BY e.dealer_id"
  sources: subscriber_events,cdr
  sink_dataset: fraud_dealer
  window_start: "2026-07-01 00:00:00"
  window_end: "2026-07-02 00:00:00"
  enabled: true
