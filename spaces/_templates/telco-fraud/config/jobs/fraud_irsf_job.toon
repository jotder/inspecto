job:
  name: fraud_irsf
  type: sql.template
  description: "IRSF - seconds of originated voice to high-risk international ranges, per caller"
  sql: "WITH cur AS (WITH n AS (SELECT a_number, duration_s, CASE WHEN b_number LIKE '+%' THEN substr(b_number, 2) WHEN b_number LIKE '00%' THEN substr(b_number, 3) WHEN b_number LIKE '0%' THEN $home_cc || substr(b_number, 2) ELSE b_number END AS nb FROM cdr WHERE direction = 'MO' AND service = 'VOICE' AND start_ts >= CAST($window_start AS TIMESTAMP) AND start_ts < CAST($window_end AS TIMESTAMP)) SELECT a_number AS msisdn, CAST($window_start AS DATE) AS window_date, count(*) AS irsf_calls, CAST(sum(duration_s) AS BIGINT) AS irsf_seconds FROM n WHERE coalesce(CASE WHEN len(list_filter(string_split($irsf_prefixes, ','), e -> NOT regexp_full_match(trim(e), '[0-9]{1,15}'))) > 0 THEN error('irsf_prefixes must be a comma-separated list of digit prefixes') END, 0) = 0 AND len(list_filter(string_split($irsf_prefixes, ','), e -> starts_with(nb, trim(e)))) > 0 GROUP BY a_number) SELECT * FROM cur UNION ALL BY NAME SELECT * FROM fraud_irsf WHERE window_date <> CAST($window_start AS DATE) AND window_date >= CAST($window_start AS DATE) - to_days(CAST($retention_days AS INTEGER))"
  sources: cdr,fraud_irsf
  sink_dataset: fraud_irsf
  cron: "0 2 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  retention_days: "30"
  irsf_prefixes: "882,883,8818"
  home_cc: "999"
  enabled: true
