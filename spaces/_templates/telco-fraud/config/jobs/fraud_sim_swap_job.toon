job:
  name: fraud_sim_swap
  type: sql.template
  description: "SIM-swap - payments out of a line within window_hours after its latest SIM swap (each payment counted once)"
  sql: "WITH s AS (SELECT msisdn, event_ts FROM subscriber_events WHERE event_type = 'SIM_SWAP' AND event_ts >= CAST($window_start AS TIMESTAMP) AND event_ts < CAST($window_end AS TIMESTAMP)), a AS (SELECT p.txn_id, p.msisdn, p.amount, p.txn_ts, max(s.event_ts) AS swap_ts FROM payments p JOIN s ON s.msisdn = p.msisdn AND s.event_ts < p.txn_ts WHERE p.txn_type = 'PAYMENT' GROUP BY p.txn_id, p.msisdn, p.amount, p.txn_ts) SELECT msisdn, CAST($window_start AS DATE) AS window_date, count(*) AS post_swap_payment_count, sum(amount) AS post_swap_payments FROM a WHERE txn_ts <= swap_ts + to_hours(CAST($window_hours AS INTEGER)) GROUP BY msisdn"
  sources: subscriber_events,payments
  sink_dataset: fraud_sim_swap
  cron: "0 2 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  day: "$yesterday"
  incremental:
    by: day
    column: window_date
    lookback: 1
    retain: 31
  window_hours: "24"
  enabled: true
