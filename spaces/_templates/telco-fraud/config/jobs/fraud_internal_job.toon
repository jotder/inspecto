job:
  name: fraud_internal
  type: sql.template
  description: "Internal fraud - SIM swaps performed per staff user, outside the exempt back-office desks"
  sql: "WITH cur AS (SELECT dealer_id AS staff_id, CAST($window_start AS DATE) AS window_date, count(*) AS swaps, count(DISTINCT msisdn) AS lines_swapped FROM subscriber_events WHERE event_type = 'SIM_SWAP' AND coalesce(dealer_id, '') <> '' AND NOT list_contains(string_split($exempt_staff, ','), dealer_id) AND event_ts >= CAST($window_start AS TIMESTAMP) AND event_ts < CAST($window_end AS TIMESTAMP) GROUP BY dealer_id) SELECT * FROM cur UNION ALL BY NAME SELECT * FROM fraud_internal WHERE window_date <> CAST($window_start AS DATE) AND window_date >= CAST($window_start AS DATE) - to_days(CAST($retention_days AS INTEGER))"
  sources: subscriber_events,fraud_internal
  sink_dataset: fraud_internal
  cron: "0 2 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  retention_days: "30"
  exempt_staff: "HELPDESK"
  enabled: true
