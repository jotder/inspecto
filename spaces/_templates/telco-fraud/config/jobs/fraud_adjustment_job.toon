job:
  name: fraud_adjustment
  type: sql.template
  description: "Internal fraud - manual ADJUSTMENT credits summed per staff agent, outside the exempt billing-correction desks"
  sql: "SELECT agent_id, CAST($window_start AS DATE) AS window_date, count(*) AS adjustments, sum(amount) AS adjusted_amount, count(DISTINCT msisdn) AS lines_credited FROM payments WHERE txn_type = 'ADJUSTMENT' AND coalesce(agent_id, '') <> '' AND NOT list_contains(string_split($exempt_agents, ','), agent_id) AND txn_ts >= CAST($window_start AS TIMESTAMP) AND txn_ts < CAST($window_end AS TIMESTAMP) GROUP BY agent_id"
  sources: payments
  sink_dataset: fraud_adjustment
  cron: "0 2 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  day: "$yesterday"
  incremental:
    by: day
    column: window_date
    lookback: 1
  exempt_agents: "BILLING-DESK"
  enabled: true
