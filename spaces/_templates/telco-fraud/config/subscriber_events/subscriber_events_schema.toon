raw:
  name: SUBSCRIBER_EVENTS
  format: CSV
  fields[6]{name,selector,type,description,unit,classification}:
    event_id,"0",VARCHAR,"Event identifier","","INTERNAL"
    event_ts,"1",TIMESTAMP,"Event time","","INTERNAL"
    event_type,"2",VARCHAR,"ACTIVATION or SIM_SWAP","","INTERNAL"
    msisdn,"3",VARCHAR,"Subscriber number","","CONFIDENTIAL"
    dealer_id,"4",VARCHAR,"Dealer that performed the activation, or the staff user that performed the SIM swap","","INTERNAL"
    id_doc,"5",VARCHAR,"Identity document presented","","CONFIDENTIAL"
mapping:
  canonicalName: subscriber_events
  rawName: SUBSCRIBER_EVENTS
  fields[6]:
    - name: event_id
      from: event_id
      fn: keep
    - name: event_ts
      from: event_ts
      fn: keep
    - name: event_type
      from: event_type
      fn: keep
    - name: msisdn
      from: msisdn
      fn: keep
    - name: dealer_id
      from: dealer_id
      fn: keep
    - name: id_doc
      from: id_doc
      fn: keep
