raw:
  name: CDR
  format: CSV
  fields[10]{name,selector,type,description,unit,classification}:
    record_id,"0",VARCHAR,"Call detail record identifier","","INTERNAL"
    start_ts,"1",TIMESTAMP,"Call or SMS start time","","INTERNAL"
    direction,"2",VARCHAR,"MO (originated by a_number) or MT (terminated on b_number)","","INTERNAL"
    service,"3",VARCHAR,"VOICE, SMS or DATA (a data session)","","INTERNAL"
    a_number,"4",VARCHAR,"Calling number","","CONFIDENTIAL"
    b_number,"5",VARCHAR,"Called number (DATA: the APN)","","CONFIDENTIAL"
    duration_s,"6",INTEGER,"Answered duration (DATA: session seconds)","s","INTERNAL"
    charge,"7",DOUBLE,"Rated charge","USD","INTERNAL"
    roaming,"8",VARCHAR,"Y when the a_number was roaming","","INTERNAL"
    cell_id,"9",VARCHAR,"Serving cell","","CONFIDENTIAL"
mapping:
  canonicalName: cdr
  rawName: CDR
  fields[10]:
    - name: record_id
      from: record_id
      fn: keep
    - name: start_ts
      from: start_ts
      fn: keep
    - name: direction
      from: direction
      fn: keep
    - name: service
      from: service
      fn: keep
    - name: a_number
      from: a_number
      fn: keep
    - name: b_number
      from: b_number
      fn: keep
    - name: duration_s
      from: duration_s
      fn: keep
    - name: charge
      from: charge
      fn: keep
    - name: roaming
      from: roaming
      fn: keep
    - name: cell_id
      from: cell_id
      fn: keep
