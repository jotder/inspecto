raw:
  name: FRAUD_ALARMS
  format: CSV
  fields[3]{name,selector,type,description,unit,classification}:
    msisdn,"0",VARCHAR,"MSISDN","","CONFIDENTIAL"
    raised_at,"1",TIMESTAMP,"Raised at","","INTERNAL"
    alarm_type,"2",VARCHAR,"Typology","","INTERNAL"
mapping:
  canonicalName: fraud_alarms
  rawName: FRAUD_ALARMS
  fields[3]:
    - name: msisdn
      from: msisdn
      fn: keep
    - name: raised_at
      from: raised_at
      fn: keep
    - name: alarm_type
      from: alarm_type
      fn: keep
