raw:
  name: HLR_EIR
  format: CSV
  fields[5]{name,selector,type,description,unit,classification}:
    msisdn,"0",VARCHAR,"MSISDN","","CONFIDENTIAL"
    imsi,"1",VARCHAR,"IMSI","","CONFIDENTIAL"
    imei,"2",VARCHAR,"IMEI seen with this IMSI","","CONFIDENTIAL"
    forwarding_to,"3",VARCHAR,"Unconditional call-forwarding target, else empty","","CONFIDENTIAL"
    sim_swap_at,"4",TIMESTAMP,"When this IMSI replaced the previous one, else empty","","INTERNAL"
mapping:
  canonicalName: hlr_eir
  rawName: HLR_EIR
  fields[5]:
    - name: msisdn
      from: msisdn
      fn: keep
    - name: imsi
      from: imsi
      fn: keep
    - name: imei
      from: imei
      fn: keep
    - name: forwarding_to
      from: forwarding_to
      fn: keep
    - name: sim_swap_at
      from: sim_swap_at
      fn: keep
