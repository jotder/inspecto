job:
  name: telecom_links
  type: sql.template
  description: "Folds the six telecom feeds into ONE MSISDN-to-MSISDN link Dataset for Link Analysis: voice and sms aggregated per (a, b, kind); forwarding from voice_cdr.redirecting_number and hlr_eir.forwarding_to; shared_device (IMEI), shared_identity (id document, address), shared_payment (voucher, agent, card) and sim_history (customer id on real ownership transfers, old_subscriber <> new_subscriber) as pairs from a self-join on the shared key, emitted in BOTH directions, named in via. Pair cap: a key held by more than max_key_msisdns distinct MSISDNs (a big retail agent, a shop address) is common, not evidence, and makes no pairs. Snapshot rebuild; docs/superpower/la-telecom-demo-data.md."
  sql: "WITH as_of AS (SELECT max(start_time) AS t FROM voice_cdr), calls AS (SELECT a_number AS a_msisdn, b_number AS b_msisdn, 'voice' AS link_kind, min(start_time) AS first_seen, max(start_time) AS last_seen, count(*) AS events, sum(duration_s) AS total_duration_s, CAST(NULL AS VARCHAR) AS via FROM voice_cdr WHERE a_number IS NOT NULL AND b_number IS NOT NULL AND a_number <> b_number GROUP BY a_number, b_number), texts AS (SELECT orig_msisdn, term_msisdn, 'sms', min(ts), max(ts), count(*), 0, CAST(NULL AS VARCHAR) FROM sms_cdr WHERE orig_msisdn IS NOT NULL AND term_msisdn IS NOT NULL AND orig_msisdn <> term_msisdn GROUP BY orig_msisdn, term_msisdn), fwd_ev AS (SELECT redirecting_number AS a, b_number AS b, start_time AS t, duration_s AS d, 'cdr' AS src FROM voice_cdr WHERE redirecting_number IS NOT NULL AND redirecting_number <> '' AND b_number IS NOT NULL UNION ALL SELECT msisdn, forwarding_to, (SELECT t FROM as_of), 0, 'hlr' FROM hlr_eir WHERE forwarding_to IS NOT NULL AND forwarding_to <> ''), fwd AS (SELECT a, b, 'forwarding', min(t), max(t), count(*), sum(d), string_agg(DISTINCT src, '|' ORDER BY src) FROM fwd_ev WHERE a <> b GROUP BY a, b), keyed AS (SELECT 'shared_device' AS kind, 'imei:' || imei AS k, a_number AS m, start_time AS t FROM voice_cdr WHERE imei IS NOT NULL AND imei <> '' UNION ALL SELECT 'shared_device', 'imei:' || imei, msisdn, coalesce(sim_swap_at, (SELECT t FROM as_of)) FROM hlr_eir WHERE imei IS NOT NULL AND imei <> '' UNION ALL SELECT 'shared_identity', 'id_doc:' || id_doc_hash, msisdn, CAST(activation_date AS TIMESTAMP) FROM crm_kyc WHERE id_doc_hash IS NOT NULL AND id_doc_hash <> '' UNION ALL SELECT 'shared_identity', 'address:' || address_hash, msisdn, CAST(activation_date AS TIMESTAMP) FROM crm_kyc WHERE address_hash IS NOT NULL AND address_hash <> '' UNION ALL SELECT 'shared_payment', 'voucher:' || voucher_id, msisdn, ts FROM recharge WHERE voucher_id IS NOT NULL AND voucher_id <> '' UNION ALL SELECT 'shared_payment', 'agent:' || agent_id, msisdn, ts FROM recharge WHERE agent_id IS NOT NULL AND agent_id <> '' UNION ALL SELECT 'shared_payment', 'card:' || card_hash, msisdn, ts FROM recharge WHERE card_hash IS NOT NULL AND card_hash <> '' UNION ALL SELECT 'sim_history', 'subscriber:' || old_subscriber, msisdn, ts FROM provisioning WHERE event IN ('ownership_transfer', 'sim_swap', 'number_reassignment') AND old_subscriber <> '' AND new_subscriber <> '' AND old_subscriber <> new_subscriber UNION ALL SELECT 'sim_history', 'subscriber:' || new_subscriber, msisdn, ts FROM provisioning WHERE event IN ('ownership_transfer', 'sim_swap', 'number_reassignment') AND old_subscriber <> '' AND new_subscriber <> '' AND old_subscriber <> new_subscriber), holders AS (SELECT kind, k, m, min(t) AS f, max(t) AS l FROM keyed WHERE m IS NOT NULL GROUP BY kind, k, m), usable AS (SELECT kind, k FROM holders GROUP BY kind, k HAVING count(*) BETWEEN 2 AND CAST($max_key_msisdns AS INTEGER)), shared AS (SELECT x.m, y.m, x.kind, min(least(x.f, y.f)), max(greatest(x.l, y.l)), count(DISTINCT x.k), 0, string_agg(DISTINCT x.k, '|' ORDER BY x.k) FROM holders x JOIN usable u ON u.kind = x.kind AND u.k = x.k JOIN holders y ON y.kind = x.kind AND y.k = x.k AND x.m <> y.m GROUP BY x.m, y.m, x.kind), links AS (SELECT * FROM calls UNION ALL SELECT * FROM texts UNION ALL SELECT * FROM fwd UNION ALL SELECT * FROM shared) SELECT a_msisdn, b_msisdn, link_kind, first_seen, last_seen, CAST(events AS BIGINT) AS events, CAST(total_duration_s AS BIGINT) AS total_duration_s, via, round(total_duration_s / events, 1) AS avg_duration_s FROM links ORDER BY link_kind, a_msisdn, b_msisdn"
  sources: voice_cdr,sms_cdr,hlr_eir,crm_kyc,recharge,provisioning
  sink_dataset: telecom_links
  cron: "*/10 * * * *"
  max_key_msisdns: "10"
  enabled: true
