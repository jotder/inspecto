job:
  name: telecom_msisdn_indicators
  type: sql.template
  description: "One row per home-network MSISDN (crm_kyc): the indicator factors and a transparent 0-100 indicator_score = 25 x on_blocklist + 15 x min(alarms_recent, 3) / 3 + 15 x recent_activation_high_intl + 15 x shares_imei_with_flagged + (only with at least min_calls outbound calls) 10 x premium_destination_share + 10 x short_call_ratio + 10 x one_way_ratio. Plus the typology columns the pattern stages cannot compute (out_distinct_b, inbound_distinct_b, avg_dur_s, out_in_ratio, premium_share, imei_per_msisdn, msisdn_per_imei, activated_at). The as-of instant is the newest voice_cdr start_time, so the shipped corpus scores the same on any day. docs/superpower/la-telecom-demo-data.md."
  sql: "WITH as_of AS (SELECT max(start_time) AS t FROM voice_cdr), subs AS (SELECT msisdn, min(activation_date) AS activated_at FROM crm_kyc GROUP BY msisdn), outv AS (SELECT a_number AS msisdn, count(*) AS out_events, count(DISTINCT b_number) AS out_distinct_b, sum(duration_s) AS out_dur, count(*) FILTER (WHERE duration_s <= CAST($short_call_s AS INTEGER)) AS short_events, count(*) FILTER (WHERE destination_type = 'premium_intl') AS premium_events, count(*) FILTER (WHERE destination_type IN ('premium_intl', 'international')) AS intl_events FROM voice_cdr WHERE a_number IS NOT NULL AND b_number IS NOT NULL AND b_number <> '' GROUP BY a_number), inv AS (SELECT b_number AS msisdn, count(*) AS in_events, count(DISTINCT a_number) AS inbound_distinct_b FROM voice_cdr GROUP BY b_number), oneway AS (SELECT o.a_number AS msisdn, count(DISTINCT o.b_number) FILTER (WHERE r.a_number IS NULL) AS never_back FROM (SELECT DISTINCT a_number, b_number FROM voice_cdr) o LEFT JOIN (SELECT DISTINCT a_number, b_number FROM voice_cdr) r ON r.a_number = o.b_number AND r.b_number = o.a_number GROUP BY o.a_number), dev AS (SELECT DISTINCT a_number AS msisdn, imei FROM voice_cdr WHERE imei IS NOT NULL AND imei <> '' UNION SELECT msisdn, imei FROM hlr_eir WHERE imei IS NOT NULL AND imei <> ''), per_imei AS (SELECT imei, count(DISTINCT msisdn) AS n FROM dev GROUP BY imei), devs AS (SELECT d.msisdn, count(DISTINCT d.imei) AS imei_per_msisdn, max(p.n) AS msisdn_per_imei FROM dev d JOIN per_imei p USING (imei) GROUP BY d.msisdn), blocked AS (SELECT DISTINCT msisdn FROM fraud_blocklist), alarmed AS (SELECT msisdn, count(*) AS n FROM fraud_alarms WHERE raised_at >= (SELECT t FROM as_of) - to_days(CAST($alarm_days AS INTEGER)) GROUP BY msisdn), flagged AS (SELECT msisdn FROM blocked UNION SELECT msisdn FROM alarmed), imei_flag AS (SELECT DISTINCT d.msisdn FROM dev d JOIN dev f ON f.imei = d.imei AND f.msisdn <> d.msisdn JOIN flagged g ON g.msisdn = f.msisdn), f AS (SELECT s.msisdn, s.activated_at, b.msisdn IS NOT NULL AS on_blocklist, CAST(coalesce(a.n, 0) AS INTEGER) AS alarms_recent, coalesce(o.out_events, 0) AS out_events, CAST(coalesce(o.out_distinct_b, 0) AS INTEGER) AS out_distinct_b, CAST(coalesce(i.inbound_distinct_b, 0) AS INTEGER) AS inbound_distinct_b, coalesce(round(o.out_dur / NULLIF(o.out_events, 0), 1), 0) AS avg_dur_s, round(coalesce(o.out_events, 0) / (coalesce(i.in_events, 0) + 1), 2) AS out_in_ratio, coalesce(round(o.premium_events / NULLIF(o.out_events, 0), 3), 0) AS premium_destination_share, coalesce(round(o.intl_events / NULLIF(o.out_events, 0), 3), 0) AS premium_share, coalesce(round(o.short_events / NULLIF(o.out_events, 0), 3), 0) AS short_call_ratio, coalesce(round(w.never_back / NULLIF(o.out_distinct_b, 0), 3), 0) AS one_way_ratio, CAST(coalesce(d.imei_per_msisdn, 0) AS INTEGER) AS imei_per_msisdn, CAST(coalesce(d.msisdn_per_imei, 0) AS INTEGER) AS msisdn_per_imei, x.msisdn IS NOT NULL AS shares_imei_with_flagged FROM subs s LEFT JOIN outv o USING (msisdn) LEFT JOIN inv i USING (msisdn) LEFT JOIN oneway w USING (msisdn) LEFT JOIN devs d USING (msisdn) LEFT JOIN blocked b USING (msisdn) LEFT JOIN alarmed a USING (msisdn) LEFT JOIN imei_flag x USING (msisdn)), g AS (SELECT *, out_events >= CAST($min_calls AS INTEGER) AS busy, activated_at >= CAST((SELECT t FROM as_of) AS DATE) - to_days(CAST($recent_activation_days AS INTEGER)) AND out_events >= CAST($min_calls AS INTEGER) AND premium_share >= CAST($high_intl_share AS DOUBLE) AS recent_activation_high_intl FROM f) SELECT msisdn, round(greatest(0, least(100, 25 * CAST(on_blocklist AS INTEGER) + 15 * least(alarms_recent, 3) / 3 + 15 * CAST(recent_activation_high_intl AS INTEGER) + 15 * CAST(shares_imei_with_flagged AS INTEGER) + CASE WHEN busy THEN 10 * premium_destination_share + 10 * short_call_ratio + 10 * one_way_ratio ELSE 0 END)), 1) AS indicator_score, on_blocklist, alarms_recent, recent_activation_high_intl, shares_imei_with_flagged, premium_destination_share, short_call_ratio, one_way_ratio, out_distinct_b, inbound_distinct_b, avg_dur_s, out_in_ratio, premium_share, imei_per_msisdn, msisdn_per_imei, activated_at FROM g ORDER BY indicator_score DESC, msisdn"
  sources: voice_cdr,hlr_eir,crm_kyc,fraud_blocklist,fraud_alarms
  sink_dataset: telecom_msisdn_indicators
  cron: "*/10 * * * *"
  short_call_s: "5"
  alarm_days: "14"
  min_calls: "10"
  recent_activation_days: "30"
  high_intl_share: "0.3"
  enabled: true
