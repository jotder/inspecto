name: mule_ring_route_map
title: "The ring across Europe"
description: "The laundering ring on a map: cash paid in at small-town branches gathers in one hub account in Rotterdam, fans out to relay accounts in Madrid and Warsaw and leaves for George Town; the shell companies’ loop circles Valencia, Milan, Lyon and Turin. Route colour shows each account’s role. Synthetic placements."
sourceId: od-routes
display: markers
query:
  routes:
    datasetId: mule_ring_legs_dataset
    fromLatCol: FROM_LAT
    fromLonCol: FROM_LON
    toLatCol: TO_LAT
    toLonCol: TO_LON
    fromCol: FROM_ACCOUNT
    toCol: TO_ACCOUNT
    kindCol: ROLE
camera:
  center[2]: 10,47
  zoom: 4
