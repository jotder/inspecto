name: mule_account_locations_map
title: "Where the accounts are"
description: "Every account in the transfer data placed in its city (113 accounts), coloured by the kind of site: small rural branches are where the cash deposits go in, tills are where the money comes out. Synthetic placements."
sourceId: dataset
display: markers
query:
  projection:
    datasetId: mule_account_locations_dataset
    latCol: LAT
    lonCol: LON
    entityCol: ACCOUNT
    entityIdCol: ACCOUNT
    kindCol: SITE_TYPE
camera:
  center[2]: 10,47
  zoom: 4
