name: mule_large_transfers
title: "Large transfers only"
description: "The same accounts, showing only transfers of 5,000 or more. Ordinary payments are almost all under 3,000, so what remains is the hub’s wires to the relay accounts, the relays’ crypto payments offshore and the shell companies’ loop. The small cash deposits disappear, which is exactly what structuring is designed to achieve: compare with the full ring to see what an amount threshold alone would miss. Cycles finds the shell companies’ loop."
sourceId: entity-projection
layout: dagre
profile: finance
query:
  projection:
    datasetId: mule_transfers_dataset
    sourceCol: PAYER_ACCOUNT
    targetCol: PAYEE_ACCOUNT
    linkKindCol: CHANNEL
    attrCols[2]: BOOKED_AT,AMOUNT
  filter:
    kind: group
    op: AND
    items[1]{kind,field,operator,value}:
      condition,AMOUNT,">=","5000"
view:
  legend: true
  workingSet: true
  plugins:
    minimap: true
    behaviors[1]: hover-activate
