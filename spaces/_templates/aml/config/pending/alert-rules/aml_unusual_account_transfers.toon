afterScore:
  kind: anomaly-model
  model: aml_account_transfers
dataset: anomaly_scores_aml_account_transfers_latest
measure: "max(score)"
by[2]: model, entity_key
comparator: gte
threshold: 80
severity: CRITICAL
description: "Unusual account transfers: the account's Anomaly Score reached the model's high threshold (80) in its latest run"
