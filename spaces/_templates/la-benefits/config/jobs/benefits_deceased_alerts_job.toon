job:
  name: benefits_deceased_alerts
  type: alert.evaluate
  description: "Evaluates the Alert Rules each time the benefits_deceased_counts Job produces its Dataset, so benefits_paid_to_the_deceased_after_notice sees the new counts without anyone pressing Evaluate. On a build without Alert Rules (Basic) the rule is not armed and this Job finds nothing to evaluate."
  on_signal: job.dataset.produced
  when: "$signal.dataset == benefits_deceased_counts"
  enabled: true
