job:
  name: benefits_screen_links
  type: sql.template
  description: "Derived from benefits_links each time it is produced: the four integrity screens a benefits-integrity team runs, each a small slice of the link Dataset, tagged in the column screen so a saved view reads one screen and stays under the canvas's 1 000 nodes. shared_address: every address with 8 or more claimants, its residents, their claims and the accounts those are paid into. after_death: every account that received a claim paid 30 or more days after the claimant's death (or still running), every claim paid into those accounts and its claimant. work_while_claiming: every payroll link of a person who was paid while on Jobseeker benefit, and their Jobseeker claims. refund_concentration: the clients of every preparer who filed 60 or more returns, and every refund account shared by 3 or more taxpayers, with those taxpayers' preparers and refund accounts."
  sql: "WITH l AS (SELECT * FROM benefits_links), sa_la AS (SELECT * FROM l WHERE kind = 'lives_at' AND TRY_CAST(regexp_extract(via, 'claimants:([0-9]+)', 1) AS INTEGER) >= 8), sa_cl AS (SELECT * FROM l WHERE kind = 'claims' AND src IN (SELECT src FROM sa_la)), sa_pi AS (SELECT * FROM l WHERE kind = 'paid_into' AND src IN (SELECT dst FROM sa_cl)), sa AS (SELECT *, 'shared_address' AS screen FROM (SELECT * FROM sa_la UNION SELECT * FROM sa_cl UNION SELECT * FROM sa_pi)), ad_hit AS (SELECT DISTINCT dst FROM l WHERE kind = 'paid_into' AND (via LIKE '%paid_after_death_days:ongoing%' OR TRY_CAST(regexp_extract(via, 'paid_after_death_days:([0-9]+)', 1) AS INTEGER) >= 30)), ad_pi AS (SELECT * FROM l WHERE kind = 'paid_into' AND dst IN (SELECT dst FROM ad_hit)), ad_cl AS (SELECT * FROM l WHERE kind = 'claims' AND dst IN (SELECT src FROM ad_pi)), ad AS (SELECT *, 'after_death' AS screen FROM (SELECT * FROM ad_pi UNION SELECT * FROM ad_cl)), ww_eb AS (SELECT * FROM l WHERE kind = 'employed_by' AND TRY_CAST(regexp_extract(via, 'jobseeker_months:([0-9]+)', 1) AS INTEGER) > 0), ww_cl AS (SELECT * FROM l WHERE kind = 'claims' AND via LIKE 'benefit:Jobseeker|%' AND src IN (SELECT src FROM ww_eb)), ww AS (SELECT *, 'work_while_claiming' AS screen FROM (SELECT * FROM ww_eb UNION SELECT * FROM ww_cl)), rc_big AS (SELECT dst FROM l WHERE kind = 'prepared_by' GROUP BY dst HAVING count(*) >= 60), rc_shared AS (SELECT dst FROM l WHERE kind = 'refund_to' GROUP BY dst HAVING count(DISTINCT src) >= 3), rc_pb AS (SELECT * FROM l WHERE kind = 'prepared_by' AND (dst IN (SELECT dst FROM rc_big) OR src IN (SELECT src FROM l WHERE kind = 'refund_to' AND dst IN (SELECT dst FROM rc_shared)))), rc_rt AS (SELECT * FROM l WHERE kind = 'refund_to' AND (src IN (SELECT src FROM rc_pb) OR dst IN (SELECT dst FROM rc_shared))), rc AS (SELECT *, 'refund_concentration' AS screen FROM (SELECT * FROM rc_pb UNION SELECT * FROM rc_rt)), links AS (SELECT * FROM sa UNION ALL SELECT * FROM ad UNION ALL SELECT * FROM ww UNION ALL SELECT * FROM rc) SELECT src, dst, kind, ts, amount, event_date, via, screen FROM links ORDER BY screen, kind, src, dst"
  sources: benefits_links
  sink_dataset: benefits_screen_links
  on_signal: job.dataset.produced
  when: "$signal.dataset == benefits_links"
  enabled: true
