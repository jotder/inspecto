job:
  name: benefits_links
  type: sql.template
  description: "Folds the benefits and tax feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via), one row per pair. claims: a person to their claim (amount = monthly amount, via = benefit type, start and end); paid_into: a claim to the account it is paid into (via = benefit and monthly amount and, when the claimant is on the death register and was paid after the death, the death and notice days, paid_after_death_days - ongoing while the claim runs - and the overpayment recovered); lives_at: a person to their home address (amount = claimants there, via = residents, claimants, household declarations and the members they declare); employed_by: a person to an employer from payroll (amount = wages, via = months, first and last pay period, jobseeker_months on payroll while on Jobseeker benefit and over_limit_months above the 200-a-month permitted earnings); prepared_by: a taxpayer to the preparer who filed their return (amount = refund); refund_to: a taxpayer to the account a refund was paid into (via = returns and the preparer, or self). Ids say what an endpoint is: CIT- person, CL- claim, AD- address, EMP- employer, P- tax preparer, SYN- bank account. Runs after every Pipeline commit, and every 5 minutes as well: a commit that lands while a run is in flight is skipped, not queued (JOB-SIGNAL-OVERLAP-SKIP-1), so the cron catches up the last landing."
  sql: "WITH c AS (SELECT claim_id, person_id, benefit_type, CAST(start_date AS DATE) AS sd, TRY_CAST(nullif(CAST(end_date AS VARCHAR), '') AS DATE) AS ed, CAST(monthly_amount AS DOUBLE) AS amt, nullif(trim(bank_account), '') AS acct, TRY_CAST(nullif(CAST(overpaid_recovered AS VARCHAR), '') AS DOUBLE) AS rec FROM claim), dr AS (SELECT person_id, min(CAST(died_on AS DATE)) AS died, min(CAST(notified_on AS DATE)) AS notified FROM death_register GROUP BY person_id), cl AS (SELECT person_id AS src, claim_id AS dst, 'claims' AS kind, CAST(sd AS TIMESTAMP) AS ts, amt AS amount, 'benefit:' || benefit_type || '|start:' || strftime(sd, '%Y-%m-%d') || '|end:' || coalesce(strftime(ed, '%Y-%m-%d'), '') AS via FROM c), pi AS (SELECT c.claim_id AS src, c.acct AS dst, 'paid_into' AS kind, CAST(c.sd AS TIMESTAMP) AS ts, c.amt AS amount, 'benefit:' || c.benefit_type || '|monthly:' || CAST(round(c.amt) AS BIGINT) || CASE WHEN dr.died IS NOT NULL AND (c.ed IS NULL OR c.ed > dr.died) THEN '|died:' || strftime(dr.died, '%Y-%m-%d') || '|notified:' || strftime(dr.notified, '%Y-%m-%d') || '|paid_after_death_days:' || coalesce(CAST(date_diff('day', dr.died, c.ed) AS VARCHAR), 'ongoing') || '|recovered:' || CAST(round(coalesce(c.rec, 0)) AS BIGINT) ELSE '' END AS via FROM c LEFT JOIN dr USING (person_id) WHERE c.acct IS NOT NULL), p AS (SELECT person_id, nullif(trim(address_id), '') AS address_id FROM person), cp AS (SELECT DISTINCT person_id FROM c), res AS (SELECT p.address_id, count(*) AS residents, count(cp.person_id) AS claimants FROM p LEFT JOIN cp USING (person_id) WHERE p.address_id IS NOT NULL GROUP BY p.address_id), hh AS (SELECT address_id, count(*) AS decl, sum(coalesce(TRY_CAST(declared_members AS INTEGER), 0)) AS dm FROM household GROUP BY address_id), la AS (SELECT p.person_id AS src, p.address_id AS dst, 'lives_at' AS kind, TIMESTAMP '2025-10-01 00:00:00' AS ts, CAST(res.claimants AS DOUBLE) AS amount, 'residents:' || res.residents || '|claimants:' || res.claimants || '|households_declared:' || coalesce(hh.decl, 0) || '|declared_members:' || coalesce(hh.dm, 0) AS via FROM p JOIN res USING (address_id) LEFT JOIN hh USING (address_id)), pay AS (SELECT employer_id, person_id, CAST(period AS DATE) AS per, CAST(wages AS DOUBLE) AS w FROM payroll), js AS (SELECT person_id, date_trunc('month', sd) AS sm, coalesce(ed, DATE '2099-12-31') AS em FROM c WHERE benefit_type = 'Jobseeker'), pw AS (SELECT pay.employer_id, pay.person_id, pay.per, pay.w, count(js.person_id) > 0 AS claiming FROM pay LEFT JOIN js ON js.person_id = pay.person_id AND pay.per >= js.sm AND pay.per <= js.em GROUP BY ALL), eb AS (SELECT person_id AS src, employer_id AS dst, 'employed_by' AS kind, CAST(min(per) AS TIMESTAMP) AS ts, sum(w) AS amount, 'months:' || count(*) || '|first:' || strftime(min(per), '%Y-%m') || '|last:' || strftime(max(per), '%Y-%m') || '|jobseeker_months:' || count(*) FILTER (WHERE claiming) || '|over_limit_months:' || count(*) FILTER (WHERE claiming AND w > 200) || '|wages_while_claiming:' || CAST(round(coalesce(sum(w) FILTER (WHERE claiming), 0)) AS BIGINT) AS via FROM pw GROUP BY person_id, employer_id), tr AS (SELECT return_id, taxpayer_id, nullif(trim(preparer_id), '') AS prep, CAST(refund AS DOUBLE) AS refund, nullif(trim(bank_account), '') AS acct, CAST(filed_at AS DATE) AS filed FROM tax_return), pb AS (SELECT taxpayer_id AS src, prep AS dst, 'prepared_by' AS kind, CAST(min(filed) AS TIMESTAMP) AS ts, sum(refund) AS amount, 'returns:' || count(*) || '|refund:' || CAST(round(sum(refund)) AS BIGINT) AS via FROM tr WHERE prep IS NOT NULL GROUP BY taxpayer_id, prep), rt AS (SELECT taxpayer_id AS src, acct AS dst, 'refund_to' AS kind, CAST(min(filed) AS TIMESTAMP) AS ts, sum(refund) AS amount, 'returns:' || count(*) || '|preparer:' || coalesce(string_agg(DISTINCT prep, '|' ORDER BY prep), 'self') AS via FROM tr WHERE acct IS NOT NULL AND refund > 0 GROUP BY taxpayer_id, acct), links AS (SELECT * FROM cl UNION ALL SELECT * FROM pi UNION ALL SELECT * FROM la UNION ALL SELECT * FROM eb UNION ALL SELECT * FROM pb UNION ALL SELECT * FROM rt) SELECT src, dst, kind, ts, round(amount, 2) AS amount, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: claim,death_register,person,household,payroll,tax_return
  sink_dataset: benefits_links
  on_signal: pipeline.commit
  cron: "*/5 * * * *"
  enabled: true
