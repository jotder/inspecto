job:
  name: benefits_deceased_counts
  type: sql.template
  description: "Runs each time the benefits_links Job produces its Dataset. One row of counts about claims of people on the death register that were paid after the death: deceased_claims_paid_after_notice (claims still paid more than grace_days_after_notice days after the death was notified, or still running that long after it - the payments to the deceased), accounts_paid_after_notice (the accounts those claims are paid into, from the paid_into links), living_claims_into_those_accounts (claims of people not on the death register paid into the same accounts: who else the account serves), overpayments_stopped_after_notice (claims paid after the death that stopped within the grace after the notice: the normal overpayment of a death notified late) and slowest_stop_after_notice_days (the most days such a claim ran past its notice, the margin under the grace). Days are counted from the notice, not the death: a notice arrives 0-60 days after the death, so a claim stopped days after a late notice overpays for weeks and is normal; a claim still paid months after the notice is not. A claim still running is counted to the latest date any feed reports. The Alert Rule benefits_paid_to_the_deceased_after_notice reads it; no person, claim or account id leaves this Job, they are found in the Investigation."
  sql: "WITH c AS (SELECT claim_id, person_id, CAST(start_date AS DATE) AS sd, TRY_CAST(nullif(CAST(end_date AS VARCHAR), '') AS DATE) AS ed FROM claim), dr AS (SELECT person_id, min(CAST(died_on AS DATE)) AS died, min(CAST(notified_on AS DATE)) AS notified FROM death_register GROUP BY person_id), cut AS (SELECT greatest((SELECT max(notified) FROM dr), (SELECT max(sd) FROM c)) AS d), x AS (SELECT c.claim_id, date_diff('day', dr.notified, coalesce(c.ed, (SELECT d FROM cut))) AS after_notice FROM c JOIN dr USING (person_id) WHERE c.ed IS NULL OR c.ed > dr.died), hit AS (SELECT claim_id FROM x WHERE after_notice > CAST($grace_days_after_notice AS INTEGER)), paid AS (SELECT src AS claim_id, dst AS acct FROM benefits_links WHERE kind = 'paid_into'), acc AS (SELECT DISTINCT acct FROM paid WHERE claim_id IN (SELECT claim_id FROM hit)) SELECT (SELECT count(*) FROM hit) AS deceased_claims_paid_after_notice, (SELECT count(*) FROM acc) AS accounts_paid_after_notice, (SELECT count(*) FROM paid JOIN acc USING (acct) JOIN c USING (claim_id) WHERE c.person_id NOT IN (SELECT person_id FROM dr)) AS living_claims_into_those_accounts, (SELECT count(*) FROM x WHERE after_notice <= CAST($grace_days_after_notice AS INTEGER)) AS overpayments_stopped_after_notice, (SELECT coalesce(max(after_notice), 0) FROM x WHERE after_notice <= CAST($grace_days_after_notice AS INTEGER)) AS slowest_stop_after_notice_days"
  sources: benefits_links,claim,death_register
  sink_dataset: benefits_deceased_counts
  on_signal: job.dataset.produced
  when: "$signal.dataset == benefits_links"
  grace_days_after_notice: "30"
  enabled: true
