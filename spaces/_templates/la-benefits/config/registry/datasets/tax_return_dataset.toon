physicalRef: tax_return/database
description: "Benefits and tax fraud Link Analysis showcase - One row per income tax return: the taxpayer, the preparer who filed it (blank when the taxpayer filed it alone), the refund (0 when tax was owed) and the account it is paid into, and the day it was filed. One file per month filed (TAX_RETURN_YYYYMM.csv); the next month is in data/staged. Landed by the tax_return Pipeline. Synthetic."
eventDate: filed_at
columns[6]{name,type,classification}:
  return_id,string,
  taxpayer_id,string,
  preparer_id,string,
  refund,number,
  bank_account,string,
  filed_at,date,
