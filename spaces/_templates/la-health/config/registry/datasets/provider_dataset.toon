physicalRef: provider/database
description: "Provider billing fraud Link Analysis showcase - One row per enrolled provider (practices, clinics, imaging centres, laboratories, pharmacies, hospitals): name, specialty, premises address and the bank account payments go to (blank for about 4 %). One extract (PROVIDER_20260930.csv). Landed by the provider Pipeline. Synthetic."
primaryEntityType: provider
columns[5]{name,type,classification}:
  provider_id,string,PROVIDER
  name,string,
  specialty,string,
  address_id,string,ADDRESS
  bank_account,string,BANK_ACCOUNT
defaultLinkMapping:
  from: provider_id
  to: bank_account
