name: phantom_billing
description: "Billed in hospital or after death - every provider-member link with a claim line dated inside the member's stay at another hospital or after the member's death (via on treated = in_admission, after_death, corrected, corrected_within_days). Most are date errors reversed within a week. One physiotherapy clinic bills 40 patients for sessions while they were in hospital or after they died, and none of it is reversed."
sourceId: entity-projection
layout: force
query:
  projection:
    datasetId: health_screen_links_dataset
    sourceCol: src
    targetCol: dst
    linkKindCol: kind
    attrCols[4]: ts,amount,via,screen
  filter:
    kind: group
    op: AND
    items[1]{kind,field,operator,value}:
      condition,screen,"=","phantom_billing"
view:
  legend: true
  workingSet: true
  plugins:
    minimap: true
    hulls: true
    behaviors[1]: hover-activate
