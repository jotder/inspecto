name: admission
active: true
description: "Provider billing fraud Link Analysis showcase - One row per hospital stay: member, hospital (a provider id) and the admission and discharge dates. One file per admission month (ADMISSION_YYYYMM.csv); the next month is in data/staged. Synthetic; regenerate with tools/gen-la-health-data.py."

dirs:
  poll:       data/inbox/admission
  database:   data/admission/database
  backup:     data/admission/backup
  temp:       data/admission/temp
  errors:     data/admission/errors
  quarantine: data/admission/quarantine
  markers:    data/admission/markers
  status_dir: data/admission/status
  log_dir:    data/admission/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: admission_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
