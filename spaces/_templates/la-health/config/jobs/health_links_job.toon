job:
  name: health_links
  type: sql.template
  description: "Folds the payer's feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via), one row per pair. treated: a provider to a member it billed for (amount = paid, reversed lines excluded; via = lines, months, first and last service date, in_admission - open lines dated inside the member's stay at another hospital, with admitted_at - after_death - open lines dated after the member's death, with died - and corrected, lines in a stay or after a death that were reversed, with corrected_within_days); referred_to: a referring practice to the provider it referred to (amount = referrals; via = referrals, of_all_referrals, share, members); owned_by: a provider to its owner (amount = office visits; via = specialty, city and, for providers billing office visits, office_visits, top_level_share, all_providers_share, same_age_mix_share - the top-level share expected from the ages of its patients, ages counted in 2026 - ratio_to_same_age_mix and patients_80_plus); prescribed: a prescriber to a member (amount = quantity; via = scripts, strong_opioid_scripts, strong_opioid_qty, cash_scripts, distance_km from the member's home); filled_at: a member to a pharmacy (via = fills, strong_opioid_fills, cash_fills, distance_km); lives_at: a person who owns a provider to their home (amount = owners at that address). Ids say what an endpoint is: PR- provider, OW- owner, M- member, AD- address. Runs after every Pipeline commit, and every 5 minutes as well: a commit that lands while a run is in flight is skipped, not queued (JOB-SIGNAL-OVERLAP-SKIP-1), so the cron catches up the last landing."
  sql: "WITH a AS (SELECT address_id, city, TRY_CAST(nullif(CAST(lat AS VARCHAR), '') AS DOUBLE) AS lat, TRY_CAST(nullif(CAST(lon AS VARCHAR), '') AS DOUBLE) AS lon FROM address), m AS (SELECT member_id, TRY_CAST(birth_year AS INTEGER) AS yob, nullif(trim(address_id), '') AS addr, TRY_CAST(nullif(CAST(died_on AS VARCHAR), '') AS DATE) AS died FROM member), pv AS (SELECT provider_id, specialty, nullif(trim(address_id), '') AS addr FROM provider), cl AS (SELECT claim_id, provider_id, member_id, CAST(service_date AS DATE) AS sd, procedure_code AS pc, TRY_CAST(nullif(CAST(level AS VARCHAR), '') AS INTEGER) AS lvl, CAST(paid AS DOUBLE) AS paid, CAST(received_on AS DATE) AS rcv, nullif(trim(reverses), '') AS rev FROM claim_line), rv AS (SELECT rev, min(rcv) AS rrcv FROM cl WHERE rev IS NOT NULL GROUP BY rev), ad AS (SELECT member_id, hospital_id, CAST(from_date AS DATE) AS fd, CAST(to_date AS DATE) AS td FROM admission), o AS (SELECT cl.*, rv.rrcv FROM cl LEFT JOIN rv ON rv.rev = cl.claim_id WHERE cl.rev IS NULL), ia AS (SELECT o.claim_id, string_agg(DISTINCT ad.hospital_id, ' ') AS hosp FROM o JOIN ad ON ad.member_id = o.member_id AND o.sd > ad.fd AND o.sd < ad.td AND ad.hospital_id <> o.provider_id GROUP BY o.claim_id), f AS (SELECT o.*, ia.hosp, ia.claim_id IS NOT NULL AS in_ad, coalesce(o.sd > m.died, false) AS after_death, m.died, m.yob FROM o LEFT JOIN ia USING (claim_id) LEFT JOIN m USING (member_id)), tr AS (SELECT provider_id AS src, member_id AS dst, 'treated' AS kind, CAST(min(sd) AS TIMESTAMP) AS ts, sum(CASE WHEN rrcv IS NULL THEN paid ELSE 0 END) AS amount, 'lines:' || count(*) || '|months:' || count(DISTINCT date_trunc('month', sd)) || '|first:' || strftime(min(sd), '%Y-%m-%d') || '|last:' || strftime(max(sd), '%Y-%m-%d') || '|in_admission:' || count(*) FILTER (WHERE in_ad AND rrcv IS NULL) || '|after_death:' || count(*) FILTER (WHERE after_death AND rrcv IS NULL) || '|corrected:' || count(*) FILTER (WHERE (in_ad OR after_death) AND rrcv IS NOT NULL) || coalesce('|corrected_within_days:' || max(date_diff('day', rcv, rrcv)) FILTER (WHERE (in_ad OR after_death) AND rrcv IS NOT NULL), '') || coalesce('|admitted_at:' || string_agg(DISTINCT hosp, ' ') FILTER (WHERE in_ad AND rrcv IS NULL), '') || CASE WHEN count(*) FILTER (WHERE after_death AND rrcv IS NULL) > 0 THEN '|died:' || strftime(max(died), '%Y-%m-%d') ELSE '' END AS via FROM f GROUP BY provider_id, member_id), ov AS (SELECT provider_id, lvl, CASE WHEN 2026 - yob < 40 THEN 'a' WHEN 2026 - yob < 65 THEN 'b' WHEN 2026 - yob < 80 THEN 'c' ELSE 'd' END AS band FROM f WHERE pc = 'OFV' AND lvl IS NOT NULL AND rrcv IS NULL AND yob IS NOT NULL), br AS (SELECT band, avg(CASE WHEN lvl = 5 THEN 1.0 ELSE 0.0 END) AS r5 FROM ov GROUP BY band), allr AS (SELECT avg(CASE WHEN lvl = 5 THEN 1.0 ELSE 0.0 END) AS r FROM ov), prof AS (SELECT ov.provider_id, count(*) AS visits, avg(CASE WHEN lvl = 5 THEN 1.0 ELSE 0.0 END) AS share5, avg(br.r5) AS expected, avg(CASE WHEN band = 'd' THEN 1.0 ELSE 0.0 END) AS over80 FROM ov JOIN br USING (band) GROUP BY ov.provider_id), ob AS (SELECT po.provider_id AS src, po.owner_id AS dst, 'owned_by' AS kind, TIMESTAMP '2025-10-01 00:00:00' AS ts, CAST(coalesce(prof.visits, 0) AS DOUBLE) AS amount, 'provider:' || pv.specialty || '|city:' || coalesce(a.city, '') || CASE WHEN prof.visits IS NULL THEN '' ELSE '|office_visits:' || prof.visits || '|top_level_share:' || round(prof.share5, 3) || '|all_providers_share:' || round(allr.r, 3) || '|same_age_mix_share:' || round(prof.expected, 3) || '|ratio_to_same_age_mix:' || round(prof.share5 / prof.expected, 2) || '|patients_80_plus:' || round(prof.over80, 2) END AS via FROM provider_owner po JOIN pv USING (provider_id) LEFT JOIN a ON a.address_id = pv.addr LEFT JOIN prof USING (provider_id) CROSS JOIN allr), rf AS (SELECT from_provider AS fp, to_provider AS tp, member_id, CAST(referred_on AS DATE) AS d FROM referral), rtot AS (SELECT fp, count(*) AS n FROM rf GROUP BY fp), ref AS (SELECT rf.fp AS src, rf.tp AS dst, 'referred_to' AS kind, CAST(min(rf.d) AS TIMESTAMP) AS ts, CAST(count(*) AS DOUBLE) AS amount, 'referrals:' || count(*) || '|of_all_referrals:' || any_value(rtot.n) || '|share:' || round(count(*) / any_value(rtot.n), 2) || '|members:' || count(DISTINCT rf.member_id) AS via FROM rf JOIN rtot USING (fp) GROUP BY rf.fp, rf.tp), rx AS (SELECT prescriber_id, pharmacy_id, member_id, drug_class, CAST(qty AS INTEGER) AS qty, paid_cash = 'Y' AS cash, CAST(filled_on AS DATE) AS d FROM prescription), mg AS (SELECT m.member_id, a.lat AS mlat, a.lon AS mlon FROM m JOIN a ON a.address_id = m.addr), pg AS (SELECT pv.provider_id, a.lat AS plat, a.lon AS plon FROM pv JOIN a ON a.address_id = pv.addr), pr AS (SELECT rx.prescriber_id AS src, rx.member_id AS dst, 'prescribed' AS kind, CAST(min(rx.d) AS TIMESTAMP) AS ts, CAST(sum(rx.qty) AS DOUBLE) AS amount, 'scripts:' || count(*) || '|strong_opioid_scripts:' || count(*) FILTER (WHERE rx.drug_class = 'Strong opioid') || '|strong_opioid_qty:' || coalesce(sum(rx.qty) FILTER (WHERE rx.drug_class = 'Strong opioid'), 0) || '|cash_scripts:' || count(*) FILTER (WHERE rx.cash) || coalesce('|distance_km:' || CAST(round(any_value(2 * 6371 * asin(sqrt(pow(sin(radians(pg.plat - mg.mlat) / 2), 2) + cos(radians(mg.mlat)) * cos(radians(pg.plat)) * pow(sin(radians(pg.plon - mg.mlon) / 2), 2))))) AS BIGINT), '') AS via FROM rx LEFT JOIN mg USING (member_id) LEFT JOIN pg ON pg.provider_id = rx.prescriber_id GROUP BY rx.prescriber_id, rx.member_id), fa AS (SELECT rx.member_id AS src, rx.pharmacy_id AS dst, 'filled_at' AS kind, CAST(min(rx.d) AS TIMESTAMP) AS ts, CAST(sum(rx.qty) AS DOUBLE) AS amount, 'fills:' || count(*) || '|strong_opioid_fills:' || count(*) FILTER (WHERE rx.drug_class = 'Strong opioid') || '|cash_fills:' || count(*) FILTER (WHERE rx.cash) || coalesce('|distance_km:' || CAST(round(any_value(2 * 6371 * asin(sqrt(pow(sin(radians(pg.plat - mg.mlat) / 2), 2) + cos(radians(mg.mlat)) * cos(radians(pg.plat)) * pow(sin(radians(pg.plon - mg.mlon) / 2), 2))))) AS BIGINT), '') AS via FROM rx LEFT JOIN mg USING (member_id) LEFT JOIN pg ON pg.provider_id = rx.pharmacy_id GROUP BY rx.member_id, rx.pharmacy_id), ow AS (SELECT owner_id, nullif(trim(address_id), '') AS addr FROM owner WHERE owner_type = 'person'), oc AS (SELECT addr, count(*) AS n FROM ow GROUP BY addr), la AS (SELECT ow.owner_id AS src, ow.addr AS dst, 'lives_at' AS kind, TIMESTAMP '2025-10-01 00:00:00' AS ts, CAST(oc.n AS DOUBLE) AS amount, 'owners_at_address:' || oc.n AS via FROM ow JOIN oc USING (addr) WHERE ow.addr IS NOT NULL), links AS (SELECT * FROM tr UNION ALL SELECT * FROM ob UNION ALL SELECT * FROM ref UNION ALL SELECT * FROM pr UNION ALL SELECT * FROM fa UNION ALL SELECT * FROM la) SELECT src, dst, kind, ts, round(amount, 2) AS amount, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: address,member,provider,owner,provider_owner,claim_line,admission,referral,prescription
  sink_dataset: health_links
  on_signal: pipeline.commit
  cron: "*/5 * * * *"
  enabled: true
