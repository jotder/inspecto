job:
  name: health_screen_links
  type: sql.template
  description: "Derived from health_links each time it is produced: the four screens a program-integrity team runs, each a small slice of the link Dataset, tagged in the column screen so a saved view reads one screen and stays under the canvas's 1 000 nodes. referral_concentration: every practice that sends 60 % or more of 20 or more referrals to one provider (that link only), the owners of both ends and the homes two of those owners share. phantom_billing: every provider-member link with a line dated inside a stay at another hospital or after the member's death, open or corrected. pill_mill: every prescriber with 40 or more strong-opioid patients, those patients and the pharmacies where they filled strong opioids. upcoding: every provider with 150 or more office visits billed at the top level at least 1.75 times as often as all providers, with its owner and everything that owner owns."
  sql: "WITH l AS (SELECT * FROM health_links), rc_top AS (SELECT * FROM l WHERE kind = 'referred_to' AND TRY_CAST(regexp_extract(via, 'of_all_referrals:([0-9]+)', 1) AS INTEGER) >= 20 AND TRY_CAST(regexp_extract(via, '[|]share:([0-9.]+)', 1) AS DOUBLE) >= 0.6), rc_ends AS (SELECT src AS p FROM rc_top UNION SELECT dst FROM rc_top), rc_ob AS (SELECT * FROM l WHERE kind = 'owned_by' AND src IN (SELECT p FROM rc_ends)), rc_homes AS (SELECT dst FROM l WHERE kind = 'lives_at' AND src IN (SELECT dst FROM rc_ob) GROUP BY dst HAVING count(*) >= 2), rc_la AS (SELECT * FROM l WHERE kind = 'lives_at' AND src IN (SELECT dst FROM rc_ob) AND dst IN (SELECT dst FROM rc_homes)), rc AS (SELECT *, 'referral_concentration' AS screen FROM (SELECT * FROM rc_top UNION ALL SELECT * FROM rc_ob UNION ALL SELECT * FROM rc_la)), pb AS (SELECT *, 'phantom_billing' AS screen FROM l WHERE kind = 'treated' AND (TRY_CAST(regexp_extract(via, 'in_admission:([0-9]+)', 1) AS INTEGER) > 0 OR TRY_CAST(regexp_extract(via, 'after_death:([0-9]+)', 1) AS INTEGER) > 0 OR TRY_CAST(regexp_extract(via, 'corrected:([0-9]+)', 1) AS INTEGER) > 0)), pm_big AS (SELECT src FROM l WHERE kind = 'prescribed' AND TRY_CAST(regexp_extract(via, 'strong_opioid_scripts:([0-9]+)', 1) AS INTEGER) > 0 GROUP BY src HAVING count(*) >= 40), pm_pr AS (SELECT * FROM l WHERE kind = 'prescribed' AND src IN (SELECT src FROM pm_big) AND TRY_CAST(regexp_extract(via, 'strong_opioid_scripts:([0-9]+)', 1) AS INTEGER) > 0), pm_fa AS (SELECT * FROM l WHERE kind = 'filled_at' AND src IN (SELECT dst FROM pm_pr) AND TRY_CAST(regexp_extract(via, 'strong_opioid_fills:([0-9]+)', 1) AS INTEGER) > 0), pm AS (SELECT *, 'pill_mill' AS screen FROM (SELECT * FROM pm_pr UNION ALL SELECT * FROM pm_fa)), up_hit AS (SELECT * FROM l WHERE kind = 'owned_by' AND TRY_CAST(regexp_extract(via, 'office_visits:([0-9]+)', 1) AS INTEGER) >= 150 AND TRY_CAST(regexp_extract(via, 'top_level_share:([0-9.]+)', 1) AS DOUBLE) >= 1.75 * TRY_CAST(regexp_extract(via, 'all_providers_share:([0-9.]+)', 1) AS DOUBLE)), up AS (SELECT *, 'upcoding' AS screen FROM l WHERE kind = 'owned_by' AND dst IN (SELECT dst FROM up_hit)), links AS (SELECT * FROM rc UNION ALL SELECT * FROM pb UNION ALL SELECT * FROM pm UNION ALL SELECT * FROM up) SELECT src, dst, kind, ts, amount, event_date, via, screen FROM links ORDER BY screen, kind, src, dst"
  sources: health_links
  sink_dataset: health_screen_links
  on_signal: job.dataset.produced
  when: "$signal.dataset == health_links"
  enabled: true
