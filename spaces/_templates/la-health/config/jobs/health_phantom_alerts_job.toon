job:
  name: health_phantom_alerts
  type: alert.evaluate
  description: "Evaluates the Alert Rules each time the health_phantom_counts Job produces its Dataset, so health_billed_in_admission_or_after_death sees the new counts without anyone pressing Evaluate. On a build without Alert Rules (Basic) the rule is not armed and this Job finds nothing to evaluate."
  on_signal: job.dataset.produced
  when: "$signal.dataset == health_phantom_counts"
  enabled: true
