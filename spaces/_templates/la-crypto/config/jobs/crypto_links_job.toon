job:
  name: crypto_links
  type: sql.template
  description: "Folds the crypto feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via), one row per pair. sent_to: an address to an address it paid (amount = total; via = transfers, asset, first and last, both labels, and src_hop / dst_hop - 1 when that address has the peel shape: exactly one transfer in and two out, to two addresses, both within 24 hours after it); same_cluster: an address to its common-input cluster (amount = cluster size; via = the address label, cluster_size and cluster_exchange, how many of the cluster's addresses are labelled exchange); deposit_of: an exchange deposit address to its account (amount = deposited; via = exchange, deposits, senders); kyc_of: an account to the KYC person who holds it (amount = that person's accounts; via = exchange, name, birth year, country); cashed_out_to: an account to a bank account it withdrew to (amount = total; via = cashouts, first, last and accounts_to_this_bank); mixer_exit: an address that paid into a mixer to an address the mixer paid within 6 hours after, 90-100 % of the input in SYC (ts and amount = the closest exit; via = candidates, matched - yes when within 120 minutes and at least 98 % - minutes, ratio and both transfer ids). Ids say what an endpoint is: syn1... address (an invented format), CL- cluster, XA- exchange account, KP- KYC person, BK- bank account. Runs after every Pipeline commit, and every 5 minutes as well: a commit that lands while a run is in flight is skipped, not queued (JOB-SIGNAL-OVERLAP-SKIP-1), so the cron catches up the last landing."
  sql: "WITH t AS (SELECT tx_id, from_address AS fa, to_address AS ta, CAST(amount AS DOUBLE) AS amt, asset, CAST(tx_at AS TIMESTAMP) AS tat FROM transfer), w AS (SELECT address, min(label) AS label, min(CAST(first_seen AS TIMESTAMP)) AS fs FROM wallet GROUP BY address), ins AS (SELECT ta AS a, count(*) AS n, min(tat) AS t_in FROM t GROUP BY ta), outs AS (SELECT fa AS a, count(*) AS n, count(DISTINCT ta) AS nd, min(tat) AS t1, max(tat) AS t2 FROM t GROUP BY fa), hop AS (SELECT ins.a FROM ins JOIN outs ON outs.a = ins.a WHERE ins.n = 1 AND outs.n = 2 AND outs.nd = 2 AND outs.t1 >= ins.t_in AND outs.t2 <= ins.t_in + INTERVAL 24 HOUR), st AS (SELECT t.fa AS src, t.ta AS dst, 'sent_to' AS kind, min(t.tat) AS ts, sum(t.amt) AS amount, 'transfers:' || count(*) || '|asset:' || min(t.asset) || '|first:' || strftime(min(t.tat), '%Y-%m-%d %H:%M') || '|last:' || strftime(max(t.tat), '%Y-%m-%d %H:%M') || '|src_label:' || coalesce(min(ws.label), '') || '|dst_label:' || coalesce(min(wd.label), '') || '|src_hop:' || CASE WHEN min(hs.a) IS NULL THEN 0 ELSE 1 END || '|dst_hop:' || CASE WHEN min(hd.a) IS NULL THEN 0 ELSE 1 END AS via FROM t LEFT JOIN w ws ON ws.address = t.fa LEFT JOIN w wd ON wd.address = t.ta LEFT JOIN hop hs ON hs.a = t.fa LEFT JOIN hop hd ON hd.a = t.ta GROUP BY t.fa, t.ta), ch AS (SELECT DISTINCT address, cluster_id FROM cluster_hint), cs AS (SELECT ch.cluster_id, count(*) AS n, count(*) FILTER (WHERE w.label = 'exchange') AS ex FROM ch LEFT JOIN w ON w.address = ch.address GROUP BY ch.cluster_id), sc AS (SELECT ch.address AS src, ch.cluster_id AS dst, 'same_cluster' AS kind, coalesce(w.fs, TIMESTAMP '2025-10-01 00:00:00') AS ts, CAST(cs.n AS DOUBLE) AS amount, 'label:' || coalesce(w.label, '') || '|cluster_size:' || cs.n || '|cluster_exchange:' || cs.ex AS via FROM ch JOIN cs ON cs.cluster_id = ch.cluster_id LEFT JOIN w ON w.address = ch.address), xa AS (SELECT DISTINCT account_id, exchange, kyc_person_id, deposit_address, CAST(opened_at AS TIMESTAMP) AS oat FROM exchange_account), di AS (SELECT ta, count(*) AS n, count(DISTINCT fa) AS ns, sum(amt) AS amt FROM t GROUP BY ta), dep AS (SELECT xa.deposit_address AS src, xa.account_id AS dst, 'deposit_of' AS kind, xa.oat AS ts, coalesce(di.amt, 0) AS amount, 'exchange:' || xa.exchange || '|deposits:' || coalesce(di.n, 0) || '|senders:' || coalesce(di.ns, 0) AS via FROM xa LEFT JOIN di ON di.ta = xa.deposit_address), pa AS (SELECT kyc_person_id, count(*) AS n FROM xa GROUP BY kyc_person_id), ky AS (SELECT xa.account_id AS src, xa.kyc_person_id AS dst, 'kyc_of' AS kind, xa.oat AS ts, CAST(pa.n AS DOUBLE) AS amount, 'exchange:' || xa.exchange || '|name:' || coalesce(p.name, '') || '|birth_year:' || coalesce(CAST(p.birth_year AS VARCHAR), '') || '|country:' || coalesce(p.country, '') || '|accounts:' || pa.n AS via FROM xa JOIN pa ON pa.kyc_person_id = xa.kyc_person_id LEFT JOIN (SELECT person_id, min(name) AS name, min(birth_year) AS birth_year, min(country) AS country FROM kyc_person GROUP BY person_id) p ON p.person_id = xa.kyc_person_id), cog AS (SELECT account_id AS src, bank_account AS dst, min(CAST(cashout_at AS TIMESTAMP)) AS ts, max(CAST(cashout_at AS TIMESTAMP)) AS tl, sum(CAST(amount AS DOUBLE)) AS amount, count(*) AS n FROM cashout GROUP BY account_id, bank_account), co AS (SELECT src, dst, 'cashed_out_to' AS kind, ts, amount, 'cashouts:' || n || '|first:' || strftime(ts, '%Y-%m-%d') || '|last:' || strftime(tl, '%Y-%m-%d') || '|accounts_to_this_bank:' || count(*) OVER (PARTITION BY dst) AS via FROM cog), mi AS (SELECT t.tx_id, t.fa, t.amt, t.tat FROM t JOIN w wt ON wt.address = t.ta LEFT JOIN w wf ON wf.address = t.fa WHERE wt.label = 'mixer' AND coalesce(wf.label, '') <> 'mixer' AND t.asset = 'SYC'), mo AS (SELECT t.tx_id, t.ta, t.amt, t.tat FROM t JOIN w wf ON wf.address = t.fa LEFT JOIN w wt ON wt.address = t.ta WHERE wf.label = 'mixer' AND coalesce(wt.label, '') <> 'mixer' AND t.asset = 'SYC'), mc AS (SELECT mi.fa AS src, mo.ta AS dst, mi.tx_id AS itx, mo.tx_id AS otx, mo.tat, mo.amt, date_diff('minute', mi.tat, mo.tat) AS mins, mo.amt / mi.amt AS ratio FROM mi JOIN mo ON mo.tat > mi.tat AND mo.tat <= mi.tat + INTERVAL 6 HOUR AND mo.amt >= 0.90 * mi.amt AND mo.amt <= mi.amt), mk AS (SELECT *, mins <= 120 AND ratio >= 0.98 AS ok, CASE WHEN mins <= 120 AND ratio >= 0.98 THEN 0 ELSE 100000 END + mins AS k FROM mc), mx AS (SELECT src, dst, 'mixer_exit' AS kind, arg_min(tat, k) AS ts, arg_min(amt, k) AS amount, 'candidates:' || count(*) || '|matched:' || CASE WHEN bool_or(ok) THEN 'yes' ELSE 'no' END || '|minutes:' || arg_min(mins, k) || '|ratio:' || CAST(round(arg_min(ratio, k), 4) AS VARCHAR) || '|in_tx:' || arg_min(itx, k) || '|out_tx:' || arg_min(otx, k) AS via FROM mk GROUP BY src, dst), links AS (SELECT * FROM st UNION ALL SELECT * FROM sc UNION ALL SELECT * FROM dep UNION ALL SELECT * FROM ky UNION ALL SELECT * FROM co UNION ALL SELECT * FROM mx) SELECT src, dst, kind, ts, round(amount, 6) AS amount, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: wallet,transfer,cluster_hint,exchange_account,kyc_person,cashout
  sink_dataset: crypto_links
  on_signal: pipeline.commit
  cron: "*/5 * * * *"
  enabled: true
