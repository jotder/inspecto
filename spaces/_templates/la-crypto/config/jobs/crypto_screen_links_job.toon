job:
  name: crypto_screen_links
  type: sql.template
  description: "Derived from crypto_links each time it is produced: the three screens a crypto compliance team runs, each a small slice of the link Dataset, tagged in the column screen so a saved view reads one screen and stays under the canvas's 1 000 nodes. peel_chain: every sent_to link in or out of a peel-shaped address chained to another (one transfer in, two out within 24 hours; sent_to via src_hop:1 and dst_hop:1), the exchange accounts such a hop paid (deposit_of) and their KYC persons. mixer_hop: every mixer_exit link (matched or a near miss), and for a matched exit the deposits its recipient made, the accounts and the KYC persons. converging_cash_out: every cluster (with no exchange-labelled address) whose addresses paid the deposit addresses of 10 or more exchange accounts, with those payments, the accounts, their KYC persons and the bank accounts they cashed out to."
  sql: "WITH l AS (SELECT * FROM crypto_links), s AS (SELECT * FROM l WHERE kind = 'sent_to'), dl AS (SELECT * FROM l WHERE kind = 'deposit_of'), hh AS (SELECT src AS a FROM s WHERE ends_with(via, '|src_hop:1|dst_hop:1') UNION SELECT dst AS a FROM s WHERE ends_with(via, '|src_hop:1|dst_hop:1')), pc_s AS (SELECT * FROM s WHERE src IN (SELECT a FROM hh) OR dst IN (SELECT a FROM hh)), pc_d AS (SELECT * FROM dl WHERE src IN (SELECT dst FROM pc_s WHERE src IN (SELECT a FROM hh))), pc_k AS (SELECT * FROM l WHERE kind = 'kyc_of' AND src IN (SELECT dst FROM pc_d)), pc AS (SELECT *, 'peel_chain' AS screen FROM (SELECT * FROM pc_s UNION ALL SELECT * FROM pc_d UNION ALL SELECT * FROM pc_k)), mx AS (SELECT * FROM l WHERE kind = 'mixer_exit'), mh_s AS (SELECT * FROM s WHERE src IN (SELECT dst FROM mx WHERE contains(via, '|matched:yes|')) AND dst IN (SELECT src FROM dl)), mh_d AS (SELECT * FROM dl WHERE src IN (SELECT dst FROM mh_s)), mh_k AS (SELECT * FROM l WHERE kind = 'kyc_of' AND src IN (SELECT dst FROM mh_d)), mh AS (SELECT *, 'mixer_hop' AS screen FROM (SELECT * FROM mx UNION ALL SELECT * FROM mh_s UNION ALL SELECT * FROM mh_d UNION ALL SELECT * FROM mh_k)), sc AS (SELECT * FROM l WHERE kind = 'same_cluster' AND ends_with(via, '|cluster_exchange:0')), cf AS (SELECT sc.dst AS cl, dl.dst AS acct FROM sc JOIN s ON s.src = sc.src JOIN dl ON dl.src = s.dst), fc AS (SELECT cl FROM cf GROUP BY cl HAVING count(DISTINCT acct) >= 10), cc_c AS (SELECT * FROM sc WHERE dst IN (SELECT cl FROM fc)), cc_s AS (SELECT * FROM s WHERE src IN (SELECT src FROM cc_c) AND dst IN (SELECT src FROM dl)), cc_d AS (SELECT * FROM dl WHERE src IN (SELECT dst FROM cc_s)), cc_k AS (SELECT * FROM l WHERE kind = 'kyc_of' AND src IN (SELECT dst FROM cc_d)), cc_o AS (SELECT * FROM l WHERE kind = 'cashed_out_to' AND src IN (SELECT dst FROM cc_d)), cc AS (SELECT *, 'converging_cash_out' AS screen FROM (SELECT * FROM cc_c UNION ALL SELECT * FROM cc_s UNION ALL SELECT * FROM cc_d UNION ALL SELECT * FROM cc_k UNION ALL SELECT * FROM cc_o)), links AS (SELECT * FROM pc UNION ALL SELECT * FROM mh UNION ALL SELECT * FROM cc) SELECT src, dst, kind, ts, amount, event_date, via, screen FROM links ORDER BY screen, kind, src, dst"
  sources: crypto_links
  sink_dataset: crypto_screen_links
  on_signal: job.dataset.produced
  when: "$signal.dataset == crypto_links"
  enabled: true
