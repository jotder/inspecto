job:
  name: crypto_hack_trace_alerts
  type: alert.evaluate
  description: "Evaluates the Alert Rules each time the crypto_hack_trace_counts Job produces its Dataset, so crypto_deposit_traced_to_hack sees the new counts without anyone pressing Evaluate. On a build without Alert Rules (Basic) the rule is not armed and this Job finds nothing to evaluate."
  on_signal: job.dataset.produced
  when: "$signal.dataset == crypto_hack_trace_counts"
  enabled: true
