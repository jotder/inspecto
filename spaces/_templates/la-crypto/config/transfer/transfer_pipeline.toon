name: transfer
active: true
description: "Crypto laundering Link Analysis showcase - One row per on-chain transfer: from and to address, amount and asset (SYC, or the stable token SUSD for merchant payments; both invented), and when. One file per month (TRANSFER_YYYYMM.csv); the next month is in data/staged. Synthetic; regenerate with tools/gen-la-crypto-data.py."

dirs:
  poll:       data/inbox/transfer
  database:   data/transfer/database
  backup:     data/transfer/backup
  temp:       data/transfer/temp
  errors:     data/transfer/errors
  quarantine: data/transfer/quarantine
  markers:    data/transfer/markers
  status_dir: data/transfer/status
  log_dir:    data/transfer/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: transfer_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
