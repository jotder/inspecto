raw:
  name: KYC_PERSON
  format: CSV
  fields[4]{name,selector,type}:
    person_id,"0",VARCHAR
    name,"1",VARCHAR
    birth_year,"2",INTEGER
    country,"3",VARCHAR
mapping:
  canonicalName: kyc_person
  rawName: KYC_PERSON
  fields[4]:
    - name: person_id
      from: person_id
      fn: keep
    - name: name
      from: name
      fn: keep
    - name: birth_year
      from: birth_year
      fn: keep
    - name: country
      from: country
      fn: keep
