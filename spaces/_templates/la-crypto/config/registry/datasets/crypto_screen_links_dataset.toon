  dst,string,CRYPTO_ENTITY
  kind,string,
  ts,timestamp,
  amount,number,
  event_date,date,
  via,string,
  screen,string,
defaultLinkMapping:
  from: src
  to: dst
  kind: kind
  primaryTime: ts
  primaryMeasure: amount
