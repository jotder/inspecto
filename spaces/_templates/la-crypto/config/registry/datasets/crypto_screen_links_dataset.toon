physicalRef: crypto_screen_links
description: "Crypto laundering Link Analysis showcase - Derived from crypto_links each time it is produced, for the three saved views: the links each screen selects, tagged in screen (peel_chain, mixer_hop, converging_cash_out). A link selected by two screens appears once in each. Same columns as crypto_links plus screen. Synthetic."
eventDate: event_date
primaryEntityType: crypto_entity
columns[8]{name,type,classification}:
