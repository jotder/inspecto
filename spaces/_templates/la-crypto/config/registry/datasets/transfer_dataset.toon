physicalRef: transfer/database
description: "Crypto laundering Link Analysis showcase - One row per on-chain transfer: from and to address, amount and asset (SYC, or the stable token SUSD for merchant payments; both invented), and when. One file per month (TRANSFER_YYYYMM.csv); the next month is in data/staged. Landed by the transfer Pipeline. Synthetic."
eventDate: tx_at
columns[6]{name,type,classification}:
  tx_id,string,
  from_address,string,
  to_address,string,
  amount,number,
  asset,string,
  tx_at,timestamp,
