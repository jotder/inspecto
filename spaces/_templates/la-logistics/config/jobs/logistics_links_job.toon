job:
  name: logistics_links
  type: sql.template
  description: "Folds the cargo feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via), one row per pair. Every trip-side link carries the load in via: route, goods, value, high_value (Y at 100 000 or more), arrived (Y when the destination warehouse scanned it in) and lost (the loss type, or N). drove: a driver to a trip (ts = departure, amount = value; via adds the co-driver and the driver's trips and losses over the whole period, as driver or co-driver); co_drove: the second driver of a two-driver team to the trip; scanned_by: a trip to the warehouse employee who scanned its load out onto the truck (via adds the warehouse, the shift - early 06-14, late 14-22, night 22-06 - and the scanner's outbound scans, night scans and losses); stopped_at: a trip to a place on the road where it stood 20 minutes or more (amount = minutes; via adds the place type, whether it was the trip's last GPS stop, and the place's long stops, high-value long stops and lost trips; shorter stops are fuel and traffic and stay in the stop Dataset); carried_by: a trip to its carrier (via adds the carrier's age in days at departure, insured, and how many GPS stops the trip sent); lost: a trip to its loss report (ts = reported; via adds the loss type and the hours from departure to the report); same_phone: two parties whose phone numbers match once written as digits - a carrier to a driver, or two drivers (via names both numbers as given, the driver's carrier, when the driver left and the driver's losses). Ids say what an endpoint is: DRV- driver, TR- trip (its shipment is SH- with the same number), EMP- warehouse employee, PL- place on the road, CAR- carrier, LR- loss report. Runs after every Pipeline commit, and every 5 minutes as well: a commit that lands while a run is in flight is skipped, not queued (JOB-SIGNAL-OVERLAP-SKIP-1), so the cron catches up the last landing."
  sql: "WITH sh AS (SELECT shipment_id, goods, CAST(value AS DOUBLE) AS value FROM shipment), t AS (SELECT trip_id, shipment_id, nullif(trim(driver_id), '') AS drv, nullif(trim(co_driver_id), '') AS co, nullif(trim(carrier_id), '') AS car, route, CAST(depart_at AS TIMESTAMP) AS dep, CAST(arrive_at AS TIMESTAMP) AS arr FROM trip), lr AS (SELECT loss_id, shipment_id, CAST(reported_at AS TIMESTAMP) AS rep, loss_type FROM loss_report), sc AS (SELECT shipment_id, nullif(trim(warehouse_id), '') AS wh, scan_type, CAST(scanned_at AS TIMESTAMP) AS sat, nullif(trim(employee_id), '') AS emp FROM warehouse_scan), arrv AS (SELECT DISTINCT shipment_id FROM sc WHERE scan_type = 'arrived'), tl AS (SELECT t.*, sh.goods, sh.value, CASE WHEN sh.value >= 100000 THEN 'Y' ELSE 'N' END AS hv, lr.loss_id, lr.rep, lr.loss_type, arrv.shipment_id IS NOT NULL AS got FROM t JOIN sh USING (shipment_id) LEFT JOIN lr USING (shipment_id) LEFT JOIN arrv USING (shipment_id)), ev AS (SELECT trip_id, 'route:' || route || '|goods:' || goods || '|value:' || CAST(round(value) AS BIGINT) || '|high_value:' || hv || '|arrived:' || CASE WHEN got THEN 'Y' ELSE 'N' END || '|lost:' || coalesce(loss_type, 'N') AS e FROM tl), crew AS (SELECT drv AS p, trip_id, loss_id FROM tl WHERE drv IS NOT NULL UNION ALL SELECT co AS p, trip_id, loss_id FROM tl WHERE co IS NOT NULL), cs AS (SELECT p, count(DISTINCT trip_id) AS trips, count(DISTINCT loss_id) AS losses FROM crew GROUP BY p), dr AS (SELECT tl.drv AS src, tl.trip_id AS dst, 'drove' AS kind, tl.dep AS ts, tl.value AS amount, ev.e || '|co_driver:' || coalesce(tl.co, '') || '|driver_trips:' || cs.trips || '|driver_losses:' || cs.losses AS via FROM tl JOIN ev USING (trip_id) JOIN cs ON cs.p = tl.drv), cd AS (SELECT tl.co AS src, tl.trip_id AS dst, 'co_drove' AS kind, tl.dep AS ts, tl.value AS amount, ev.e || '|driver:' || coalesce(tl.drv, '') || '|driver_trips:' || cs.trips || '|driver_losses:' || cs.losses AS via FROM tl JOIN ev USING (trip_id) JOIN cs ON cs.p = tl.co), ob AS (SELECT shipment_id, wh, sat, emp FROM sc WHERE scan_type = 'outbound' AND emp IS NOT NULL), es AS (SELECT ob.emp, count(*) AS n, count(*) FILTER (WHERE hour(ob.sat) >= 22 OR hour(ob.sat) < 6) AS night, count(lr.loss_id) AS losses FROM ob LEFT JOIN lr USING (shipment_id) GROUP BY ob.emp), sb AS (SELECT tl.trip_id AS src, ob.emp AS dst, 'scanned_by' AS kind, ob.sat AS ts, tl.value AS amount, 'scan:outbound|warehouse:' || coalesce(ob.wh, '') || '|shift:' || CASE WHEN hour(ob.sat) >= 22 OR hour(ob.sat) < 6 THEN 'night' WHEN hour(ob.sat) >= 14 THEN 'late' ELSE 'early' END || '|' || ev.e || '|scanner_outbound:' || es.n || '|scanner_night:' || es.night || '|scanner_losses:' || es.losses AS via FROM ob JOIN tl USING (shipment_id) JOIN ev USING (trip_id) JOIN es USING (emp)), st AS (SELECT trip_id, place_id, CAST(start_at AS TIMESTAMP) AS sat, CAST(minutes AS DOUBLE) AS mins FROM stop), lastst AS (SELECT trip_id, max(sat) AS last FROM st GROUP BY trip_id), ls AS (SELECT trip_id, place_id, min(sat) AS sat, max(sat) AS lat, sum(mins) AS mins FROM st WHERE mins >= 20 GROUP BY trip_id, place_id), ps AS (SELECT ls.place_id, count(*) AS long_stops, count(*) FILTER (WHERE tl.hv = 'Y') AS hv_stops, count(tl.loss_id) AS lost FROM ls JOIN tl USING (trip_id) GROUP BY ls.place_id), sa AS (SELECT ls.trip_id AS src, ls.place_id AS dst, 'stopped_at' AS kind, ls.sat AS ts, ls.mins AS amount, 'minutes:' || CAST(ls.mins AS BIGINT) || '|place_type:' || coalesce(pl.place_type, '') || '|last_stop:' || CASE WHEN ls.lat = lastst.last THEN 'Y' ELSE 'N' END || '|' || ev.e || '|place_long_stops:' || ps.long_stops || '|place_high_value_long_stops:' || ps.hv_stops || '|place_lost_trips:' || ps.lost AS via FROM ls JOIN ev USING (trip_id) JOIN ps USING (place_id) JOIN lastst USING (trip_id) LEFT JOIN place pl USING (place_id)), car AS (SELECT carrier_id, CAST(registered_at AS TIMESTAMP) AS reg, insured FROM carrier), ns AS (SELECT trip_id, count(*) AS n FROM st GROUP BY trip_id), cb AS (SELECT tl.trip_id AS src, tl.car AS dst, 'carried_by' AS kind, tl.dep AS ts, tl.value AS amount, ev.e || '|carrier_age_days:' || coalesce(CAST(date_diff('second', car.reg, tl.dep) // 86400 AS VARCHAR), '') || '|insured:' || coalesce(car.insured, '') || '|gps_stops:' || coalesce(ns.n, 0) AS via FROM tl JOIN ev USING (trip_id) LEFT JOIN car ON car.carrier_id = tl.car LEFT JOIN ns USING (trip_id) WHERE tl.car IS NOT NULL), lo AS (SELECT tl.trip_id AS src, tl.loss_id AS dst, 'lost' AS kind, tl.rep AS ts, tl.value AS amount, 'loss_type:' || tl.loss_type || '|' || ev.e || '|reported_hours_after_departure:' || date_diff('hour', tl.dep, tl.rep) AS via FROM tl JOIN ev USING (trip_id) WHERE tl.loss_id IS NOT NULL), ph AS (SELECT carrier_id AS id, 'carrier' AS who, phone FROM carrier UNION ALL SELECT driver_id AS id, 'driver' AS who, phone FROM driver), pd AS (SELECT id, who, phone, regexp_replace(coalesce(phone, ''), '[^0-9]', '', 'g') AS d FROM ph), pn AS (SELECT id, who, phone, CASE WHEN d LIKE '44%' THEN '0' || substr(d, 3) ELSE d END AS num FROM pd WHERE d <> ''), sp AS (SELECT a.id AS src, b.id AS dst, 'same_phone' AS kind, coalesce(car.reg, TIMESTAMP '2025-10-01 00:00:00') AS ts, 1.0 AS amount, 'phone:' || a.num || '|src_phone:' || a.phone || '|dst_phone:' || b.phone || '|dst_carrier:' || coalesce(dv.carrier_id, '') || '|dst_left_on:' || coalesce(CAST(dv.left_on AS VARCHAR), '') || '|dst_driver_losses:' || coalesce(cs.losses, 0) AS via FROM pn a JOIN pn b ON a.num = b.num AND a.id <> b.id AND (a.who = 'carrier' AND b.who = 'driver' OR a.who = b.who AND a.id < b.id) LEFT JOIN car ON car.carrier_id = a.id LEFT JOIN driver dv ON dv.driver_id = b.id LEFT JOIN cs ON cs.p = b.id), links AS (SELECT * FROM dr UNION ALL SELECT * FROM cd UNION ALL SELECT * FROM sb UNION ALL SELECT * FROM sa UNION ALL SELECT * FROM cb UNION ALL SELECT * FROM lo UNION ALL SELECT * FROM sp) SELECT src, dst, kind, ts, round(amount, 2) AS amount, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: carrier,driver,place,shipment,trip,stop,warehouse_scan,loss_report
  sink_dataset: logistics_links
  on_signal: pipeline.commit
  cron: "*/5 * * * *"
  enabled: true
