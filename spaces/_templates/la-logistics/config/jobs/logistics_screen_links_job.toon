job:
  name: logistics_screen_links
  type: sql.template
  description: "Derived from logistics_links each time it is produced: the three screens a cargo-security team runs, each a small slice of the link Dataset, tagged in the column screen so a saved view reads one screen and stays under the canvas's 1 000 nodes. inside_job: every driver, co-driver and outbound scanner on 2 or more lost trips, with those trips and their loss reports. stop_hotspot: every place where 3 or more lost trips stood 20 minutes or more, with every trip that stood there that long and the loss reports of the lost ones. new_carrier: every high-value trip (100 000 or more) given to a carrier under 60 days old, with its loss report if it was lost, the carrier's same_phone links, and the lost trips of any driver whose phone the carrier shares."
  sql: "WITH l AS (SELECT * FROM logistics_links), lt AS (SELECT src AS trip FROM l WHERE kind = 'lost'), crew AS (SELECT src AS p, dst AS trip FROM l WHERE kind IN ('drove', 'co_drove') AND dst IN (SELECT trip FROM lt) UNION ALL SELECT dst AS p, src AS trip FROM l WHERE kind = 'scanned_by' AND src IN (SELECT trip FROM lt)), rep AS (SELECT p FROM crew GROUP BY p HAVING count(DISTINCT trip) >= 2), ij AS (SELECT * FROM l WHERE kind IN ('drove', 'co_drove') AND src IN (SELECT p FROM rep) AND dst IN (SELECT trip FROM lt) UNION ALL SELECT * FROM l WHERE kind = 'scanned_by' AND dst IN (SELECT p FROM rep) AND src IN (SELECT trip FROM lt)), ij_lost AS (SELECT * FROM l WHERE kind = 'lost' AND src IN (SELECT CASE WHEN kind = 'scanned_by' THEN src ELSE dst END FROM ij)), inside AS (SELECT *, 'inside_job' AS screen FROM (SELECT * FROM ij UNION SELECT * FROM ij_lost)), ls AS (SELECT * FROM l WHERE kind = 'stopped_at'), hot AS (SELECT dst FROM ls WHERE src IN (SELECT trip FROM lt) GROUP BY dst HAVING count(DISTINCT src) >= 3), hs AS (SELECT * FROM ls WHERE dst IN (SELECT dst FROM hot)), hs_lost AS (SELECT * FROM l WHERE kind = 'lost' AND src IN (SELECT src FROM hs)), hotspot AS (SELECT *, 'stop_hotspot' AS screen FROM (SELECT * FROM hs UNION SELECT * FROM hs_lost)), nc AS (SELECT * FROM l WHERE kind = 'carried_by' AND via LIKE '%|high_value:Y|%' AND TRY_CAST(regexp_extract(via, 'carrier_age_days:([0-9]+)', 1) AS INTEGER) < 60), nc_lost AS (SELECT * FROM l WHERE kind = 'lost' AND src IN (SELECT src FROM nc)), nc_phone AS (SELECT * FROM l WHERE kind = 'same_phone' AND src IN (SELECT dst FROM nc)), nc_crew AS (SELECT * FROM l WHERE kind IN ('drove', 'co_drove') AND src IN (SELECT dst FROM nc_phone) AND dst IN (SELECT trip FROM lt)), nc_crew_lost AS (SELECT * FROM l WHERE kind = 'lost' AND src IN (SELECT dst FROM nc_crew)), newc AS (SELECT *, 'new_carrier' AS screen FROM (SELECT * FROM nc UNION SELECT * FROM nc_lost UNION SELECT * FROM nc_phone UNION SELECT * FROM nc_crew UNION SELECT * FROM nc_crew_lost)), links AS (SELECT * FROM inside UNION ALL SELECT * FROM hotspot UNION ALL SELECT * FROM newc) SELECT src, dst, kind, ts, amount, event_date, via, screen FROM links ORDER BY screen, kind, src, dst"
  sources: logistics_links
  sink_dataset: logistics_screen_links
  on_signal: job.dataset.produced
  when: "$signal.dataset == logistics_links"
  enabled: true
