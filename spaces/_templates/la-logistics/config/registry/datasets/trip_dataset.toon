physicalRef: trip/database
description: "Logistics cargo theft Link Analysis showcase - One row per trip (one per shipment): driver, co-driver for a two-driver team, vehicle (blank for a few), carrier, route (origin-destination city), departure and arrival (blank when the truck never got there). One file per month of departure (TRIP_YYYYMM.csv); the next month is in data/staged. Landed by the trip Pipeline. Synthetic."
eventDate: depart_at
primaryEntityType: trip
columns[9]{name,type,classification}:
  trip_id,string,TRIP
  shipment_id,string,SHIPMENT
  driver_id,string,DRIVER
  co_driver_id,string,DRIVER
  vehicle,string,VEHICLE
  carrier_id,string,CARRIER
  route,string,
  depart_at,timestamp,
  arrive_at,timestamp,
defaultLinkMapping:
  from: driver_id
  to: shipment_id
  primaryTime: depart_at
