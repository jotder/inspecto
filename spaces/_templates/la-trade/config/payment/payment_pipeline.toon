name: payment
active: true
description: "Trade-based money-laundering Link Analysis showcase - One row per payment between company accounts: amount, time and the trade it settles (trade_ref, blank for payments that settle no trade). One file per month (PAYMENT_YYYYMM.csv), October 2026 staged. Synthetic; regenerate with tools/gen-la-trade-data.py."

dirs:
  poll:       data/inbox/payment
  database:   data/payment/database
  backup:     data/payment/backup
  temp:       data/payment/temp
  errors:     data/payment/errors
  quarantine: data/payment/quarantine
  markers:    data/payment/markers
  status_dir: data/payment/status
  log_dir:    data/payment/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: payment_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
