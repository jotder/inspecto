job:
  name: trade_links
  type: sql.template
  description: "Folds the seven trade feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via, flag), one row per pair. traded_with: the beneficiary (exporter) to the applicant (importer), amount = trade value summed, via = trade count, HS codes, the highest unit price as a multiple of the month's reference median and the trades over price_ratio_alert times it; on_vessel: a shipper to the vessel on its bills of lading (amount = B/Ls); shipped_in: a shipper to a container (amount = B/Ls, via = consignees and the box's relays and shippers); directed_by: a company to its director; registered_at: a company to its upper-cased registered address; paid: the company that owns the paying account to the company that owns the receiving one (amount = payments summed). flag: price_over_reference (traded_with, a unit price over price_ratio_alert times the reference); vessel_elsewhere (traded_with and on_vessel, a bill of lading whose vessel was, on the B/L date, not in the B/L's port of loading by vessel_position: each B/L is checked against its own vessel, so a transhipment's two legs both pass); transhipment (a trade carried on two vessels); relayed (shipped_in, a box whose consignee ships it on at least min_relays times); many_shippers (shipped_in, a box carried for min_box_shippers or more shippers); shared_address (registered_at, min_shared_address or more companies at the address). Runs after every Pipeline commit and every 5 minutes."
  sql: "WITH co AS (SELECT company_id, max(reg_address) AS addr, max(account_id) AS acct, min(incorporated_at) AS inc FROM company GROUP BY company_id), pr AS (SELECT hs_code, month, max(median_unit_price) AS ref FROM price_reference GROUP BY hs_code, month), vp AS (SELECT vessel, pos_date, max(port_or_area) AS port_or_area FROM vessel_position GROUP BY vessel, pos_date), bl AS (SELECT b.bl_id, b.trade_id, b.vessel, b.container, b.shipper, b.consignee, b.port_from, b.bl_date, p.port_or_area AS vessel_at, coalesce(p.port_or_area <> b.port_from, false) AS elsewhere FROM bill_of_lading b LEFT JOIN vp p ON p.vessel = b.vessel AND p.pos_date = b.bl_date), leg AS (SELECT trade_id, bool_or(elsewhere) AS elsewhere, count(DISTINCT vessel) > 1 AS transhipped FROM bl GROUP BY trade_id), tr AS (SELECT t.trade_id, t.applicant, t.beneficiary, t.hs_code, t.value, t.ship_date, t.unit_price / nullif(r.ref, 0) AS x_ref, coalesce(l.elsewhere, false) AS elsewhere, coalesce(l.transhipped, false) AS transhipped FROM trade t LEFT JOIN pr r ON r.hs_code = t.hs_code AND r.month = strftime(t.ship_date, '%Y-%m') LEFT JOIN leg l ON l.trade_id = t.trade_id), tw AS (SELECT beneficiary AS src, applicant AS dst, 'traded_with' AS kind, CAST(min(ship_date) AS TIMESTAMP) AS ts, CAST(sum(value) AS DOUBLE) AS amount, 'trades:' || CAST(count(*) AS VARCHAR) || '|hs:' || string_agg(DISTINCT hs_code, ',' ORDER BY hs_code) || '|max_x_reference:' || coalesce(CAST(round(max(x_ref), 2) AS VARCHAR), '') || '|over_reference:' || coalesce(string_agg(CASE WHEN x_ref > CAST($price_ratio_alert AS DOUBLE) THEN trade_id END, ',' ORDER BY trade_id), '') || '|bl_vessel_elsewhere:' || coalesce(string_agg(CASE WHEN elsewhere THEN trade_id END, ',' ORDER BY trade_id), '') AS via, concat_ws(',', CASE WHEN max(x_ref) > CAST($price_ratio_alert AS DOUBLE) THEN 'price_over_reference' END, CASE WHEN bool_or(elsewhere) THEN 'vessel_elsewhere' END, CASE WHEN bool_or(transhipped) THEN 'transhipment' END) AS flag FROM tr WHERE coalesce(applicant, '') <> '' AND coalesce(beneficiary, '') <> '' GROUP BY beneficiary, applicant), ov AS (SELECT b.shipper AS src, b.vessel AS dst, 'on_vessel' AS kind, CAST(min(b.bl_date) AS TIMESTAMP) AS ts, CAST(count(*) AS DOUBLE) AS amount, 'bls:' || CAST(count(*) AS VARCHAR) || '|elsewhere:' || coalesce(string_agg(CASE WHEN b.elsewhere THEN b.bl_id || ' on ' || CAST(b.bl_date AS VARCHAR) || ' loading at ' || b.port_from || ' while the vessel was at ' || b.vessel_at END, '; ' ORDER BY b.bl_id), '') AS via, concat_ws(',', CASE WHEN bool_or(b.elsewhere) THEN 'vessel_elsewhere' END, CASE WHEN bool_or(l.transhipped) THEN 'transhipment' END) AS flag FROM bl b JOIN leg l ON l.trade_id = b.trade_id WHERE coalesce(b.shipper, '') <> '' AND coalesce(b.vessel, '') <> '' GROUP BY b.shipper, b.vessel), seq AS (SELECT container, shipper, lag(consignee) OVER (PARTITION BY container ORDER BY bl_date, bl_id) AS prev FROM bill_of_lading WHERE coalesce(container, '') <> ''), box AS (SELECT container, count(*) FILTER (WHERE shipper = prev) AS relays, count(DISTINCT shipper) AS shippers FROM seq GROUP BY container), si AS (SELECT b.shipper AS src, b.container AS dst, 'shipped_in' AS kind, CAST(min(b.bl_date) AS TIMESTAMP) AS ts, CAST(count(*) AS DOUBLE) AS amount, 'bls:' || CAST(count(*) AS VARCHAR) || '|consignees:' || string_agg(DISTINCT b.consignee, ',' ORDER BY b.consignee) || '|box_relays:' || CAST(max(x.relays) AS VARCHAR) || '|box_shippers:' || CAST(max(x.shippers) AS VARCHAR) AS via, CASE WHEN max(x.relays) >= CAST($min_relays AS INTEGER) THEN 'relayed' WHEN max(x.shippers) >= CAST($min_box_shippers AS INTEGER) THEN 'many_shippers' ELSE '' END AS flag FROM bill_of_lading b JOIN box x ON x.container = b.container WHERE coalesce(b.shipper, '') <> '' GROUP BY b.shipper, b.container), db AS (SELECT d.company_id AS src, d.person_id AS dst, 'directed_by' AS kind, CAST(coalesce(min(c.inc), DATE '2025-10-01') AS TIMESTAMP) AS ts, CAST(0 AS DOUBLE) AS amount, 'name:' || coalesce(max(d.person_name), '') AS via, '' AS flag FROM director d LEFT JOIN co c ON c.company_id = d.company_id WHERE coalesce(d.company_id, '') <> '' AND coalesce(d.person_id, '') <> '' GROUP BY d.company_id, d.person_id), ad AS (SELECT company_id, upper(trim(addr)) AS a, inc FROM co WHERE coalesce(trim(addr), '') <> ''), adn AS (SELECT a, count(*) AS n FROM ad GROUP BY a), ra AS (SELECT ad.company_id AS src, ad.a AS dst, 'registered_at' AS kind, CAST(coalesce(ad.inc, DATE '2025-10-01') AS TIMESTAMP) AS ts, CAST(0 AS DOUBLE) AS amount, 'companies_at_address:' || CAST(n.n AS VARCHAR) || '|incorporated:' || coalesce(CAST(ad.inc AS VARCHAR), '') AS via, CASE WHEN n.n >= CAST($min_shared_address AS INTEGER) THEN 'shared_address' ELSE '' END AS flag FROM ad JOIN adn n ON n.a = ad.a), acc AS (SELECT acct, min(company_id) AS company_id FROM co WHERE coalesce(acct, '') <> '' GROUP BY acct), pd AS (SELECT coalesce(f.company_id, p.from_account) AS src, coalesce(t.company_id, p.to_account) AS dst, 'paid' AS kind, min(p.paid_at) AS ts, CAST(sum(p.amount) AS DOUBLE) AS amount, 'payments:' || CAST(count(*) AS VARCHAR) || '|settling_trades:' || CAST(count(*) FILTER (WHERE coalesce(p.trade_ref, '') <> '') AS VARCHAR) || '|last:' || CAST(CAST(max(p.paid_at) AS DATE) AS VARCHAR) AS via, '' AS flag FROM payment p LEFT JOIN acc f ON f.acct = p.from_account LEFT JOIN acc t ON t.acct = p.to_account WHERE coalesce(p.from_account, '') <> '' AND coalesce(p.to_account, '') <> '' GROUP BY 1, 2), links AS (SELECT * FROM tw UNION ALL SELECT * FROM ov UNION ALL SELECT * FROM si UNION ALL SELECT * FROM db UNION ALL SELECT * FROM ra UNION ALL SELECT * FROM pd) SELECT src, dst, kind, ts, round(amount, 2) AS amount, CAST(ts AS DATE) AS event_date, via, flag FROM links ORDER BY kind, src, dst"
  sources: company,director,trade,bill_of_lading,vessel_position,price_reference,payment
  sink_dataset: trade_links
  on_signal: pipeline.commit
  cron: "*/5 * * * *"
  price_ratio_alert: "3.0"
  min_relays: "2"
  min_box_shippers: "6"
  min_shared_address: "5"
  enabled: true
