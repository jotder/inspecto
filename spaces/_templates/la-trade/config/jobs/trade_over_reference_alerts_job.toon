job:
  name: trade_over_reference_alerts
  type: alert.evaluate
  description: "Evaluates the Alert Rules each time the trade_over_reference_counts Job produces its Dataset, so trade_unit_price_over_reference sees the new counts without anyone pressing Evaluate. On a build without Alert Rules (Basic) the rule is not armed and this Job finds nothing to evaluate."
  on_signal: job.dataset.produced
  when: "$signal.dataset == trade_over_reference_counts"
  enabled: true
