name: price_reference
active: true
description: "Trade-based money-laundering Link Analysis showcase - One row per HS code per month: the reference median unit price (real HS codes, invented prices). One file per month (PRICE_REFERENCE_YYYYMM.csv), October 2026 staged. Synthetic; regenerate with tools/gen-la-trade-data.py."

dirs:
  poll:       data/inbox/price_reference
  database:   data/price_reference/database
  backup:     data/price_reference/backup
  temp:       data/price_reference/temp
  errors:     data/price_reference/errors
  quarantine: data/price_reference/quarantine
  markers:    data/price_reference/markers
  status_dir: data/price_reference/status
  log_dir:    data/price_reference/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: price_reference_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
