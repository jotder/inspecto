physicalRef: payment/database
description: "Trade-based money-laundering Link Analysis showcase - One row per payment between company accounts: amount, time and the trade it settles (trade_ref, blank for payments that settle no trade). Landed by the payment Pipeline. Synthetic."
eventDate: paid_at
columns[6]{name,type,classification}:
  payment_id,string,
  from_account,string,
  to_account,string,
  amount,number,
  paid_at,timestamp,
  trade_ref,string,
