name: claims_accidents_map
description: "GEO scene 0 - every accident of the claims corpus as a point, coloured by whether a police report exists. Synthetic placements, city-level."
sourceId: dataset
display: markers
query:
  projection:
    datasetId: claims_accidents_dataset
    latCol: lat
    lonCol: lon
    entityCol: accident_id
    entityIdCol: accident_id
    kindCol: report_status
camera:
  center[2]: -2,52.5
  zoom: 5.5
