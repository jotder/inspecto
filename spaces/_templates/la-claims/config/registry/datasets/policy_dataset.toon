physicalRef: policy/database
description: "Insurance-claims Link Analysis showcase - One row per policy: holder, broker, inception day, premium, the bank account the premium is paid from (blank when paid by card) and the holder's address. The early-claim story reads inception against the claim loss date; the ghost-broker story reads payer_account and holder_address. Landed by the policy Pipeline. Synthetic."
eventDate: inception_date
primaryEntityType: policy
columns[7]{name,type,classification}:
  policy_id,string,POLICY
  holder_id,string,PARTY
  broker_id,string,BROKER
  inception_date,date,
  premium,number,
  payer_account,string,PII
  holder_address,string,PII
defaultLinkMapping:
  from: holder_id
  to: policy_id
  primaryTime: inception_date
  primaryMeasure: premium
owner: siu.analyst
shares[5]{subjectType,subjectId,access}:
  user,admin,view
  user,siu.analyst,view
  user,siu.manager,view
  user,partner.reviewer,view
  user,outsider,view
