name: claims_shared_identity
description: "Claims shared identity - only links that carry NO money (amount 0): shared phone, shared address, same accident (a parts supplier whose parts were all fitted also carries 0 and is left out). The ring shares 4 phones and 3 addresses; the benign family of four shares one of each and stays its own small group. Run Cliques and Triangle count."
sourceId: entity-projection
layout: force
query:
  projection:
    datasetId: claims_links_dataset
    sourceCol: src
    targetCol: dst
    linkKindCol: kind
    attrCols[2]: ts,via
  filter:
    kind: group
    op: AND
    items[2]{kind,field,operator,value}:
      condition,amount,"<=","0"
      condition,kind,"!=","supplied_parts"
view:
  legend: true
  workingSet: true
  plugins:
    minimap: true
    hulls: true
    behaviors[1]: hover-activate
