name: claim
active: true
description: "Insurance-claims Link Analysis showcase - One row per insurance claim: policy, accident, loss and report dates, claim amount and the garage, clinic and lawyer on it (blank when none), plus the lawyer who referred the clinic. One extract (CLAIM_20260930.csv). Synthetic; regenerate with tools/gen-la-claims-data.py."

dirs:
  poll:       data/inbox/claim
  database:   data/claim/database
  backup:     data/claim/backup
  temp:       data/claim/temp
  errors:     data/claim/errors
  quarantine: data/claim/quarantine
  markers:    data/claim/markers
  status_dir: data/claim/status
  log_dir:    data/claim/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: claim_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
