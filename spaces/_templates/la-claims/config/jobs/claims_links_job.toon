job:
  name: claims_links
  type: sql.template
  description: "Folds the claim feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via). claimed_with: two people on one claim; same_accident: people on different claims of one accident; serviced_by / represented_by: a person to the garage, clinic or lawyer on their claim (amount = that provider's bills on those claims); referred_to: the lawyer who referred a claim to a clinic; shares_phone / shares_address: two people holding one phone number (digits only) or address. Shared values are materialised ONCE per pair (src < dst) and named in via; a blank or placeholder phone or address (empty, a number of one repeated digit, UNKNOWN, N/A) is no evidence and makes no link; a value held by more than max_key_parties people is common, not evidence. supplied_parts: a parts supplier to a garage it invoiced parts through (amount = the value of the parts the garage did NOT fit; 0 when every part was fitted). paid_by: a policyholder to a bank account that pays the premiums of two or more policies (amount = those premiums; via names the policies); an account paying one policy is no evidence and makes no link. Snapshot rebuild; docs/okf/product/solution-pack/la-claims/admin-guide-showcase-runbook.md."
  sql: "WITH ev AS (SELECT c.claim_id, c.claim_amount, c.garage_id, c.clinic_id, c.lawyer_id, c.referred_by, c.accident_id, a.accident_at AS t FROM claim c JOIN accident_location a ON a.accident_id = c.accident_id), pc AS (SELECT DISTINCT p.claim_id, p.party_id, e.t, e.claim_amount, e.accident_id FROM claim_party p JOIN ev e ON e.claim_id = p.claim_id WHERE p.party_id IS NOT NULL AND p.party_id <> ''), cw AS (SELECT x.party_id AS src, y.party_id AS dst, 'claimed_with' AS kind, min(x.t) AS ts, sum(x.claim_amount) AS amount, string_agg(DISTINCT 'claim:' || x.claim_id, '|' ORDER BY 'claim:' || x.claim_id) AS via FROM pc x JOIN pc y ON y.claim_id = x.claim_id AND x.party_id < y.party_id GROUP BY x.party_id, y.party_id), sa AS (SELECT x.party_id AS src, y.party_id AS dst, 'same_accident' AS kind, min(x.t) AS ts, 0.0 AS amount, string_agg(DISTINCT 'accident:' || x.accident_id, '|' ORDER BY 'accident:' || x.accident_id) AS via FROM pc x JOIN pc y ON y.accident_id = x.accident_id AND y.claim_id <> x.claim_id AND x.party_id < y.party_id GROUP BY x.party_id, y.party_id), bill AS (SELECT claim_id, provider_id, sum(amount) AS amount FROM provider_bill GROUP BY claim_id, provider_id), prov AS (SELECT claim_id, garage_id AS provider_id, 'serviced_by' AS kind FROM claim WHERE garage_id IS NOT NULL AND garage_id <> '' UNION ALL SELECT claim_id, clinic_id, 'serviced_by' FROM claim WHERE clinic_id IS NOT NULL AND clinic_id <> '' UNION ALL SELECT claim_id, lawyer_id, 'represented_by' FROM claim WHERE lawyer_id IS NOT NULL AND lawyer_id <> ''), pv AS (SELECT q.party_id AS src, v.provider_id AS dst, v.kind, min(q.t) AS ts, coalesce(sum(b.amount), 0.0) AS amount, string_agg(DISTINCT 'claim:' || q.claim_id, '|' ORDER BY 'claim:' || q.claim_id) AS via FROM pc q JOIN prov v ON v.claim_id = q.claim_id LEFT JOIN bill b ON b.claim_id = v.claim_id AND b.provider_id = v.provider_id GROUP BY q.party_id, v.provider_id, v.kind), rf AS (SELECT e.referred_by AS src, e.clinic_id AS dst, 'referred_to' AS kind, min(e.t) AS ts, coalesce(sum(b.amount), 0.0) AS amount, string_agg(DISTINCT 'claim:' || e.claim_id, '|' ORDER BY 'claim:' || e.claim_id) AS via FROM ev e LEFT JOIN bill b ON b.claim_id = e.claim_id AND b.provider_id = e.clinic_id WHERE e.referred_by IS NOT NULL AND e.referred_by <> '' AND e.clinic_id IS NOT NULL AND e.clinic_id <> '' GROUP BY e.referred_by, e.clinic_id), first_seen AS (SELECT party_id, min(t) AS t FROM pc GROUP BY party_id), keyed AS (SELECT DISTINCT party_id, 'shares_phone' AS kind, 'phone:' || regexp_replace(phone, '[^0-9]', '', 'g') AS k FROM claim_party WHERE party_id IS NOT NULL AND length(regexp_replace(coalesce(phone, ''), '[^0-9]', '', 'g')) >= 7 AND replace(regexp_replace(phone, '[^0-9]', '', 'g'), substr(regexp_replace(phone, '[^0-9]', '', 'g'), 1, 1), '') <> '' UNION SELECT DISTINCT party_id, 'shares_address', 'address:' || lower(trim(address)) FROM claim_party WHERE party_id IS NOT NULL AND address IS NOT NULL AND trim(address) <> '' AND upper(trim(address)) NOT IN ('UNKNOWN', 'N/A', 'NA', 'NONE', 'TBC')), usable AS (SELECT kind, k FROM keyed GROUP BY kind, k HAVING count(*) BETWEEN 2 AND CAST($max_key_parties AS INTEGER)), sh AS (SELECT x.party_id AS src, y.party_id AS dst, x.kind, max(greatest(fx.t, fy.t)) AS ts, 0.0 AS amount, string_agg(DISTINCT x.k, '|' ORDER BY x.k) AS via FROM keyed x JOIN usable u ON u.kind = x.kind AND u.k = x.k JOIN keyed y ON y.kind = x.kind AND y.k = x.k AND x.party_id < y.party_id JOIN first_seen fx ON fx.party_id = x.party_id JOIN first_seen fy ON fy.party_id = y.party_id GROUP BY x.party_id, y.party_id, x.kind), sp AS (SELECT r.supplier_id AS src, r.garage_id AS dst, 'supplied_parts' AS kind, min(e.t) AS ts, coalesce(sum(CASE WHEN upper(trim(r.fitted)) = 'N' THEN r.amount END), 0.0) AS amount, string_agg(DISTINCT 'claim:' || r.claim_id, '|' ORDER BY 'claim:' || r.claim_id) AS via FROM repair_invoice r JOIN ev e ON e.claim_id = r.claim_id WHERE r.supplier_id IS NOT NULL AND r.supplier_id <> '' AND r.garage_id IS NOT NULL AND r.garage_id <> '' GROUP BY r.supplier_id, r.garage_id), payer AS (SELECT trim(payer_account) AS acct FROM policy WHERE payer_account IS NOT NULL AND trim(payer_account) <> '' GROUP BY trim(payer_account) HAVING count(DISTINCT policy_id) >= 2), pb AS (SELECT p.holder_id AS src, a.acct AS dst, 'paid_by' AS kind, CAST(min(p.inception_date) AS TIMESTAMP) AS ts, sum(p.premium) AS amount, string_agg(DISTINCT 'policy:' || p.policy_id, '|' ORDER BY 'policy:' || p.policy_id) AS via FROM policy p JOIN payer a ON a.acct = trim(p.payer_account) WHERE p.holder_id IS NOT NULL AND p.holder_id <> '' GROUP BY p.holder_id, a.acct), links AS (SELECT * FROM cw UNION ALL SELECT * FROM sa UNION ALL SELECT * FROM pv UNION ALL SELECT * FROM rf UNION ALL SELECT * FROM sh UNION ALL SELECT * FROM sp UNION ALL SELECT * FROM pb) SELECT src, dst, kind, ts, round(amount, 2) AS amount, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: claim,claim_party,provider_bill,accident_location,repair_invoice,policy
  sink_dataset: claims_links
  cron: "*/10 * * * *"
  max_key_parties: "8"
  enabled: true
