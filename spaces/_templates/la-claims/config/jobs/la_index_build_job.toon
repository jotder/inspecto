job:
  name: la_index_build
  type: la.index.build
  description: "Builds or appends the Link Analysis Index of claims_links each time the claims_links Job produces its Dataset. The first build is a full build (allow_full), every later one is the append the server itself advises. The owner is stamped with whoever creates the Space."
  on_signal: job.dataset.produced
  when: "$signal.dataset == claims_links"
  dataset: claims_links_dataset
  source_col: src
  target_col: dst
  kind_col: kind
  time_col: ts
  owner: admin
  allow_full: "true"
  timeout_seconds: "600"
  wait_seconds: "300"
