job:
  name: mfs_screen_links
  type: sql.template
  description: "Derived from mfs_links each time it is produced: the three fraud screens an MFS team runs, each a small slice of the link Dataset, tagged in the column screen so a saved view reads one screen and stays under the canvas's 1 000 nodes. swap_burst: every SIM swap by a staff login that made 15 or more swaps within 10 days, with the handsets those wallets were first used on within 24 hours after the swap, the wallets or merchants they first paid within 24 hours after it, and where any payee of two or more of those wallets cashed out. split_deposit: every cash-in at an agent that handled 1 000 or more cash-ins averaging under 25, with the agent's registration of those wallets. merchant_quick_pay: every payment to a merchant paid by 30 or more wallets within 60 minutes after a cash-in, the merchant's settlement account, and the agents where those quick payers were cashed in before paying."
  sql: "WITH l AS (SELECT * FROM mfs_links), sb AS (SELECT * FROM l WHERE kind = 'swapped_by' AND TRY_CAST(regexp_extract(via, 'login_max_swaps_10d:([0-9]+)', 1) AS INTEGER) >= 15), sb_lo AS (SELECT DISTINCT x.* FROM l x JOIN sb ON x.src = sb.src WHERE x.kind = 'logged_in_on' AND x.ts >= sb.ts AND x.ts < sb.ts + INTERVAL 24 HOUR), sb_pd AS (SELECT DISTINCT x.* FROM l x JOIN sb ON x.src = sb.src WHERE x.kind = 'paid' AND x.ts >= sb.ts AND x.ts < sb.ts + INTERVAL 24 HOUR), mu AS (SELECT dst FROM sb_pd GROUP BY dst HAVING count(DISTINCT src) >= 2), sb_co AS (SELECT * FROM l WHERE kind = 'cashed_out_at' AND src IN (SELECT dst FROM mu)), sw AS (SELECT *, 'swap_burst' AS screen FROM (SELECT * FROM sb UNION ALL SELECT * FROM sb_lo UNION ALL SELECT * FROM sb_pd UNION ALL SELECT * FROM sb_co)), ci AS (SELECT *, TRY_CAST(regexp_extract(via, 'cash_ins:([0-9]+)', 1) AS INTEGER) AS n FROM l WHERE kind = 'cashed_in_at'), sa AS (SELECT dst FROM ci GROUP BY dst HAVING sum(n) >= 1000 AND sum(amount) / sum(n) < 25), sd_ci AS (SELECT * EXCLUDE (n) FROM ci WHERE dst IN (SELECT dst FROM sa)), sd_rb AS (SELECT * FROM l WHERE kind = 'registered_by' AND dst IN (SELECT dst FROM sa) AND src IN (SELECT src FROM sd_ci)), sd AS (SELECT *, 'split_deposit' AS screen FROM (SELECT * FROM sd_ci UNION ALL SELECT * FROM sd_rb)), pm AS (SELECT *, TRY_CAST(regexp_extract(via, 'within_60m_of_cash_in:([0-9]+)', 1) AS INTEGER) AS q FROM l WHERE kind = 'paid' AND dst LIKE 'MR-%'), qm AS (SELECT dst FROM pm WHERE q >= 1 GROUP BY dst HAVING count(*) >= 30), qp_pd AS (SELECT * EXCLUDE (q) FROM pm WHERE dst IN (SELECT dst FROM qm)), qp_st AS (SELECT * FROM l WHERE kind = 'settles_to' AND src IN (SELECT dst FROM qm)), qp_ci AS (SELECT * EXCLUDE (n) FROM ci WHERE TRY_CAST(regexp_extract(via, 'merchant_pay_within_60m:([0-9]+)', 1) AS INTEGER) >= 1 AND src IN (SELECT src FROM pm WHERE q >= 1 AND dst IN (SELECT dst FROM qm))), qp AS (SELECT *, 'merchant_quick_pay' AS screen FROM (SELECT * FROM qp_pd UNION ALL SELECT * FROM qp_st UNION ALL SELECT * FROM qp_ci)), links AS (SELECT * FROM sw UNION ALL SELECT * FROM sd UNION ALL SELECT * FROM qp) SELECT src, dst, kind, ts, amount, event_date, via, screen FROM links ORDER BY screen, kind, src, dst"
  sources: mfs_links
  sink_dataset: mfs_screen_links
  on_signal: job.dataset.produced
  when: "$signal.dataset == mfs_links"
  enabled: true
