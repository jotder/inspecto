job:
  name: mfs_swap_drain_alerts
  type: alert.evaluate
  description: "Evaluates the Alert Rules each time the mfs_swap_drain_counts Job produces its Dataset, so mfs_wallet_drained_after_sim_swap sees the new counts without anyone pressing Evaluate. On a build without Alert Rules (Basic) the rule is not armed and this Job finds nothing to evaluate."
  on_signal: job.dataset.produced
  when: "$signal.dataset == mfs_swap_drain_counts"
  enabled: true
