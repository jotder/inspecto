job:
  name: mfs_links
  type: sql.template
  description: "Folds the mobile financial services feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via), one row per pair. registered_by: a wallet to the agent that registered it (ts = opened; amount = cashed in at that agent; via = KYC level and the wallet's cash-ins, those at its registrar, cash-outs, P2P sent and received, merchant payments); paid: a wallet to the wallet or merchant it paid, P2P or merchant_pay (amount = total; via = payments, first and last, and within_60m_of_cash_in - how many were made within 60 minutes after the wallet was cashed in); cashed_in_at and cashed_out_at: a wallet to the agent (via = count, days, per day, average, and for a cash-in how many merchant payments followed within 60 minutes - merchant_pay_within_60m); logged_in_on: a wallet to a handset (amount = days used; via = first and last); swapped_by: a wallet to the staff login that swapped its SIM (amount = paid out within 2 hours; via = MSISDN, channel, swaps, new_device_minutes - minutes from the swap to the first login on a handset the wallet never used - out_within_2h, and login_max_swaps_10d, the most swaps that login made in any 10 days); settles_to: a merchant to its settlement bank account (amount = settled; via = category, the date it opened, settlements and settlement days). Ids say what an endpoint is: WL- wallet, A- agent, MR- merchant, HS- handset, S- staff login, BA- bank account. Runs after every Pipeline commit, and every 5 minutes as well: a commit that lands while a run is in flight is skipped, not queued (JOB-SIGNAL-OVERLAP-SKIP-1), so the cron catches up the last landing."
  sql: "WITH t AS (SELECT txn_id, from_id, to_id, type, CAST(amount AS DOUBLE) AS amt, CAST(txn_at AS TIMESTAMP) AS tat FROM wallet_txn), ci AS (SELECT txn_id, to_id AS w, from_id AS ag, amt, tat FROM t WHERE type = 'cash_in'), mp AS (SELECT txn_id, from_id AS w, to_id AS m, tat FROM t WHERE type = 'merchant_pay'), q AS (SELECT mp.txn_id, mp.w, mp.m, arg_max(ci.ag, ci.tat) AS ag FROM mp JOIN ci ON ci.w = mp.w AND ci.tat <= mp.tat AND ci.tat > mp.tat - INTERVAL 60 MINUTE GROUP BY mp.txn_id, mp.w, mp.m), qm AS (SELECT w, m, count(*) AS n FROM q GROUP BY w, m), qa AS (SELECT w, ag, count(*) AS n FROM q GROUP BY w, ag), pd AS (SELECT t.from_id AS src, t.to_id AS dst, 'paid' AS kind, min(t.tat) AS ts, sum(t.amt) AS amount, 'type:' || min(t.type) || '|payments:' || count(*) || '|first:' || strftime(min(t.tat), '%Y-%m-%d %H:%M') || '|last:' || strftime(max(t.tat), '%Y-%m-%d') || '|within_60m_of_cash_in:' || coalesce(min(qm.n), 0) AS via FROM t LEFT JOIN qm ON qm.w = t.from_id AND qm.m = t.to_id WHERE t.type IN ('p2p', 'merchant_pay') GROUP BY t.from_id, t.to_id), cil AS (SELECT ci.w AS src, ci.ag AS dst, 'cashed_in_at' AS kind, min(ci.tat) AS ts, sum(ci.amt) AS amount, 'cash_ins:' || count(*) || '|days:' || count(DISTINCT CAST(ci.tat AS DATE)) || '|per_day:' || round(count(*) / count(DISTINCT CAST(ci.tat AS DATE)), 1) || '|average:' || round(sum(ci.amt) / count(*), 2) || '|merchant_pay_within_60m:' || coalesce(min(qa.n), 0) AS via FROM ci LEFT JOIN qa ON qa.w = ci.w AND qa.ag = ci.ag GROUP BY ci.w, ci.ag), col AS (SELECT from_id AS src, to_id AS dst, 'cashed_out_at' AS kind, min(tat) AS ts, sum(amt) AS amount, 'cash_outs:' || count(*) || '|first:' || strftime(min(tat), '%Y-%m-%d') || '|last:' || strftime(max(tat), '%Y-%m-%d') AS via FROM t WHERE type = 'cash_out' GROUP BY from_id, to_id), wa AS (SELECT w, count(*) FILTER (WHERE type = 'cash_in' AND d = 'in') AS cin, count(*) FILTER (WHERE type = 'cash_out' AND d = 'out') AS cout, count(*) FILTER (WHERE type = 'p2p' AND d = 'out') AS p2ps, count(*) FILTER (WHERE type = 'p2p' AND d = 'in') AS p2pr, count(*) FILTER (WHERE type = 'merchant_pay' AND d = 'out') AS mps FROM (SELECT to_id AS w, type, 'in' AS d FROM t UNION ALL SELECT from_id AS w, type, 'out' AS d FROM t) GROUP BY w), reg AS (SELECT w, ag, count(*) AS n, sum(amt) AS amt FROM ci GROUP BY w, ag), rb AS (SELECT wl.wallet_id AS src, trim(wl.registered_by_agent) AS dst, 'registered_by' AS kind, CAST(wl.opened_at AS TIMESTAMP) AS ts, coalesce(reg.amt, 0) AS amount, 'kyc:' || wl.kyc_level || '|cash_ins:' || coalesce(wa.cin, 0) || '|cash_ins_at_registrar:' || coalesce(reg.n, 0) || '|cash_outs:' || coalesce(wa.cout, 0) || '|p2p_sent:' || coalesce(wa.p2ps, 0) || '|p2p_received:' || coalesce(wa.p2pr, 0) || '|merchant_pays:' || coalesce(wa.mps, 0) AS via FROM wallet wl LEFT JOIN wa ON wa.w = wl.wallet_id LEFT JOIN reg ON reg.w = wl.wallet_id AND reg.ag = trim(wl.registered_by_agent) WHERE nullif(trim(wl.registered_by_agent), '') IS NOT NULL), lo AS (SELECT wallet_id AS src, device_id AS dst, 'logged_in_on' AS kind, min(CAST(login_at AS TIMESTAMP)) AS ts, count(*) AS amount, 'login_days:' || count(*) || '|first:' || strftime(min(CAST(login_at AS TIMESTAMP)), '%Y-%m-%d %H:%M') || '|last:' || strftime(max(CAST(login_at AS TIMESTAMP)), '%Y-%m-%d') AS via FROM device_login GROUP BY wallet_id, device_id), se AS (SELECT w.wallet_id AS w, s.msisdn, CAST(s.event_at AS TIMESTAMP) AS sat, s.channel, s.staff_login AS lg FROM sim_event s JOIN wallet w ON w.msisdn = s.msisdn WHERE s.event = 'sim_swap'), bu AS (SELECT lg, max(n10) AS mx FROM (SELECT lg, count(*) OVER (PARTITION BY lg ORDER BY sat RANGE BETWEEN CURRENT ROW AND INTERVAL 10 DAYS FOLLOWING) AS n10 FROM se) GROUP BY lg), nd AS (SELECT se.w, se.lg, se.sat, min(lo.ts) AS nf FROM se JOIN lo ON lo.src = se.w AND lo.ts >= se.sat GROUP BY se.w, se.lg, se.sat), o2 AS (SELECT se.w, se.lg, se.sat, sum(t.amt) AS amt, count(*) AS n FROM se JOIN t ON t.from_id = se.w AND t.type IN ('p2p', 'merchant_pay', 'cash_out') AND t.tat >= se.sat AND t.tat <= se.sat + INTERVAL 2 HOUR GROUP BY se.w, se.lg, se.sat), ev AS (SELECT se.w, se.lg, se.sat, se.msisdn, se.channel, date_diff('minute', se.sat, nd.nf) AS ndm, coalesce(o2.amt, 0) AS oa, coalesce(o2.n, 0) AS onn FROM se LEFT JOIN nd ON nd.w = se.w AND nd.lg = se.lg AND nd.sat = se.sat LEFT JOIN o2 ON o2.w = se.w AND o2.lg = se.lg AND o2.sat = se.sat), sw AS (SELECT ev.w AS src, ev.lg AS dst, 'swapped_by' AS kind, min(ev.sat) AS ts, max(ev.oa) AS amount, 'msisdn:' || min(ev.msisdn) || '|channel:' || min(ev.channel) || '|swaps:' || count(*) || '|new_device_minutes:' || coalesce(CAST(min(ev.ndm) AS VARCHAR), '') || '|out_within_2h:' || CAST(round(max(ev.oa), 2) AS VARCHAR) || '|out_txns_within_2h:' || max(ev.onn) || '|login_max_swaps_10d:' || min(bu.mx) AS via FROM ev JOIN bu ON bu.lg = ev.lg GROUP BY ev.w, ev.lg), st AS (SELECT m.merchant_id AS src, m.settlement_account AS dst, 'settles_to' AS kind, coalesce(min(t.tat), CAST(m.opened_at AS TIMESTAMP)) AS ts, coalesce(sum(t.amt), 0) AS amount, 'category:' || m.category || '|merchant_opened:' || strftime(CAST(m.opened_at AS DATE), '%Y-%m-%d') || '|settlements:' || count(t.txn_id) || '|settlement_days:' || count(DISTINCT CAST(t.tat AS DATE)) || '|first_settlement:' || coalesce(strftime(min(t.tat), '%Y-%m-%d'), '') AS via FROM merchant m LEFT JOIN t ON t.from_id = m.merchant_id AND t.type = 'settlement' GROUP BY m.merchant_id, m.settlement_account, m.category, m.opened_at), links AS (SELECT * FROM rb UNION ALL SELECT * FROM pd UNION ALL SELECT * FROM cil UNION ALL SELECT * FROM col UNION ALL SELECT * FROM lo UNION ALL SELECT * FROM sw UNION ALL SELECT * FROM st) SELECT src, dst, kind, ts, round(amount, 2) AS amount, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: wallet,agent,merchant,wallet_txn,sim_event,device_login
  sink_dataset: mfs_links
  on_signal: pipeline.commit
  cron: "*/5 * * * *"
  enabled: true
