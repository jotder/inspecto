physicalRef: sim_event/database
description: "Mobile financial services fraud Link Analysis showcase - One row per SIM event on a wallet's number from the operator's SIM register: sim_swap (a new SIM for the same number) or port_out, when, the channel (store or call_centre) and the staff login that did it. One file per month (SIM_EVENT_YYYYMM.csv); the next month is in data/staged. Landed by the sim_event Pipeline. Synthetic."
eventDate: event_at
primaryEntityType: subscriber_number
columns[5]{name,type,classification}:
  msisdn,string,SUBSCRIBER_NUMBER
  event,string,
  event_at,timestamp,
  channel,string,
  staff_login,string,STAFF_LOGIN
defaultLinkMapping:
  from: staff_login
  to: msisdn
  kind: event
  primaryTime: event_at
