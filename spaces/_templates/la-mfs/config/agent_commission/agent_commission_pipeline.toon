name: agent_commission
active: true
description: "Mobile financial services fraud Link Analysis showcase - One row per agent and month: the cash-ins and cash-outs it handled and the commission it earned (0.40 a transaction up to 50, 0.80 up to 200, 1.50 above). One file per month (AGENT_COMMISSION_YYYYMM.csv); the next month is in data/staged. Synthetic; regenerate with tools/gen-la-mfs-data.py."

dirs:
  poll:       data/inbox/agent_commission
  database:   data/agent_commission/database
  backup:     data/agent_commission/backup
  temp:       data/agent_commission/temp
  errors:     data/agent_commission/errors
  quarantine: data/agent_commission/quarantine
  markers:    data/agent_commission/markers
  status_dir: data/agent_commission/status
  log_dir:    data/agent_commission/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: agent_commission_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
