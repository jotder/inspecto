name: wallet
active: true
description: "Mobile financial services fraud Link Analysis showcase - One row per wallet: its MSISDN, KYC level (1-3), when it was opened and the agent that registered it (blank when the customer registered in the app). One extract of every wallet opened by 2026-09-30 (WALLET_20260930.csv); the October openings are in data/staged. Synthetic; regenerate with tools/gen-la-mfs-data.py."

dirs:
  poll:       data/inbox/wallet
  database:   data/wallet/database
  backup:     data/wallet/backup
  temp:       data/wallet/temp
  errors:     data/wallet/errors
  quarantine: data/wallet/quarantine
  markers:    data/wallet/markers
  status_dir: data/wallet/status
  log_dir:    data/wallet/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: wallet_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
