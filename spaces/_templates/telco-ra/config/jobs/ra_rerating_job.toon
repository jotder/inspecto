job:
  name: ra_rerating
  type: sql.template
  sql: "WITH m AS (SELECT r.XDR_ID, r.EVENT_TS, r.EVENT_DATE, r.SUBSCRIBER_ID, r.PLAN, r.SERVICE, r.USAGE_UNITS, r.CHARGE, COUNT(t.RATE_PER_UNIT) AS TARIFF_ROWS, MIN(t.RATE_PER_UNIT) AS RATE FROM rated_usage r LEFT JOIN tariff t ON t.PLAN = r.PLAN AND t.SERVICE = r.SERVICE AND t.EFFECTIVE_FROM <= r.EVENT_TS AND (t.EFFECTIVE_TO IS NULL OR r.EVENT_TS < t.EFFECTIVE_TO) GROUP BY r.XDR_ID, r.EVENT_TS, r.EVENT_DATE, r.SUBSCRIBER_ID, r.PLAN, r.SERVICE, r.USAGE_UNITS, r.CHARGE), k AS (SELECT *, CASE WHEN TARIFF_ROWS = 1 THEN ROUND(USAGE_UNITS * RATE, 2) END AS EXPECTED_CHARGE, CASE WHEN TARIFF_ROWS = 0 THEN 'no_tariff' WHEN TARIFF_ROWS > 1 THEN 'ambiguous_tariff' WHEN ABS(ROUND(USAGE_UNITS * RATE, 2) - CHARGE) > CAST($tolerance AS DECIMAL(18,4)) THEN 'rate_mismatch' END AS REASON FROM m) SELECT XDR_ID AS ITEM_KEY, EVENT_DATE, EVENT_TS, SUBSCRIBER_ID, PLAN, SERVICE, USAGE_UNITS, TARIFF_ROWS, CHARGE AS ACTUAL_CHARGE, EXPECTED_CHARGE, EXPECTED_CHARGE - CHARGE AS LEAKAGE_AMOUNT, REASON, CASE WHEN REASON = 'rate_mismatch' THEN 'leakage' ELSE 'data_quality' END AS FINDING, 'ra_rerating' AS CONTROL FROM k WHERE REASON IS NOT NULL"
  sources: "rated_usage,tariff"
  sink_dataset: ra_rerating_exceptions
  tolerance: "0.02"
  cron: "10 5 * * *"
  enabled: true
