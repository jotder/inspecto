job:
  name: ra_rollforward
  type: sql.template
  sql: "WITH b AS (SELECT *, LAG(CLOSING) OVER (PARTITION BY SUBSCRIBER_ID ORDER BY BALANCE_DATE) AS PREV_CLOSING FROM balance_ledger), k AS (SELECT *, CASE WHEN OPENING IS NULL OR TOPUPS IS NULL OR ADJUSTMENTS IS NULL OR USAGE_DEBITS IS NULL OR CLOSING IS NULL THEN 'null_value' WHEN ABS(OPENING + TOPUPS + ADJUSTMENTS - USAGE_DEBITS - CLOSING) > CAST($tolerance AS DECIMAL(18,4)) THEN 'movement' WHEN PREV_CLOSING IS NOT NULL AND ABS(OPENING - PREV_CLOSING) > CAST($tolerance AS DECIMAL(18,4)) THEN 'continuity' END AS REASON FROM b) SELECT SUBSCRIBER_ID || '|' || CAST(BALANCE_DATE AS VARCHAR) AS ITEM_KEY, BALANCE_DATE AS EVENT_DATE, SUBSCRIBER_ID, PREV_CLOSING, OPENING, TOPUPS, ADJUSTMENTS, USAGE_DEBITS, CLOSING, CASE REASON WHEN 'movement' THEN OPENING + TOPUPS + ADJUSTMENTS - USAGE_DEBITS - CLOSING WHEN 'continuity' THEN PREV_CLOSING - OPENING END AS LEAKAGE_AMOUNT, REASON, CASE WHEN REASON = 'null_value' THEN 'data_quality' ELSE 'leakage' END AS FINDING, 'ra_rollforward' AS CONTROL FROM k WHERE REASON IS NOT NULL"
  sources: balance_ledger
  sink_dataset: ra_rollforward_findings
  tolerance: "0.05"
  on_signal: job.run.completed
  when: "$signal.job == ra_rerating && $signal.outcome == SUCCESS"
  enabled: true
