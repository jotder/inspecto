job:
  name: ra_settlement
  type: sql.template
  sql: "WITH ours AS (SELECT x.PARTNER, x.EVENT_DATE, SUM(CAST(CEIL(x.USAGE_UNITS / 60.0) AS BIGINT)) AS OUR_MINUTES FROM switch_xdr x WHERE x.SERVICE = 'VOICE' AND x.PARTNER IS NOT NULL AND x.PARTNER <> '' GROUP BY x.PARTNER, x.EVENT_DATE), priced AS (SELECT o.PARTNER, o.EVENT_DATE, o.OUR_MINUTES, ROUND(o.OUR_MINUTES * r.RATE_PER_MIN, 2) AS EXPECTED_AMOUNT FROM ours o LEFT JOIN ic_rates r ON r.PARTNER = o.PARTNER), stm AS (SELECT s.STATEMENT_ID, s.PARTNER, s.EVENT_DATE, s.MINUTES, s.AMOUNT, r.RATE_PER_MIN IS NOT NULL AS KNOWN_PARTNER FROM ic_statement s LEFT JOIN ic_rates r ON r.PARTNER = s.PARTNER), j AS (SELECT COALESCE(s.PARTNER, p.PARTNER) AS PARTNER, COALESCE(s.EVENT_DATE, p.EVENT_DATE) AS EVENT_DATE, s.STATEMENT_ID, s.KNOWN_PARTNER, s.MINUTES AS BILLED_MINUTES, s.AMOUNT AS BILLED_AMOUNT, p.OUR_MINUTES, p.EXPECTED_AMOUNT FROM stm s FULL OUTER JOIN priced p ON p.PARTNER = s.PARTNER AND p.EVENT_DATE = s.EVENT_DATE), k AS (SELECT *, CASE WHEN STATEMENT_ID IS NULL THEN 'missing_statement' WHEN NOT KNOWN_PARTNER THEN 'unknown_partner' WHEN EXPECTED_AMOUNT IS NULL THEN 'no_traffic' WHEN ABS(BILLED_AMOUNT - EXPECTED_AMOUNT) > EXPECTED_AMOUNT * CAST($tolerance_pct AS DECIMAL(18,4)) / 100 THEN 'amount_mismatch' END AS REASON FROM j) SELECT PARTNER || '|' || CAST(EVENT_DATE AS VARCHAR) AS ITEM_KEY, EVENT_DATE, PARTNER, STATEMENT_ID, OUR_MINUTES, BILLED_MINUTES, EXPECTED_AMOUNT, BILLED_AMOUNT, CASE REASON WHEN 'amount_mismatch' THEN BILLED_AMOUNT - EXPECTED_AMOUNT WHEN 'missing_statement' THEN NULL ELSE BILLED_AMOUNT END AS LEAKAGE_AMOUNT, REASON, CASE WHEN REASON = 'missing_statement' THEN 'data_quality' ELSE 'leakage' END AS FINDING, 'ra_settlement' AS CONTROL FROM k WHERE REASON IS NOT NULL"
  sources: "ic_statement,ic_rates,switch_xdr"
  sink_dataset: ra_settlement_exceptions
  tolerance_pct: "1.0"
  cron: "20 5 * * *"
  enabled: true
