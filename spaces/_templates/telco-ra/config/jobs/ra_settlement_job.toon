job:
  name: ra_settlement
  type: sql.template
  sql: "WITH ours AS (SELECT PARTNER, EVENT_DATE, SUM(CEIL(USAGE_UNITS / 60.0)) AS OUR_MINUTES FROM switch_xdr WHERE SERVICE = 'VOICE' AND PARTNER IS NOT NULL AND PARTNER <> '' GROUP BY PARTNER, EVENT_DATE), priced AS (SELECT s.PARTNER, s.EVENT_DATE, s.MINUTES AS BILLED_MINUTES, s.AMOUNT AS BILLED_AMOUNT, o.OUR_MINUTES, ROUND(COALESCE(o.OUR_MINUTES, 0) * r.RATE_PER_MIN, 2) AS EXPECTED_AMOUNT FROM ic_statement s LEFT JOIN ic_rates r ON r.PARTNER = s.PARTNER LEFT JOIN ours o ON o.PARTNER = s.PARTNER AND o.EVENT_DATE = s.EVENT_DATE) SELECT PARTNER || '|' || CAST(EVENT_DATE AS VARCHAR) AS ITEM_KEY, EVENT_DATE, PARTNER, OUR_MINUTES, BILLED_MINUTES, EXPECTED_AMOUNT, BILLED_AMOUNT, ROUND(BILLED_AMOUNT - EXPECTED_AMOUNT, 2) AS LEAKAGE_AMOUNT, 'ra_settlement' AS CONTROL FROM priced WHERE EXPECTED_AMOUNT IS NULL OR ABS(BILLED_AMOUNT - EXPECTED_AMOUNT) > EXPECTED_AMOUNT * CAST($tolerance_pct AS DOUBLE) / 100"
  sources: "ic_statement,ic_rates,switch_xdr"
  sink_dataset: ra_settlement_exceptions
  tolerance_pct: "1.0"
  cron: "20 5 * * *"
  enabled: true
