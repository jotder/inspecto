job:
  name: ra_leakage
  type: sql.template
  sql: "SELECT CONTROL, EVENT_DATE, ITEM_KEY, REASON, FINDING, LEAKAGE_AMOUNT FROM ra_rerating_findings WHERE FINDING = 'leakage' UNION ALL SELECT CONTROL, EVENT_DATE, ITEM_KEY, REASON, FINDING, LEAKAGE_AMOUNT FROM ra_rollforward_findings WHERE FINDING = 'leakage' UNION ALL SELECT CONTROL, EVENT_DATE, ITEM_KEY, REASON, FINDING, LEAKAGE_AMOUNT FROM ra_settlement_findings WHERE FINDING = 'leakage'"
  sources: "ra_rerating_findings,ra_rollforward_findings,ra_settlement_findings"
  sink_dataset: ra_leakage
  cron: "30 5 * * *"
  enabled: true
