partitionKey: EVENT_DATE
raw:
  name: RATED_USAGE
  format: CSV
  fields[8]{name,selector,type,description,unit,classification}:
    XDR_ID,"0","VARCHAR","Usage record identifier","","INTERNAL"
    EVENT_TS,"1","TIMESTAMP","Call start - the instant the tariff is chosen at","","INTERNAL"
    EVENT_DATE,"2","DATE","Business date of the event","","INTERNAL"
    SUBSCRIBER_ID,"3","VARCHAR","Subscriber (synthetic)","","INTERNAL"
    PLAN,"4","VARCHAR","Tariff plan applied","","INTERNAL"
    SERVICE,"5","VARCHAR","VOICE, SMS or DATA","","INTERNAL"
    USAGE_UNITS,"6","BIGINT","Units rated","count","INTERNAL"
    CHARGE,"7","DECIMAL(18,4)","Rated charge","USD","INTERNAL"
mapping:
  canonicalName: rated_usage
  rawName: RATED_USAGE
  fields[8]:
    - name: XDR_ID
      from: XDR_ID
      fn: keep
    - name: EVENT_TS
      from: EVENT_TS
      fn: keep
    - name: EVENT_DATE
      from: EVENT_DATE
      fn: keep
    - name: SUBSCRIBER_ID
      from: SUBSCRIBER_ID
      fn: keep
    - name: PLAN
      from: PLAN
      fn: keep
    - name: SERVICE
      from: SERVICE
      fn: keep
    - name: USAGE_UNITS
      from: USAGE_UNITS
      fn: keep
    - name: CHARGE
      from: CHARGE
      fn: keep
