partitionKey: EVENT_DATE
raw:
  name: RATED_USAGE
  format: CSV
  fields[7]{name,selector,type,description,unit,classification}:
    XDR_ID,"0",VARCHAR,"Usage record identifier","","INTERNAL"
    EVENT_DATE,"1",DATE,"Business date of the event","","INTERNAL"
    SUBSCRIBER_ID,"2",VARCHAR,"Subscriber (synthetic)","","INTERNAL"
    PLAN,"3",VARCHAR,"Tariff plan applied","","INTERNAL"
    SERVICE,"4",VARCHAR,"VOICE, SMS or DATA","","INTERNAL"
    USAGE_UNITS,"5",BIGINT,"Units rated","count","INTERNAL"
    CHARGE,"6",DOUBLE,"Rated charge","USD","INTERNAL"
mapping:
  canonicalName: rated_usage
  rawName: RATED_USAGE
  fields[7]:
    - name: XDR_ID
      from: XDR_ID
      fn: keep
    - name: EVENT_DATE
      from: EVENT_DATE
      fn: keep
    - name: SUBSCRIBER_ID
      from: SUBSCRIBER_ID
      fn: keep
    - name: PLAN
      from: PLAN
      fn: keep
    - name: SERVICE
      from: SERVICE
      fn: keep
    - name: USAGE_UNITS
      from: USAGE_UNITS
      fn: keep
    - name: CHARGE
      from: CHARGE
      fn: keep
