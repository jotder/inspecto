partitionKey: EVENT_DATE
raw:
  name: MEDIATED_XDR
  format: CSV
  fields[5]{name,selector,type,description,unit,classification}:
    XDR_ID,"0",VARCHAR,"Usage record identifier","","INTERNAL"
    EVENT_DATE,"1",DATE,"Business date of the event","","INTERNAL"
    SUBSCRIBER_ID,"2",VARCHAR,"Subscriber (synthetic)","","INTERNAL"
    SERVICE,"3",VARCHAR,"VOICE, SMS or DATA","","INTERNAL"
    USAGE_UNITS,"4",BIGINT,"Units after mediation","count","INTERNAL"
mapping:
  canonicalName: mediated_xdr
  rawName: MEDIATED_XDR
  fields[5]:
    - name: XDR_ID
      from: XDR_ID
      fn: keep
    - name: EVENT_DATE
      from: EVENT_DATE
      fn: keep
    - name: SUBSCRIBER_ID
      from: SUBSCRIBER_ID
      fn: keep
    - name: SERVICE
      from: SERVICE
      fn: keep
    - name: USAGE_UNITS
      from: USAGE_UNITS
      fn: keep
