name: topup
active: true
description: "Telecom revenue assurance Link Analysis showcase - One row per prepaid top-up: subscriber, amount, when, the channel (retail, app or card) and, for a retail top-up, the point of sale. One file per month topped up (TOPUP_YYYYMM.csv); the next month is in data/staged. Synthetic; regenerate with tools/gen-la-telco-ra-data.py."

dirs:
  poll:       data/inbox/topup
  database:   data/topup/database
  backup:     data/topup/backup
  temp:       data/topup/temp
  errors:     data/topup/errors
  quarantine: data/topup/quarantine
  markers:    data/topup/markers
  status_dir: data/topup/status
  log_dir:    data/topup/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: topup_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
