name: dealer_commission_fraud
description: "Commission spikes - every SIM that earned its dealer an activation commission (activated and topped up) in a week when that dealer earned 50 or more, with the dealer, the activation device and the points of sale where the SIM was topped up (via on activated_by = plan, top-ups and days to the first, usage months, last usage). Two dealers spike: one near a university at the start of term, whose students keep topping up and using their SIMs, and one whose 400 SIMs were each topped up once at its own shop and never used again."
sourceId: entity-projection
layout: force
query:
  projection:
    datasetId: telco_ra_screen_links_dataset
    sourceCol: src
    targetCol: dst
    linkKindCol: kind
    attrCols[4]: ts,amount,via,screen
  filter:
    kind: group
    op: AND
    items[1]{kind,field,operator,value}:
      condition,screen,"=","commission_spike"
view:
  legend: true
  workingSet: true
  plugins:
    minimap: true
    hulls: true
    behaviors[1]: hover-activate
