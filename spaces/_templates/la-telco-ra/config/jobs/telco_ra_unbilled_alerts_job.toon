job:
  name: telco_ra_unbilled_alerts
  type: alert.evaluate
  description: "Evaluates the Alert Rules each time the telco_ra_unbilled_counts Job produces its Dataset, so telco_ra_usage_without_billing sees the new counts without anyone pressing Evaluate. On a build without Alert Rules (Basic) the rule is not armed and this Job finds nothing to evaluate."
  on_signal: job.dataset.produced
  when: "$signal.dataset == telco_ra_unbilled_counts"
  enabled: true
