job:
  name: telco_ra_screen_links
  type: sql.template
  description: "Derived from telco_ra_links each time it is produced: the three revenue-assurance screens a team runs, each a small slice of the link Dataset, tagged in the column screen so a saved view reads one screen and stays under the canvas's 1 000 nodes. unbilled_usage: every subscriber with network usage in 2 or more months that reached no billing record, with its dealer and activation device. commission_spike: every subscriber that earned a dealer its activation commission (activated and topped up at least once) in a week when that dealer earned 50 or more, with the dealer, the activation device and the points of sale where it was topped up. pbx_off_hours: every enterprise trunk's calls to a destination with 300 or more off-hours minutes (calls starting before 07:00 or from 21:00 or at a weekend), with the trunk's customer."
  sql: "WITH l AS (SELECT * FROM telco_ra_links), ub_ab AS (SELECT * FROM l WHERE kind = 'activated_by' AND TRY_CAST(regexp_extract(via, 'unbilled_months:([0-9]+)', 1) AS INTEGER) >= 2), ub_ao AS (SELECT * FROM l WHERE kind = 'activated_on' AND src IN (SELECT src FROM ub_ab)), ub AS (SELECT *, 'unbilled_usage' AS screen FROM (SELECT * FROM ub_ab UNION ALL SELECT * FROM ub_ao)), earn AS (SELECT *, date_trunc('week', ts) AS wk FROM l WHERE kind = 'activated_by' AND TRY_CAST(regexp_extract(via, 'topups:([0-9]+)', 1) AS INTEGER) >= 1), spike AS (SELECT dst, wk FROM earn GROUP BY dst, wk HAVING count(*) >= 50), cs_ab AS (SELECT earn.* EXCLUDE (wk) FROM earn JOIN spike USING (dst, wk)), cs_more AS (SELECT * FROM l WHERE kind IN ('activated_on', 'topped_up') AND src IN (SELECT src FROM cs_ab)), cs AS (SELECT *, 'commission_spike' AS screen FROM (SELECT * FROM cs_ab UNION ALL SELECT * FROM cs_more)), px_cc AS (SELECT * FROM l WHERE kind = 'called_country' AND TRY_CAST(regexp_extract(via, 'off_hours_minutes:([0-9]+)', 1) AS INTEGER) >= 300), px_tr AS (SELECT * FROM l WHERE kind = 'trunk_of' AND src IN (SELECT src FROM px_cc)), px AS (SELECT *, 'pbx_off_hours' AS screen FROM (SELECT * FROM px_cc UNION ALL SELECT * FROM px_tr)), links AS (SELECT * FROM ub UNION ALL SELECT * FROM cs UNION ALL SELECT * FROM px) SELECT src, dst, kind, ts, amount, event_date, via, screen FROM links ORDER BY screen, kind, src, dst"
  sources: telco_ra_links
  sink_dataset: telco_ra_screen_links
  on_signal: job.dataset.produced
  when: "$signal.dataset == telco_ra_links"
  enabled: true
