job:
  name: telco_ra_unbilled_counts
  type: sql.template
  description: "Runs each time the telco_ra_links Job produces its Dataset. One row of counts of usage without billing, a subscriber-month at a time (network_usage and billing_record are monthly): a month with network usage and no billing record for that subscriber, judged only once that month's billing file has landed, so a usage file that lands before its billing file is not read as unbilled. unbilled_subscribers: subscribers NOT on the known list (plan Internal test, the network test team's SIMs) with min_unbilled_months or more such months whose latest judged month is still unbilled - usage that keeps escaping billing. known_list_subscribers: the test SIMs with unbilled usage, which are expected and never counted. other_unbilled_subscribers: the rest with an unbilled month the rule does not count (a single dropped month, or a provisioning lag whose later months reached billing). The Alert Rule telco_ra_usage_without_billing reads it; no subscriber or dealer id leaves this Job, they are found in the unbilled_usage view."
  sql: "WITH s AS (SELECT msisdn, plan FROM subscriber), bp AS (SELECT DISTINCT CAST(period AS DATE) AS per FROM billing_record), u AS (SELECT msisdn, CAST(period AS DATE) AS per FROM network_usage GROUP BY ALL HAVING sum(CAST(minutes AS DOUBLE)) > 0 OR sum(CAST(mb AS DOUBLE)) > 0), b AS (SELECT DISTINCT msisdn, CAST(period AS DATE) AS per FROM billing_record), m AS (SELECT u.msisdn, u.per, b.msisdn IS NULL AS unbilled FROM u JOIN bp USING (per) LEFT JOIN b USING (msisdn, per)), p0 AS (SELECT m.msisdn, count(*) FILTER (WHERE m.unbilled) AS unbilled_months, arg_max(m.unbilled, m.per) AS still_unbilled, coalesce(any_value(s.plan) = 'Internal test', false) AS known FROM m LEFT JOIN s USING (msisdn) GROUP BY m.msisdn), p AS (SELECT *, NOT known AND still_unbilled AND unbilled_months >= CAST($min_unbilled_months AS INTEGER) AS counted FROM p0 WHERE unbilled_months > 0) SELECT (SELECT count(*) FROM p WHERE counted) AS unbilled_subscribers, (SELECT count(*) FROM p WHERE known) AS known_list_subscribers, (SELECT count(*) FROM p WHERE NOT counted AND NOT known) AS other_unbilled_subscribers"
  sources: subscriber,network_usage,billing_record
  sink_dataset: telco_ra_unbilled_counts
  on_signal: job.dataset.produced
  when: "$signal.dataset == telco_ra_links"
  min_unbilled_months: "2"
  enabled: true
