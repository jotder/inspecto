job:
  name: telco_ra_links
  type: sql.template
  description: "Folds the revenue-assurance feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via), one row per pair. activated_by: a subscriber (MSISDN) to the dealer that activated it (ts = activation, amount = topped up; via = plan, device, top-ups and days to the first, usage months and how many of them reached no billing record - unbilled_months, a month judged only once its billing file has landed, so a usage file that lands before its billing file is not read as unbilled - usage and billed minutes, usage MB and the last month used); activated_on: a subscriber to the dealer device it was activated on; topped_up: a subscriber to the retail point of sale where it was topped up (app and card top-ups have no point of sale); trunk_of: an enterprise trunk to its customer (amount = international minutes); called_country: a trunk to a destination - country and number type, CTRY-<country>-GEO, -MOB or -PRN for premium rate - (amount = minutes; via = days, minutes and the off-hours minutes, calls starting before 07:00 or from 21:00 or at a weekend, split into night and weekend). Ids say what an endpoint is: 9996... subscriber, DL- dealer, DEV- dealer device, POS- point of sale, TRK- trunk, ENT- enterprise customer, CTRY- destination. Runs after every Pipeline commit, and every 5 minutes as well: a commit that lands while a run is in flight is skipped, not queued (JOB-SIGNAL-OVERLAP-SKIP-1), so the cron catches up the last landing."
  sql: "WITH s AS (SELECT msisdn, nullif(trim(dealer_id), '') AS dealer, CAST(activated_at AS TIMESTAMP) AS act, plan, nullif(trim(activation_device), '') AS dev FROM subscriber), u AS (SELECT msisdn, CAST(period AS DATE) AS per, sum(CAST(minutes AS DOUBLE)) AS mins, sum(CAST(mb AS DOUBLE)) AS mb FROM network_usage GROUP BY ALL), b AS (SELECT msisdn, CAST(period AS DATE) AS per, sum(CAST(billed_minutes AS DOUBLE)) AS bmins FROM billing_record GROUP BY ALL), bp AS (SELECT DISTINCT CAST(period AS DATE) AS per FROM billing_record), ub AS (SELECT u.msisdn, count(*) AS usage_months, count(*) FILTER (WHERE b.msisdn IS NULL AND bp.per IS NOT NULL) AS unbilled_months, sum(u.mins) AS mins, sum(u.mb) AS mb, sum(coalesce(b.bmins, 0)) AS bmins, max(u.per) AS last_use FROM u LEFT JOIN b USING (msisdn, per) LEFT JOIN bp ON bp.per = u.per WHERE u.mins > 0 OR u.mb > 0 GROUP BY u.msisdn), t AS (SELECT msisdn, CAST(amount AS DOUBLE) AS amt, CAST(topped_up_at AS TIMESTAMP) AS tat, nullif(trim(pos_id), '') AS pos FROM topup), tt AS (SELECT msisdn, count(*) AS topups, sum(amt) AS topped, min(tat) AS first_at FROM t GROUP BY msisdn), ab AS (SELECT s.msisdn AS src, s.dealer AS dst, 'activated_by' AS kind, s.act AS ts, coalesce(tt.topped, 0) AS amount, 'plan:' || s.plan || '|device:' || coalesce(s.dev, '') || '|topups:' || coalesce(tt.topups, 0) || '|first_topup_days:' || coalesce(CAST(date_diff('day', CAST(s.act AS DATE), CAST(tt.first_at AS DATE)) AS VARCHAR), '') || '|usage_months:' || coalesce(ub.usage_months, 0) || '|unbilled_months:' || coalesce(ub.unbilled_months, 0) || '|usage_minutes:' || CAST(round(coalesce(ub.mins, 0)) AS BIGINT) || '|billed_minutes:' || CAST(round(coalesce(ub.bmins, 0)) AS BIGINT) || '|usage_mb:' || CAST(round(coalesce(ub.mb, 0)) AS BIGINT) || '|last_usage:' || coalesce(strftime(ub.last_use, '%Y-%m'), '') AS via FROM s LEFT JOIN tt USING (msisdn) LEFT JOIN ub USING (msisdn) WHERE s.dealer IS NOT NULL), ao AS (SELECT msisdn AS src, dev AS dst, 'activated_on' AS kind, act AS ts, 1.0 AS amount, 'dealer:' || coalesce(dealer, '') || '|plan:' || plan AS via FROM s WHERE dev IS NOT NULL), tu AS (SELECT msisdn AS src, pos AS dst, 'topped_up' AS kind, min(tat) AS ts, sum(amt) AS amount, 'topups:' || count(*) || '|first:' || strftime(min(tat), '%Y-%m-%d') || '|last:' || strftime(max(tat), '%Y-%m-%d') AS via FROM t WHERE pos IS NOT NULL GROUP BY msisdn, pos), tc AS (SELECT trunk_id, CAST(call_date AS DATE) AS d, destination_country AS c, number_type AS nt, CAST(minutes AS DOUBLE) AS m, CAST(start_hour AS INTEGER) AS h FROM trunk_call), cc AS (SELECT trunk_id AS src, 'CTRY-' || c || '-' || CASE nt WHEN 'premium' THEN 'PRN' WHEN 'mobile' THEN 'MOB' ELSE 'GEO' END AS dst, 'called_country' AS kind, CAST(min(d) AS TIMESTAMP) AS ts, sum(m) AS amount, 'number_type:' || min(nt) || '|days:' || count(DISTINCT d) || '|minutes:' || CAST(round(sum(m)) AS BIGINT) || '|off_hours_minutes:' || CAST(round(coalesce(sum(m) FILTER (WHERE h < 7 OR h >= 21 OR isodow(d) >= 6), 0)) AS BIGINT) || '|night_minutes:' || CAST(round(coalesce(sum(m) FILTER (WHERE h < 7 OR h >= 21), 0)) AS BIGINT) || '|weekend_minutes:' || CAST(round(coalesce(sum(m) FILTER (WHERE isodow(d) >= 6), 0)) AS BIGINT) AS via FROM tc GROUP BY trunk_id, c, nt), tm AS (SELECT src, sum(amount) AS mins FROM cc GROUP BY src), tr AS (SELECT e.trunk_id AS src, e.customer_id AS dst, 'trunk_of' AS kind, TIMESTAMP '2025-10-01 00:00:00' AS ts, coalesce(tm.mins, 0) AS amount, 'international_minutes:' || CAST(round(coalesce(tm.mins, 0)) AS BIGINT) AS via FROM enterprise_trunk e LEFT JOIN tm ON tm.src = e.trunk_id), links AS (SELECT * FROM ab UNION ALL SELECT * FROM ao UNION ALL SELECT * FROM tu UNION ALL SELECT * FROM cc UNION ALL SELECT * FROM tr) SELECT src, dst, kind, ts, round(amount, 2) AS amount, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: subscriber,network_usage,billing_record,topup,enterprise_trunk,trunk_call
  sink_dataset: telco_ra_links
  on_signal: pipeline.commit
  cron: "*/5 * * * *"
  enabled: true
