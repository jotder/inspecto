raw:
  name: CUSTODY
  format: CSV
  fields[4]{name,selector,type}:
    custody_id,"0",VARCHAR
    person_id,"1",VARCHAR
    arrested_at,"2",TIMESTAMP
    co_arrest_group,"3",VARCHAR
mapping:
  canonicalName: custody
  rawName: CUSTODY
  fields[4]:
    - name: custody_id
      from: custody_id
      fn: keep
    - name: person_id
      from: person_id
      fn: keep
    - name: arrested_at
      from: arrested_at
      fn: keep
    - name: co_arrest_group
      from: co_arrest_group
      fn: keep
