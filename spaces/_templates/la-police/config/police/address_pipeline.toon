name: address
active: true
description: "Police Link Analysis showcase - One row per address: invented street, district, city and a city-level invented location. One extract (ADDRESS_20261031.csv). Synthetic; regenerate with tools/gen-la-police-data.py."

dirs:
  poll:       data/inbox/address
  database:   data/address/database
  backup:     data/address/backup
  temp:       data/address/temp
  errors:     data/address/errors
  quarantine: data/address/quarantine
  markers:    data/address/markers
  status_dir: data/address/status
  log_dir:    data/address/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: address_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
