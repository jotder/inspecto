  rawName: DEALER_SALE
  fields[6]:
    - name: sale_id
      from: sale_id
      fn: keep
    - name: dealer_id
      from: dealer_id
      fn: keep
    - name: seller_person_id
      from: seller_person_id
      fn: keep
    - name: item_desc
