raw:
  name: PERSON
  format: CSV
  fields[5]{name,selector,type}:
    person_id,"0",VARCHAR
    name,"1",VARCHAR
    birth_year,"2",INTEGER
    address_id,"3",VARCHAR
    role_flags,"4",VARCHAR
mapping:
  canonicalName: person
  rawName: PERSON
  fields[5]:
    - name: person_id
      from: person_id
      fn: keep
    - name: name
      from: name
      fn: keep
    - name: birth_year
      from: birth_year
      fn: keep
    - name: address_id
      from: address_id
      fn: keep
    - name: role_flags
      from: role_flags
      fn: keep
