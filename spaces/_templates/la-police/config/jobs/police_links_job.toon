job:
  name: police_links
  type: sql.template
  description: "Folds the eleven police feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via). called: caller number to callee number (amount = calls, via = calls and seconds); co_arrested: two people in one co_arrest_group (stored once, src < dst); involved_in: a person to an incident (via = their roles); keeper_of: a keeper to a plate; seen_near: a plate read within 2 km and 30 minutes of an incident's window (amount = reads, via = cameras); lives_at: a person to an address; uses_number: a person to the handset number attributed to them; sold_item: a seller to a second-hand dealer (amount = sales); item_match: an incident to the seller of a dealer sale whose serial equals a serial stolen in it (via = serial, sale and dealer; a serial under 5 characters is no evidence). amount is the number of records behind each link; links with no time of their own (keeper_of, lives_at, uses_number) carry the start of the period, 2025-11-01. Snapshot rebuild."
  sql: "WITH cl AS (SELECT caller AS src, callee AS dst, 'called' AS kind, min(start_at) AS ts, count(*) AS amount, 'calls:' || count(*) || '|seconds:' || sum(duration_s) AS via FROM call_record WHERE caller IS NOT NULL AND caller <> '' AND callee IS NOT NULL AND callee <> '' GROUP BY caller, callee), ca AS (SELECT x.person_id AS src, y.person_id AS dst, 'co_arrested' AS kind, min(x.arrested_at) AS ts, count(DISTINCT x.co_arrest_group) AS amount, string_agg(DISTINCT 'custody:' || x.co_arrest_group, '|' ORDER BY 'custody:' || x.co_arrest_group) AS via FROM custody x JOIN custody y ON y.co_arrest_group = x.co_arrest_group AND x.person_id < y.person_id GROUP BY x.person_id, y.person_id), ii AS (SELECT p.person_id AS src, p.incident_id AS dst, 'involved_in' AS kind, min(i.start_at) AS ts, count(*) AS amount, string_agg(DISTINCT 'role:' || p.role, '|' ORDER BY 'role:' || p.role) AS via FROM incident_person p JOIN incident_report i ON i.incident_id = p.incident_id WHERE p.person_id IS NOT NULL AND p.person_id <> '' GROUP BY p.person_id, p.incident_id), ko AS (SELECT keeper_person_id AS src, plate AS dst, 'keeper_of' AS kind, TIMESTAMP '2025-11-01 00:00:00' AS ts, count(*) AS amount, 'vehicle:' || max(colour) || ' ' || max(make) AS via FROM vehicle WHERE keeper_person_id IS NOT NULL AND keeper_person_id <> '' GROUP BY keeper_person_id, plate), sn AS (SELECT r.plate AS src, i.incident_id AS dst, 'seen_near' AS kind, min(r.read_at) AS ts, count(*) AS amount, string_agg(DISTINCT 'camera:' || r.camera_id, '|' ORDER BY 'camera:' || r.camera_id) AS via FROM plate_read r JOIN incident_report i ON r.read_at BETWEEN i.start_at - INTERVAL 30 MINUTE AND i.end_at + INTERVAL 30 MINUTE WHERE 2 * 6371000 * asin(sqrt(power(sin(radians(i.lat - r.lat) / 2), 2) + cos(radians(r.lat)) * cos(radians(i.lat)) * power(sin(radians(i.lon - r.lon) / 2), 2))) <= 2000 GROUP BY r.plate, i.incident_id), la AS (SELECT person_id AS src, address_id AS dst, 'lives_at' AS kind, TIMESTAMP '2025-11-01 00:00:00' AS ts, count(*) AS amount, 'address:' || address_id AS via FROM person WHERE address_id IS NOT NULL AND address_id <> '' GROUP BY person_id, address_id), un AS (SELECT attributed_person_id AS src, number AS dst, 'uses_number' AS kind, TIMESTAMP '2025-11-01 00:00:00' AS ts, count(*) AS amount, 'imei:' || coalesce(nullif(max(imei), ''), 'not recorded') AS via FROM handset WHERE attributed_person_id IS NOT NULL AND attributed_person_id <> '' GROUP BY attributed_person_id, number), si AS (SELECT seller_person_id AS src, dealer_id AS dst, 'sold_item' AS kind, min(sold_at) AS ts, count(*) AS amount, string_agg('sale:' || sale_id, '|' ORDER BY 'sale:' || sale_id) AS via FROM dealer_sale WHERE seller_person_id IS NOT NULL AND seller_person_id <> '' GROUP BY seller_person_id, dealer_id), im AS (SELECT p.incident_id AS src, s.seller_person_id AS dst, 'item_match' AS kind, min(s.sold_at) AS ts, count(*) AS amount, string_agg('serial:' || upper(trim(s.serial)) || '|sale:' || s.sale_id || '|dealer:' || s.dealer_id, '|' ORDER BY 'serial:' || upper(trim(s.serial)) || '|sale:' || s.sale_id || '|dealer:' || s.dealer_id) AS via FROM property_stolen p JOIN dealer_sale s ON upper(trim(s.serial)) = upper(trim(p.serial)) WHERE length(trim(p.serial)) >= 5 AND s.seller_person_id IS NOT NULL AND s.seller_person_id <> '' GROUP BY p.incident_id, s.seller_person_id), links AS (SELECT * FROM cl UNION ALL SELECT * FROM ca UNION ALL SELECT * FROM ii UNION ALL SELECT * FROM ko UNION ALL SELECT * FROM sn UNION ALL SELECT * FROM la UNION ALL SELECT * FROM un UNION ALL SELECT * FROM si UNION ALL SELECT * FROM im) SELECT src, dst, kind, ts, CAST(amount AS DOUBLE) AS amount, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: incident_report,incident_person,person,vehicle,plate_read,call_record,handset,custody,dealer_sale,property_stolen
  sink_dataset: police_links
  cron: "*/5 * * * *"
  enabled: true
