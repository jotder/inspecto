name: police_witness_link
description: "The witness link - people recorded as a witness on two or more incidents, everyone on those incidents and the witnesses' co-arrests (police_witness_links_dataset). One witness on an assault in Leeds West was co-arrested with its suspect three months before, and witnessed an unrelated theft in Sheffield; a shopkeeper who witnessed 6 incidents in Bradford East has no custody record at all."
sourceId: entity-projection
layout: force
query:
  projection:
    datasetId: police_witness_links_dataset
    sourceCol: src
    targetCol: dst
    linkKindCol: kind
    attrCols[3]: ts,amount,via
view:
  legend: true
  workingSet: true
  plugins:
    minimap: true
    hulls: true
    behaviors[1]: hover-activate
