name: ps_sms
leftDataset: settlement_expected
rightDataset: settlement_billed
keyColumns[4]: agreement_id,direction,service,destination_class
includeRecordCount: false
filters:
  settlement_expected: "service = 'SMS' AND amount IS NOT NULL"
  settlement_billed: "service = 'SMS' AND amount IS NOT NULL"
compareColumns[1]{column,agg,toleranceType,tolerance}:
  amount,sum,absolute,0
