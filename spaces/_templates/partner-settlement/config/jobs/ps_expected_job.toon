job:
  name: ps_expected
  type: sql.template
  description: "Our independently re-rated usage per agreement, direction, service, destination class and day, in the settlement currency, with the tolerance in force that day; only for cycles whose statement is received or overdue"
  sql: "WITH u AS ( SELECT r.*, c.period_start, c.period_end, c.statement_due FROM rerated_usage r JOIN settlement_calendar c ON c.agreement_id = r.agreement_id AND r.usage_date BETWEEN c.period_start AND c.period_end ), pick AS ( SELECT agreement_id, period_start, period_end, rating_run_id FROM (SELECT agreement_id, period_start, period_end, rating_run_id, max(rated_at) AS run_at FROM u GROUP BY agreement_id, period_start, period_end, rating_run_id) QUALIFY row_number() OVER (PARTITION BY agreement_id, period_start, period_end ORDER BY run_at DESC, rating_run_id DESC) = 1 ), cur AS ( SELECT u.* FROM u JOIN pick k ON k.agreement_id = u.agreement_id AND k.period_start = u.period_start AND k.period_end = u.period_end AND k.rating_run_id = u.rating_run_id WHERE u.amount_expected IS NOT NULL AND u.reason IS NULL AND (u.statement_due < CAST($as_of AS DATE) OR EXISTS (SELECT 1 FROM settlement_statement_current s WHERE s.agreement_id = u.agreement_id AND s.period_start = u.period_start AND s.period_end = u.period_end)) ), g AS ( SELECT agreement_id, direction, service, destination_class, usage_date, period_start, period_end, currency AS currency_orig, rating_run_id, sum(units) AS units, sum(amount_expected) AS amount_orig, CAST(sum(record_count) AS BIGINT) AS record_count, string_agg(DISTINCT rate_id, ',' ORDER BY rate_id) AS rate_ids FROM cur GROUP BY agreement_id, direction, service, destination_class, usage_date, period_start, period_end, currency, rating_run_id ), b AS ( SELECT row_number() OVER () AS rid, g.*, a.partner_id, a.currency AS currency, a.tolerance_type, a.tolerance, a.fx_rate_type, CASE a.fx_date_rule WHEN 'period_end' THEN g.period_end ELSE g.usage_date END AS fx_date FROM g JOIN settlement_agreement a ON a.agreement_id = g.agreement_id AND g.usage_date >= a.valid_from AND (a.valid_to IS NULL OR g.usage_date <= a.valid_to) ), x AS ( SELECT b.*, f.rate, f.rate_date AS fx_rate_date FROM b LEFT JOIN fx_rate f ON f.from_currency = b.currency_orig AND f.to_currency = b.currency AND f.rate_type = b.fx_rate_type AND f.rate_date <= b.fx_date QUALIFY row_number() OVER (PARTITION BY b.rid ORDER BY f.rate_date DESC) = 1 ), y AS ( SELECT *, CASE WHEN currency_orig = currency THEN CAST(1 AS DECIMAL(18,8)) ELSE rate END AS fx_rate, CASE WHEN currency_orig = currency THEN 'same_currency' WHEN rate IS NOT NULL THEN 'ok' ELSE 'missing' END AS fx_status FROM x ) SELECT agreement_id, partner_id, direction, service, destination_class, usage_date, period_start, period_end, units, CAST(round(amount_orig * fx_rate, 4) AS DECIMAL(18,4)) AS amount, currency, amount_orig, currency_orig, fx_rate, CASE WHEN fx_status = 'same_currency' THEN NULL ELSE fx_rate_date END AS fx_rate_date, fx_status, rate_ids, rating_run_id, record_count, tolerance_type, tolerance, CASE tolerance_type WHEN 'pct' THEN CAST(round(abs(amount_orig * fx_rate) * tolerance / 100, 4) AS DECIMAL(18,4)) ELSE tolerance END AS tolerance_amount FROM y"
  sources: "rerated_usage,settlement_calendar,settlement_agreement,fx_rate,settlement_statement_current"
  sink_dataset: settlement_expected
  on_signal: job.run.completed
  when: "$signal.job == ps_statement_findings && $signal.outcome == SUCCESS"
  as_of: "$today"
  enabled: true
