job:
  name: ps_aging
  type: sql.template
  description: "Aging per agreement and statement cycle: what the current statement says is owed in the agreement's direction (invoiced), the finance records applied to it oldest cycle first (settled_applied), the open balance and the open disputed amount, aged from the statement's received date into four buckets (boundaries aging_bucket_1, _2, _3, default 30, 60, 90 days), the payment due date and a payment_alert flag when an open balance reaches payment_alert_days before it (overdue included). Payments after the as-of day and statements received after it are not counted. Amounts are in the settlement currency; the kpi_ columns repeat them for kpi_currency only, so a KPI tile never adds two currencies"
  sql: "WITH m AS ( SELECT * FROM settlement_movement WHERE status IN ('ok', 'fx_missing') AND (source = 'statement' OR movement_date <= CAST($as_of AS DATE)) ), sd AS ( SELECT agreement_id, period_start, period_end, CAST(max(received_at) AS DATE) AS statement_date FROM settlement_statement_current GROUP BY agreement_id, period_start, period_end ), cyc AS ( SELECT m.agreement_id, min(m.partner_id) AS partner_id, m.direction, m.period_start, m.period_end, m.netting_group, m.currency, CAST(coalesce(sum(m.signed_amount), 0) * CASE m.direction WHEN 'we_pay' THEN 1 ELSE -1 END AS DECIMAL(18,4)) AS invoiced, CAST(count(*) FILTER (WHERE m.status = 'fx_missing') AS BIGINT) AS lines_unconverted FROM m JOIN sd ON sd.agreement_id = m.agreement_id AND sd.period_start = m.period_start AND sd.period_end = m.period_end WHERE m.source = 'statement' AND sd.statement_date <= CAST($as_of AS DATE) GROUP BY m.agreement_id, m.direction, m.period_start, m.period_end, m.netting_group, m.currency ), pool AS ( SELECT agreement_id, direction, currency, CAST(-coalesce(sum(signed_amount), 0) * CASE direction WHEN 'we_pay' THEN 1 ELSE -1 END AS DECIMAL(18,4)) AS settled FROM m WHERE source = 'payment' GROUP BY agreement_id, direction, currency ), f AS ( SELECT c.*, coalesce(p.settled, CAST(0 AS DECIMAL(18,4))) AS settled, coalesce(sum(greatest(c.invoiced, 0)) OVER (PARTITION BY c.agreement_id, c.direction, c.currency ORDER BY c.period_end, c.period_start ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING), 0) AS applied_before FROM cyc c LEFT JOIN pool p ON p.agreement_id = c.agreement_id AND p.direction = c.direction AND p.currency = c.currency ), o AS ( SELECT f.*, CAST(least(greatest(f.invoiced, 0), greatest(f.settled - f.applied_before, 0)) AS DECIMAL(18,4)) AS settled_applied FROM f ), d AS ( SELECT agreement_id, period_start, period_end, CAST(sum(disputed_amount) AS DECIMAL(18,4)) AS open_disputed, CAST(count(*) AS BIGINT) AS disputed_lines FROM settlement_dispute GROUP BY agreement_id, period_start, period_end ), r AS ( SELECT o.*, sd.statement_date, c.payment_due, CAST(o.invoiced - o.settled_applied AS DECIMAL(18,4)) AS open_balance, CAST(coalesce(d.open_disputed, 0) AS DECIMAL(18,4)) AS open_disputed, CAST(coalesce(d.disputed_lines, 0) AS BIGINT) AS disputed_lines, CAST(date_diff('day', sd.statement_date, CAST($as_of AS DATE)) AS BIGINT) AS age_days, CAST($aging_bucket_1 AS INTEGER) AS b1, CAST($aging_bucket_2 AS INTEGER) AS b2, CAST($aging_bucket_3 AS INTEGER) AS b3 FROM o JOIN sd ON sd.agreement_id = o.agreement_id AND sd.period_start = o.period_start AND sd.period_end = o.period_end LEFT JOIN settlement_calendar c ON c.agreement_id = o.agreement_id AND c.period_start = o.period_start AND c.period_end = o.period_end LEFT JOIN d ON d.agreement_id = o.agreement_id AND d.period_start = o.period_start AND d.period_end = o.period_end ), b AS ( SELECT r.*, CASE WHEN age_days <= b1 THEN '0-' || CAST(b1 AS VARCHAR) WHEN age_days <= b2 THEN CAST(b1 + 1 AS VARCHAR) || '-' || CAST(b2 AS VARCHAR) WHEN age_days <= b3 THEN CAST(b2 + 1 AS VARCHAR) || '-' || CAST(b3 AS VARCHAR) ELSE CAST(b3 AS VARCHAR) || '+' END AS age_bucket, CAST(CASE WHEN age_days <= b1 THEN 1 WHEN age_days <= b2 THEN 2 WHEN age_days <= b3 THEN 3 ELSE 4 END AS BIGINT) AS bucket_order, CAST(date_diff('day', CAST($as_of AS DATE), payment_due) AS BIGINT) AS days_to_payment_due FROM r ) SELECT agreement_id || '|' || CAST(period_start AS VARCHAR) || '|' || CAST(period_end AS VARCHAR) AS aging_key, agreement_id, partner_id, direction, netting_group, currency, period_start, period_end, CAST(date_trunc('month', period_end) AS DATE) AS cycle_month, statement_date, payment_due, CAST($as_of AS DATE) AS as_of, age_days, age_bucket, bucket_order, age_bucket || ' ' || currency AS age_bucket_currency, partner_id || ' ' || currency AS partner_currency, invoiced, settled_applied, open_balance, open_disputed, disputed_lines, lines_unconverted, days_to_payment_due, CAST(CASE WHEN open_balance > 0 AND days_to_payment_due <= CAST($payment_alert_days AS INTEGER) THEN 1 ELSE 0 END AS BIGINT) AS payment_alert, CAST(CASE WHEN age_days > b2 THEN open_balance ELSE 0 END AS DECIMAL(18,4)) AS aged_late_amount, CAST(CASE WHEN currency = $kpi_currency THEN open_disputed ELSE 0 END AS DECIMAL(18,4)) AS kpi_open_disputed, CAST(CASE WHEN currency = $kpi_currency AND age_days > b2 THEN open_balance ELSE 0 END AS DECIMAL(18,4)) AS kpi_aged_late FROM b"
  sources: "settlement_movement,settlement_statement_current,settlement_dispute,settlement_calendar"
  sink_dataset: settlement_aging
  on_signal: job.run.completed
  when: "$signal.job == ps_rollforward && $signal.outcome == SUCCESS"
  as_of: "$today"
  aging_bucket_1: "30"
  aging_bucket_2: "60"
  aging_bucket_3: "90"
  payment_alert_days: "5"
  kpi_currency: USD
  enabled: true
