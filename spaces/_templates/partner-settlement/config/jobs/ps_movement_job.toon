job:
  name: ps_movement
  type: sql.template
  description: "Every money movement of a settlement cycle at line level, in the settlement currency and with both currencies and the FX row that converted it: the current statement lines (what the partner says is owed) and the finance payments and credit or debit notes. Signed from our side (positive = we owe the partner); a line with no agreement or no FX rate is named in status, never dropped"
  sql: "WITH pay AS ( SELECT * FROM settlement_payment QUALIFY row_number() OVER (PARTITION BY payment_id ORDER BY recorded_at DESC) = 1 ), u AS ( SELECT 'statement' AS source, 'STM|' || statement_id || '|' || CAST(statement_version AS VARCHAR) || '|' || CAST(line_no AS VARCHAR) AS movement_id, statement_id AS document_id, CAST(statement_version AS INTEGER) AS document_version, agreement_id, partner_id, direction, period_start, period_end, CAST(date_trunc('month', period_end) AS DATE) AS cycle_month, coalesce(usage_date, period_end) AS movement_date, line_kind AS movement_kind, CASE WHEN line_kind IN ('usage', 'fee', 'tax') THEN 'invoiced' ELSE 'adjustment' END AS effect, 1 AS kind_sign, amount AS amount_orig, currency AS currency_orig FROM settlement_statement_current UNION ALL SELECT 'payment', 'PAY|' || payment_id, payment_id, CAST(NULL AS INTEGER), agreement_id, partner_id, direction, CAST(NULL AS DATE), CAST(NULL AS DATE), CAST(date_trunc('month', payment_date) AS DATE), payment_date, kind, CASE kind WHEN 'payment' THEN 'paid' ELSE 'adjustment' END, CASE kind WHEN 'debit_note' THEN 1 ELSE -1 END, amount, currency FROM pay ), b0 AS ( SELECT u.*, a.agreement_id AS known_agreement, a.currency AS currency, a.netting_group, a.fx_rate_type, a.fx_date_rule FROM u LEFT JOIN settlement_agreement a ON a.agreement_id = u.agreement_id AND a.partner_id = u.partner_id AND a.valid_from <= u.movement_date QUALIFY row_number() OVER (PARTITION BY u.movement_id ORDER BY a.valid_from DESC) = 1 ), b AS ( SELECT row_number() OVER () AS rid, b0.*, CASE WHEN source = 'payment' THEN movement_date WHEN movement_kind = 'usage' AND fx_date_rule <> 'period_end' THEN movement_date ELSE period_end END AS fx_date FROM b0 ), x AS ( SELECT b.*, f.rate, f.rate_date AS fx_rate_date FROM b LEFT JOIN fx_rate f ON f.from_currency = b.currency_orig AND f.to_currency = b.currency AND f.rate_type = b.fx_rate_type AND f.rate_date <= b.fx_date QUALIFY row_number() OVER (PARTITION BY b.rid ORDER BY f.rate_date DESC) = 1 ), y AS ( SELECT *, CASE WHEN known_agreement IS NULL THEN 'unknown_agreement' WHEN currency_orig = currency THEN 'same_currency' WHEN rate IS NOT NULL THEN 'ok' ELSE 'missing' END AS fx_status FROM x ), z AS ( SELECT *, CASE fx_status WHEN 'same_currency' THEN CAST(1 AS DECIMAL(18,8)) WHEN 'ok' THEN rate END AS fx_rate, CASE WHEN fx_status IN ('same_currency', 'ok') THEN CAST(round(amount_orig * CASE fx_status WHEN 'same_currency' THEN CAST(1 AS DECIMAL(18,8)) ELSE rate END, 4) AS DECIMAL(18,4)) END AS amount FROM y ) SELECT movement_id, source, document_id, document_version, agreement_id, partner_id, netting_group, direction, cycle_month, movement_date, period_start, period_end, movement_kind, effect, amount_orig, currency_orig, amount, currency, fx_rate, CASE WHEN fx_status = 'ok' THEN fx_rate_date END AS fx_rate_date, fx_rate_type, fx_status, CAST(amount * kind_sign * CASE direction WHEN 'we_pay' THEN 1 ELSE -1 END AS DECIMAL(18,4)) AS signed_amount, CASE fx_status WHEN 'unknown_agreement' THEN 'unknown_agreement' WHEN 'missing' THEN 'fx_missing' ELSE 'ok' END AS status FROM z"
  sources: "settlement_statement_current,settlement_payment,settlement_agreement,fx_rate"
  sink_dataset: settlement_movement
  on_signal: job.run.completed
  when: "$signal.job == ps_findings && $signal.outcome == SUCCESS"
  enabled: true
