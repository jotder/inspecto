job:
  name: ps_accrual
  type: sql.template
  description: "Accruals per agreement and closed cycle, reported, never posted: our expected amount (the latest re-rating run, priced into the settlement currency as ps_expected does, whether or not the statement is due), what the current statement invoiced, the unbilled accrual (the expected amount while no statement has arrived: status unbilled up to and including the statement due date, statement_late after it, when the missing_statement finding also fires) and a provision on the disputed amount (provision_pct, default 100, a finance policy). Amounts are in the agreement's direction and settlement currency; kpi_accrued_unbilled repeats the accrual for kpi_currency only"
  sql: "WITH u AS ( SELECT r.*, c.period_start, c.period_end, c.statement_due FROM rerated_usage r JOIN settlement_calendar c ON c.agreement_id = r.agreement_id AND r.usage_date BETWEEN c.period_start AND c.period_end ), pick AS ( SELECT agreement_id, period_start, period_end, rating_run_id FROM (SELECT agreement_id, period_start, period_end, rating_run_id, max(rated_at) AS run_at FROM u GROUP BY agreement_id, period_start, period_end, rating_run_id) QUALIFY row_number() OVER (PARTITION BY agreement_id, period_start, period_end ORDER BY run_at DESC, rating_run_id DESC) = 1 ), cur AS ( SELECT u.* FROM u JOIN pick k ON k.agreement_id = u.agreement_id AND k.period_start = u.period_start AND k.period_end = u.period_end AND k.rating_run_id = u.rating_run_id WHERE u.amount_expected IS NOT NULL AND u.reason IS NULL ), g AS ( SELECT agreement_id, direction, service, destination_class, usage_date, period_start, period_end, statement_due, currency AS currency_orig, sum(amount_expected) AS amount_orig FROM cur GROUP BY agreement_id, direction, service, destination_class, usage_date, period_start, period_end, statement_due, currency ), b AS ( SELECT row_number() OVER () AS rid, g.*, a.partner_id, a.currency, a.netting_group, a.fx_rate_type, CASE a.fx_date_rule WHEN 'period_end' THEN g.period_end ELSE g.usage_date END AS fx_date FROM g JOIN settlement_agreement a ON a.agreement_id = g.agreement_id AND g.usage_date >= a.valid_from AND (a.valid_to IS NULL OR g.usage_date <= a.valid_to) ), x AS ( SELECT b.*, f.rate FROM b LEFT JOIN fx_rate f ON f.from_currency = b.currency_orig AND f.to_currency = b.currency AND f.rate_type = b.fx_rate_type AND f.rate_date <= b.fx_date QUALIFY row_number() OVER (PARTITION BY b.rid ORDER BY f.rate_date DESC) = 1 ), e AS ( SELECT agreement_id, min(partner_id) AS partner_id, direction, period_start, period_end, statement_due, netting_group, currency, CAST(coalesce(sum(CASE WHEN currency_orig = currency THEN round(amount_orig, 4) WHEN rate IS NOT NULL THEN round(amount_orig * rate, 4) END), 0) AS DECIMAL(18,4)) AS expected_amount, CAST(count(*) FILTER (WHERE currency_orig <> currency AND rate IS NULL) AS BIGINT) AS lines_unconverted FROM x GROUP BY agreement_id, direction, period_start, period_end, statement_due, netting_group, currency ), s AS ( SELECT agreement_id, direction, period_start, period_end, CAST(coalesce(sum(signed_amount), 0) * CASE direction WHEN 'we_pay' THEN 1 ELSE -1 END AS DECIMAL(18,4)) AS invoiced_amount FROM settlement_movement WHERE source = 'statement' AND status IN ('ok', 'fx_missing') GROUP BY agreement_id, direction, period_start, period_end ), d AS ( SELECT agreement_id, period_start, period_end, CAST(sum(disputed_amount) AS DECIMAL(18,4)) AS disputed_amount FROM settlement_dispute GROUP BY agreement_id, period_start, period_end ), r AS ( SELECT e.*, s.invoiced_amount, CASE WHEN s.agreement_id IS NOT NULL THEN 'billed' WHEN CAST($as_of AS DATE) <= e.statement_due THEN 'unbilled' ELSE 'statement_late' END AS status, CAST(CASE WHEN s.agreement_id IS NULL THEN e.expected_amount ELSE 0 END AS DECIMAL(18,4)) AS accrued_unbilled, CAST(coalesce(d.disputed_amount, 0) AS DECIMAL(18,4)) AS disputed_amount, CAST($provision_pct AS DECIMAL(9,4)) AS provision_pct FROM e LEFT JOIN s ON s.agreement_id = e.agreement_id AND s.direction = e.direction AND s.period_start = e.period_start AND s.period_end = e.period_end LEFT JOIN d ON d.agreement_id = e.agreement_id AND d.period_start = e.period_start AND d.period_end = e.period_end ), p AS ( SELECT r.*, CAST(round(disputed_amount * provision_pct / 100, 4) AS DECIMAL(18,4)) AS dispute_provision FROM r ) SELECT agreement_id || '|' || CAST(period_start AS VARCHAR) || '|' || CAST(period_end AS VARCHAR) AS accrual_key, agreement_id, partner_id, direction, netting_group, currency, period_start, period_end, CAST(date_trunc('month', period_end) AS DATE) AS cycle_month, statement_due, CAST($as_of AS DATE) AS as_of, status, expected_amount, invoiced_amount, accrued_unbilled, disputed_amount, provision_pct, dispute_provision, CAST(accrued_unbilled + dispute_provision AS DECIMAL(18,4)) AS accrual_total, lines_unconverted, CAST(CASE WHEN currency = $kpi_currency THEN accrued_unbilled ELSE 0 END AS DECIMAL(18,4)) AS kpi_accrued_unbilled FROM p"
  sources: "rerated_usage,settlement_calendar,settlement_agreement,fx_rate,settlement_movement,settlement_dispute"
  sink_dataset: settlement_accrual
  on_signal: job.run.completed
  when: "$signal.job == ps_aging && $signal.outcome == SUCCESS"
  as_of: "$today"
  provision_pct: "100"
  kpi_currency: USD
  enabled: true
