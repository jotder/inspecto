job:
  name: ps_findings
  type: sql.template
  description: "Settlement findings: amount_mismatch, cutoff_difference, fx_difference (variance), missing_statement, unrated_usage, fx_rate_missing (data quality)"
  sql: "WITH ru AS ( SELECT r.*, c.period_start, c.period_end FROM rerated_usage r JOIN settlement_calendar c ON c.agreement_id = r.agreement_id AND r.usage_date BETWEEN c.period_start AND c.period_end ), pick AS ( SELECT agreement_id, period_start, period_end, rating_run_id FROM (SELECT agreement_id, period_start, period_end, rating_run_id, max(rated_at) AS run_at FROM ru GROUP BY agreement_id, period_start, period_end, rating_run_id) QUALIFY row_number() OVER (PARTITION BY agreement_id, period_start, period_end ORDER BY run_at DESC, rating_run_id DESC) = 1 ), unrated AS ( SELECT DISTINCT u.agreement_id, u.direction, u.service, u.destination_class, u.usage_date FROM ru u JOIN pick k ON k.agreement_id = u.agreement_id AND k.period_start = u.period_start AND k.period_end = u.period_end AND k.rating_run_id = u.rating_run_id WHERE u.reason IS NOT NULL ), j AS ( SELECT coalesce(e.agreement_id, b.agreement_id) AS agreement_id, coalesce(e.partner_id, b.partner_id) AS partner_id, coalesce(e.direction, b.direction) AS direction, coalesce(e.service, b.service) AS service, coalesce(e.destination_class, b.destination_class) AS destination_class, coalesce(e.usage_date, b.usage_date) AS usage_date, coalesce(e.period_start, b.period_start) AS period_start, coalesce(e.period_end, b.period_end) AS period_end, e.amount AS exp_amount, b.amount_billed AS bil_amount, e.amount_orig AS exp_orig, e.currency_orig AS exp_cur, b.currency_orig AS bil_cur, coalesce(e.currency, b.currency) AS settle_cur, b.partner_fx_rate, CAST(coalesce(b.amount_billed, CAST(0 AS DECIMAL(18,4))) - coalesce(e.amount, CAST(0 AS DECIMAL(18,4))) AS DECIMAL(18,4)) AS variance, coalesce(e.tolerance_amount, CAST(0 AS DECIMAL(18,4))) AS tol, CASE WHEN e.agreement_id IS NULL THEN 'statement_only' WHEN b.agreement_id IS NULL THEN 'ours_only' ELSE 'both' END AS side FROM settlement_expected e FULL OUTER JOIN settlement_billed b ON b.agreement_id = e.agreement_id AND b.direction = e.direction AND b.service = e.service AND b.destination_class = e.destination_class AND b.usage_date = e.usage_date WHERE (e.agreement_id IS NULL OR e.amount IS NOT NULL) AND (b.agreement_id IS NULL OR b.amount_billed IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM unrated u WHERE u.agreement_id = coalesce(e.agreement_id, b.agreement_id) AND u.direction = coalesce(e.direction, b.direction) AND u.service = coalesce(e.service, b.service) AND u.destination_class = coalesce(e.destination_class, b.destination_class) AND u.usage_date = coalesce(e.usage_date, b.usage_date)) ), k AS ( SELECT j.*, EXISTS (SELECT 1 FROM j n WHERE n.agreement_id = j.agreement_id AND n.direction = j.direction AND n.service = j.service AND n.destination_class = j.destination_class AND date_diff('day', n.usage_date, j.usage_date) IN (-1, 1) AND abs(n.variance) > n.tol AND sign(n.variance) = -sign(j.variance) AND abs(n.variance + j.variance) <= j.tol) AS cutoff, (j.partner_fx_rate IS NOT NULL AND j.bil_cur = j.settle_cur AND j.exp_cur <> j.bil_cur AND abs(j.bil_amount - CAST(round(j.exp_orig * j.partner_fx_rate, 4) AS DECIMAL(18,4))) <= j.tol) AS fx_explained, EXISTS (SELECT 1 FROM settlement_statement_current s WHERE s.agreement_id = j.agreement_id AND s.period_start = j.period_start AND s.period_end = j.period_end) AS has_statement FROM j ), variance_rows AS ( SELECT agreement_id || '|' || direction || '|' || service || '|' || destination_class || '|' || CAST(usage_date AS VARCHAR) AS item_key, usage_date, agreement_id, partner_id, direction, service, destination_class, period_start, period_end, exp_amount AS expected_amount, bil_amount AS billed_amount, variance, tol AS tolerance_amount, side, CASE WHEN cutoff THEN 'cutoff_difference' WHEN fx_explained THEN 'fx_difference' ELSE 'amount_mismatch' END AS reason, 'variance' AS finding FROM k WHERE abs(variance) > tol AND (side <> 'ours_only' OR has_statement) ), missing AS ( SELECT agreement_id || '|' || CAST(period_start AS VARCHAR) || '|' || CAST(period_end AS VARCHAR) AS item_key, period_start AS usage_date, agreement_id, min(partner_id) AS partner_id, CAST(NULL AS VARCHAR) AS direction, CAST(NULL AS VARCHAR) AS service, CAST(NULL AS VARCHAR) AS destination_class, period_start, period_end, sum(amount) AS expected_amount, CAST(NULL AS DECIMAL(18,4)) AS billed_amount, CAST(NULL AS DECIMAL(18,4)) AS variance, CAST(NULL AS DECIMAL(18,4)) AS tolerance_amount, 'ours_only' AS side, 'missing_statement' AS reason, 'data_quality' AS finding FROM settlement_expected e WHERE NOT EXISTS (SELECT 1 FROM settlement_statement_current s WHERE s.agreement_id = e.agreement_id AND s.period_start = e.period_start AND s.period_end = e.period_end) GROUP BY agreement_id, period_start, period_end ), unrated_rows AS ( SELECT agreement_id || '|' || direction || '|' || service || '|' || destination_class || '|' || CAST(usage_date AS VARCHAR) AS item_key, usage_date, agreement_id, CAST(NULL AS VARCHAR) AS partner_id, direction, service, destination_class, CAST(NULL AS DATE) AS period_start, CAST(NULL AS DATE) AS period_end, CAST(NULL AS DECIMAL(18,4)) AS expected_amount, CAST(NULL AS DECIMAL(18,4)) AS billed_amount, CAST(NULL AS DECIMAL(18,4)) AS variance, CAST(NULL AS DECIMAL(18,4)) AS tolerance_amount, 'ours_only' AS side, 'unrated_usage' AS reason, 'data_quality' AS finding FROM unrated ), fx_rows AS ( SELECT DISTINCT agreement_id || '|' || direction || '|' || service || '|' || destination_class || '|' || CAST(usage_date AS VARCHAR) AS item_key, usage_date, agreement_id, partner_id, direction, service, destination_class, period_start, period_end, CAST(NULL AS DECIMAL(18,4)) AS expected_amount, CAST(NULL AS DECIMAL(18,4)) AS billed_amount, CAST(NULL AS DECIMAL(18,4)) AS variance, CAST(NULL AS DECIMAL(18,4)) AS tolerance_amount, 'both' AS side, 'fx_rate_missing' AS reason, 'data_quality' AS finding FROM (SELECT agreement_id, partner_id, direction, service, destination_class, usage_date, period_start, period_end FROM settlement_expected WHERE fx_status = 'missing' UNION ALL SELECT agreement_id, partner_id, direction, service, destination_class, usage_date, period_start, period_end FROM settlement_billed WHERE fx_status = 'missing') ) SELECT *, 'ps_settlement' AS control FROM variance_rows UNION ALL SELECT *, 'ps_settlement' FROM missing UNION ALL SELECT *, 'ps_settlement' FROM unrated_rows UNION ALL SELECT *, 'ps_settlement' FROM fx_rows"
  sources: "settlement_expected,settlement_billed,settlement_statement_current,rerated_usage,settlement_calendar"
  sink_dataset: settlement_findings
  on_signal: job.run.completed
  when: "$signal.job == ps_billed && $signal.outcome == SUCCESS"
  enabled: true
