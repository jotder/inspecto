job:
  name: ps_rollforward
  type: sql.template
  description: "Roll-forward of the balance per netting group and settlement currency, one row for every month from the first movement to the as-of month (a month with no movement carries the balance): opening + invoiced - paid + adjustments = closing, signed from our side (positive = we owe). It reads no dispute, so a disputed amount is neither netted away nor shown"
  sql: "WITH m AS ( SELECT * FROM settlement_movement WHERE status IN ('ok', 'fx_missing') ), a AS ( SELECT netting_group, currency, cycle_month, CAST(coalesce(sum(CASE WHEN effect = 'invoiced' THEN signed_amount END), 0) AS DECIMAL(18,4)) AS invoiced, CAST(-coalesce(sum(CASE WHEN effect = 'paid' THEN signed_amount END), 0) AS DECIMAL(18,4)) AS paid, CAST(coalesce(sum(CASE WHEN effect = 'adjustment' THEN signed_amount END), 0) AS DECIMAL(18,4)) AS adjustments, CAST(count(*) AS BIGINT) AS movements, CAST(count(*) FILTER (WHERE status = 'fx_missing') AS BIGINT) AS lines_unconverted FROM m GROUP BY netting_group, currency, cycle_month ), bounds AS ( SELECT netting_group, currency, min(cycle_month) AS lo, greatest(max(cycle_month), CAST(date_trunc('month', CAST($as_of AS DATE)) AS DATE)) AS hi FROM a GROUP BY netting_group, currency ), s AS ( SELECT netting_group, currency, CAST(unnest(generate_series(CAST(lo AS TIMESTAMP), CAST(hi AS TIMESTAMP), INTERVAL 1 MONTH)) AS DATE) AS cycle_month FROM bounds ), j AS ( SELECT s.netting_group, s.currency, s.cycle_month, coalesce(a.invoiced, CAST(0 AS DECIMAL(18,4))) AS invoiced, coalesce(a.paid, CAST(0 AS DECIMAL(18,4))) AS paid, coalesce(a.adjustments, CAST(0 AS DECIMAL(18,4))) AS adjustments, coalesce(a.movements, CAST(0 AS BIGINT)) AS movements, coalesce(a.lines_unconverted, CAST(0 AS BIGINT)) AS lines_unconverted FROM s LEFT JOIN a ON a.netting_group = s.netting_group AND a.currency = s.currency AND a.cycle_month = s.cycle_month ), c AS ( SELECT *, sum(invoiced - paid + adjustments) OVER (PARTITION BY netting_group, currency ORDER BY cycle_month) AS closing FROM j ) SELECT netting_group, cycle_month, currency, CAST(coalesce(lag(closing) OVER (PARTITION BY netting_group, currency ORDER BY cycle_month), 0) AS DECIMAL(18,4)) AS opening, invoiced, paid, adjustments, CAST(closing AS DECIMAL(18,4)) AS closing, movements, lines_unconverted FROM c"
  sources: "settlement_movement"
  sink_dataset: settlement_rollforward
  on_signal: job.run.completed
  when: "$signal.job == ps_position && $signal.outcome == SUCCESS"
  as_of: "$today"
  enabled: true
