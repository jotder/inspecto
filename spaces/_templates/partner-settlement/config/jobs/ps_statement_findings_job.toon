job:
  name: ps_statement_findings
  type: sql.template
  description: "Statement integrity findings: control_total_mismatch, duplicate_statement, restated_statement, unknown_partner, unknown_agreement"
  sql: "WITH d AS ( SELECT *, row_number() OVER (PARTITION BY statement_id, statement_version, line_no ORDER BY received_at) AS rn FROM settlement_statement ), st AS ( SELECT statement_id, statement_version, partner_id, agreement_id, period_start, period_end, count(*) FILTER (WHERE rn = 1) AS line_count, sum(amount) FILTER (WHERE rn = 1) AS line_sum, max(control_total_amount) AS ct_amount, max(control_total_lines) AS ct_lines, count(*) FILTER (WHERE rn > 1) AS duplicate_lines FROM d GROUP BY statement_id, statement_version, partner_id, agreement_id, period_start, period_end ), x AS ( SELECT st.*, EXISTS (SELECT 1 FROM partner p WHERE p.partner_id = st.partner_id) AS known_partner, EXISTS (SELECT 1 FROM settlement_agreement a WHERE a.agreement_id = st.agreement_id AND a.partner_id = st.partner_id) AS known_agreement, EXISTS (SELECT 1 FROM st s2 WHERE s2.agreement_id = st.agreement_id AND s2.period_start = st.period_start AND s2.period_end = st.period_end AND s2.statement_version < st.statement_version) AS restates FROM st ), f AS ( SELECT *, 'control_total_mismatch' AS reason, 'data_quality' AS finding, line_sum - ct_amount AS amount_delta FROM x WHERE line_sum <> ct_amount OR line_count <> ct_lines UNION ALL SELECT *, 'duplicate_statement', 'data_quality', CAST(NULL AS DECIMAL(38,4)) FROM x WHERE duplicate_lines > 0 UNION ALL SELECT *, 'restated_statement', 'info', CAST(NULL AS DECIMAL(38,4)) FROM x WHERE restates AND known_partner AND known_agreement UNION ALL SELECT *, 'unknown_partner', 'data_quality', CAST(NULL AS DECIMAL(38,4)) FROM x WHERE NOT known_partner UNION ALL SELECT *, 'unknown_agreement', 'data_quality', CAST(NULL AS DECIMAL(38,4)) FROM x WHERE known_partner AND NOT known_agreement ) SELECT statement_id || '|' || CAST(statement_version AS VARCHAR) AS item_key, statement_id, statement_version, partner_id, agreement_id, period_start, period_end, line_count, duplicate_lines, line_sum, ct_amount AS control_total_amount, ct_lines AS control_total_lines, amount_delta, reason, finding, 'ps_statement_integrity' AS control FROM f"
  sources: "settlement_statement,partner,settlement_agreement"
  sink_dataset: settlement_statement_findings
  on_signal: job.run.completed
  when: "$signal.job == ps_statement_current && $signal.outcome == SUCCESS"
  enabled: true
