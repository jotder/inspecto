job:
  name: ps_calendar
  type: sql.template
  description: "Settlement-cycle calendar: one row per agreement and closed cycle with the statement due, dispute window end and payment due dates, each rolled forward to the next business day (weekends and the partner country holidays)"
  sql: "WITH ag AS ( SELECT a.agreement_id, a.partner_id, a.cycle, a.statement_due_days, a.dispute_window_days, a.payment_due_days, a.valid_from, coalesce(a.valid_to, DATE '2999-12-31') AS valid_to, p.country FROM settlement_agreement a LEFT JOIN partner p ON p.partner_id = a.partner_id ), cand AS ( SELECT ag.*, CAST(unnest(generate_series(CAST(ag.valid_from AS TIMESTAMP), CAST(least(ag.valid_to, CAST($as_of AS DATE) - 1) AS TIMESTAMP), INTERVAL 1 DAY)) AS DATE) AS pend FROM ag ), per AS ( SELECT agreement_id, partner_id, country, statement_due_days, dispute_window_days, payment_due_days, pend AS period_end, CASE cycle WHEN 'monthly' THEN CAST(date_trunc('month', pend) AS DATE) WHEN 'semi_monthly' THEN CASE WHEN day(pend) = 15 THEN CAST(date_trunc('month', pend) AS DATE) ELSE CAST(date_trunc('month', pend) AS DATE) + 15 END WHEN 'weekly' THEN pend - 6 END AS period_start FROM cand WHERE (cycle = 'monthly' AND pend = last_day(pend)) OR (cycle = 'semi_monthly' AND (day(pend) = 15 OR pend = last_day(pend))) OR (cycle = 'weekly' AND isodow(pend) = 7) ), bounds AS (SELECT min(period_end) AS lo, max(period_end) + 400 AS hi FROM per), bday AS ( SELECT c.country, CAST(u.g AS DATE) AS day FROM (SELECT DISTINCT country FROM per) c CROSS JOIN bounds b CROSS JOIN unnest(generate_series(CAST(b.lo AS TIMESTAMP), CAST(b.hi AS TIMESTAMP), INTERVAL 1 DAY)) AS u(g) WHERE isodow(CAST(u.g AS DATE)) < 6 AND NOT EXISTS (SELECT 1 FROM holiday h WHERE h.holiday_date = CAST(u.g AS DATE) AND h.country IS NOT DISTINCT FROM c.country) ), s1 AS ( SELECT p.*, (SELECT min(b.day) FROM bday b WHERE b.country IS NOT DISTINCT FROM p.country AND b.day >= p.period_end + p.statement_due_days) AS statement_due FROM per p ) SELECT s.agreement_id, s.partner_id, s.period_start, s.period_end, s.statement_due, (SELECT min(b.day) FROM bday b WHERE b.country IS NOT DISTINCT FROM s.country AND b.day >= s.statement_due + s.dispute_window_days) AS dispute_window_end, (SELECT min(b.day) FROM bday b WHERE b.country IS NOT DISTINCT FROM s.country AND b.day >= s.statement_due + s.payment_due_days) AS payment_due FROM s1 s"
  sources: "settlement_agreement,partner,holiday"
  sink_dataset: settlement_calendar
  cron: "0 1 * * *"
  as_of: "$today"
  enabled: true
