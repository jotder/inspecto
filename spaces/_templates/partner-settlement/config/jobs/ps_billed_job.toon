job:
  name: ps_billed
  type: sql.template
  description: "The partner statement usage lines at the same grain, in the settlement currency; amount is snapped to our expected amount when the variance is inside the tolerance, so the Reconciliation compares at exact tolerance 0 and a Break is a variance beyond tolerance"
  sql: "WITH s AS ( SELECT l.*, c.period_start AS cal_start, c.period_end AS cal_end FROM settlement_statement_current l JOIN settlement_calendar c ON c.agreement_id = l.agreement_id AND l.usage_date BETWEEN c.period_start AND c.period_end WHERE l.line_kind = 'usage' AND l.usage_date IS NOT NULL ), g AS ( SELECT agreement_id, direction, service, destination_class, usage_date, cal_start AS period_start, cal_end AS period_end, currency AS currency_orig, min(statement_id) AS statement_id, max(statement_version) AS statement_version, sum(units) AS units, sum(amount) AS amount_orig, max(fx_rate_applied) AS partner_fx_rate FROM s GROUP BY agreement_id, direction, service, destination_class, usage_date, cal_start, cal_end, currency ), b AS ( SELECT row_number() OVER () AS rid, g.*, a.partner_id, a.currency AS currency, a.fx_rate_type, CASE a.fx_date_rule WHEN 'period_end' THEN g.period_end ELSE g.usage_date END AS fx_date FROM g JOIN settlement_agreement a ON a.agreement_id = g.agreement_id AND g.usage_date >= a.valid_from AND (a.valid_to IS NULL OR g.usage_date <= a.valid_to) ), x AS ( SELECT b.*, f.rate, f.rate_date AS fx_rate_date FROM b LEFT JOIN fx_rate f ON f.from_currency = b.currency_orig AND f.to_currency = b.currency AND f.rate_type = b.fx_rate_type AND f.rate_date <= b.fx_date QUALIFY row_number() OVER (PARTITION BY b.rid ORDER BY f.rate_date DESC) = 1 ), y AS ( SELECT *, CASE WHEN currency_orig = currency THEN CAST(1 AS DECIMAL(18,8)) ELSE rate END AS fx_rate, CASE WHEN currency_orig = currency THEN 'same_currency' WHEN rate IS NOT NULL THEN 'ok' ELSE 'missing' END AS fx_status FROM x ), z AS ( SELECT y.*, CAST(round(y.amount_orig * y.fx_rate, 4) AS DECIMAL(18,4)) AS amount_billed FROM y ) SELECT z.agreement_id, z.partner_id, z.direction, z.service, z.destination_class, z.usage_date, z.period_start, z.period_end, z.units, CASE WHEN e.amount IS NOT NULL AND z.amount_billed IS NOT NULL AND abs(z.amount_billed - e.amount) <= e.tolerance_amount THEN e.amount ELSE z.amount_billed END AS amount, z.amount_billed, z.currency, z.amount_orig, z.currency_orig, z.fx_rate, CASE WHEN z.fx_status = 'same_currency' THEN NULL ELSE z.fx_rate_date END AS fx_rate_date, z.fx_status, z.partner_fx_rate, z.statement_id, z.statement_version, e.amount AS amount_expected, CAST(z.amount_billed - e.amount AS DECIMAL(18,4)) AS variance FROM z LEFT JOIN settlement_expected e ON e.agreement_id = z.agreement_id AND e.direction = z.direction AND e.service = z.service AND e.destination_class = z.destination_class AND e.usage_date = z.usage_date"
  sources: "settlement_statement_current,settlement_calendar,settlement_agreement,fx_rate,settlement_expected"
  sink_dataset: settlement_billed
  on_signal: job.run.completed
  when: "$signal.job == ps_expected && $signal.outcome == SUCCESS"
  enabled: true
