job:
  name: ps_dispute
  type: sql.template
  description: "Dispute lines: every amount_mismatch and fx_difference finding as one line of the dispute for its partner and cycle (dispute_key), with the disputed amount, the settlement currency and netting group of the agreement version in force, the dispute window end from the calendar and whether that window closes within window_alert_days of the as-of day, plus the evidence the dispute pack files (S7): our rate ids and re-rating run, the agreement version and tolerance, both FX rows and the statement id and version"
  sql: "WITH f AS ( SELECT * FROM settlement_findings WHERE finding = 'variance' AND reason IN ('amount_mismatch', 'fx_difference') ), a AS ( SELECT f.item_key, g.currency, g.netting_group, g.valid_from AS agreement_version FROM f LEFT JOIN settlement_agreement g ON g.agreement_id = f.agreement_id AND g.partner_id = f.partner_id AND g.valid_from <= f.usage_date QUALIFY row_number() OVER (PARTITION BY f.item_key ORDER BY g.valid_from DESC) = 1 ) SELECT f.partner_id || '|' || CAST(f.period_start AS VARCHAR) || '|' || CAST(f.period_end AS VARCHAR) AS dispute_key, f.item_key, f.partner_id, f.agreement_id, f.direction, f.service, f.destination_class, f.usage_date, f.period_start, f.period_end, f.reason, f.side, f.expected_amount, f.billed_amount, f.variance, CAST(abs(f.variance) AS DECIMAL(18,4)) AS disputed_amount, a.currency, a.netting_group, CAST(date_trunc('month', f.period_end) AS DATE) AS cycle_month, c.statement_due, c.dispute_window_end, CAST(date_diff('day', CAST($as_of AS DATE), c.dispute_window_end) AS BIGINT) AS days_to_window_end, CAST(CASE WHEN date_diff('day', CAST($as_of AS DATE), c.dispute_window_end) BETWEEN 0 AND CAST($window_alert_days AS INTEGER) THEN 1 ELSE 0 END AS BIGINT) AS window_alert, e.rate_ids, e.rating_run_id, a.agreement_version, e.tolerance_type, e.tolerance, f.tolerance_amount, e.currency_orig AS rated_currency, e.fx_rate AS our_fx_rate, e.fx_rate_date AS our_fx_rate_date, b.currency_orig AS invoiced_currency, b.partner_fx_rate, b.statement_id, b.statement_version FROM f JOIN a ON a.item_key = f.item_key LEFT JOIN settlement_calendar c ON c.agreement_id = f.agreement_id AND c.period_start = f.period_start AND c.period_end = f.period_end LEFT JOIN settlement_expected e ON e.agreement_id = f.agreement_id AND e.direction = f.direction AND e.service = f.service AND e.destination_class = f.destination_class AND e.usage_date = f.usage_date LEFT JOIN settlement_billed b ON b.agreement_id = f.agreement_id AND b.direction = f.direction AND b.service = f.service AND b.destination_class = f.destination_class AND b.usage_date = f.usage_date"
  sources: "settlement_findings,settlement_agreement,settlement_calendar,settlement_expected,settlement_billed"
  sink_dataset: settlement_dispute
  on_signal: job.run.completed
  when: "$signal.job == ps_findings && $signal.outcome == SUCCESS"
  as_of: "$today"
  window_alert_days: "5"
  enabled: true
