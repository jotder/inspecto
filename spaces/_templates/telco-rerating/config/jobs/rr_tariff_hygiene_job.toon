job:
  name: rr_tariff_hygiene
  type: sql.template
  description: "Tariff-table hygiene - one row per defect in tariff_version itself, before any usage is judged: two rows in force at once with the same rate or with different rates (PRIORITY_ORDERED is a fact about that PAIR; the verdict for a call is its RESOLUTION in rerated_usage, which looks at every row in force at once), a gap between consecutive versions of a plan and service, a negative rate, a missing rate, an interval that ends before it starts. A zero rate is a free plan and is not a defect. The whole table is judged on every run and the snapshot is replaced."
  sql: "WITH t AS ( SELECT TARIFF_VERSION_ID, PLAN, SERVICE, RATE_PER_UNIT, EFFECTIVE_FROM, EFFECTIVE_TO, PRIORITY, (EFFECTIVE_TO IS NULL OR EFFECTIVE_TO > EFFECTIVE_FROM) AS VALID_INTERVAL, (RATE_PER_UNIT IS NOT NULL AND EFFECTIVE_FROM IS NOT NULL AND (EFFECTIVE_TO IS NULL OR EFFECTIVE_TO > EFFECTIVE_FROM)) AS USABLE, row_number() OVER (ORDER BY PLAN, SERVICE, EFFECTIVE_FROM, TARIFF_VERSION_ID) AS RN FROM tariff_version ), single_row AS ( SELECT CASE WHEN EFFECTIVE_FROM IS NULL THEN 'missing_start' WHEN NOT VALID_INTERVAL THEN 'inverted_interval' WHEN RATE_PER_UNIT IS NULL THEN 'missing_rate' ELSE 'negative_rate' END AS REASON, PLAN, SERVICE, TARIFF_VERSION_ID, CAST(NULL AS VARCHAR) AS OTHER_TARIFF_VERSION_ID, RATE_PER_UNIT, CAST(NULL AS DECIMAL(18,4)) AS OTHER_RATE_PER_UNIT, EFFECTIVE_FROM AS PERIOD_FROM, EFFECTIVE_TO AS PERIOD_TO, CAST(NULL AS BOOLEAN) AS PRIORITY_ORDERED FROM t WHERE EFFECTIVE_FROM IS NULL OR NOT VALID_INTERVAL OR RATE_PER_UNIT IS NULL OR RATE_PER_UNIT < 0 ), overlap AS ( SELECT CASE WHEN a.RATE_PER_UNIT = b.RATE_PER_UNIT THEN 'overlap_same_rate' ELSE 'overlap_different_rate' END AS REASON, a.PLAN, a.SERVICE, a.TARIFF_VERSION_ID, b.TARIFF_VERSION_ID AS OTHER_TARIFF_VERSION_ID, a.RATE_PER_UNIT, b.RATE_PER_UNIT AS OTHER_RATE_PER_UNIT, greatest(a.EFFECTIVE_FROM, b.EFFECTIVE_FROM) AS PERIOD_FROM, CASE WHEN a.EFFECTIVE_TO IS NULL THEN b.EFFECTIVE_TO WHEN b.EFFECTIVE_TO IS NULL THEN a.EFFECTIVE_TO ELSE least(a.EFFECTIVE_TO, b.EFFECTIVE_TO) END AS PERIOD_TO, CASE WHEN a.RATE_PER_UNIT <> b.RATE_PER_UNIT THEN a.PRIORITY IS DISTINCT FROM b.PRIORITY END AS PRIORITY_ORDERED FROM t a JOIN t b ON a.PLAN = b.PLAN AND a.SERVICE = b.SERVICE AND a.RN < b.RN AND a.USABLE AND b.USABLE AND b.EFFECTIVE_FROM < coalesce(a.EFFECTIVE_TO, TIMESTAMP '9999-12-31 00:00:00') ), ordered AS ( SELECT *, bool_or(EFFECTIVE_TO IS NULL) OVER w AS PREV_OPEN, max(EFFECTIVE_TO) OVER w AS PREV_END, arg_max(TARIFF_VERSION_ID, (EFFECTIVE_TO, TARIFF_VERSION_ID)) OVER w AS PREV_ID FROM t WHERE USABLE WINDOW w AS (PARTITION BY PLAN, SERVICE ORDER BY EFFECTIVE_FROM, TARIFF_VERSION_ID ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) ), gap AS ( SELECT 'gap' AS REASON, PLAN, SERVICE, TARIFF_VERSION_ID, PREV_ID AS OTHER_TARIFF_VERSION_ID, RATE_PER_UNIT, CAST(NULL AS DECIMAL(18,4)) AS OTHER_RATE_PER_UNIT, PREV_END AS PERIOD_FROM, EFFECTIVE_FROM AS PERIOD_TO, CAST(NULL AS BOOLEAN) AS PRIORITY_ORDERED FROM ordered WHERE NOT PREV_OPEN AND EFFECTIVE_FROM > PREV_END ), allf AS ( SELECT * FROM single_row UNION ALL SELECT * FROM overlap UNION ALL SELECT * FROM gap ) SELECT concat_ws('|', REASON, PLAN, SERVICE, TARIFF_VERSION_ID, OTHER_TARIFF_VERSION_ID) AS FINDING_KEY, REASON, 'data_quality' AS FINDING, PLAN, SERVICE, TARIFF_VERSION_ID, OTHER_TARIFF_VERSION_ID, RATE_PER_UNIT, OTHER_RATE_PER_UNIT, PERIOD_FROM, PERIOD_TO, PRIORITY_ORDERED, 'rr_tariff_hygiene' AS CONTROL FROM allf"
  sources: "tariff_version"
  sink_dataset: rerating_tariff_findings
  cron: "30 4 * * *"
  enabled: true
