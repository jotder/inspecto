job:
  name: rr_rerate
  type: sql.template
  description: "Independent re-rating of one day of rated usage against the effective-dated tariff_version rows in force at each call's START. Per call it counts the candidate tariff rows and gives a verdict: single, agree (several rows, one amount), precedence (several amounts, one row holds the highest explicit PRIORITY), disagree (several amounts, no winner: the expected charge is the range LOW to HIGH) or none. A charge inside the range is explained and goes to data quality; a charge outside it is leakage or over-billing against the nearest bound; under-charged and over-billed amounts are separate columns and never net. Writes the rerated_usage contract, one row per call."
  sql: "WITH u AS NOT MATERIALIZED ( SELECT XDR_ID, EVENT_DATE, EVENT_TS, SUBSCRIBER_ID, PLAN, SERVICE, USAGE_UNITS, CHARGE FROM rated_usage WHERE EVENT_TS >= CAST($window_start AS TIMESTAMP) AND EVENT_TS < CAST($window_end AS TIMESTAMP) ), tv AS ( SELECT TARIFF_VERSION_ID, PLAN, SERVICE, RATE_PER_UNIT, EFFECTIVE_FROM, EFFECTIVE_TO, PRIORITY FROM tariff_version WHERE RATE_PER_UNIT IS NOT NULL ), bnd AS ( SELECT PLAN, SERVICE, EFFECTIVE_FROM AS T FROM tv UNION SELECT PLAN, SERVICE, EFFECTIVE_TO AS T FROM tv WHERE EFFECTIVE_TO IS NOT NULL ), seg AS ( SELECT PLAN, SERVICE, T AS SEG_FROM, lead(T) OVER (PARTITION BY PLAN, SERVICE ORDER BY T) AS SEG_TO FROM bnd ), segc AS ( SELECT s.PLAN, s.SERVICE, s.SEG_FROM, s.SEG_TO, count(*) AS CANDIDATES, min(t.RATE_PER_UNIT) AS MIN_RATE, max(t.RATE_PER_UNIT) AS MAX_RATE, string_agg(t.TARIFF_VERSION_ID, ',' ORDER BY t.TARIFF_VERSION_ID) AS CANDIDATE_VERSIONS, min(t.TARIFF_VERSION_ID) AS FIRST_VERSION, max(t.PRIORITY, 2) AS TOP2, arg_max(t.RATE_PER_UNIT, t.PRIORITY) AS TOP_RATE, arg_max(t.TARIFF_VERSION_ID, t.PRIORITY) AS TOP_VERSION FROM seg s JOIN tv t ON t.PLAN = s.PLAN AND t.SERVICE = s.SERVICE AND t.EFFECTIVE_FROM <= s.SEG_FROM AND (t.EFFECTIVE_TO IS NULL OR s.SEG_FROM < t.EFFECTIVE_TO) GROUP BY s.PLAN, s.SERVICE, s.SEG_FROM, s.SEG_TO ), j AS ( SELECT u.XDR_ID, u.EVENT_DATE, u.EVENT_TS, u.SUBSCRIBER_ID, u.PLAN, u.SERVICE, u.USAGE_UNITS, u.CHARGE, coalesce(c.CANDIDATES, 0) AS CANDIDATES, c.CANDIDATE_VERSIONS, c.FIRST_VERSION, c.TOP_VERSION, c.TOP2, least(ROUND(u.USAGE_UNITS * c.MIN_RATE, 2), ROUND(u.USAGE_UNITS * c.MAX_RATE, 2)) AS CAND_LOW, greatest(ROUND(u.USAGE_UNITS * c.MIN_RATE, 2), ROUND(u.USAGE_UNITS * c.MAX_RATE, 2)) AS CAND_HIGH, ROUND(u.USAGE_UNITS * c.TOP_RATE, 2) AS TOP_EXPECTED FROM u LEFT JOIN segc c ON c.PLAN = u.PLAN AND c.SERVICE = u.SERVICE AND c.SEG_FROM <= u.EVENT_TS AND (c.SEG_TO IS NULL OR u.EVENT_TS < c.SEG_TO) ), r AS ( SELECT *, CASE WHEN CANDIDATES = 0 THEN 'none' WHEN CANDIDATES = 1 THEN 'single' WHEN CAND_LOW = CAND_HIGH THEN 'agree' WHEN (len(TOP2) = 1 OR TOP2[1] > TOP2[2]) THEN 'precedence' ELSE 'disagree' END AS RESOLUTION FROM j ), x AS ( SELECT *, CASE RESOLUTION WHEN 'precedence' THEN TOP_VERSION WHEN 'disagree' THEN NULL ELSE FIRST_VERSION END AS TARIFF_VERSION_ID, CASE RESOLUTION WHEN 'precedence' THEN TOP_EXPECTED ELSE CAND_LOW END AS EXPECTED_LOW, CASE RESOLUTION WHEN 'precedence' THEN TOP_EXPECTED ELSE CAND_HIGH END AS EXPECTED_HIGH FROM r ), k AS ( SELECT *, CASE WHEN EXPECTED_LOW - CHARGE > CAST($tolerance AS DECIMAL(18,4)) THEN EXPECTED_LOW - CHARGE ELSE 0 END AS UNDER, CASE WHEN CHARGE - EXPECTED_HIGH > CAST($tolerance AS DECIMAL(18,4)) THEN CHARGE - EXPECTED_HIGH ELSE 0 END AS OVER FROM x ) SELECT XDR_ID AS ITEM_KEY, EVENT_DATE, EVENT_TS, SUBSCRIBER_ID, PLAN, SERVICE, USAGE_UNITS, CHARGE AS ACTUAL_CHARGE, CANDIDATES, RESOLUTION, TARIFF_VERSION_ID, CANDIDATE_VERSIONS, CASE WHEN EXPECTED_LOW = EXPECTED_HIGH THEN EXPECTED_LOW END AS EXPECTED_CHARGE, EXPECTED_LOW, EXPECTED_HIGH, CASE WHEN CANDIDATES > 0 THEN UNDER END AS UNDERCHARGED_AMOUNT, CASE WHEN CANDIDATES > 0 THEN OVER END AS OVERBILLED_AMOUNT, CASE WHEN CANDIDATES = 0 THEN 'no_tariff' WHEN UNDER > 0 OR OVER > 0 THEN 'rate_mismatch' WHEN RESOLUTION = 'disagree' THEN 'ambiguous_tariff' END AS REASON, CASE WHEN CANDIDATES = 0 THEN 'data_quality' WHEN UNDER > 0 THEN 'leakage' WHEN OVER > 0 THEN 'overbilled' WHEN RESOLUTION = 'disagree' THEN 'data_quality' END AS FINDING, 'rr_rerate' AS CONTROL, CAST($window_start AS DATE) AS window_date FROM k"
  sources: "rated_usage,tariff_version"
  sink_dataset: rerated_usage
  on_signal: job.run.completed
  when: "$signal.job == rr_tariff_hygiene && $signal.outcome == SUCCESS"
  window_start: "$yesterday"
  window_end: "$today"
  day: "$yesterday"
  incremental:
    by: day
    column: window_date
    lookback: 1
    retain: 31
  tolerance: "0.02"
  enabled: true
