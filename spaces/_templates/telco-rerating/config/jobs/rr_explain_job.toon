job:
  name: rr_explain
  type: sql.template
  description: "Explains every finding of one day of rerated_usage, one row per finding. A leakage or over-billing is tested against counterfactual re-rating, each a one-parameter change that must reproduce the actual charge within the tolerance: stale_version (the most recently ended version of the plan and service), lower_priority_rate (a row in force that lost on PRIORITY) and early_version (the next version, billed before it starts). CAUSE_CONFIDENCE is exactness (1 when the counterfactual reproduces the charge exactly, within_tolerance_confidence when only within the tolerance) times support (the share of the same plan, service, candidate versions and finding that the same hypothesis also explains); below confidence_floor, or when nothing fits, the cause is unexplained with confidence 0. Every other fitting hypothesis is kept in CAUSE_ALTERNATIVE; the wording is consistent with, never proof. A data-quality finding carries its own reason as the cause. LEAKAGE_LOW is the shortfall against the nearest bound of the expected range (revenue at risk), LEAKAGE_HIGH the shortfall against the dearest candidate (an ambiguous tariff may justify the difference), OVERBILLED_AMOUNT the customer exposure, never counted in LEAKAGE_LOW. LEAKAGE_AMOUNT repeats LEAKAGE_LOW for the column list the starter leakage union reads."
  sql: "WITH f AS NOT MATERIALIZED ( SELECT ITEM_KEY, EVENT_DATE, EVENT_TS, SUBSCRIBER_ID, PLAN, SERVICE, RESOLUTION, TARIFF_VERSION_ID, CANDIDATE_VERSIONS, USAGE_UNITS, ACTUAL_CHARGE, EXPECTED_LOW, EXPECTED_HIGH, UNDERCHARGED_AMOUNT, OVERBILLED_AMOUNT, REASON, FINDING, CAST(window_date AS DATE) AS window_date FROM rerated_usage WHERE FINDING IS NOT NULL AND CAST(window_date AS DATE) = CAST($window_start AS DATE) ), tv AS ( SELECT TARIFF_VERSION_ID, PLAN, SERVICE, RATE_PER_UNIT, EFFECTIVE_FROM, EFFECTIVE_TO FROM tariff_version WHERE RATE_PER_UNIT >= 0 AND (EFFECTIVE_TO IS NULL OR EFFECTIVE_TO > EFFECTIVE_FROM) ), m AS ( SELECT *, count(*) OVER (PARTITION BY PLAN, SERVICE, CANDIDATE_VERSIONS, FINDING) AS COHORT_N FROM f WHERE FINDING IN ('leakage', 'overbilled') ), cf AS ( ( SELECT m.ITEM_KEY, 'stale_version' AS CAUSE, 1 AS CAUSE_RANK, t.TARIFF_VERSION_ID AS CF_VERSION, ROUND(m.USAGE_UNITS * t.RATE_PER_UNIT, 2) AS CF_AMOUNT FROM m JOIN tv t ON t.PLAN = m.PLAN AND t.SERVICE = m.SERVICE AND t.EFFECTIVE_TO <= m.EVENT_TS QUALIFY row_number() OVER (PARTITION BY m.ITEM_KEY ORDER BY t.EFFECTIVE_TO DESC, t.TARIFF_VERSION_ID) = 1 ) UNION ALL ( SELECT m.ITEM_KEY, 'lower_priority_rate' AS CAUSE, 2 AS CAUSE_RANK, t.TARIFF_VERSION_ID AS CF_VERSION, ROUND(m.USAGE_UNITS * t.RATE_PER_UNIT, 2) AS CF_AMOUNT FROM m JOIN tv t ON t.PLAN = m.PLAN AND t.SERVICE = m.SERVICE AND t.EFFECTIVE_FROM <= m.EVENT_TS AND (t.EFFECTIVE_TO IS NULL OR m.EVENT_TS < t.EFFECTIVE_TO) AND t.TARIFF_VERSION_ID <> m.TARIFF_VERSION_ID WHERE m.RESOLUTION = 'precedence' QUALIFY row_number() OVER (PARTITION BY m.ITEM_KEY ORDER BY abs(ROUND(m.USAGE_UNITS * t.RATE_PER_UNIT, 2) - m.ACTUAL_CHARGE), t.TARIFF_VERSION_ID) = 1 ) UNION ALL ( SELECT m.ITEM_KEY, 'early_version' AS CAUSE, 3 AS CAUSE_RANK, t.TARIFF_VERSION_ID AS CF_VERSION, ROUND(m.USAGE_UNITS * t.RATE_PER_UNIT, 2) AS CF_AMOUNT FROM m JOIN tv t ON t.PLAN = m.PLAN AND t.SERVICE = m.SERVICE AND t.EFFECTIVE_FROM > m.EVENT_TS QUALIFY row_number() OVER (PARTITION BY m.ITEM_KEY ORDER BY t.EFFECTIVE_FROM, t.TARIFF_VERSION_ID) = 1 ) ), fit AS ( SELECT cf.ITEM_KEY, cf.CAUSE, cf.CAUSE_RANK, cf.CF_VERSION, abs(cf.CF_AMOUNT - m.ACTUAL_CHARGE) AS DIFF, m.PLAN, m.SERVICE, m.CANDIDATE_VERSIONS, m.FINDING, m.COHORT_N FROM cf JOIN m ON m.ITEM_KEY = cf.ITEM_KEY WHERE abs(cf.CF_AMOUNT - m.ACTUAL_CHARGE) <= CAST($tolerance AS DECIMAL(18,4)) ), scored AS ( SELECT *, ROUND((CASE WHEN DIFF = 0 THEN 1.0 ELSE CAST($within_tolerance_confidence AS DOUBLE) END) * count(*) OVER (PARTITION BY PLAN, SERVICE, CANDIDATE_VERSIONS, FINDING, CAUSE) / COHORT_N, 4) AS CONF FROM fit ), ranked AS ( SELECT *, row_number() OVER (PARTITION BY ITEM_KEY ORDER BY CONF DESC, CAUSE_RANK) AS RN FROM scored WHERE CONF >= CAST($confidence_floor AS DOUBLE) ), alt AS ( SELECT ITEM_KEY, string_agg(CAUSE, ',' ORDER BY RN) AS ALT FROM ranked WHERE RN > 1 GROUP BY ITEM_KEY ), fin AS ( SELECT f.ITEM_KEY, f.EVENT_DATE, f.EVENT_TS, f.SUBSCRIBER_ID, f.PLAN, f.SERVICE, f.REASON, f.FINDING, CASE WHEN f.FINDING = 'data_quality' THEN f.REASON ELSE coalesce(b.CAUSE, 'unexplained') END AS CAUSE, CAST(CASE WHEN f.FINDING = 'data_quality' THEN 1 ELSE coalesce(b.CONF, 0) END AS DECIMAL(9,4)) AS CAUSE_CONFIDENCE, a.ALT AS CAUSE_ALTERNATIVE, b.CF_VERSION AS CAUSE_TARIFF_VERSION_ID, f.TARIFF_VERSION_ID, f.CANDIDATE_VERSIONS, f.ACTUAL_CHARGE, f.EXPECTED_LOW, f.EXPECTED_HIGH, coalesce(f.UNDERCHARGED_AMOUNT, 0) AS LEAKAGE_LOW, CASE WHEN f.EXPECTED_HIGH - f.ACTUAL_CHARGE > CAST($tolerance AS DECIMAL(18,4)) THEN f.EXPECTED_HIGH - f.ACTUAL_CHARGE ELSE 0 END AS LEAKAGE_HIGH, coalesce(f.OVERBILLED_AMOUNT, 0) AS OVERBILLED_AMOUNT, f.window_date FROM f LEFT JOIN ranked b ON b.ITEM_KEY = f.ITEM_KEY AND b.RN = 1 LEFT JOIN alt a ON a.ITEM_KEY = f.ITEM_KEY ) SELECT ITEM_KEY, EVENT_DATE, EVENT_TS, SUBSCRIBER_ID, PLAN, SERVICE, REASON, FINDING, CAUSE, CAUSE_CONFIDENCE, CAUSE_ALTERNATIVE, CAUSE_TARIFF_VERSION_ID, TARIFF_VERSION_ID, CANDIDATE_VERSIONS, ACTUAL_CHARGE, EXPECTED_LOW, EXPECTED_HIGH, LEAKAGE_LOW, LEAKAGE_HIGH, LEAKAGE_LOW AS LEAKAGE_AMOUNT, OVERBILLED_AMOUNT, 'rr_explain' AS CONTROL, window_date FROM fin"
  sources: "rerated_usage,tariff_version"
  sink_dataset: rerating_findings
  on_signal: job.run.completed
  when: "$signal.job == rr_rerate && $signal.outcome == SUCCESS"
  window_start: "$yesterday"
  window_end: "$today"
  day: "$yesterday"
  incremental:
    by: day
    column: window_date
    lookback: 1
    retain: 31
  tolerance: "0.02"
  within_tolerance_confidence: "0.9"
  confidence_floor: "0.5"
  enabled: true
