job:
  name: rr_explain
  type: sql.template
  description: "Explains every finding of one day of rerated_usage, one row per finding. A leakage or over-billing is tested against counterfactual re-rating, each a one-parameter change that must reproduce the actual charge within the tolerance: stale_version (the most recently ended version of the plan and service), lower_priority_rate (a row in force that lost on PRIORITY) early_version (the next version, billed before it starts) and wrong_plan (the plan the subscriber's own calls of the day are billed at, when the subscription_history Dataset assigns the subscriber a different plan at the call's start). The inferred plan of a subscriber and service is the one plan whose rate, in the version in force at each call, reproduces the charge of at least plan_share of that day's calls with a charge and non-zero units; it needs plan_min_rows such calls and a single top plan (two plans with the same rate infer nothing), and a call with no single assigned plan in force claims nothing. The confidence of wrong_plan is exactness times that share. CAUSE_CONFIDENCE is exactness (1 when the counterfactual reproduces the charge exactly, within_tolerance_confidence when only within the tolerance) times support (the share of the same plan, service, candidate versions and finding that the same hypothesis also explains; for wrong_plan, the share of the subscriber's calls the inferred plan explains); below confidence_floor, or when nothing fits, the cause is unexplained with confidence 0. Every other fitting hypothesis is kept in CAUSE_ALTERNATIVE; the wording is consistent with, never proof. A data-quality finding carries its own reason as the cause. LEAKAGE_LOW is the shortfall against the nearest bound of the expected range (revenue at risk), LEAKAGE_HIGH the shortfall against the dearest candidate (an ambiguous tariff may justify the difference), OVERBILLED_AMOUNT the customer exposure, never counted in LEAKAGE_LOW. LEAKAGE_AMOUNT repeats LEAKAGE_LOW for the column list the starter leakage union reads."
  sql: "WITH f AS NOT MATERIALIZED ( SELECT ITEM_KEY, EVENT_DATE, EVENT_TS, SUBSCRIBER_ID, PLAN, SERVICE, RESOLUTION, TARIFF_VERSION_ID, CANDIDATE_VERSIONS, USAGE_UNITS, ACTUAL_CHARGE, EXPECTED_LOW, EXPECTED_HIGH, UNDERCHARGED_AMOUNT, OVERBILLED_AMOUNT, REASON, FINDING, CAST(window_date AS DATE) AS window_date FROM rerated_usage WHERE FINDING IS NOT NULL AND CAST(window_date AS DATE) = CAST($window_start AS DATE) ), tv AS ( SELECT TARIFF_VERSION_ID, PLAN, SERVICE, RATE_PER_UNIT, EFFECTIVE_FROM, EFFECTIVE_TO FROM tariff_version WHERE RATE_PER_UNIT >= 0 AND (EFFECTIVE_TO IS NULL OR EFFECTIVE_TO > EFFECTIVE_FROM) ), m AS ( SELECT *, count(*) OVER (PARTITION BY PLAN, SERVICE, CANDIDATE_VERSIONS, FINDING) AS COHORT_N FROM f WHERE FINDING IN ('leakage', 'overbilled') ), sub AS ( SELECT DISTINCT SUBSCRIBER_ID FROM m ), pc AS ( SELECT r.ITEM_KEY, r.SUBSCRIBER_ID, r.SERVICE, r.EVENT_TS, r.USAGE_UNITS, r.ACTUAL_CHARGE FROM rerated_usage r JOIN sub s ON s.SUBSCRIBER_ID = r.SUBSCRIBER_ID WHERE CAST(r.window_date AS DATE) = CAST($window_start AS DATE) AND r.ACTUAL_CHARGE IS NOT NULL AND r.USAGE_UNITS <> 0 ), pn AS ( SELECT SUBSCRIBER_ID, SERVICE, count(*) AS N FROM pc GROUP BY SUBSCRIBER_ID, SERVICE ), px AS ( SELECT pc.SUBSCRIBER_ID, pc.SERVICE, t.PLAN AS QPLAN, count(DISTINCT pc.ITEM_KEY) AS HITS FROM pc JOIN tv t ON t.SERVICE = pc.SERVICE AND t.EFFECTIVE_FROM <= pc.EVENT_TS AND (t.EFFECTIVE_TO IS NULL OR pc.EVENT_TS < t.EFFECTIVE_TO) WHERE abs(ROUND(pc.USAGE_UNITS * t.RATE_PER_UNIT, 2) - pc.ACTUAL_CHARGE) <= CAST($tolerance AS DECIMAL(18,4)) GROUP BY pc.SUBSCRIBER_ID, pc.SERVICE, t.PLAN ), pr AS ( SELECT px.SUBSCRIBER_ID, px.SERVICE, px.QPLAN, px.HITS, pn.N, rank() OVER (PARTITION BY px.SUBSCRIBER_ID, px.SERVICE ORDER BY px.HITS DESC) AS RK FROM px JOIN pn ON pn.SUBSCRIBER_ID = px.SUBSCRIBER_ID AND pn.SERVICE = px.SERVICE ), inf AS ( SELECT SUBSCRIBER_ID, SERVICE, QPLAN, HITS, N FROM pr WHERE RK = 1 AND N >= CAST($plan_min_rows AS INTEGER) AND CAST(HITS AS DOUBLE) / N >= CAST($plan_share AS DOUBLE) QUALIFY count(*) OVER (PARTITION BY SUBSCRIBER_ID, SERVICE) = 1 ), asg AS ( SELECT m.ITEM_KEY, min(h.PLAN) AS APLAN FROM m JOIN subscription_history h ON h.SUBSCRIBER_ID = m.SUBSCRIBER_ID AND h.FROM_TS <= m.EVENT_TS AND (h.TO_TS IS NULL OR m.EVENT_TS < h.TO_TS) GROUP BY m.ITEM_KEY HAVING count(DISTINCT h.PLAN) = 1 ), cf AS ( ( SELECT m.ITEM_KEY, 'stale_version' AS CAUSE, 1 AS CAUSE_RANK, t.TARIFF_VERSION_ID AS CF_VERSION, ROUND(m.USAGE_UNITS * t.RATE_PER_UNIT, 2) AS CF_AMOUNT, CAST(NULL AS BIGINT) AS SUP_N, CAST(NULL AS BIGINT) AS SUP_D FROM m JOIN tv t ON t.PLAN = m.PLAN AND t.SERVICE = m.SERVICE AND t.EFFECTIVE_TO <= m.EVENT_TS QUALIFY row_number() OVER (PARTITION BY m.ITEM_KEY ORDER BY t.EFFECTIVE_TO DESC, t.TARIFF_VERSION_ID) = 1 ) UNION ALL ( SELECT m.ITEM_KEY, 'lower_priority_rate' AS CAUSE, 2 AS CAUSE_RANK, t.TARIFF_VERSION_ID AS CF_VERSION, ROUND(m.USAGE_UNITS * t.RATE_PER_UNIT, 2) AS CF_AMOUNT, CAST(NULL AS BIGINT) AS SUP_N, CAST(NULL AS BIGINT) AS SUP_D FROM m JOIN tv t ON t.PLAN = m.PLAN AND t.SERVICE = m.SERVICE AND t.EFFECTIVE_FROM <= m.EVENT_TS AND (t.EFFECTIVE_TO IS NULL OR m.EVENT_TS < t.EFFECTIVE_TO) AND t.TARIFF_VERSION_ID <> m.TARIFF_VERSION_ID WHERE m.RESOLUTION = 'precedence' QUALIFY row_number() OVER (PARTITION BY m.ITEM_KEY ORDER BY abs(ROUND(m.USAGE_UNITS * t.RATE_PER_UNIT, 2) - m.ACTUAL_CHARGE), t.TARIFF_VERSION_ID) = 1 ) UNION ALL ( SELECT m.ITEM_KEY, 'early_version' AS CAUSE, 3 AS CAUSE_RANK, t.TARIFF_VERSION_ID AS CF_VERSION, ROUND(m.USAGE_UNITS * t.RATE_PER_UNIT, 2) AS CF_AMOUNT, CAST(NULL AS BIGINT) AS SUP_N, CAST(NULL AS BIGINT) AS SUP_D FROM m JOIN tv t ON t.PLAN = m.PLAN AND t.SERVICE = m.SERVICE AND t.EFFECTIVE_FROM > m.EVENT_TS QUALIFY row_number() OVER (PARTITION BY m.ITEM_KEY ORDER BY t.EFFECTIVE_FROM, t.TARIFF_VERSION_ID) = 1 ) UNION ALL ( SELECT m.ITEM_KEY, 'wrong_plan' AS CAUSE, 4 AS CAUSE_RANK, t.TARIFF_VERSION_ID AS CF_VERSION, ROUND(m.USAGE_UNITS * t.RATE_PER_UNIT, 2) AS CF_AMOUNT, i.HITS AS SUP_N, i.N AS SUP_D FROM m JOIN inf i ON i.SUBSCRIBER_ID = m.SUBSCRIBER_ID AND i.SERVICE = m.SERVICE LEFT JOIN asg a ON a.ITEM_KEY = m.ITEM_KEY JOIN tv t ON t.PLAN = i.QPLAN AND t.SERVICE = m.SERVICE AND t.EFFECTIVE_FROM <= m.EVENT_TS AND (t.EFFECTIVE_TO IS NULL OR m.EVENT_TS < t.EFFECTIVE_TO) WHERE a.APLAN <> i.QPLAN QUALIFY row_number() OVER (PARTITION BY m.ITEM_KEY ORDER BY abs(m.ACTUAL_CHARGE - ROUND(m.USAGE_UNITS * t.RATE_PER_UNIT, 2)), t.TARIFF_VERSION_ID) = 1 ) ), fit AS ( SELECT cf.ITEM_KEY, cf.CAUSE, cf.CAUSE_RANK, cf.CF_VERSION, cf.SUP_N, cf.SUP_D, abs(cf.CF_AMOUNT - m.ACTUAL_CHARGE) AS DIFF, m.PLAN, m.SERVICE, m.CANDIDATE_VERSIONS, m.FINDING, m.COHORT_N FROM cf JOIN m ON m.ITEM_KEY = cf.ITEM_KEY WHERE abs(cf.CF_AMOUNT - m.ACTUAL_CHARGE) <= CAST($tolerance AS DECIMAL(18,4)) ), scored AS ( SELECT *, ROUND((CASE WHEN DIFF = 0 THEN 1.0 ELSE CAST($within_tolerance_confidence AS DOUBLE) END) * coalesce(SUP_N, count(*) OVER (PARTITION BY PLAN, SERVICE, CANDIDATE_VERSIONS, FINDING, CAUSE)) / coalesce(SUP_D, COHORT_N), 4) AS CONF FROM fit ), ranked AS ( SELECT *, row_number() OVER (PARTITION BY ITEM_KEY ORDER BY CONF DESC, CAUSE_RANK) AS RN FROM scored WHERE CONF >= CAST($confidence_floor AS DOUBLE) ), alt AS ( SELECT ITEM_KEY, string_agg(CAUSE, ',' ORDER BY RN) AS ALT FROM ranked WHERE RN > 1 GROUP BY ITEM_KEY ), fin AS ( SELECT f.ITEM_KEY, f.EVENT_DATE, f.EVENT_TS, f.SUBSCRIBER_ID, f.PLAN, f.SERVICE, f.REASON, f.FINDING, CASE WHEN f.FINDING = 'data_quality' THEN f.REASON ELSE coalesce(b.CAUSE, 'unexplained') END AS CAUSE, CAST(CASE WHEN f.FINDING = 'data_quality' THEN 1 ELSE coalesce(b.CONF, 0) END AS DECIMAL(9,4)) AS CAUSE_CONFIDENCE, a.ALT AS CAUSE_ALTERNATIVE, b.CF_VERSION AS CAUSE_TARIFF_VERSION_ID, f.TARIFF_VERSION_ID, f.CANDIDATE_VERSIONS, f.ACTUAL_CHARGE, f.EXPECTED_LOW, f.EXPECTED_HIGH, coalesce(f.UNDERCHARGED_AMOUNT, 0) AS LEAKAGE_LOW, CASE WHEN f.EXPECTED_HIGH - f.ACTUAL_CHARGE > CAST($tolerance AS DECIMAL(18,4)) THEN f.EXPECTED_HIGH - f.ACTUAL_CHARGE ELSE 0 END AS LEAKAGE_HIGH, coalesce(f.OVERBILLED_AMOUNT, 0) AS OVERBILLED_AMOUNT, f.window_date FROM f LEFT JOIN ranked b ON b.ITEM_KEY = f.ITEM_KEY AND b.RN = 1 LEFT JOIN alt a ON a.ITEM_KEY = f.ITEM_KEY ) SELECT ITEM_KEY, EVENT_DATE, EVENT_TS, SUBSCRIBER_ID, PLAN, SERVICE, REASON, FINDING, CAUSE, CAUSE_CONFIDENCE, CAUSE_ALTERNATIVE, CAUSE_TARIFF_VERSION_ID, TARIFF_VERSION_ID, CANDIDATE_VERSIONS, ACTUAL_CHARGE, EXPECTED_LOW, EXPECTED_HIGH, LEAKAGE_LOW, LEAKAGE_HIGH, LEAKAGE_LOW AS LEAKAGE_AMOUNT, OVERBILLED_AMOUNT, 'rr_explain' AS CONTROL, window_date FROM fin"
  sources: "rerated_usage,tariff_version,subscription_history"
  sink_dataset: rerating_findings
  on_signal: job.run.completed
  when: "$signal.job == rr_rerate && $signal.outcome == SUCCESS"
  window_start: "$yesterday"
  window_end: "$today"
  day: "$yesterday"
  incremental:
    by: day
    column: window_date
    lookback: 1
    retain: 31
  tolerance: "0.02"
  within_tolerance_confidence: "0.9"
  confidence_floor: "0.5"
  plan_share: "0.6"
  plan_min_rows: "3"
  enabled: true
