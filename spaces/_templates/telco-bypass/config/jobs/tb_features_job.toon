job:
  name: tb_features
  type: sql.template
  description: "Bypass / SIM-box signals - one row per SIM per day with twelve CDR signals (B-number diversity, call shape, answer rate, inbound share, service mix, cells and implied speed, sequential dialling, hour profile, burst cadence, overlapping calls, own-network targets, tenure and batch) and a box_like flag; an absent optional column or Reference is omitted and named in missing"
  sql: "WITH w AS NOT MATERIALIZED ( SELECT * FROM voice_cdr WHERE start_ts >= CAST($window_start AS TIMESTAMP) AND start_ts < CAST($window_end AS TIMESTAMP) ), site AS ( SELECT cell_id, min(lat) AS lat, min(lon) AS lon FROM cell_site GROUP BY cell_id ), np AS ( SELECT count(*) AS plan_rows, list(prefix) FILTER (WHERE own = 'Y') AS own_prefixes FROM number_plan ), calls AS ( SELECT c.a_number AS msisdn, c.record_id, c.start_ts, c.b_number, c.duration_s, c.cell_id, nullif(c.imei, '') AS imei, nullif(c.imsi, '') AS imsi, hour(timezone($local_zone, timezone($feed_zone, c.start_ts))) AS hr, CASE WHEN nullif(c.answered, '') IS NOT NULL THEN c.answered = 'Y' WHEN nullif(c.release_cause, '') IS NOT NULL THEN c.release_cause = '16' END AS ok, s.lat, s.lon, CASE WHEN np.plan_rows = 0 THEN NULL ELSE len(list_filter(coalesce(np.own_prefixes, CAST([] AS VARCHAR[])), x -> starts_with(c.b_number, x))) > 0 END AS onnet, lag(c.b_number) OVER seqw AS pb, lag(c.start_ts) OVER seqw AS pts, lag(c.cell_id) OVER seqw AS pcell, lag(s.lat) OVER seqw AS plat, lag(s.lon) OVER seqw AS plon, max(c.start_ts + to_seconds(CAST(c.duration_s AS BIGINT))) OVER (PARTITION BY c.a_number ORDER BY c.start_ts, c.record_id ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS prev_end FROM w c LEFT JOIN site s ON s.cell_id = c.cell_id CROSS JOIN np WHERE c.service = 'VOICE' AND c.direction = 'MO' AND coalesce(c.roaming, 'N') <> 'Y' WINDOW seqw AS (PARTITION BY c.a_number ORDER BY c.start_ts, c.record_id) ), calls2 AS ( SELECT *, CASE WHEN pts IS NOT NULL THEN epoch(start_ts) - epoch(pts) END AS gap_s, CASE WHEN pb IS NOT NULL AND left(b_number, CAST($seq_prefix AS INTEGER)) = left(pb, CAST($seq_prefix AS INTEGER)) AND abs(try_cast(b_number AS BIGINT) - try_cast(pb AS BIGINT)) BETWEEN 1 AND CAST($seq_step AS BIGINT) THEN 1 ELSE 0 END AS seq, CASE WHEN prev_end IS NOT NULL AND start_ts < prev_end THEN 1 ELSE 0 END AS ovl, CASE WHEN pcell IS NOT NULL AND pcell <> cell_id AND lat IS NOT NULL AND plat IS NOT NULL THEN 2 * 6371 * asin(sqrt(pow(sin(radians(lat - plat) / 2), 2) + cos(radians(plat)) * cos(radians(lat)) * pow(sin(radians(lon - plon) / 2), 2))) / (greatest(epoch(start_ts) - epoch(pts), 1) / 3600.0) END AS kmh FROM calls ), hourly AS ( SELECT msisdn, hr, count(*) AS n, count(DISTINCT b_number) AS db, sum(count(*)) OVER (PARTITION BY msisdn) AS total FROM calls2 GROUP BY msisdn, hr ), hour_agg AS ( SELECT msisdn, max(n) AS max_calls_1h, max(db) AS max_distinct_b_1h, count(*) AS active_hours, sum(n) FILTER (WHERE hr < CAST($night_end_hour AS INTEGER)) AS night_calls, -sum((n / total) * ln(n / total)) / ln(24) AS hour_entropy FROM (SELECT msisdn, hr, n, db, CAST(total AS DOUBLE) AS total FROM hourly) GROUP BY msisdn ), cellshare AS ( SELECT msisdn, max(n) AS top_cell_calls, count(*) AS distinct_cells FROM (SELECT msisdn, cell_id, count(*) AS n FROM calls2 GROUP BY msisdn, cell_id) GROUP BY msisdn ), mo AS ( SELECT msisdn, count(*) AS calls_mo, count(DISTINCT b_number) AS distinct_b, CAST(count(DISTINCT b_number) AS DOUBLE) / count(*) AS b_diversity, CAST(count(*) FILTER (WHERE duration_s > 0 AND duration_s <= CAST($short_s AS INTEGER)) AS DOUBLE) / nullif(count(*) FILTER (WHERE duration_s > 0), 0) AS short_call_ratio, avg(duration_s) FILTER (WHERE duration_s > 0) AS acd_s, stddev_pop(duration_s) FILTER (WHERE duration_s > 0) / nullif(avg(duration_s) FILTER (WHERE duration_s > 0), 0) AS acd_cv, avg(CASE WHEN ok IS NULL THEN NULL WHEN ok THEN 1.0 ELSE 0.0 END) AS asr, 1.0 - avg(CASE WHEN ok IS NULL THEN NULL WHEN ok THEN 1.0 ELSE 0.0 END) AS failed_share, CAST(sum(seq) AS DOUBLE) / nullif(count(pb), 0) AS seq_dial_share, CAST(sum(ovl) AS BIGINT) AS overlap_calls, max(kmh) AS max_implied_kmh, count(lat) AS calls_with_site, stddev_pop(gap_s) / nullif(avg(gap_s), 0) AS gap_cv, avg(CASE WHEN onnet IS NULL THEN NULL WHEN onnet THEN 1.0 ELSE 0.0 END) AS onnet_target_share, count(imei) > 0 AS has_imei, count(imsi) > 0 AS has_imsi, coalesce(array_to_string(arg_min(record_id, (duration_s, record_id), 3) FILTER (WHERE duration_s > 0), ','), '') AS evidence_ids FROM calls2 GROUP BY msisdn ), ev AS ( SELECT a_number AS msisdn, service, direction, duration_s FROM w WHERE direction = 'MO' UNION ALL SELECT b_number AS msisdn, service, direction, duration_s FROM w WHERE direction = 'MT' ), evs AS ( SELECT msisdn, count(*) AS events, count(*) FILTER (WHERE service = 'VOICE') AS voice_events, count(*) FILTER (WHERE service = 'VOICE' AND direction = 'MT') AS calls_mt, count(*) FILTER (WHERE service = 'SMS' AND direction = 'MO') AS sms_mo, CAST(coalesce(sum(duration_s) FILTER (WHERE service = 'DATA'), 0) AS BIGINT) AS data_s FROM ev GROUP BY msisdn ), prof AS ( SELECT msisdn, max(activated_on) AS activated_on, arg_max(dealer_id, activated_on) AS dealer_id FROM subscriber_profile GROUP BY msisdn ), batch AS ( SELECT dealer_id, activated_on, count(*) AS batch_size FROM prof WHERE dealer_id IS NOT NULL AND activated_on IS NOT NULL GROUP BY dealer_id, activated_on ), sig AS ( SELECT m.msisdn, m.calls_mo, m.distinct_b, m.b_diversity, m.short_call_ratio, m.acd_s, m.acd_cv, m.asr, m.failed_share, e.calls_mt, CAST(e.calls_mt AS DOUBLE) / (e.calls_mt + m.calls_mo) AS inbound_ratio, CAST(e.voice_events AS DOUBLE) / e.events AS voice_only_share, e.sms_mo, e.data_s, cs.distinct_cells, CAST(cs.top_cell_calls AS DOUBLE) / m.calls_mo AS top_cell_share, m.max_implied_kmh, m.seq_dial_share, h.active_hours, CAST(coalesce(h.night_calls, 0) AS DOUBLE) / m.calls_mo AS night_share, h.hour_entropy, h.max_calls_1h, h.max_distinct_b_1h, m.gap_cv, m.overlap_calls, m.onnet_target_share, date_diff('day', p.activated_on, CAST($window_start AS DATE)) AS tenure_days, p.dealer_id, p.activated_on, concat_ws(',', CASE WHEN m.asr IS NULL THEN 'S3' END, CASE WHEN m.calls_with_site = 0 THEN 'S6' END, CASE WHEN np.plan_rows = 0 THEN 'S11' END, CASE WHEN p.msisdn IS NULL THEN 'S12' END) AS missing, m.has_imei, m.has_imsi, m.evidence_ids FROM mo m JOIN evs e ON e.msisdn = m.msisdn JOIN hour_agg h ON h.msisdn = m.msisdn JOIN cellshare cs ON cs.msisdn = m.msisdn LEFT JOIN prof p ON p.msisdn = m.msisdn CROSS JOIN np WHERE m.calls_mo >= CAST($min_events AS INTEGER) ), flagged AS ( SELECT *, coalesce(inbound_ratio < CAST($cand_max_inbound AS DOUBLE) AND b_diversity > CAST($cand_min_b_div AS DOUBLE) AND short_call_ratio > CAST($cand_min_short AS DOUBLE) AND voice_only_share > CAST($cand_min_voice_only AS DOUBLE) AND top_cell_share > CAST($cand_min_top_cell AS DOUBLE), false) AS box_like FROM sig ) SELECT f.msisdn, f.calls_mo, f.distinct_b, f.b_diversity, f.short_call_ratio, f.acd_s, f.acd_cv, f.asr, f.failed_share, f.calls_mt, f.inbound_ratio, f.voice_only_share, f.sms_mo, f.data_s, f.distinct_cells, f.top_cell_share, f.max_implied_kmh, f.seq_dial_share, f.active_hours, f.night_share, f.hour_entropy, f.max_calls_1h, f.max_distinct_b_1h, f.gap_cv, f.overlap_calls, f.onnet_target_share, f.tenure_days, f.dealer_id, CAST(c.cands AS DOUBLE) / b.batch_size AS new_batch_share, f.box_like, f.missing, f.has_imei, f.has_imsi, f.evidence_ids, CAST($window_start AS DATE) AS window_date FROM flagged f LEFT JOIN batch b ON b.dealer_id = f.dealer_id AND b.activated_on = f.activated_on LEFT JOIN (SELECT dealer_id, activated_on, count(*) FILTER (WHERE box_like) AS cands FROM flagged GROUP BY dealer_id, activated_on) c ON c.dealer_id = f.dealer_id AND c.activated_on = f.activated_on"
  sources: "voice_cdr,cell_site,number_plan,subscriber_profile"
  sink_dataset: tb_features
  cron: "0 3 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  day: "$yesterday"
  incremental:
    by: day
    column: window_date
    lookback: 1
    retain: 31
  min_events: "20"
  short_s: "60"
  seq_step: "5"
  seq_prefix: "6"
  night_end_hour: "5"
  feed_zone: "UTC"
  local_zone: "UTC"
  cand_max_inbound: "0.05"
  cand_min_b_div: "0.9"
  cand_min_short: "0.9"
  cand_min_voice_only: "0.99"
  cand_min_top_cell: "0.9"
  enabled: true
