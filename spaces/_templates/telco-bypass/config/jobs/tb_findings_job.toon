job:
  name: tb_findings
  type: sql.template
  description: "Bypass / SIM-box findings - one row per SIM that scored at or above the Risk Score's high threshold (and per allowed SIM, whatever its score) with the agreement, persistence, allow-list and shadow decisions applied; status says why a high SIM did or did not alert, alert_score is the only column the tb_sim_high Alert Rule reads"
  sql: "WITH win AS ( SELECT CAST($window_start AS DATE) AS d, CAST($window_end AS TIMESTAMP) AS ts ), base AS ( SELECT f.msisdn AS entity_key, s.score, s.high, f.primary_signals, f.est_bypass_minutes, f.evidence_ids, s.factors, concat_ws('/', CAST(CAST(f.no_inbound_flag AS INTEGER) AS VARCHAR), CAST(CAST(f.inbound_excess > 0 AS INTEGER) AS VARCHAR), CAST(CAST(f.mobility_flag AS INTEGER) AS VARCHAR), CAST(CAST(f.normal_service_mix > 0 AS INTEGER) AS VARCHAR)) AS shape_sig FROM tb_factors f JOIN risk_scores_tb_sim_latest s ON s.entity_key = f.msisdn CROSS JOIN win WHERE f.window_date = win.d AND s.scored_at >= win.ts ), lst AS ( SELECT b.*, EXISTS (SELECT 1 FROM entity_list_tb_allow a CROSS JOIN win WHERE a.purpose = 'allow' AND (a.expires_at IS NULL OR a.expires_at > win.ts) AND CASE a.match WHEN 'key' THEN a.entry = b.entity_key WHEN 'prefix' THEN starts_with(b.entity_key, a.entry) WHEN 'range' THEN length(b.entity_key) = length(a.lo) AND b.entity_key BETWEEN a.lo AND a.hi ELSE false END) AS allowed, EXISTS (SELECT 1 FROM entity_list_tb_watch w CROSS JOIN win WHERE w.purpose = 'watch' AND (w.expires_at IS NULL OR w.expires_at > win.ts) AND CASE w.match WHEN 'key' THEN w.entry = b.entity_key WHEN 'prefix' THEN starts_with(b.entity_key, w.entry) WHEN 'range' THEN length(b.entity_key) = length(w.lo) AND b.entity_key BETWEEN w.lo AND w.hi ELSE false END) AS watched FROM base b ), hist AS ( SELECT t.entity_key, count(*) FILTER (WHERE t.high AND date_diff('day', CAST(t.window_date AS DATE), win.d) < CAST($persist_window AS INTEGER)) AS prior_hits, arg_max(t.shape_sig, CAST(t.window_date AS DATE)) FILTER (WHERE t.allowed) AS prev_sig FROM tb_findings t CROSS JOIN win WHERE CAST(t.window_date AS DATE) < win.d GROUP BY t.entity_key ), fin AS ( SELECT l.*, coalesce(h.prior_hits, 0) + CASE WHEN l.high THEN 1 ELSE 0 END AS persist_hits, h.prev_sig, CAST($persist_days AS INTEGER) - CASE WHEN l.watched THEN 1 ELSE 0 END AS needed FROM lst l LEFT JOIN hist h ON h.entity_key = l.entity_key WHERE l.high OR l.allowed ), st AS ( SELECT *, CASE WHEN allowed THEN 'allowed' WHEN primary_signals < CAST($min_signals AS INTEGER) THEN 'agreement' WHEN persist_hits < needed THEN 'persistence' WHEN CAST($shadow AS BOOLEAN) THEN 'shadow' ELSE 'alert' END AS status FROM fin ) SELECT entity_key, 'SIM' AS kind, score, high, primary_signals, status, CASE WHEN status = 'alert' THEN score ELSE 0.0 END AS alert_score, array_to_string(list_transform(list_slice(list_sort(list_transform(list_filter(CAST(factors AS JSON[]), x -> CAST(json_extract(x, 'contribution') AS DOUBLE) > 0), x -> {'k': -CAST(json_extract(x, 'contribution') AS DOUBLE), 'i': json_extract_string(x, 'indicator')})), 1, 3), y -> y.i), ',') AS top_factors, est_bypass_minutes, allowed, watched, persist_hits, shape_sig, CASE WHEN allowed AND prev_sig IS NOT NULL AND prev_sig <> shape_sig AND NOT CAST($shadow AS BOOLEAN) THEN 1 ELSE 0 END AS shape_changed, evidence_ids, factors, CAST($window_start AS DATE) AS window_date FROM st"
  sources: "tb_factors,risk_scores_tb_sim_latest,tb_findings,entity_list_tb_allow,entity_list_tb_watch"
  sink_dataset: tb_findings
  cron: "30 3 * * *"
  window_start: "$yesterday"
  window_end: "$today"
  day: "$yesterday"
  incremental:
    by: day
    column: window_date
    lookback: 1
    retain: 31
  min_signals: "5"
  persist_days: "2"
  persist_window: "3"
  shadow: "false"
  enabled: true
