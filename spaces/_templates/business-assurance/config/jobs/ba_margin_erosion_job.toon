job:
  name: ba_margin_erosion
  type: sql.template
  sql: "WITH p AS (SELECT 10 AS min_lines, 1000.0 AS min_revenue), w AS (SELECT max(ds) AS last_ds FROM margin_lines), a AS (SELECT m.product, m.channel, m.partner, sum(m.revenue) AS revenue, sum(m.cost) AS cost, count(*) FILTER (WHERE m.ds <= w.last_ds - 28) AS base_lines, count(*) FILTER (WHERE m.ds > w.last_ds - 28) AS recent_lines, sum(m.revenue) FILTER (WHERE m.ds <= w.last_ds - 28) AS base_revenue, sum(m.cost) FILTER (WHERE m.ds <= w.last_ds - 28) AS base_cost, sum(m.revenue) FILTER (WHERE m.ds > w.last_ds - 28) AS recent_revenue, sum(m.cost) FILTER (WHERE m.ds > w.last_ds - 28) AS recent_cost, count(*) FILTER (WHERE m.cost IS NULL OR m.revenue IS NULL) AS null_lines, count(*) FILTER (WHERE m.revenue < 0 OR m.cost < 0) AS negative_lines FROM margin_lines m CROSS JOIN w WHERE m.ds > w.last_ds - 56 GROUP BY m.product, m.channel, m.partner), c AS (SELECT a.*, CASE WHEN a.null_lines > 0 OR a.negative_lines > 0 THEN 'data_quality' WHEN a.base_lines = 0 THEN 'new' WHEN a.base_lines < p.min_lines OR a.recent_lines < p.min_lines OR coalesce(a.base_revenue, 0) < p.min_revenue OR coalesce(a.recent_revenue, 0) < p.min_revenue THEN 'insufficient' ELSE 'assessed' END AS status FROM a CROSS JOIN p), q AS (SELECT *, 100.0 * (base_revenue - base_cost) / NULLIF(base_revenue, 0) AS base_pct, 100.0 * (recent_revenue - recent_cost) / NULLIF(recent_revenue, 0) AS recent_pct FROM c) SELECT product, channel, partner, status, base_lines, recent_lines, null_lines, negative_lines, CASE WHEN status = 'data_quality' THEN 1 ELSE 0 END AS data_quality_issue, ROUND(revenue, 2) AS revenue, ROUND(cost, 2) AS cost, ROUND(revenue - cost, 2) AS margin, ROUND(100.0 * (revenue - cost) / NULLIF(revenue, 0), 2) AS margin_pct, ROUND(base_pct, 2) AS baseline_margin_pct, ROUND(recent_pct, 2) AS recent_margin_pct, CASE WHEN status = 'assessed' THEN ROUND(base_pct - recent_pct, 2) END AS erosion_pp FROM q ORDER BY product, channel, partner"
  sources: margin_lines
  sink_dataset: margin_erosion
  cron: "0 6 * * *"
  enabled: false
