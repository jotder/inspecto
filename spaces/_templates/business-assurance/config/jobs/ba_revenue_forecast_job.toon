job:
  name: ba_revenue_forecast
  type: sql.template
  sql: "WITH RECURSIVE s AS (SELECT CAST(row_number() OVER (ORDER BY ds) AS INTEGER) AS t, ds, CAST(revenue AS DOUBLE) AS y FROM daily_revenue), p AS (SELECT 0.25 AS a, 0.02 AS b, 0.15 AS g, 4.0 AS z, 28 AS warmup, 3 AS regime_k, 0.25 AS cusum_k, 8.0 AS cusum_h), d AS (SELECT y - lag(y, 7) OVER (ORDER BY t) AS d FROM s), sig AS (SELECT 1.4826 * median(abs(d - (SELECT median(d) FROM d))) / sqrt(2.0) AS sigma FROM d WHERE d IS NOT NULL), init AS (SELECT avg(y) FILTER (WHERE t <= 7) AS l0, (avg(y) FILTER (WHERE t BETWEEN 8 AND 14) - avg(y) FILTER (WHERE t <= 7)) / 7.0 AS b0, list(y ORDER BY t) FILTER (WHERE t <= 7) AS y0 FROM s), hw AS (SELECT 7 AS t, l0 AS lvl, b0 AS tr, list_transform(y0, x -> x - l0) AS seas, CAST(NULL AS DOUBLE) AS f, 0 AS out_raw, 0 AS run_at, 0 AS regime, 0 AS drift, 0 AS run, CAST(0 AS DOUBLE) AS sp, CAST(0 AS DOUBLE) AS sn, 0 AS np, 0 AS nn FROM init UNION ALL SELECT t, lvl, CASE WHEN regime = 1 THEN ptr WHEN drift = 1 THEN ptr + dslope ELSE b * (lvl - plvl) + (1 - b) * ptr END AS tr, CASE WHEN regime = 1 OR drift = 1 THEN seas ELSE list_transform(seas, (x, i) -> CASE WHEN i = k THEN g * (yc - lvl) + (1 - g) * so ELSE x END) END AS seas, f, out_raw, run_at, regime, drift, CASE WHEN regime = 1 OR drift = 1 THEN 0 ELSE run_at END AS run, CASE WHEN regime = 1 OR drift = 1 THEN CAST(0 AS DOUBLE) ELSE sp1 END AS sp, CASE WHEN regime = 1 OR drift = 1 THEN CAST(0 AS DOUBLE) ELSE sn1 END AS sn, CASE WHEN regime = 1 OR drift = 1 OR sp1 = 0 THEN 0 ELSE np1 END AS np, CASE WHEN regime = 1 OR drift = 1 OR sn1 = 0 THEN 0 ELSE nn1 END AS nn FROM (SELECT *, CASE WHEN regime = 1 OR drift = 1 THEN yc - so ELSE a * (yc - so) + (1 - a) * (plvl + ptr) END AS lvl, CASE WHEN sp1 > cusum_h THEN 2.0 * (sp1 + cusum_k * np1) * sigma / (np1 * (np1 + 1.0)) WHEN sn1 > cusum_h THEN -2.0 * (sn1 + cusum_k * nn1) * sigma / (nn1 * (nn1 + 1.0)) ELSE 0.0 END AS dslope FROM (SELECT *, CASE WHEN regime = 1 THEN y WHEN out_raw = 1 THEN f ELSE y END AS yc, CASE WHEN regime = 0 AND out_raw = 0 AND (sp1 > cusum_h OR sn1 > cusum_h) THEN 1 ELSE 0 END AS drift FROM (SELECT *, CASE WHEN run_at >= regime_k THEN 1 ELSE 0 END AS regime, CASE WHEN out_raw = 1 THEN psp ELSE greatest(0.0, psp + (y - f) / sigma - cusum_k) END AS sp1, CASE WHEN out_raw = 1 THEN psn ELSE greatest(0.0, psn - (y - f) / sigma - cusum_k) END AS sn1, CASE WHEN out_raw = 1 THEN pnp ELSE pnp + 1 END AS np1, CASE WHEN out_raw = 1 THEN pnn ELSE pnn + 1 END AS nn1 FROM (SELECT *, CASE WHEN out_raw = 1 THEN prun + 1 ELSE 0 END AS run_at FROM (SELECT *, CASE WHEN abs(y - f) > z * sigma THEN 1 ELSE 0 END AS out_raw FROM (SELECT s.t, s.y, CAST((s.t - 1) % 7 AS INTEGER) + 1 AS k, hw.seas[CAST((s.t - 1) % 7 AS INTEGER) + 1] AS so, hw.lvl + hw.tr + hw.seas[CAST((s.t - 1) % 7 AS INTEGER) + 1] AS f, hw.lvl AS plvl, hw.tr AS ptr, hw.seas, hw.run AS prun, hw.sp AS psp, hw.sn AS psn, hw.np AS pnp, hw.nn AS pnn, p.a, p.b, p.g, p.z, p.regime_k, p.cusum_k, p.cusum_h, sig.sigma FROM hw JOIN s ON s.t = hw.t + 1 CROSS JOIN p CROSS JOIN sig) x0) x1) x2) x3) x4) x5), r AS (SELECT hw.*, sum(CASE WHEN hw.out_raw = 0 THEN 1 ELSE 0 END) OVER (ORDER BY hw.t) AS grp FROM hw WHERE hw.f IS NOT NULL), rl AS (SELECT r.*, max(r.run_at) OVER (PARTITION BY r.grp) AS run_len FROM r) SELECT s.ds, s.y AS actual, ROUND(rl.f, 2) AS forecast, ROUND(rl.f - p.z * sig.sigma, 2) AS lower_band, ROUND(rl.f + p.z * sig.sigma, 2) AS upper_band, CASE WHEN s.t > p.warmup AND rl.out_raw = 1 AND rl.run_len < p.regime_k THEN 1 ELSE 0 END AS outside_band, CASE WHEN s.t > p.warmup AND rl.regime = 1 THEN 1 ELSE 0 END AS regime_change, CASE WHEN s.t > p.warmup AND rl.drift = 1 THEN 1 ELSE 0 END AS drift_change, CASE WHEN s.t > p.warmup THEN 0 ELSE 1 END AS warmup FROM rl JOIN s ON s.t = rl.t CROSS JOIN p CROSS JOIN sig ORDER BY s.ds"
  sources: daily_revenue
  sink_dataset: revenue_forecast
  cron: "0 6 * * *"
  enabled: false
