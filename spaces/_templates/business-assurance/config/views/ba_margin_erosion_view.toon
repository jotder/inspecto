store: ba_margin_erosion
pipeline: business-assurance
source_store[0]:
derived_sql: "WITH margin_lines AS (SELECT ds, product, channel, partner, units, CAST(ROUND(units * price, 2) AS DOUBLE) AS revenue, ROUND(units * price * cost_ratio, 2) AS cost, CAST(ROUND(units * price, 2) AS DOUBLE) - ROUND(units * price * cost_ratio, 2) AS margin FROM (SELECT CAST(DATE '2026-01-05' + CAST(d AS INTEGER) AS DATE) AS ds, pr.product, ch.channel, pa.partner, CAST(ROUND((20.0 + 10.0 * ((d * 0.6180339887498949 + pr.i * 0.7548776662466927 + ch.i * 0.5698402909980532 + pa.i * 0.4142135623730950 + 0.20260930) % 1.0)) * CASE WHEN pr.product = 'P2' AND ch.channel = 'retail' AND pa.partner = 'PC' AND d >= 28 THEN 0.5 ELSE 1.0 END) AS INTEGER) AS units, pr.price * ch.price_factor AS price, (1.0 - pr.base_margin) / ch.price_factor * (1.0 + 0.02 * (((d * 0.7548776662466927 + pr.i * 0.4142135623730950 + ch.i * 0.6180339887498949 + pa.i * 0.5698402909980532 + 0.30092026) % 1.0) - 0.5)) * CASE WHEN pr.product = 'P3' AND ch.channel = 'online' AND pa.partner = 'PB' AND d >= 28 THEN 1.15 WHEN pr.product = 'P1' AND ch.channel = 'online' AND pa.partner = 'PA' AND d >= 28 THEN 1.03 ELSE 1.0 END AS cost_ratio FROM range(56) r(d) CROSS JOIN (VALUES (1, 'P1', 50.0, 0.40), (2, 'P2', 80.0, 0.30), (3, 'P3', 120.0, 0.25), (4, 'P4', 30.0, 0.08)) pr(i, product, price, base_margin) CROSS JOIN (VALUES (1, 'online', 1.00), (2, 'retail', 1.05), (3, 'wholesale', 0.97)) ch(i, channel, price_factor) CROSS JOIN (VALUES (1, 'PA'), (2, 'PB'), (3, 'PC')) pa(i, partner)) g) SELECT * FROM (WITH w AS (SELECT max(ds) AS last_ds FROM margin_lines), a AS (SELECT m.product, m.channel, m.partner, sum(m.revenue) AS revenue, sum(m.cost) AS cost, sum(m.revenue) FILTER (WHERE m.ds <= w.last_ds - 28) AS base_revenue, sum(m.cost) FILTER (WHERE m.ds <= w.last_ds - 28) AS base_cost, sum(m.revenue) FILTER (WHERE m.ds > w.last_ds - 28) AS recent_revenue, sum(m.cost) FILTER (WHERE m.ds > w.last_ds - 28) AS recent_cost FROM margin_lines m CROSS JOIN w WHERE m.ds > w.last_ds - 56 GROUP BY m.product, m.channel, m.partner), p AS (SELECT *, 100.0 * (base_revenue - base_cost) / NULLIF(base_revenue, 0) AS base_pct, 100.0 * (recent_revenue - recent_cost) / NULLIF(recent_revenue, 0) AS recent_pct FROM a) SELECT product, channel, partner, ROUND(revenue, 2) AS revenue, ROUND(cost, 2) AS cost, ROUND(revenue - cost, 2) AS margin, ROUND(100.0 * (revenue - cost) / NULLIF(revenue, 0), 2) AS margin_pct, ROUND(base_pct, 2) AS baseline_margin_pct, ROUND(recent_pct, 2) AS recent_margin_pct, ROUND(base_pct - recent_pct, 2) AS erosion_pp FROM p ORDER BY product, channel, partner) AS f"
