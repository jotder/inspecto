store: ba_revenue_forecast
pipeline: business-assurance
source_store[0]:
derived_sql: "WITH daily_revenue AS (SELECT CAST(DATE '2026-01-05' + CAST(t AS INTEGER) AS DATE) AS ds, ROUND(1000.0 + 2.0 * t + list_extract([-120.0, -60.0, 0.0, 40.0, 80.0, 150.0, -90.0], CAST(t % 7 AS INTEGER) + 1) + 20.0 * sqrt(-2.0 * ln(u1)) * cos(2.0 * pi() * u2) + CASE WHEN t = 150 THEN -400.0 WHEN t = 120 THEN 60.0 ELSE 0.0 END, 2) AS revenue FROM (SELECT t, ((t + 1) * 0.6180339887498949 + 0.20260930) % 1.0 AS u1, ((t + 1) * 0.7548776662466927 + 0.30092026) % 1.0 AS u2 FROM range(182) r(t)) g) SELECT * FROM (WITH RECURSIVE s AS (SELECT CAST(row_number() OVER (ORDER BY ds) AS INTEGER) AS t, ds, CAST(revenue AS DOUBLE) AS y FROM daily_revenue), p AS (SELECT 0.25 AS a, 0.02 AS b, 0.15 AS g, 4.0 AS z, 28 AS warmup), d AS (SELECT y - lag(y, 7) OVER (ORDER BY t) AS d FROM s), sig AS (SELECT 1.4826 * median(abs(d - (SELECT median(d) FROM d))) / sqrt(2.0) AS sigma FROM d WHERE d IS NOT NULL), init AS (SELECT avg(y) FILTER (WHERE t <= 7) AS l0, (avg(y) FILTER (WHERE t BETWEEN 8 AND 14) - avg(y) FILTER (WHERE t <= 7)) / 7.0 AS b0, list(y ORDER BY t) FILTER (WHERE t <= 7) AS y0 FROM s), hw AS (SELECT 7 AS t, l0 AS lvl, b0 AS tr, list_transform(y0, x -> x - l0) AS seas, CAST(NULL AS DOUBLE) AS f FROM init UNION ALL SELECT t, lvl, b * (lvl - plvl) + (1 - b) * ptr AS tr, list_transform(seas, (x, i) -> CASE WHEN i = k THEN g * (yc - lvl) + (1 - g) * so ELSE x END) AS seas, f FROM (SELECT t, k, so, f, yc, plvl, ptr, seas, b, g, a * (yc - so) + (1 - a) * (plvl + ptr) AS lvl FROM (SELECT t, k, so, f, plvl, ptr, seas, a, b, g, CASE WHEN abs(y - f) > z * sigma THEN f ELSE y END AS yc FROM (SELECT s.t, s.y, CAST((s.t - 1) % 7 AS INTEGER) + 1 AS k, hw.seas[CAST((s.t - 1) % 7 AS INTEGER) + 1] AS so, hw.lvl + hw.tr + hw.seas[CAST((s.t - 1) % 7 AS INTEGER) + 1] AS f, hw.lvl AS plvl, hw.tr AS ptr, hw.seas, p.a, p.b, p.g, p.z, sig.sigma FROM hw JOIN s ON s.t = hw.t + 1 CROSS JOIN p CROSS JOIN sig) x1) x2) x3) SELECT s.ds, s.y AS actual, ROUND(hw.f, 2) AS forecast, ROUND(hw.f - p.z * sig.sigma, 2) AS lower_band, ROUND(hw.f + p.z * sig.sigma, 2) AS upper_band, CASE WHEN s.t > p.warmup AND abs(s.y - hw.f) > p.z * sig.sigma THEN 1 ELSE 0 END AS outside_band, CASE WHEN s.t > p.warmup THEN 0 ELSE 1 END AS warmup FROM hw JOIN s ON s.t = hw.t CROSS JOIN p CROSS JOIN sig WHERE hw.f IS NOT NULL ORDER BY s.ds) AS f"
