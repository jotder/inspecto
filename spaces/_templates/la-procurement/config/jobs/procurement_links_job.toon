job:
  name: procurement_links
  type: sql.template
  description: "Folds the procurement feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via, market), one row per pair. bid_on: a bidder to a tender (amount = the bid, via = its rank and how far above the award it was); won: the winner to the tender (amount = award value, via = number of bids and the estimate); directed_by: a company to a director (via = the dates, and the debarment day of a debarred company); same_ip: a bidder to an IP address that another bidder also submitted from (amount = bids, via = the tenders and the fewest minutes to another bidder's bid from that address on the same tender); same_author: a bidder to a document author that another bidder's bids also carry (a blank or placeholder author such as Administrator is no evidence and makes no link); approved_change: an official to the firm whose contract they changed (amount = value added, via = number of changes and the tenders); lives_at: a person to their home address. market is the tender category of a tender link, or the category a company mostly bids in for its own links. Ids say what an endpoint is: CO- company, T- tender, P- person, AD- home address, an IP address, or a document author. Runs after every Pipeline commit, and every 5 minutes as well: a commit that lands while a run is in flight is skipped, not queued (JOB-SIGNAL-OVERLAP-SKIP-1), so the cron catches up the last landing."
  sql: "WITH t AS (SELECT tender_id, category, estimate, TRY_CAST(nullif(CAST(awarded_at AS VARCHAR), '') AS DATE) AS awarded_at, nullif(trim(awarded_to), '') AS awarded_to, award_value FROM tender), b AS (SELECT bid_id, tender_id, bidder_id, amount, submitted_at, nullif(trim(ip), '') AS ip, nullif(trim(doc_author), '') AS author FROM bid), bt AS (SELECT b.*, t.category, t.awarded_to, t.award_value, count(*) OVER (PARTITION BY b.tender_id) AS n, rank() OVER (PARTITION BY b.tender_id ORDER BY b.amount) AS rk FROM b JOIN t USING (tender_id)), cc AS (SELECT bidder_id, category, count(*) AS k FROM bt GROUP BY ALL), mk AS (SELECT bidder_id AS company_id, first(category ORDER BY k DESC, category) AS market FROM cc GROUP BY bidder_id), bo AS (SELECT bidder_id AS src, tender_id AS dst, 'bid_on' AS kind, submitted_at AS ts, amount, 'rank:' || rk || '/' || n || CASE WHEN award_value > 0 AND bidder_id <> coalesce(awarded_to, '') THEN '|vs_award:' || CASE WHEN amount >= award_value THEN '+' ELSE '' END || round(100 * (amount / award_value - 1), 1) || '%' ELSE '' END AS via, category AS market FROM bt), nb AS (SELECT tender_id, count(*) AS bids FROM b GROUP BY tender_id), wn AS (SELECT awarded_to AS src, tender_id AS dst, 'won' AS kind, CAST(awarded_at AS TIMESTAMP) AS ts, award_value AS amount, 'bids:' || coalesce(nb.bids, 0) || '|estimate:' || CAST(round(estimate) AS BIGINT) AS via, category AS market FROM t LEFT JOIN nb USING (tender_id) WHERE awarded_to IS NOT NULL AND awarded_at IS NOT NULL), co AS (SELECT company_id, TRY_CAST(nullif(CAST(debarred_at AS VARCHAR), '') AS DATE) AS deb FROM company), d AS (SELECT company_id, person_id, CAST(from_date AS DATE) AS f, TRY_CAST(nullif(CAST(to_date AS VARCHAR), '') AS DATE) AS tod FROM director), db AS (SELECT d.company_id AS src, d.person_id AS dst, 'directed_by' AS kind, CAST(min(d.f) AS TIMESTAMP) AS ts, 0.0 AS amount, string_agg('from:' || strftime(d.f, '%Y-%m-%d') || '|to:' || coalesce(strftime(d.tod, '%Y-%m-%d'), ''), ';' ORDER BY d.f) || coalesce('|company_debarred:' || strftime(max(co.deb), '%Y-%m-%d'), '') AS via, coalesce(max(mk.market), '') AS market FROM d LEFT JOIN co USING (company_id) LEFT JOIN mk USING (company_id) GROUP BY d.company_id, d.person_id), gap AS (SELECT x.bidder_id, x.ip, min(abs(date_diff('minute', x.submitted_at, y.submitted_at))) AS g FROM b x JOIN b y ON x.tender_id = y.tender_id AND x.ip = y.ip AND x.bidder_id <> y.bidder_id GROUP BY x.bidder_id, x.ip), ipu AS (SELECT ip FROM b WHERE ip IS NOT NULL GROUP BY ip HAVING count(DISTINCT bidder_id) >= 2), si AS (SELECT b.bidder_id AS src, b.ip AS dst, 'same_ip' AS kind, min(b.submitted_at) AS ts, CAST(count(*) AS DOUBLE) AS amount, 'bids:' || count(*) || '|same_tender_gap_min:' || coalesce(CAST(max(gap.g) AS VARCHAR), 'none') || '|tenders:' || string_agg(DISTINCT b.tender_id, '|' ORDER BY b.tender_id) AS via, coalesce(max(mk.market), '') AS market FROM b LEFT JOIN gap ON gap.bidder_id = b.bidder_id AND gap.ip = b.ip LEFT JOIN mk ON mk.company_id = b.bidder_id WHERE b.ip IN (SELECT ip FROM ipu) GROUP BY b.bidder_id, b.ip), ba AS (SELECT * FROM b WHERE author IS NOT NULL AND lower(author) NOT IN ('administrator', 'admin', 'user', 'owner', 'author', 'unknown')), auu AS (SELECT author FROM ba GROUP BY author HAVING count(DISTINCT bidder_id) >= 2), sa AS (SELECT ba.bidder_id AS src, ba.author AS dst, 'same_author' AS kind, min(ba.submitted_at) AS ts, CAST(count(*) AS DOUBLE) AS amount, 'bids:' || count(*) || '|tenders:' || string_agg(DISTINCT ba.tender_id, '|' ORDER BY ba.tender_id) AS via, coalesce(max(mk.market), '') AS market FROM ba LEFT JOIN mk ON mk.company_id = ba.bidder_id WHERE ba.author IN (SELECT author FROM auu) GROUP BY ba.bidder_id, ba.author), ac AS (SELECT c.approved_by AS src, t.awarded_to AS dst, 'approved_change' AS kind, CAST(min(CAST(c.approved_at AS DATE)) AS TIMESTAMP) AS ts, sum(c.change_value) AS amount, 'changes:' || count(*) || '|tenders:' || string_agg(DISTINCT c.tender_id, '|' ORDER BY c.tender_id) AS via, min(t.category) AS market FROM contract_change c JOIN t USING (tender_id) WHERE t.awarded_to IS NOT NULL GROUP BY c.approved_by, t.awarded_to), la AS (SELECT person_id AS src, address_id AS dst, 'lives_at' AS kind, TIMESTAMP '2025-10-01 00:00:00' AS ts, 0.0 AS amount, '' AS via, '' AS market FROM procurement_person WHERE nullif(trim(address_id), '') IS NOT NULL), links AS (SELECT * FROM bo UNION ALL SELECT * FROM wn UNION ALL SELECT * FROM db UNION ALL SELECT * FROM si UNION ALL SELECT * FROM sa UNION ALL SELECT * FROM ac UNION ALL SELECT * FROM la) SELECT src, dst, kind, ts, round(amount, 2) AS amount, CAST(ts AS DATE) AS event_date, via, market FROM links ORDER BY kind, src, dst"
  sources: tender,bid,company,director,procurement_person,contract_change
  sink_dataset: procurement_links
  on_signal: pipeline.commit
  cron: "*/5 * * * *"
  enabled: true
