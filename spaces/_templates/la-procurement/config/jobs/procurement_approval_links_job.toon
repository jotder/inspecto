job:
  name: procurement_approval_links
  type: sql.template
  description: "Derived from procurement_links each time it is produced: contract-change approvals and shared homes. Every approved_change link (official to the firm whose contract they changed); of the officials and the directors of those firms, the home addresses that two or more of them share (lives_at); and the directorships of the people at those shared homes (directed_by). Keeping only shared homes holds the saved view procurement_change_approvals under the canvas's 1 000 nodes."
  sql: "WITH ac AS (SELECT * FROM procurement_links WHERE kind = 'approved_change'), db AS (SELECT * FROM procurement_links WHERE kind = 'directed_by' AND src IN (SELECT dst FROM ac)), people AS (SELECT src AS p FROM ac UNION SELECT dst FROM db), la AS (SELECT * FROM procurement_links WHERE kind = 'lives_at' AND src IN (SELECT p FROM people)), shared AS (SELECT dst FROM la GROUP BY dst HAVING count(DISTINCT src) >= 2), las AS (SELECT * FROM la WHERE dst IN (SELECT dst FROM shared)), dbs AS (SELECT * FROM db WHERE dst IN (SELECT src FROM las)), links AS (SELECT * FROM ac UNION ALL SELECT * FROM las UNION ALL SELECT * FROM dbs) SELECT src, dst, kind, ts, amount, event_date, via, market FROM links ORDER BY kind, src, dst"
  sources: procurement_links
  sink_dataset: procurement_approval_links
  on_signal: job.dataset.produced
  when: "$signal.dataset == procurement_links"
  enabled: true
