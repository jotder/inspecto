name: contract_change
active: true
description: "Bid rigging and procurement fraud Link Analysis showcase - One row per approved contract change (a variation that raises the contract value): tender, the value added, the official who approved it and the day. One landed extract; the next month is in data/staged. Synthetic; regenerate with tools/gen-la-procurement-data.py."

dirs:
  poll:       data/inbox/contract_change
  database:   data/contract_change/database
  backup:     data/contract_change/backup
  temp:       data/contract_change/temp
  errors:     data/contract_change/errors
  quarantine: data/contract_change/quarantine
  markers:    data/contract_change/markers
  status_dir: data/contract_change/status
  log_dir:    data/contract_change/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: contract_change_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
