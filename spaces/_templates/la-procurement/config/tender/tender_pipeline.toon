name: tender
active: true
description: "Bid rigging and procurement fraud Link Analysis showcase - One row per tender: buyer unit, category, estimate, the day it was published and, once decided, the day it was awarded, the winner and the award value (blank while open). One file per month of publication (TENDER_YYYYMM.csv); the next month is in data/staged. Synthetic; regenerate with tools/gen-la-procurement-data.py."

dirs:
  poll:       data/inbox/tender
  database:   data/tender/database
  backup:     data/tender/backup
  temp:       data/tender/temp
  errors:     data/tender/errors
  quarantine: data/tender/quarantine
  markers:    data/tender/markers
  status_dir: data/tender/status
  log_dir:    data/tender/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: tender_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
