name: officer
active: true
description: "Beneficial-ownership and sanctions Link Analysis showcase - One row per officer appointment: company, person and role (director or secretary). One extract (OFFICER_20260930.csv). Synthetic; regenerate with tools/gen-la-ownership-data.py."

dirs:
  poll:       data/inbox/officer
  database:   data/officer/database
  backup:     data/officer/backup
  temp:       data/officer/temp
  errors:     data/officer/errors
  quarantine: data/officer/quarantine
  markers:    data/officer/markers
  status_dir: data/officer/status
  log_dir:    data/officer/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: officer_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
