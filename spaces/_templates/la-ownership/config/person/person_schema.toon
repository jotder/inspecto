raw:
  name: PERSON
  format: CSV
  fields[4]{name,selector,type}:
    person_id,"0",VARCHAR
    name,"1",VARCHAR
    birth_year,"2",VARCHAR
    nationality,"3",VARCHAR
mapping:
  canonicalName: person
  rawName: PERSON
  fields[4]:
    - name: person_id
      from: person_id
      fn: keep
    - name: name
      from: name
      fn: keep
    - name: birth_year
      from: birth_year
      fn: keep
    - name: nationality
      from: nationality
      fn: keep
