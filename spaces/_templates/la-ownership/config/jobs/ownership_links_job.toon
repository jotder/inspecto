job:
  name: ownership_links
  type: sql.template
  description: "Folds the ownership feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, percent, score, event_date, via), one row per pair. owns: a person or company to the company it holds (percent = the stake, via = stake and the owned company's jurisdiction); officer_of: a person to the company they are an officer of (via = role and registered address); customer_is: a bank customer to the company it is; paid: a customer to a company it paid (amount = payments summed); name_match: a person to a sanctions-list entry whose name or an alias scores at least min_name_score on DuckDB jaro_winkler_similarity (lower case, letters only) with the SAME birth year and nationality (score = the best match, via = the listed name it matched). A person with a blank birth year or nationality is never matched. Runs after every Pipeline commit."
  sql: "WITH co AS (SELECT company_id, min(incorporated_at) AS inc, max(jurisdiction) AS jur, max(reg_address) AS addr FROM company GROUP BY company_id), ow AS (SELECT o.owner_id AS src, o.owned_id AS dst, 'owns' AS kind, CAST(coalesce(min(c.inc), DATE '2025-10-01') AS TIMESTAMP) AS ts, 0.0 AS amount, CAST(sum(o.percent) AS DOUBLE) AS percent, CAST(NULL AS DOUBLE) AS score, 'stake:' || CAST(round(sum(o.percent), 2) AS VARCHAR) || '%|jurisdiction:' || coalesce(max(c.jur), '') AS via FROM ownership o LEFT JOIN co c ON c.company_id = o.owned_id WHERE coalesce(o.owner_id, '') <> '' AND coalesce(o.owned_id, '') <> '' GROUP BY o.owner_id, o.owned_id), oc AS (SELECT f.person_id AS src, f.company_id AS dst, 'officer_of' AS kind, CAST(coalesce(min(c.inc), DATE '2025-10-01') AS TIMESTAMP) AS ts, 0.0 AS amount, CAST(NULL AS DOUBLE) AS percent, CAST(NULL AS DOUBLE) AS score, string_agg(DISTINCT 'role:' || f.role, '|' ORDER BY 'role:' || f.role) || '|address:' || coalesce(max(c.addr), '') AS via FROM officer f LEFT JOIN co c ON c.company_id = f.company_id WHERE coalesce(f.person_id, '') <> '' AND coalesce(f.company_id, '') <> '' GROUP BY f.person_id, f.company_id), ci AS (SELECT customer_id AS src, company_id AS dst, 'customer_is' AS kind, CAST(min(onboarded_at) AS TIMESTAMP) AS ts, 0.0 AS amount, CAST(NULL AS DOUBLE) AS percent, CAST(NULL AS DOUBLE) AS score, 'onboarded:' || CAST(min(onboarded_at) AS VARCHAR) AS via FROM customer WHERE coalesce(customer_id, '') <> '' AND coalesce(company_id, '') <> '' GROUP BY customer_id, company_id), pd AS (SELECT from_customer AS src, to_company AS dst, 'paid' AS kind, min(paid_at) AS ts, sum(amount) AS amount, CAST(NULL AS DOUBLE) AS percent, CAST(NULL AS DOUBLE) AS score, 'payments:' || CAST(count(*) AS VARCHAR) || '|last:' || CAST(CAST(max(paid_at) AS DATE) AS VARCHAR) AS via FROM payment WHERE coalesce(from_customer, '') <> '' AND coalesce(to_company, '') <> '' GROUP BY from_customer, to_company), pn AS (SELECT person_id, trim(regexp_replace(regexp_replace(lower(name), '[^a-z ]', '', 'g'), ' +', ' ', 'g')) AS nm, trim(birth_year) AS byr, upper(trim(nationality)) AS nat FROM person WHERE coalesce(trim(birth_year), '') <> '' AND coalesce(trim(nationality), '') <> '' AND coalesce(trim(name), '') <> ''), cands AS (SELECT list_id, listed_at, trim(birth_year) AS byr, upper(trim(nationality)) AS nat, unnest(string_split(name || '|' || coalesce(aliases, ''), '|')) AS cand FROM sanctions_list), sl AS (SELECT list_id, listed_at, byr, nat, cand, trim(regexp_replace(regexp_replace(lower(cand), '[^a-z ]', '', 'g'), ' +', ' ', 'g')) AS nm FROM cands WHERE trim(cand) <> ''), sc AS (SELECT p.person_id, s.list_id, s.listed_at, s.byr, s.nat, s.cand, jaro_winkler_similarity(p.nm, s.nm) AS sim FROM pn p JOIN sl s ON s.byr = p.byr AND s.nat = p.nat), nm AS (SELECT person_id AS src, list_id AS dst, 'name_match' AS kind, CAST(min(listed_at) AS TIMESTAMP) AS ts, 0.0 AS amount, CAST(NULL AS DOUBLE) AS percent, round(max(sim), 3) AS score, 'listed_as:' || arg_max(cand, sim) || '|birth_year:' || min(byr) || '|nationality:' || min(nat) AS via FROM sc WHERE sim >= CAST($min_name_score AS DOUBLE) GROUP BY person_id, list_id), links AS (SELECT * FROM ow UNION ALL SELECT * FROM oc UNION ALL SELECT * FROM ci UNION ALL SELECT * FROM pd UNION ALL SELECT * FROM nm) SELECT src, dst, kind, ts, round(amount, 2) AS amount, percent, score, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: company,person,ownership,officer,customer,payment,sanctions_list
  sink_dataset: ownership_links
  on_signal: pipeline.commit
  min_name_score: "0.90"
  enabled: true
