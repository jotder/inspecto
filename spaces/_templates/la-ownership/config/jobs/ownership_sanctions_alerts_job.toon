job:
  name: ownership_sanctions_alerts
  type: alert.evaluate
  description: "Evaluates the Alert Rules each time the ownership_sanctions_counts Job produces its Dataset, so ownership_path_to_listed_person sees the new counts without anyone pressing Evaluate. On a build without Alert Rules (Basic) the rule is not armed and this Job finds nothing to evaluate."
  on_signal: job.dataset.produced
  when: "$signal.dataset == ownership_sanctions_counts"
  enabled: true
