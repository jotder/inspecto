name: circular_ownership
description: "Circular ownership - Ownership and money - stakes, customers and the payments between them (amount summed, payment count in via). Look for companies that own each other in a circle and pay each other round the same circle every month. A group with a clear parent at the top that charges its subsidiaries a monthly fee has no circle."
sourceId: entity-projection
layout: force
query:
  projection:
    datasetId: ownership_links_dataset
    sourceCol: src
    targetCol: dst
    linkKindCol: kind
    attrCols[5]: ts,amount,percent,score,via
  filter:
    kind: group
    op: OR
    items[3]{kind,field,operator,value}:
      condition,kind,"=","owns"
      condition,kind,"=","customer_is"
      condition,kind,"=","paid"
view:
  legend: true
  workingSet: true
  plugins:
    minimap: true
    hulls: true
    behaviors[1]: hover-activate
