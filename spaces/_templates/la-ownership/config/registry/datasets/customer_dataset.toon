physicalRef: customer/database
description: "Beneficial-ownership and sanctions Link Analysis showcase - One row per bank customer: the customer id, the company it is and the onboarding date. Landed by the customer Pipeline. Synthetic."
primaryEntityType: customer
columns[3]{name,type,classification}:
  customer_id,string,CUSTOMER
  company_id,string,COMPANY
  onboarded_at,date,
defaultLinkMapping:
  from: customer_id
  to: company_id
  primaryTime: onboarded_at
