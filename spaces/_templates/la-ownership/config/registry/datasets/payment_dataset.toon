physicalRef: payment/database
description: "Beneficial-ownership and sanctions Link Analysis showcase - One row per outgoing payment from a customer to a company: amount and time. Landed by the payment Pipeline. Synthetic."
eventDate: paid_at
primaryEntityType: customer
columns[5]{name,type,classification}:
  payment_id,string,
  from_customer,string,CUSTOMER
  to_company,string,COMPANY
  amount,number,
  paid_at,timestamp,
defaultLinkMapping:
  from: from_customer
  to: to_company
  primaryTime: paid_at
  primaryMeasure: amount
