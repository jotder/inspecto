raw:
  name: PAYMENT
  format: CSV
  fields[5]{name,selector,type}:
    payment_id,"0",VARCHAR
    from_customer,"1",VARCHAR
    to_company,"2",VARCHAR
    amount,"3",DOUBLE
    paid_at,"4",TIMESTAMP
mapping:
  canonicalName: payment
  rawName: PAYMENT
  fields[5]:
    - name: payment_id
      from: payment_id
      fn: keep
    - name: from_customer
      from: from_customer
      fn: keep
    - name: to_company
      from: to_company
      fn: keep
    - name: amount
      from: amount
      fn: keep
    - name: paid_at
      from: paid_at
      fn: keep
