entityType: account
highThreshold: 60
factors[4]:
  - id: sim_swap_payments
    label: "Approved new-device payments after a SIM change"
    dataset: pf_sim_swap_payments
    key: account_id
    measure: "max(risky_payments)"
    weight: 60
    cap: 60
  - id: velocity
    label: "Most attempts by one instrument inside 60 minutes"
    dataset: pf_instrument_velocity
    key: account_id
    measure: "max(max_attempts_in_window)"
    weight: 5
    cap: 40
  - id: declines
    label: "Declined attempts"
    dataset: pf_account_activity
    key: account_id
    measure: "max(declined_attempts)"
    weight: 4
    cap: 20
  - id: disputes
    label: "Disputes opened"
    dataset: pf_account_activity
    key: account_id
    measure: "max(disputes)"
    weight: 20
    cap: 40
