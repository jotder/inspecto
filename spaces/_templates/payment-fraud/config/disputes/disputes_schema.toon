partitionKey: OPENED_DATE
raw:
  name: DISPUTES
  format: CSV
  fields[6]{name,selector,type,description,unit,classification}:
    DISPUTE_ID,"0",VARCHAR,"Dispute identifier","","INTERNAL"
    OPENED_DATE,"1",DATE,"Date the dispute was opened","","INTERNAL"
    ATTEMPT_ID,"2",VARCHAR,"The disputed payment attempt","","INTERNAL"
    ACCOUNT_ID,"3",VARCHAR,"Customer account (synthetic)","","INTERNAL"
    REASON_CODE,"4",VARCHAR,"Dispute reason code","","INTERNAL"
    AMOUNT,"5",DOUBLE,"Disputed amount","EUR","INTERNAL"
mapping:
  canonicalName: disputes
  rawName: DISPUTES
  fields[6]:
    - name: DISPUTE_ID
      from: DISPUTE_ID
      fn: keep
    - name: OPENED_DATE
      from: OPENED_DATE
      fn: keep
    - name: ATTEMPT_ID
      from: ATTEMPT_ID
      fn: keep
    - name: ACCOUNT_ID
      from: ACCOUNT_ID
      fn: keep
    - name: REASON_CODE
      from: REASON_CODE
      fn: keep
    - name: AMOUNT
      from: AMOUNT
      fn: keep
