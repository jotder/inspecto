name: payment_attempts
active: true

dirs:
  poll:       data/inbox/payment_attempts
  database:   data/payment_attempts/database
  backup:     data/payment_attempts/backup
  temp:       data/payment_attempts/temp
  errors:     data/payment_attempts/errors
  quarantine: data/payment_attempts/quarantine
  markers:    data/payment_attempts/markers
  status_dir: data/payment_attempts/status
  log_dir:    data/payment_attempts/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 2
  file_pattern: "glob:**/*.csv"
  reject_mode: all_or_nothing
  refusal: restricted_quarantine
  refusal_retention_days: 30
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: payment_attempts_schema.toon
  csv_settings:
    delimiter: ","
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  gap_detection:
    enabled: true
    sequence: "PAYMENT_ATTEMPTS_{yyyyMMdd}"
