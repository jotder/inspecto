partitionKey: ATTEMPT_DATE
raw:
  name: PAYMENT_ATTEMPTS
  format: CSV
  fields[11]{name,selector,type,description,unit,classification}:
    ATTEMPT_ID,"0",VARCHAR,"Payment attempt identifier","","INTERNAL"
    ATTEMPT_TS,"1",TIMESTAMP,"When the attempt reached the gateway","","INTERNAL"
    ATTEMPT_DATE,"2",DATE,"Business date of the attempt","","INTERNAL"
    ACCOUNT_ID,"3",VARCHAR,"Customer account (synthetic)","","INTERNAL"
    INSTRUMENT_TOKEN,"4",VARCHAR,"Tokenised payment instrument - never a card number","","INTERNAL"
    BIN,"5",VARCHAR,"Issuer identification number (first 6 digits of the instrument)","","INTERNAL"
    DEVICE_ID,"6",VARCHAR,"Device fingerprint token","","INTERNAL"
    MERCHANT_ID,"7",VARCHAR,"Merchant reference","","INTERNAL"
    AMOUNT,"8",DOUBLE,"Attempted amount","EUR","INTERNAL"
    CURRENCY,"9",VARCHAR,"ISO 4217 currency","","INTERNAL"
    OUTCOME,"10",VARCHAR,"APPROVED or DECLINED","","INTERNAL"
mapping:
  canonicalName: payment_attempts
  rawName: PAYMENT_ATTEMPTS
  fields[11]:
    - name: ATTEMPT_ID
      from: ""
      fn: custom
      args:
        expression: "CASE WHEN len(list_filter(list_transform(list_concat(regexp_extract_all(concat_ws('X', translate(ATTEMPT_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), CASE WHEN regexp_full_match(translate(ATTEMPT_TS, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), '[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2})?') THEN NULL ELSE translate(ATTEMPT_TS, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789') END, CASE WHEN regexp_full_match(translate(ATTEMPT_DATE, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), '[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2})?') THEN NULL ELSE translate(ATTEMPT_DATE, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789') END, translate(ACCOUNT_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(INSTRUMENT_TOKEN, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(BIN, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(DEVICE_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(MERCHANT_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(AMOUNT, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(CURRENCY, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(OUTCOME, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789')), '[0-9](?:[^0-9A-Za-z]{0,3}[0-9])*'), regexp_extract_all(concat_ws('X', translate(ATTEMPT_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), CASE WHEN regexp_full_match(translate(ATTEMPT_TS, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), '[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2})?') THEN NULL ELSE translate(ATTEMPT_TS, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789') END, CASE WHEN regexp_full_match(translate(ATTEMPT_DATE, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), '[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2})?') THEN NULL ELSE translate(ATTEMPT_DATE, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789') END, translate(ACCOUNT_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(INSTRUMENT_TOKEN, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(BIN, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(DEVICE_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(MERCHANT_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(AMOUNT, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(CURRENCY, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(OUTCOME, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789')), '[0-9]+')), lambda c: regexp_replace(c, '[^0-9]', '', 'g')), lambda d: length(d) BETWEEN 13 AND 19 AND list_sum(list_transform(range(1, length(d) + 1), lambda k: CASE WHEN k % 2 = 0 THEN TRY_CAST(substr(reverse(d), k, 1) AS INTEGER) * 2 - CASE WHEN TRY_CAST(substr(reverse(d), k, 1) AS INTEGER) > 4 THEN 9 ELSE 0 END ELSE TRY_CAST(substr(reverse(d), k, 1) AS INTEGER) END)) % 10 = 0)) > 0 THEN error('INGEST_PURGE_FILE: card-number tripwire: a Luhn-valid 13-19 digit number in a PAYMENT_ATTEMPTS row; only tokenised instruments may be ingested') ELSE ATTEMPT_ID END"
    - name: ATTEMPT_TS
      from: ATTEMPT_TS
      fn: keep
    - name: ATTEMPT_DATE
      from: ATTEMPT_DATE
      fn: keep
    - name: ACCOUNT_ID
      from: ACCOUNT_ID
      fn: keep
    - name: INSTRUMENT_TOKEN
      from: INSTRUMENT_TOKEN
      fn: keep
    - name: BIN
      from: BIN
      fn: keep
    - name: DEVICE_ID
      from: DEVICE_ID
      fn: keep
    - name: MERCHANT_ID
      from: MERCHANT_ID
      fn: keep
    - name: AMOUNT
      from: AMOUNT
      fn: keep
    - name: CURRENCY
      from: CURRENCY
      fn: keep
    - name: OUTCOME
      from: OUTCOME
      fn: keep
