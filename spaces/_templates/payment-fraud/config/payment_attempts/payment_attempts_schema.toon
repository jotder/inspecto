D length(g[i + 3]) = 4 AND length(g[i + 4]) = 3 THEN g[i + 0] || g[i + 1] || g[i + 2] || g[i + 3] || g[i + 4] END, CASE WHEN length(g[i + 0]) = 4 AND length(g[i + 1]) = 6 AND length(g[i + 2]) = 5 THEN g[i + 0] || g[i + 1] || g[i + 2] END, CASE WHEN length(g[i + 0]) = 4 AND length(g[i + 1]) = 6 AND length(g[i + 2]) = 4 THEN g[i + 0] || g[i + 1] || g[i + 2] END])))), lambda d: d IS NOT NULL AND regexp_matches(d, '^(4|5[1-5]|2[2-7]|3[47]|6)') AND list_sum(list_transform(range(1, length(d) + 1), lambda k: CASE WHEN k % 2 = 0 THEN CAST(substr(reverse(d), k, 1) AS INTEGER) * 2 - CASE WHEN CAST(substr(reverse(d), k, 1) AS INTEGER) > 4 THEN 9 ELSE 0 END ELSE CAST(substr(reverse(d), k, 1) AS INTEGER) END)) % 10 = 0)) > 0 THEN error('INGEST_REFUSE:CARD_NUMBER') ELSE ATTEMPT_ID END"
