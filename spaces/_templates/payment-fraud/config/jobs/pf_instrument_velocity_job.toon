job:
  name: pf_instrument_velocity
  type: sql.template
  sql: "WITH w AS (SELECT INSTRUMENT_TOKEN, ACCOUNT_ID, count(*) OVER (PARTITION BY INSTRUMENT_TOKEN ORDER BY ATTEMPT_TS RANGE BETWEEN to_minutes(CAST($window_minutes AS INTEGER)) PRECEDING AND CURRENT ROW) AS n FROM payment_attempts) SELECT INSTRUMENT_TOKEN AS instrument_token, ACCOUNT_ID AS account_id, max(n) AS max_attempts_in_window FROM w GROUP BY INSTRUMENT_TOKEN, ACCOUNT_ID"
  sources: payment_attempts
  sink_dataset: pf_instrument_velocity
  window_minutes: "60"
  cron: "0 * * * *"
  enabled: true
