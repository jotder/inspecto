job:
  name: pf_account_activity
  type: sql.template
  sql: "WITH a AS (SELECT ACCOUNT_ID, count(*) AS attempts, count(*) FILTER (WHERE OUTCOME = 'DECLINED') AS declined_attempts FROM payment_attempts GROUP BY ACCOUNT_ID), d AS (SELECT ACCOUNT_ID, count(*) AS disputes FROM disputes GROUP BY ACCOUNT_ID) SELECT COALESCE(a.ACCOUNT_ID, d.ACCOUNT_ID) AS account_id, COALESCE(a.attempts, 0) AS attempts, COALESCE(a.declined_attempts, 0) AS declined_attempts, COALESCE(d.disputes, 0) AS disputes FROM a FULL OUTER JOIN d ON a.ACCOUNT_ID = d.ACCOUNT_ID"
  sources: payment_attempts,disputes
  sink_dataset: pf_account_activity
  cron: "0 * * * *"
  enabled: true
