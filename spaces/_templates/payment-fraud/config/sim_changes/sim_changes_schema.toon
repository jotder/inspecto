partitionKey: EVENT_DATE
raw:
  name: SIM_CHANGES
  format: CSV
  fields[6]{name,selector,type,description,unit,classification}:
    EVENT_ID,"0",VARCHAR,"SIM-change event identifier","","INTERNAL"
    EVENT_TS,"1",TIMESTAMP,"When the SIM was changed","","INTERNAL"
    EVENT_DATE,"2",DATE,"Business date of the change","","INTERNAL"
    ACCOUNT_ID,"3",VARCHAR,"Customer account (synthetic)","","INTERNAL"
    SUBSCRIBER_TOKEN,"4",VARCHAR,"Tokenised subscriber","","INTERNAL"
    CHANNEL,"5",VARCHAR,"Where the SIM was changed (STORE/ONLINE/CALL_CENTRE)","","INTERNAL"
mapping:
  canonicalName: sim_changes
  rawName: SIM_CHANGES
  fields[6]:
    - name: EVENT_ID
      from: EVENT_ID
      fn: keep
    - name: EVENT_TS
      from: EVENT_TS
      fn: keep
    - name: EVENT_DATE
      from: EVENT_DATE
      fn: keep
    - name: ACCOUNT_ID
      from: ACCOUNT_ID
      fn: keep
    - name: SUBSCRIBER_TOKEN
      from: SUBSCRIBER_TOKEN
      fn: keep
    - name: CHANNEL
      from: CHANNEL
      fn: keep
