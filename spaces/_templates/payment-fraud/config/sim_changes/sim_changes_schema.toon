partitionKey: EVENT_DATE
raw:
  name: SIM_CHANGES
  format: CSV
  fields[6]{name,selector,type,description,unit,classification}:
    EVENT_ID,"0",VARCHAR,"SIM-change event identifier","","INTERNAL"
    EVENT_TS,"1",TIMESTAMP,"When the SIM was changed","","INTERNAL"
    EVENT_DATE,"2",DATE,"Business date of the change","","INTERNAL"
    ACCOUNT_ID,"3",VARCHAR,"Customer account (synthetic)","","INTERNAL"
    SUBSCRIBER_TOKEN,"4",VARCHAR,"Tokenised subscriber","","INTERNAL"
    CHANNEL,"5",VARCHAR,"Where the SIM was changed (STORE/ONLINE/CALL_CENTRE)","","INTERNAL"
mapping:
  canonicalName: sim_changes
  rawName: SIM_CHANGES
  fields[6]:
    - name: EVENT_ID
      from: ""
      fn: custom
      args:
        expression: "CASE WHEN len(list_filter(list_transform(list_concat(regexp_extract_all(concat_ws('X', translate(EVENT_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), CASE WHEN regexp_full_match(translate(EVENT_TS, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), '[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2})?') THEN NULL ELSE translate(EVENT_TS, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789') END, CASE WHEN regexp_full_match(translate(EVENT_DATE, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), '[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2})?') THEN NULL ELSE translate(EVENT_DATE, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789') END, translate(ACCOUNT_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(SUBSCRIBER_TOKEN, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(CHANNEL, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789')), '[0-9](?:[^0-9A-Za-z]{0,3}[0-9])*'), regexp_extract_all(concat_ws('X', translate(EVENT_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), CASE WHEN regexp_full_match(translate(EVENT_TS, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), '[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2})?') THEN NULL ELSE translate(EVENT_TS, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789') END, CASE WHEN regexp_full_match(translate(EVENT_DATE, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), '[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2})?') THEN NULL ELSE translate(EVENT_DATE, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789') END, translate(ACCOUNT_ID, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(SUBSCRIBER_TOKEN, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789'), translate(CHANNEL, '０１２３４５６７８９٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹०१२३४५६७८९', '0123456789012345678901234567890123456789')), '[0-9]+')), lambda c: regexp_replace(c, '[^0-9]', '', 'g')), lambda d: length(d) BETWEEN 13 AND 19 AND list_sum(list_transform(range(1, length(d) + 1), lambda k: CASE WHEN k % 2 = 0 THEN TRY_CAST(substr(reverse(d), k, 1) AS INTEGER) * 2 - CASE WHEN TRY_CAST(substr(reverse(d), k, 1) AS INTEGER) > 4 THEN 9 ELSE 0 END ELSE TRY_CAST(substr(reverse(d), k, 1) AS INTEGER) END)) % 10 = 0)) > 0 THEN error('INGEST_PURGE_FILE: card-number tripwire: a Luhn-valid 13-19 digit number in a SIM_CHANGES row; only tokenised instruments may be ingested') ELSE EVENT_ID END"
    - name: EVENT_TS
      from: EVENT_TS
      fn: keep
    - name: EVENT_DATE
      from: EVENT_DATE
      fn: keep
    - name: ACCOUNT_ID
      from: ACCOUNT_ID
      fn: keep
    - name: SUBSCRIBER_TOKEN
      from: SUBSCRIBER_TOKEN
      fn: keep
    - name: CHANNEL
      from: CHANNEL
      fn: keep
