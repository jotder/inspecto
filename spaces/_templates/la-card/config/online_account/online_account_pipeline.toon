name: online_account
active: true
description: "Card and e-commerce fraud Link Analysis showcase - One row per change to an online shopping account: the card on file, e-mail, phone, the device the change came from and the ship-to address; the first row of an account is its creation. One landed extract; the next month is in data/staged. Synthetic; regenerate with tools/gen-la-card-data.py."

dirs:
  poll:       data/inbox/online_account
  database:   data/online_account/database
  backup:     data/online_account/backup
  temp:       data/online_account/temp
  errors:     data/online_account/errors
  quarantine: data/online_account/quarantine
  markers:    data/online_account/markers
  status_dir: data/online_account/status
  log_dir:    data/online_account/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: online_account_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
