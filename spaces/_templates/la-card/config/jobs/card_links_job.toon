job:
  name: card_links
  type: sql.template
  description: "Folds the card fraud feeds into ONE link Dataset for Link Analysis (src, dst, kind, ts, amount, event_date, via), one row per pair. used_at: card to a merchant it bought at (amount = approved, via = authorisations, declines and days); refunded: money a merchant returned to a card (via = refunds and the sales that card made there); used_device: a card to the device of its online purchases, or an online account to the device a change came from; from_ip: a card to the /24 network of its online purchases (via = distinct IPs, authorisations, declines); account_card: an online account to its card on file; ships_to: an online account to a ship-to address (upper-cased; via = the day it was set and the devices that set it); charged_back: a card to the merchant of a disputed authorisation (via = reason@month); visited_before_fraud: a card to each merchant it paid at in the 45 days before its first card-not-present fraud (via = days before). A blank or placeholder address (UNKNOWN, N/A) is no evidence and makes no link. Ids say what an endpoint is: CRD- card, M- merchant, DEV- device, OA- online account, a /24 network, or an address. Runs after every Pipeline commit, and every 5 minutes as well: a commit that lands while a run is in flight is skipped, not queued (JOB-SIGNAL-OVERLAP-SKIP-1), so the cron catches up the last landing."
  sql: "WITH a AS (SELECT auth_id, card_id, merchant_id, amount, auth_at, nullif(trim(device_id), '') AS device_id, nullif(trim(ip), '') AS ip, result FROM card_auth), ua AS (SELECT card_id AS src, merchant_id AS dst, 'used_at' AS kind, min(auth_at) AS ts, sum(CASE WHEN result = 'approved' THEN amount ELSE 0 END) AS amount, 'auths:' || count(*) || '|declined:' || count(*) FILTER (WHERE result = 'declined') || '|days:' || count(DISTINCT CAST(auth_at AS DATE)) AS via FROM a WHERE result <> 'refund' GROUP BY card_id, merchant_id), sales AS (SELECT card_id, merchant_id, count(*) AS n FROM a WHERE result = 'approved' GROUP BY card_id, merchant_id), rf AS (SELECT r.card_id AS src, r.merchant_id AS dst, 'refunded' AS kind, min(r.auth_at) AS ts, sum(r.amount) AS amount, 'refunds:' || count(*) || '|sales:' || coalesce(max(s.n), 0) AS via FROM a r LEFT JOIN sales s ON s.card_id = r.card_id AND s.merchant_id = r.merchant_id WHERE r.result = 'refund' GROUP BY r.card_id, r.merchant_id), udc AS (SELECT card_id AS src, device_id AS dst, 'used_device' AS kind, min(auth_at) AS ts, sum(CASE WHEN result = 'approved' THEN amount ELSE 0 END) AS amount, 'auths:' || count(*) || '|declined:' || count(*) FILTER (WHERE result = 'declined') AS via FROM a WHERE device_id IS NOT NULL GROUP BY card_id, device_id), oa AS (SELECT account_id, nullif(trim(card_id), '') AS card_id, nullif(trim(device_id), '') AS device_id, upper(trim(ship_to_address)) AS ship, changed_at FROM online_account WHERE account_id IS NOT NULL AND account_id <> ''), uda AS (SELECT account_id AS src, device_id AS dst, 'used_device' AS kind, min(changed_at) AS ts, 0.0 AS amount, 'changes:' || count(*) AS via FROM oa WHERE device_id IS NOT NULL GROUP BY account_id, device_id), fi AS (SELECT card_id AS src, split_part(ip, '.', 1) || '.' || split_part(ip, '.', 2) || '.' || split_part(ip, '.', 3) || '.0/24' AS dst, 'from_ip' AS kind, min(auth_at) AS ts, sum(CASE WHEN result = 'approved' THEN amount ELSE 0 END) AS amount, 'ips:' || count(DISTINCT ip) || '|auths:' || count(*) || '|declined:' || count(*) FILTER (WHERE result = 'declined') AS via FROM a WHERE ip IS NOT NULL GROUP BY 1, 2), ac AS (SELECT account_id AS src, card_id AS dst, 'account_card' AS kind, min(changed_at) AS ts, 0.0 AS amount, 'changes:' || count(*) AS via FROM oa WHERE card_id IS NOT NULL GROUP BY account_id, card_id), st AS (SELECT account_id AS src, ship AS dst, 'ships_to' AS kind, min(changed_at) AS ts, 0.0 AS amount, 'set:' || strftime(min(changed_at), '%Y-%m-%d') || '|from:' || coalesce(string_agg(DISTINCT device_id, '|' ORDER BY device_id), '') AS via FROM oa WHERE ship IS NOT NULL AND ship NOT IN ('', 'UNKNOWN', 'N/A', 'NA', 'NONE') GROUP BY account_id, ship), cbx AS (SELECT a.card_id, a.merchant_id, a.amount, a.auth_at, c.reason, c.filed_at FROM chargeback c JOIN a ON a.auth_id = c.auth_id), cb AS (SELECT card_id AS src, merchant_id AS dst, 'charged_back' AS kind, CAST(min(filed_at) AS TIMESTAMP) AS ts, sum(amount) AS amount, string_agg(reason || '@' || strftime(filed_at, '%Y-%m'), '|' ORDER BY filed_at, reason) AS via FROM cbx GROUP BY card_id, merchant_id), fr AS (SELECT card_id, min(auth_at) AS fraud_at FROM cbx WHERE reason = 'fraud_card_not_present' GROUP BY card_id), vbf AS (SELECT s.card_id AS src, s.merchant_id AS dst, 'visited_before_fraud' AS kind, min(s.auth_at) AS ts, sum(s.amount) AS amount, 'days_before_fraud:' || min(date_diff('day', s.auth_at, f.fraud_at)) || '-' || max(date_diff('day', s.auth_at, f.fraud_at)) AS via FROM a s JOIN fr f ON f.card_id = s.card_id WHERE s.result = 'approved' AND s.auth_at < f.fraud_at AND s.auth_at >= f.fraud_at - INTERVAL 45 DAY GROUP BY s.card_id, s.merchant_id), links AS (SELECT * FROM ua UNION ALL SELECT * FROM rf UNION ALL SELECT * FROM udc UNION ALL SELECT * FROM uda UNION ALL SELECT * FROM fi UNION ALL SELECT * FROM ac UNION ALL SELECT * FROM st UNION ALL SELECT * FROM cb UNION ALL SELECT * FROM vbf) SELECT src, dst, kind, ts, round(amount, 2) AS amount, CAST(ts AS DATE) AS event_date, via FROM links ORDER BY kind, src, dst"
  sources: card_auth,chargeback,online_account
  sink_dataset: card_links
  on_signal: pipeline.commit
  cron: "*/5 * * * *"
  enabled: true
