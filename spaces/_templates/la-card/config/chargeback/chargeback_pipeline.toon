name: chargeback
active: true
description: "Card and e-commerce fraud Link Analysis showcase - One row per chargeback: the authorisation disputed, the reason and the day it was filed. One landed extract; the next month is in data/staged. Synthetic; regenerate with tools/gen-la-card-data.py."

dirs:
  poll:       data/inbox/chargeback
  database:   data/chargeback/database
  backup:     data/chargeback/backup
  temp:       data/chargeback/temp
  errors:     data/chargeback/errors
  quarantine: data/chargeback/quarantine
  markers:    data/chargeback/markers
  status_dir: data/chargeback/status
  log_dir:    data/chargeback/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: chargeback_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
