physicalRef: online_account/database
description: "Card and e-commerce fraud Link Analysis showcase - One row per change to an online shopping account: the card on file, e-mail, phone, the device the change came from and the ship-to address; the first row of an account is its creation. One landed extract; the next month is in data/staged. Landed by the online_account Pipeline. Synthetic."
eventDate: changed_at
columns[7]{name,type,classification}:
  account_id,string,
  card_id,string,
  email,string,
  phone,string,
  device_id,string,
  ship_to_address,string,
  changed_at,timestamp,
