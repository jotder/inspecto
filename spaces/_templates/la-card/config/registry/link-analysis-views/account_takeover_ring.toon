name: account_takeover_ring
description: "Account takeover - online accounts linked to the devices their changes came from and to their ship-to addresses (via shows when an address was set and from which device). Look for a handful of devices that reach many accounts and move them onto a few shared addresses within a few weeks. A family tablet that four accounts at one address sign in from is the innocent version."
sourceId: entity-projection
layout: force
query:
  projection:
    datasetId: card_links_dataset
    sourceCol: src
    targetCol: dst
    linkKindCol: kind
    attrCols[3]: ts,amount,via
  filter:
    kind: group
    op: OR
    items[2]{kind,field,operator,value}:
      condition,kind,"=","used_device"
      condition,kind,"=","ships_to"
view:
  legend: true
  workingSet: true
  plugins:
    minimap: true
    hulls: true
    behaviors[1]: hover-activate
