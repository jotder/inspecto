entityType: wallet
description: "Each wallet's daily transaction count and value against its own last 28 days (same weekday first) and against wallets of the same KYC tier. A wallet that suddenly moves far more than it usually does, or than its tier does, is high - mule wallets, account takeover and tier-limit gaming"
bucket: day
window: 28
seasonality: weekday
minBaselinePoints: 3
elevatedThreshold: 60
highThreshold: 80
maxEntities: 500000
peers:
  by[1]: kyc_tier
  dataset: wallets
  key: wallet_id
  minGroupSize: 30
features[2]:
  - id: txn_count
    label: "Transactions"
    dataset: wallet_txn
    key: wallet_id
    time: txn_ts
    measure: count
    direction: up
    weight: 1
  - id: txn_value
    label: "Transaction value (USD)"
    dataset: wallet_txn
    key: wallet_id
    time: txn_ts
    measure: "sum(amount)"
    direction: up
    weight: 1
    unit: 10
