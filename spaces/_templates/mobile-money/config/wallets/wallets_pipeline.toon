name: wallets
active: true

dirs:
  poll:       data/inbox/wallets
  database:   data/wallets/database
  backup:     data/wallets/backup
  temp:       data/wallets/temp
  errors:     data/wallets/errors
  quarantine: data/wallets/quarantine
  markers:    data/wallets/markers
  status_dir: data/wallets/status
  log_dir:    data/wallets/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 2
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: wallets_schema.toon
  csv_settings:
    delimiter: ","
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  gap_detection:
    enabled: true
    sequence: "WALLETS_{yyyyMMdd}"
