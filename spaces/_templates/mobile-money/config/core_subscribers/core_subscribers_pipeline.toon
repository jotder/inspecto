name: core_subscribers
active: true

dirs:
  poll:       data/inbox/core_subscribers
  database:   data/core_subscribers/database
  backup:     data/core_subscribers/backup
  temp:       data/core_subscribers/temp
  errors:     data/core_subscribers/errors
  quarantine: data/core_subscribers/quarantine
  markers:    data/core_subscribers/markers
  status_dir: data/core_subscribers/status
  log_dir:    data/core_subscribers/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 2
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: core_subscribers_schema.toon
  csv_settings:
    delimiter: ","
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  gap_detection:
    enabled: true
    sequence: "CORE_SUBSCRIBERS_{yyyyMMdd}"
