name: wallet_txn
active: true
description: "Link Analysis mobile-money showcase feed - one CSV per UTC day (WALLET_TXN_yyyyMMdd.csv) of wallet transactions: p2p, cash_in, cash_out, merchant_pay. Partition = txn_date. Synthetic; regenerate with tools/gen-la-mm-data.py."

dirs:
  poll:       data/inbox/wallet_txn
  database:   data/wallet_txn/database
  backup:     data/wallet_txn/backup
  temp:       data/wallet_txn/temp
  errors:     data/wallet_txn/errors
  quarantine: data/wallet_txn/quarantine
  markers:    data/wallet_txn/markers
  status_dir: data/wallet_txn/status
  log_dir:    data/wallet_txn/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
    retention_days: 30
  schema_file: wallet_txn_schema.toon
  csv_settings:
    delimiter: ","
    has_header: true
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

collector:
  discovery: poll
  connector: local
