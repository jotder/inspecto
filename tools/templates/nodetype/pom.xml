<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parentless on purpose: built OUTSIDE the engine reactor, offline (`mvn -o package`),
         against the engine version it was scaffolded from. Every plugin version is pinned so the
         build never reaches the network to resolve one. -->
    <groupId>com.example.pack</groupId>
    <artifactId>{{artifactId}}</artifactId>
    <version>1.0.0</version>
    <name>{{name}}</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>24</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- The engine supplies the SPI at run time — `provided`, so this jar ships only your code. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-engine</artifactId>
            <version>4.0.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- The engine supplies DuckDB at run time, but `provided` scope does not travel transitively,
             so the TEST needs its own copy to run the Step the way the engine will. -->
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>1.5.2.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- DuckDB opens a native library; without this the JVM warns now and will refuse
                         later. The engine's own build passes the same flag. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
