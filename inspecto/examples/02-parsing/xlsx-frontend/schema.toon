    ITEM_NAME,"item_name",VARCHAR
    QTY_ON_HAND,"qty_on_hand",DOUBLE
    UNIT_PRICE,"unit_price",DOUBLE
    CATEGORY,"category",VARCHAR
mapping:
  canonicalName: inventory
  rawName: INVENTORY
  fields[4]{name,from,fn}:
