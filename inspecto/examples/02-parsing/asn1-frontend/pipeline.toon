name: PARSE_ASN1
active: true
version: 1

dirs:
  poll:       out/inbox
  database:   out/mo_call/database
  backup:     out/mo_call/backup
  temp:       out/mo_call/temp
  errors:     out/mo_call/errors
  quarantine: out/mo_call/quarantine
  markers:    out/mo_call/markers
  status_dir: out/mo_call/status
  log_dir:    out/mo_call/logs

output:
  format: CSV

processing:
  threads: 1
  file_pattern: "glob:**/*.ber"
  duplicate_check:
    enabled: true
    marker_extension: .processed

parsing:
  frontend: asn1
  asn1:
    grammar: "CDR DEFINITIONS IMPLICIT TAGS ::= BEGIN CallEventRecord ::= SEQUENCE { moCallRecord [0] MoCall, smsRecord [1] Sms } MoCall ::= SEQUENCE { imsi [0] IA5String, duration [1] INTEGER, party [2] Party OPTIONAL } Party ::= SEQUENCE { number [0] IA5String } Sms ::= SEQUENCE { imsi [0] IA5String } END"
    root_type: CallEventRecord
    strictness: BER
    segments:
      moCallRecord: mo_call_schema.toon
