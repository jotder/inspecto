name: STEP_EXCEL
active: true

dirs:
  poll:       out/inbox
  database:   out/orders/database
  backup:     out/orders/backup
  temp:       out/orders/temp
  errors:     out/orders/errors
  quarantine: out/orders/quarantine
  markers:    out/orders/markers
  status_dir: out/orders/status
  log_dir:    out/orders/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.csv"
  duplicate_check:
    enabled: true
    marker_extension: .processed
  schema_file: "schema.toon"
  csv_settings:
    delimiter: ","
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

output_store: orders_at_rest

excel:
  path: reports/orders.xlsx
  max_rows: 1000
  sheets[3]:
    - name: Orders
    - name: By region
      sql: "SELECT REGION, count(*) AS ORDERS, round(sum(GROSS), 2) AS GROSS FROM input GROUP BY REGION ORDER BY REGION"
    - name: Shipped
      sql: "SELECT ORDER_ID, REGION, PRODUCT, GROSS FROM input WHERE STATUS = 'SHIPPED' ORDER BY ORDER_ID"
