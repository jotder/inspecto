name: STEP_UNPIVOT
active: true

dirs:
  poll:       out/inbox
  database:   out/cdr/database
  backup:     out/cdr/backup
  temp:       out/cdr/temp
  errors:     out/cdr/errors
  quarantine: out/cdr/quarantine
  markers:    out/cdr/markers
  status_dir: out/cdr/status
  log_dir:    out/cdr/logs

output:
  format: PARQUET
  compression: snappy

processing:
  threads: 1
  file_pattern: "glob:**/*.jsonl"
  duplicate_check:
    enabled: true
    marker_extension: .processed
  schema_file: "schema.toon"
  csv_settings:
    date_formats[1]: "%Y-%m-%d"
    timestamp_formats[1]: "%Y-%m-%d %H:%M:%S"

parsing:
  frontend: json
  json:
    format: newline

output_store: charge_lines

steps[1]:
  - unpivot:
      columns_pattern: "^CHARGE_"
      name_column: CHARGE_TYPE
      value_column: AMOUNT
      value_type: "DECIMAL(12,4)"
