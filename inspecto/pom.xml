<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The lean, deployable ETL engine + control plane (the "core" of the v3 split).
         Renamed from "file-processor" on 2026-08-10; the DEPLOYMENT name followed on
         2026-08-13 — package.ps1 copies this module's shaded jar to "inspecto.jar"
         inside the bundle. Stays
         zero-new-dependency; the optional agent lives in a sibling module (inspecto-agent). -->
    <artifactId>inspecto-processor</artifactId>

    <!-- Compiler/encoding/argLine properties and the compiler + surefire plugin config are
         inherited from the parent POM. Only the core-specific shade (fat-JAR) and the optional
         jacoco 'coverage' profile live here. -->

    <dependencies>
        <!-- @PublicApi stability annotation — the reactor's dependency-free leaf (S5 ①).
             Version managed by the parent. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-api</artifactId>
        </dependency>

        <!-- com.gamma.config — spec/codec/safety, extracted to its own module (S5 ②).
             Version managed by the parent. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-config</artifactId>
        </dependency>

        <!-- com.gamma.util — DuckDB access point + CSV/file/tar helpers, extracted to its own
             module (WS-D). Version managed by the parent. The ~30 DuckDbUtil call sites and every
             other com.gamma.util import keep resolving through this dependency. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-util</artifactId>
        </dependency>

        <!-- com.gamma.sql — sandboxed SQL (SqlSandbox/SqlOracle/SqlGuard/SqlViews), extracted to
             its own module (WS-D ②). Version managed by the parent. expectation/control keep
             importing com.gamma.sql through this dependency. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-sql</artifactId>
        </dependency>

        <!-- com.gamma.{signal,query,pipeline,inspector,acquire,ingester,ops,job,enrich,alert,notify,
             catalog} — the engine cluster, extracted BELOW core (WS-D). The composition root
             (service/control/report/assist/exchange/expectation/intelligence/model) compile-depends
             DOWN onto it. duckdb reaches the fat-JAR transitively through this dependency. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-engine</artifactId>
        </dependency>

        <!-- com.gamma.etl (WS-D increment 2) — extracted below fp-engine once etl became a
             foundation leaf. Declared directly (not left transitive through fp-engine) since ~14
             core main-code files import it directly. univocity/commons-compress/gson reach the
             fat-JAR transitively through this dependency. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-etl</artifactId>
        </dependency>
        <!-- fp-etl test-jar: reuses the shared fixtures com.gamma.etl.TestConfigs/
             PipelineConfigBatchTest (PipelineConfig builders) in ~45 control/report/service tests.
             Test scope is not transitive, so this is declared explicitly. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-etl</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- com.gamma.{event,metrics} (WS-D increment 3) — the Operational-Intelligence event store,
             extracted below fp-engine (mutually cyclic with each other, not with anything else).
             Declared directly since ~18 core main-code files import event/metrics directly.
             logback-classic reaches the fat-JAR transitively through this dependency. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-event</artifactId>
        </dependency>

        <!-- com.gamma.acquire (WS-D increment 4) — extracted below fp-event once acquire was no
             longer SCC-trapped. Declared directly since ~6 core main-code files import it directly. -->
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-acquire</artifactId>
        </dependency>

        <!-- JToon for configuration serialisation (version managed by the parent — shared
             with fp-config since S5) -->
        <dependency>
            <groupId>dev.toonformat</groupId>
            <artifactId>jtoon</artifactId>
        </dependency>

        <!-- Jackson for Map conversion used by JToon patterns (version managed by the parent) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logging — slf4j-api facade, used directly by ~23 core-staying classes. logback-classic
             (the SLF4J runtime binding) + logback.xml + the EventStoreAppender now live in fp-engine
             and reach the fat-JAR transitively; core no longer compiles against logback. slf4j-api's
             version is parent-managed (${slf4j.version}, pinned to what logback 1.5.x compiles against). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- JUnit 5 — unit/integration tests (version managed by the parent, M1). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Fat JAR — bundles all runtime dependencies into a single deployable JAR.
                Build with:  mvn clean package
                Run ETL:     java -cp inspecto-processor-<version>.jar com.gamma.inspector.CollectorProcessor  <pipeline.toon>
                Gen schema:  java -cp inspecto-processor-<version>.jar com.gamma.inspector.SchemaExtractor <args>
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Default main class for convenience; override with -cp and full class name -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.gamma.inspector.CollectorProcessor</mainClass>
                                </transformer>
                                <!-- Merge JDBC driver service registrations from all dependencies -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <!-- Strip JAR signatures — required to avoid SecurityException at runtime -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire (JUnit 5 runner + native-access flag) is configured in the parent POM's
                 <pluginManagement> and applies to this module's default-lifecycle test run.
                 JaCoCo (line/branch coverage) is activated by the parent POM's 'coverage' profile so a
                 normal 'mvn test' is unaffected; run 'mvn -Pcoverage test' to instrument (M5: the profile
                 moved to the parent so every module reports coverage in one reactor pass). -->
        </plugins>
    </build>

</project>
