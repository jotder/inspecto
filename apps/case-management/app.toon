id: case-management
title: Case Management
version: 1.0.0
platform: >=4.0 <5
industries[0]:
requires:
  addons[3]: caseManagement,incidents,workflowSla
templates[0]:
nav:
  alerts:
    path: alerts
    label: Alerts
    icon: heroicons_outline:bell-alert
    feature: ops
    blurb: Every Alert the Apps raise, newest first, with the Incident it opened.
  incidents:
    path: incidents
    label: Incidents
    icon: heroicons_outline:exclamation-triangle
    feature: ops
    blurb: Triage, assign and resolve what the Alerts opened, with its impact.
  cases:
    path: cases
    label: Cases
    icon: heroicons_outline:briefcase
    feature: cases
    blurb: Group related Incidents into one Case and work it to a decision.
docs: docs/okf/product/app/case-management/index.md
