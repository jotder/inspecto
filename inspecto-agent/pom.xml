<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gamma.inspector</groupId>
        <artifactId>inspecto-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>inspecto-agent</artifactId>
    <packaging>jar</packaging>

    <name>Inspecto — Assist Agent (optional)</name>
    <description>
        Optional embedded AI assist agent (v3.0). Implements the AssistAgent SPI from the
        core module and is loaded in-process by SourceService when present on the classpath.

        ALL AI/LLM dependencies (LangChain4j, the Ollama client, and — in connected builds —
        hosted-model SDKs for Gemini/Claude/ChatGPT) belong ONLY in this module, so the core
        fat-JAR stays lean. The air-gapped build omits hosted SDKs, making "local-only" a
        packaging guarantee rather than a config flag.

        M3 status (v3.3.0): the assist platform goes live — LangChain4j + Ollama behind a
        ModelProvider seam, a skill registry, the explain-entity skill, and an AI-backed
        DescriptionProvider. These deps live ONLY here; the core fat-JAR remains zero-new-dep.
        No hosted-model SDK ships in M3, so "local-only" is guaranteed by packaging.
    </description>

    <!-- langchain4j.version + eoiagent.version are managed by the parent (M1). All AI/LLM deps
         are still confined to this optional module only — CVE-scan this tree (SBOM); they never
         reach the lean core fat-JAR. -->

    <dependencies>
        <dependency>
            <groupId>com.gamma.inspector</groupId>
            <artifactId>inspecto-processor</artifactId>
            <version>${project.version}</version>
            <!-- `provided`, exactly as inspecto-connectors scopes it (PKG-5, 2026-09-12). The core is
                 ALWAYS on a bundle's classpath as inspecto.jar, so shading it into this sidecar would
                 ship a second copy of every core class and service registration - 8660 entries and
                 ~98 MB, against ~9 MB of actual agent. Duplicate ServiceLoader registrations on one
                 classpath is not merely wasteful; it is a second, older copy of the product competing
                 with the real one. Still on the compile AND test classpath, so nothing here changes
                 for the module's own build. -->
            <scope>provided</scope>
        </dependency>

        <!-- eoiagent model substrate: LlmGateway port (core) + Lc4jChatGateway transport (model).
             eoiagent types live ONLY in this module, behind the AssistAgent SPI; the lean core
             never sees them. langchain4j-open-ai is EXCLUDED so the air-gapped guarantee stays a
             packaging fact (EgressGuardTest) — the hosted module ships it deliberately. -->
        <dependency>
            <groupId>com.eoiagent</groupId>
            <artifactId>eoiagent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eoiagent</groupId>
            <artifactId>eoiagent-model</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>dev.langchain4j</groupId>
                    <artifactId>langchain4j-open-ai</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- LangChain4j + Ollama: local-first model access behind the ModelProvider seam. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The golden-eval harness (FakeModelProvider, EvalCase/Expect, EvalCaseLoader, EvalRunner,
             Evals @TestFactory glue) is vendored under src/test/java/com/gamma/agent/kernel/eval —
             formerly the kernel's agent-eval jar + test-jar. Test tree only; never ships. -->
    </dependencies>

    <!-- PKG-5 (operator decision 2026-09-12: the assistant ships in ALL THREE editions, as an
         OPTIONAL component). Shading is what makes that possible: a THIN inspecto-agent.jar on the
         bundle's classpath would be a jar that is present but cannot link, because eoiagent-* and
         langchain4j would be missing — the assistant would be silently absent while appearing to be
         installed. The `sidecar` classifier mirrors inspecto-connectors: the reactor's own thin
         artifact stays the installed one, and only the bundle carries the fat copy.

         ⚠ The eoiagent-* dependencies are compiled to JAVA 25 bytecode (class-file major 69, measured
         2026-09-12) while this product's floor is 24. That is DELIBERATELY not a build-time problem:
         the jar is staged in every bundle, and on a host too old to load it com.gamma.service.OptionalSpi
         skips the provider with a warning and the assistant's routes answer 503 — the ordinary
         absence contract. ⛔ Do not "fix" this by gating the module on a Java version; the whole point
         is that the bundle's stated requirement stays 24. -->
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <!-- Pinned: the offline reactor resolves no plugin version from a repository, and this
                     is the version the core fat jar and the connector sidecar already use. -->
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>sidecar</shadedClassifierName>
                            <transformers>
                                <!-- The whole point: MERGE the ServiceLoader registrations, or the
                                     com.gamma.assist.spi.AssistAgent entry is lost and the staged jar
                                     lights up nothing. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- A retained signature throws SecurityException at run time.
                                             Same filter as the core fat jar and the connector sidecar. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Never ship a second logging config; the core owns it. -->
                                        <exclude>logback.xml</exclude>
                                        <exclude>module-info.class</exclude>
                                        <!-- 🔴 A SECOND SLF4J BINDING on one classpath is a real conflict:
                                             SLF4J picks one non-deterministically and warns, so a bundle
                                             with this sidecar could silently log through a different
                                             backend than the core configured. The core owns the binding;
                                             this sidecar must carry slf4j-api ONLY. Found 2026-09-12 when
                                             the shaded jar turned out to register an SLF4JServiceProvider.
                                             ⛔ Do not drop these excludes to "fix" a missing-logger
                                             warning inside the agent - fix the dependency instead. -->
                                        <exclude>META-INF/services/org.slf4j.spi.SLF4JServiceProvider</exclude>
                                        <exclude>org/slf4j/impl/**</exclude>
                                        <exclude>ch/qos/logback/**</exclude>
                                        <!-- The core owns JDBC driver registration and the servlet
                                             container; a sidecar re-declaring either changes what the
                                             product boots with. Same reasoning as the binding above. -->
                                        <exclude>META-INF/services/java.sql.Driver</exclude>
                                        <exclude>META-INF/services/jakarta.servlet.ServletContainerInitializer</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Compiler + surefire native-access flag are inherited from the parent POM's
         <pluginManagement>. -->

    <!-- Coverage: the 'coverage' profile moved to the parent POM (M5) so a normal 'mvn test' is
         unaffected and 'mvn -Pcoverage test' instruments every module (not just core+agent) in one
         reactor pass. JaCoCo (and all other AI deps) only ever build here, never in the lean core
         fat-JAR. -->
</project>
